EAPI=7

DESCRIPTION="Firmware for the PC hardware ChromeOS Flex supports, from the upstream linux-firmware release"
HOMEPAGE="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git"
SRC_URI="https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-${PV}.tar.xz"

# Per-vendor licenses from WHENCE for exactly the files installed; texts the
# tree does not already carry live in this overlay's licenses/.
# BEGIN GENERATED LICENSE (scripts/gen-firmware-list.py)
LICENSE="
	GPL-2
	LICENCE.Marvell
	LICENCE.NXP
	LICENCE.atheros_firmware
	LICENCE.broadcom_bcm43xx
	LICENCE.cypress
	LICENCE.ibt_firmware
	LICENCE.iwlwifi_firmware
	LICENCE.mediatek
	LICENCE.nvidia
	LICENCE.open-ath9k-htc-firmware
	LICENCE.ralink-firmware.txt
	LICENCE.ralink_a_mediatek_company_firmware
	LICENCE.rtlwifi_firmware.txt
	LICENSE.QualcommAtheros_ath10k
	LICENSE.amdgpu
	LICENSE.ipu3_firmware
	LICENSE.ivsc
	LICENSE.qcom
	LICENSE.r8169
	LICENSE.radeon
"
# END GENERATED LICENSE
SLOT="0"
KEYWORDS="*"
RESTRICT="binchecks mirror strip test"

S="${WORKDIR}/linux-firmware-${PV}"

# files/firmware.list and LICENSE are generated by scripts/gen-firmware-list.py: Flex's
# firmware set, minus what sys-kernel/linux-firmware (our LINUX_FIRMWARE flags)
# and sys-firmware/sof-firmware already install, minus anything upstream does
# not carry (e.g. b43, which is not redistributable). Symlink targets are
# included so no link dangles.

src_compile() {
	# copy-firmware.sh materializes the WHENCE "Link:" entries (compat
	# symlinks for files upstream has moved) into a staging tree.
	./copy-firmware.sh "${WORKDIR}/stage" >/dev/null || die "copy-firmware.sh failed"
}

src_install() {
	local stage="${WORKDIR}/stage" f n=0
	while IFS= read -r f; do
		[[ -z ${f} || ${f} == \#* ]] && continue
		[[ -e ${stage}/${f} || -L ${stage}/${f} ]] || die "listed but not in upstream ${PV}: ${f}"
		mkdir -p "${ED}/lib/firmware/$(dirname "${f}")" || die
		cp -a "${stage}/${f}" "${ED}/lib/firmware/${f}" || die
		n=$((n + 1))
	done < "${FILESDIR}/firmware.list"
	einfo "installed ${n} firmware files"
}

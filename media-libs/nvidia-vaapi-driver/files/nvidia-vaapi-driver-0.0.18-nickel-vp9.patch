-gst_codecs_deps = dependency('gstreamer-codecparsers-1.0', required: false)
+# NickelOS: VP9 needs GStreamer's VP9 frame header parser. Built in from
+# gst-plugins-bad's source (nickel-gst/, glib only) instead of linking the
+# whole of GStreamer, which the system does not have. nickel-vp9-state.c is
+# gstvp9parser.c plus an accessor for the state it carries between frames.
+gst_codecs_deps = declare_dependency(
+    sources: ['nickel-gst/nickel-vp9-state.c', 'nickel-gst/vp9utils.c'],
+    include_directories: include_directories('nickel-gst'),
+    compile_args: ['-DGST_USE_UNSTABLE_API='],
+    dependencies: dependency('glib-2.0'),
+)
 
 if cc.get_argument_syntax() == 'gcc'
     add_project_arguments(

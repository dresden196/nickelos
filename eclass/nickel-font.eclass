# @ECLASS: nickel-font.eclass
# @BLURB: Install a font family into /usr/share/fonts with its own fontconfig cache.
# @DESCRIPTION:
# ChromeOS has no font.eclass. Its font cache is generated by
# chromeos-base/chromeos-fonts from whatever is in the sysroot when *it* is
# built, and that package normally arrives as a prebuilt, so fonts added by a
# board overlay would be missing from the cache. This eclass generates a cache
# for the one font directory it installs, the same way chromeos-fonts does
# (same .uuid scheme, SDK fc-cache with --sysroot, SOURCE_DATE_EPOCH=1).
# fontconfig names cache files per directory, so nothing collides with the
# caches chromeos-fonts ships.
#
# ChromeOS's /etc/fonts/local.conf lists every font directory explicitly and
# fontconfig scans nothing else, so this eclass also installs a conf.d file
# with a <dir> entry for the directory it installs.

case ${EAPI} in
7) ;;
*) die "${ECLASS}: EAPI ${EAPI} unsupported" ;;
esac

# The cache is built against the board's fontconfig config (/etc/fonts), so
# fontconfig must be in the sysroot first.
DEPEND="media-libs/fontconfig"

# @ECLASS_VARIABLE: NICKEL_FONT_FILES
# @DESCRIPTION: Bash array of font files (relative to ${S}) to install.

# @ECLASS_VARIABLE: NICKEL_FONT_CONF
# @DESCRIPTION: Optional bash array of fontconfig .conf files to install to
# /etc/fonts/conf.d.

nickel-font_src_compile() {
	[[ ${#NICKEL_FONT_FILES[@]} -gt 0 ]] || die "NICKEL_FONT_FILES is empty"
	local stage="${WORKDIR}/fcstage" dir="${WORKDIR}/fcstage/usr/share/fonts/${PN}"
	mkdir -p "${dir}" "${stage}/etc/fonts" || die
	cp "${NICKEL_FONT_FILES[@]/#/${S}/}" "${dir}/" || die
	rsync -a "${SYSROOT}/etc/fonts/" "${stage}/etc/fonts/" || die
	uuidgen --sha1 -n @dns -N "${PN}" > "${dir}/.uuid" || die
	SOURCE_DATE_EPOCH=1 /usr/bin/fc-cache -f -v --sysroot "${stage}" \
		"/usr/share/fonts/${PN}" || die
}

nickel-font_src_install() {
	local stage="${WORKDIR}/fcstage"
	insinto "/usr/share/fonts/${PN}"
	doins "${stage}/usr/share/fonts/${PN}"/*
	doins "${stage}/usr/share/fonts/${PN}/.uuid"
	# Only this directory's cache; CACHEDIR.TAG belongs to chromeos-fonts.
	insinto /usr/share/cache/fontconfig
	doins "${stage}"/usr/share/cache/fontconfig/*.cache-*
	insinto /etc/fonts/conf.d
	cat > "${T}/09-nickel-${PN}-dir.conf" <<-EOF || die
	<?xml version="1.0"?>
	<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
	<!-- Installed by ${CATEGORY}/${PN}: local.conf only lists stock font dirs. -->
	<fontconfig>
	  <dir>/usr/share/fonts/${PN}</dir>
	</fontconfig>
	EOF
	doins "${T}/09-nickel-${PN}-dir.conf"
	if [[ ${#NICKEL_FONT_CONF[@]} -gt 0 ]]; then
		doins "${NICKEL_FONT_CONF[@]}"
	fi
}

EXPORT_FUNCTIONS src_compile src_install

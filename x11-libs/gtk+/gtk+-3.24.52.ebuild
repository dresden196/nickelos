EAPI=7

# NickelOS: ported from Gentoo gtk+-3.24.52 (EAPI 8 -> 7): KEYWORDS="*", single ABI (meson, not meson-multilib), built against ChromiumOS's GLib 2.76 (GTK 3 needs 2.57.2) and the pango, cairo, gdk-pixbuf, harfbuzz, libepoxy, wayland and libxkbcommon already in portage-stable/chromiumos-overlay.
# Backends: Wayland and X11 (the X11 one needs cairo[X], i.e. cairo-xlib; set in profiles/base/package.use). Wayland EGL comes from dev-libs/wayland's libwayland-egl, not mesa[wayland] (mesa-reven is built without platforms).
# Off: broadway, quartz, cloudproviders, colord, sysprof, tracker, xinerama, introspection, demos, examples, tests, man pages (docbook) and gtk-doc. CUPS stays optional: libcups is already on the image (ChromeOS printing).
# Input-method modules are all built into libgtk (Gentoo: only the backend ones), so no immodules.cache has to be generated by running a target binary at image build time.
# gtk-update-icon-cache is built by GTK itself: Gentoo's patch moving it to dev-util/gtk-update-icon-cache is not applied (that package is not ported). The Gentoo-only GDK_WINDOWING poison-macro and test patches are not applied either.
# PDEPEND adwaita-icon-theme dropped: GTK 3 carries its own fallback icons (window controls, pan/menu arrows, folder, image-missing, ...) in its resources; the hicolor fallback theme comes from chromeos-base/nickel-desktop-base. librsvg (SVG pixbuf loader) is an RDEPEND instead of a PDEPEND (no cycle here). Gentoo's /etc/gtk-3.0/settings.ini (Adwaita theme, "gnome" icon theme) is not installed: GTK's built-in defaults apply.

GNOME_ORG_MODULE=gtk
inherit gnome.org gnome2-utils meson xdg

DESCRIPTION="Gimp ToolKit +"
HOMEPAGE="https://www.gtk.org/"

LICENSE="LGPL-2+"
SLOT="3"
KEYWORDS="*"
IUSE="cups wayland X"
REQUIRED_USE="|| ( wayland X )"
RESTRICT="test"

COMMON_DEPEND="
	>=app-accessibility/at-spi2-core-2.46.0
	>=dev-libs/fribidi-0.19.7
	>=dev-libs/glib-2.57.2:2
	media-libs/fontconfig
	>=media-libs/harfbuzz-2.2.0:=
	>=media-libs/libepoxy-1.4
	virtual/libintl
	>=x11-libs/cairo-1.14[glib,X?]
	>=x11-libs/gdk-pixbuf-2.30:2
	>=x11-libs/pango-1.44.0
	x11-misc/shared-mime-info

	cups? ( >=net-print/cups-2.0 )
	wayland? (
		>=dev-libs/wayland-1.14.91
		>=x11-libs/libxkbcommon-0.2
	)
	X? (
		media-libs/libglvnd[X]
		x11-libs/libX11
		x11-libs/libXcomposite
		x11-libs/libXcursor
		x11-libs/libXdamage
		x11-libs/libXext
		x11-libs/libXfixes
		>=x11-libs/libXi-1.8
		>=x11-libs/libXrandr-1.5
		x11-libs/libXrender
	)
"
DEPEND="${COMMON_DEPEND}
	wayland? ( >=dev-libs/wayland-protocols-1.32 )
	X? ( x11-base/xorg-proto )
"
RDEPEND="${COMMON_DEPEND}
	gnome-base/librsvg
"
BDEPEND="
	dev-util/gdbus-codegen
	dev-util/glib-utils
	wayland? ( dev-util/wayland-scanner )
	>=sys-devel/gettext-0.19.7
	virtual/pkgconfig
	x11-libs/gdk-pixbuf:2
"

src_prepare() {
	default

	# Don't use -Werror, bug #974693
	sed -e '/-Werror=/d' -i meson.build || die
}

src_configure() {
	local emesonargs=(
		-Dquartz_backend=false
		-Dwin32_backend=false
		-Dbroadway_backend=false
		$(meson_use wayland wayland_backend)
		$(meson_use X x11_backend)
		-Dxinerama=no
		-Dcloudproviders=false
		-Dprofiler=false
		-Dtracker3=false
		-Dcolord=no
		-Dprint_backends=$(usex cups cups,file file)
		-Dbuiltin_immodules=all
		-Dintrospection=false
		-Dgtk_doc=false
		-Dman=false
		-Ddemos=false
		-Dexamples=false
		-Dtests=false
		-Dinstalled_tests=false
	)
	meson_src_configure
}

src_install() {
	meson_src_install

	DOCS=( NEWS README.md )
	einstalldocs
}

pkg_postinst() {
	xdg_pkg_postinst
	gnome2_schemas_update
}

pkg_postrm() {
	xdg_pkg_postrm
	gnome2_schemas_update
}

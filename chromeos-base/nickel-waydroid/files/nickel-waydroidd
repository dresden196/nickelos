# nickel-waydroidd: what NickelOS's Android apps need root for. It owns
# org.nickelos.Android on the system bus (/org/nickelos/Android), for
# Settings > Apps > Android apps (Chrome, running as the signed-in user) and
# the APK handler (nickel-waydroid-apk, in the user's session).
#
#   GetState() -> a{sv}
#     android     s  "absent", "setting-up", "ready" or "removing"
#     arm         s  "off", "on", "turning-on" or "turning-off"
#     translator  s  what ARM support installs on this CPU: "libhoudini"
#                    (Intel's) or "libndk" (Google's)
#     progress    d  0 to 1 while Android or a translator downloads, else -1
#     error       s  why the last change failed ("download", "failed"), or ""
#     admin       b  whether the caller may change these
#     disk        t  bytes Android's images take
#   SetUp()       downloads Android (`waydroid init`: about 1 GB, 2.4 GB on
#                 disk) and starts its container (waydroid-container)
#   Cancel()      stops a setup that is still downloading
#   SetArm(b)     ARM app support on or off (nickel-waydroid-arm). The page
#                 asks first: proprietary software the user installs.
#   Remove()      Android gone: its container, images, ARM support, and the
#                 caller's Android apps and data
#   InstallPackage(h apk) -> (s result)
#                 installs the APK the caller opened as |apk| in their
#                 Android, through Android's package manager, and answers
#                 with its result: "Success" or "Failure [CODE: ...]".
#                 (Waydroid's own `app install` hands the file over and never
#                 hears whether it installed.)
#   UninstallPackage(s package) -> (s result)
#                 uninstalls an app from the caller's Android (the launcher's
#                 Uninstall, through nickel-appd and nickel-waydroid-apk):
#                 "Success" or "Failure [...]". (Waydroid's `app remove`
#                 fails on Android 13.)
# SetUp, Cancel, SetArm and Remove return at once (the page polls GetState)
# and are for administrators (group wheel) and root. InstallPackage and
# UninstallPackage are for the user whose Android is running (Waydroid's
# session), each in their own Android; InstallPackage with a file they opened
# themselves: root never opens a path for anyone. Errors are
# org.nickelos.Android.Error.{NotAllowed,Busy,NotSetUp,NotRunning,Failed}.
import grp
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.request

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

W = "/var/lib/waydroid"
CFG = W + "/waydroid.cfg"
ARM = "/usr/libexec/nickel-waydroid/nickel-waydroid-arm"
ARM_STATE = W + "/nickel-arm"
STATEFUL = "/mnt/stateful_partition/nickel"
# What `waydroid init` downloads on x86_64 by default, for its sizes.
OTA = [
    "https://ota.waydro.id/system/lineage/waydroid_x86_64/VANILLA.json",
    "https://ota.waydro.id/vendor/waydroid_x86_64/MAINLINE.json",
]
NAME = "org.nickelos.Android"
PATH = "/org/nickelos/Android"
ERROR = NAME + ".Error."

XML = """
<node>
  <interface name='org.nickelos.Android'>
    <method name='GetState'>
      <arg type='a{sv}' name='state' direction='out'/>
    </method>
    <method name='SetUp'/>
    <method name='Cancel'/>
    <method name='SetArm'>
      <arg type='b' name='on' direction='in'/>
    </method>
    <method name='Remove'/>
    <method name='InstallPackage'>
      <arg type='h' name='apk' direction='in'/>
      <arg type='s' name='result' direction='out'/>
    </method>
    <method name='UninstallPackage'>
      <arg type='s' name='package' direction='in'/>
      <arg type='s' name='result' direction='out'/>
    </method>
  </interface>
</node>
"""

DOWNLOADING = re.compile(rb"\[Downloading\]\s+([\d.]+) MB/([\d.]+) MB")
# An Android package name, as Android allows them.
PACKAGE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$")


def log(msg):
    print("nickel-waydroidd: " + msg, file=sys.stderr, flush=True)


def is_set_up():
    """Waydroid's own test: its config, and the rootfs directory `waydroid
    init` makes once the images are in place."""
    return os.path.isfile(CFG) and os.path.isdir(W + "/rootfs")


def translator_for_cpu():
    with open("/proc/cpuinfo") as f:
        vendor = next((l.split(":", 1)[1].strip() for l in f
                       if l.startswith("vendor_id")), "")
    return "libhoudini" if vendor == "GenuineIntel" else "libndk"


def images_bytes():
    path = W + "/images"
    try:
        with open(CFG) as f:
            for line in f:
                if line.startswith("images_path"):
                    path = line.split("=", 1)[1].strip()
    except OSError:
        return 0
    total = 0
    for name in ("system.img", "vendor.img"):
        try:
            total += os.stat(os.path.join(path, name)).st_size
        except OSError:
            pass
    return total


def is_admin(uid):
    if uid == 0:
        return True
    try:
        return pwd.getpwuid(uid).pw_name in grp.getgrnam("wheel").gr_mem
    except KeyError:
        return False


def container_proxy():
    return Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES |
        Gio.DBusProxyFlags.DO_NOT_CONNECT_SIGNALS, None, "id.waydro.Container",
        "/ContainerManager", "id.waydro.ContainerManager", None)


def running_session():
    """Waydroid's session in the container now (user_id, user_name, ...),
    or {}."""
    try:
        return dict(container_proxy().call_sync(
            "GetSession", None, Gio.DBusCallFlags.NONE, 5000, None).unpack()[0])
    except GLib.Error:
        return {}


def container_state():
    r = subprocess.run(["lxc-info", "-P", W + "/lxc", "-n", "waydroid", "-sH"],
                       capture_output=True, text=True)
    return r.stdout.strip()


def android_booted():
    r = subprocess.run(["waydroid", "shell", "--", "getprop",
                        "sys.boot_completed"], capture_output=True, text=True)
    return r.stdout.strip() == "1"


def umount_under(path):
    """Everything mounted at or below |path|, deepest first (lazily: a
    stopped container should have left nothing, this is a safety net)."""
    targets = []
    with open("/proc/self/mountinfo") as f:
        for line in f:
            target = line.split()[4].replace("\\040", " ")
            if target == path or target.startswith(path + "/"):
                targets.append(target)
    for target in sorted(targets, key=len, reverse=True):
        subprocess.run(["umount", "-l", target], stderr=subprocess.DEVNULL)


class Daemon:
    def __init__(self):
        self.lock = threading.Lock()
        self.android = None   # while busy: "setting-up" or "removing"
        self.arm = None       # while busy: "turning-on" or "turning-off"
        self.progress = -1.0
        self.error = ""
        self.proc = None      # `waydroid init`, while it runs
        self.canceled = False
        self.install_lock = threading.Lock()

    def busy(self):
        return self.android is not None or self.arm is not None

    # --- State -------------------------------------------------------------

    def state(self, uid):
        with self.lock:
            android = self.android or ("ready" if is_set_up() else "absent")
            if self.arm:
                arm = self.arm
            else:
                arm = "on" if os.path.exists(ARM_STATE) else "off"
            return {
                "android": GLib.Variant("s", android),
                "arm": GLib.Variant("s", arm),
                "translator": GLib.Variant("s", translator_for_cpu()),
                "progress": GLib.Variant("d", self.progress),
                "error": GLib.Variant("s", self.error),
                "admin": GLib.Variant("b", is_admin(uid)),
                "disk": GLib.Variant("t", images_bytes()),
            }

    def start(self, field, value, work, *args):
        """Runs |work| in a thread with |field| set to |value| until it
        ends; False if something else is running."""
        with self.lock:
            if self.busy():
                return False
            setattr(self, field, value)
            self.progress = -1.0
            self.error = ""
            self.canceled = False

        def run():
            try:
                work(*args)
            except Exception as e:  # report it, don't lose the daemon
                log("%s failed: %r" % (value, e))
                with self.lock:
                    self.error = self.error or "failed"
            finally:
                with self.lock:
                    setattr(self, field, None)
                    self.progress = -1.0
        threading.Thread(target=run, daemon=True).start()
        return True

    # --- Setting Android up ------------------------------------------------

    def set_up(self):
        sizes = []
        for url in OTA:
            try:
                with urllib.request.urlopen(url, timeout=20) as r:
                    sizes.append(int(json.load(r)["response"][0]["size"]))
            except Exception:
                sizes = []
                break
        total = sum(sizes) / 1e6
        # Unbuffered: Waydroid prints its progress every 2 seconds, which a
        # pipe would otherwise hold back for minutes.
        proc = subprocess.Popen(["waydroid", "init"], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT,
                                env=dict(os.environ, PYTHONUNBUFFERED="1"))
        with self.lock:
            self.proc = proc
            canceled = self.canceled
        if canceled:
            proc.terminate()
        tail = []
        buf = b""
        done = 0.0       # MB of the files finished
        file_mb = None   # the size of the one downloading
        while True:
            chunk = proc.stdout.read1(65536)
            if not chunk:
                break
            buf += chunk
            *lines, buf = re.split(rb"[\r\n]", buf)
            for line in lines:
                m = DOWNLOADING.search(line)
                if not m:
                    if line.strip():
                        tail = (tail + [line.decode(errors="replace")])[-5:]
                    continue
                now, size = float(m[1]), float(m[2])
                if file_mb is not None and size != file_mb:
                    done += file_mb   # the next file began
                file_mb = size
                with self.lock:
                    if total:
                        self.progress = min((done + now) / total, 1.0)
                    elif size:
                        self.progress = now / size
        rc = proc.wait()
        with self.lock:
            self.proc = None
            canceled = self.canceled
        if canceled or rc != 0:
            # What `waydroid init` left: its config (written first), the
            # partial download, any image it got. Android stays absent.
            for p in (CFG, W + "/waydroid_base.prop"):
                if os.path.exists(p):
                    os.remove(p)
            for d in ("cache_http", "images"):
                shutil.rmtree(os.path.join(W, d), ignore_errors=True)
            if not canceled:
                log("waydroid init failed: " + " | ".join(tail))
                with self.lock:
                    self.error = "download"
            return
        with self.lock:
            self.progress = 1.0
        # The container (nickel-waydroid-prepare sets it up first), then on
        # NVIDIA the render server Android draws through: it starts with the
        # session, and Android set up mid-session would wait for the next
        # sign-in (its job stops itself where there's no NVIDIA).
        for job in ("waydroid-container", "nickel-waydroid-venus"):
            subprocess.run(["initctl", "start", job],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def cancel(self):
        with self.lock:
            if self.android != "setting-up":
                return
            self.canceled = True
            if self.proc:
                self.proc.terminate()

    # --- ARM app support ---------------------------------------------------

    def set_arm(self, on):
        proc = subprocess.Popen(
            [ARM, "--progress", "enable" if on else "disable"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        tail = []
        for line in proc.stdout:
            f = line.split()
            if len(f) == 3 and f[0] == "progress":
                with self.lock:
                    self.progress = int(f[1]) / max(int(f[2]), 1)
            elif line.strip():
                tail = (tail + [line.strip()])[-5:]
        if proc.wait() != 0:
            log("nickel-waydroid-arm failed: " + " | ".join(tail))
            with self.lock:
                self.error = "download" if on and "download" in " ".join(
                    tail).lower() else "failed"

    # --- Removing Android --------------------------------------------------

    def remove(self, uid):
        # ARM support first: its files, and what Android registered with
        # the kernel for it.
        if os.path.exists(ARM_STATE):
            subprocess.run([ARM, "disable"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        # The container, and with it the user's session (Waydroid tells it
        # to quit), then the job, so it doesn't start again.
        try:
            container_proxy().call_sync("Stop", GLib.Variant("(b)", (True,)),
                                        Gio.DBusCallFlags.NONE, 60000, None)
        except GLib.Error:
            pass
        subprocess.run(["initctl", "stop", "waydroid-container"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        umount_under(W)
        for name in os.listdir(W) if os.path.isdir(W) else []:
            p = os.path.join(W, name)
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p, ignore_errors=True)
            else:
                os.remove(p)
        for d in ("waydroid-arm", "waydroid-nv"):
            shutil.rmtree(os.path.join(STATEFUL, d), ignore_errors=True)
        # The caller's Android: its data (Android's own users own most of
        # it, so only root can remove it) and its launcher entries.
        # Other people's stay in their encrypted homes until they sign in
        # (nickel-waydroid-session-check takes the entries away then).
        if uid != 0:
            try:
                home = pwd.getpwuid(uid).pw_dir
            except KeyError:
                return
            data = os.path.join(home, ".local/share/waydroid")
            umount_under(data)
            shutil.rmtree(data, ignore_errors=True)
            apps = os.path.join(home, ".local/share/applications")
            if os.path.isdir(apps):
                for name in os.listdir(apps):
                    if name.startswith("waydroid.") and name.endswith(".desktop"):
                        os.remove(os.path.join(apps, name))

    # --- Installing an APK -------------------------------------------------

    def in_android(self, uid, work):
        """Runs |work| (a package manager command: its output) in the
        caller's Android and returns the package manager's answer, "Success"
        or "Failure [...]"; raises DaemonError when there's no Android of
        theirs to run it in. Their session may still be starting (the APK
        helper just started it): this waits for it, then for Android's
        boot, and thaws a frozen (idle) container for the time it takes."""
        if not is_set_up():
            raise DaemonError("NotSetUp", "Android isn't set up")
        deadline = time.monotonic() + 120
        while running_session().get("user_id") != str(uid):
            if time.monotonic() > deadline:
                raise DaemonError("NotRunning",
                                  "the caller's Android isn't running")
            time.sleep(1)
        frozen = container_state() == "FROZEN"
        if frozen:
            subprocess.run(["lxc-unfreeze", "-P", W + "/lxc", "-n", "waydroid"])
        try:
            while not android_booted():
                if time.monotonic() > deadline:
                    raise DaemonError("NotRunning", "Android didn't start")
                time.sleep(1)
            with self.install_lock:
                output = work()
        finally:
            if frozen:
                subprocess.run(["lxc-freeze", "-P", W + "/lxc", "-n",
                                "waydroid"])
        lines = [l.strip() for l in output.splitlines() if l.strip()]
        for line in reversed(lines):
            if line.startswith("Success") or line.startswith("Failure"):
                return line
        return "Failure [%s]" % (lines[-1] if lines else "no answer")

    def install(self, uid, fd):
        try:
            return self.in_android(uid, lambda: self.pm_install(fd))
        finally:
            os.close(fd)

    def uninstall(self, uid, package):
        if not PACKAGE.match(package):
            raise DaemonError("Failed", "not a package name: %r" % package)
        return self.in_android(uid, lambda: subprocess.run(
            ["waydroid", "shell", "--", "pm", "uninstall", package],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True).stdout)

    def pm_install(self, fd):
        """`pm install` in the container, the APK streamed in from |fd|.
        Through a pipe, never |fd| itself as stdin: lxc-attach makes its
        stdio root's and mode 0600 (LXC's fix_stdio_permissions), which done
        to the user's own file took it away from them."""
        size = os.fstat(fd).st_size
        proc = subprocess.Popen(
            ["waydroid", "shell", "--", "pm", "install", "-r", "-S", str(size)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT)

        def feed():
            offset = 0
            try:
                while offset < size:
                    chunk = os.pread(fd, 1 << 20, offset)
                    if not chunk:
                        break
                    proc.stdin.write(chunk)
                    offset += len(chunk)
            except OSError:
                pass  # pm stopped reading: its answer says why
            finally:
                try:
                    proc.stdin.close()
                except OSError:
                    pass

        feeder = threading.Thread(target=feed, daemon=True)
        feeder.start()
        output = proc.stdout.read()
        proc.wait()
        feeder.join()
        return output.decode(errors="replace")


class DaemonError(Exception):
    def __init__(self, name, message):
        super().__init__(message)
        self.name = name
        self.message = message


def main():
    daemon = Daemon()
    node = Gio.DBusNodeInfo.new_for_xml(XML)

    def caller_uid(connection, sender):
        reply = connection.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus",
            "org.freedesktop.DBus", "GetConnectionUnixUser",
            GLib.Variant("(s)", (sender,)), GLib.VariantType("(u)"),
            Gio.DBusCallFlags.NONE, -1, None)
        return reply.unpack()[0]

    def fail(invocation, name, message):
        invocation.return_dbus_error(ERROR + name, message)

    def later(fn, *args):
        """|fn|(*args) on the main loop: a thread's reply."""
        def once():
            fn(*args)
            return False
        GLib.idle_add(once)

    def on_call(connection, sender, path, interface, method, params,
                invocation):
        try:
            uid = caller_uid(connection, sender)
        except GLib.Error:
            fail(invocation, "Failed", "who is calling?")
            return
        if method == "GetState":
            invocation.return_value(GLib.Variant("(a{sv})",
                                                 (daemon.state(uid),)))
            return
        if method == "InstallPackage":
            fds = invocation.get_message().get_unix_fd_list()
            index = params.unpack()[0]
            if not fds or index >= fds.get_length():
                fail(invocation, "Failed", "no file")
                return
            fd = fds.get(index)

            def run():
                try:
                    result = daemon.install(uid, fd)
                    later(invocation.return_value,
                          GLib.Variant("(s)", (result,)))
                except DaemonError as e:
                    later(fail, invocation, e.name, e.message)
                except Exception as e:
                    log("install failed: %r" % e)
                    later(fail, invocation, "Failed", str(e))
            threading.Thread(target=run, daemon=True).start()
            return
        if method == "UninstallPackage":
            package = params.unpack()[0]

            def run():
                try:
                    later(invocation.return_value, GLib.Variant(
                        "(s)", (daemon.uninstall(uid, package),)))
                except DaemonError as e:
                    later(fail, invocation, e.name, e.message)
                except Exception as e:
                    log("uninstall failed: %r" % e)
                    later(fail, invocation, "Failed", str(e))
            threading.Thread(target=run, daemon=True).start()
            return
        # The rest change Android for everyone on the device.
        if not is_admin(uid):
            fail(invocation, "NotAllowed", "only an administrator can")
            return
        if method == "Cancel":
            daemon.cancel()
            invocation.return_value(None)
            return
        if method == "SetUp":
            if is_set_up():
                invocation.return_value(None)
                return
            started = daemon.start("android", "setting-up", daemon.set_up)
        elif method == "SetArm":
            on = params.unpack()[0]
            if not is_set_up():
                fail(invocation, "NotSetUp", "Android isn't set up")
                return
            started = daemon.start("arm", "turning-on" if on else "turning-off",
                                   daemon.set_arm, on)
        elif method == "Remove":
            started = daemon.start("android", "removing", daemon.remove, uid)
        else:
            fail(invocation, "Failed", "unknown method")
            return
        if started:
            invocation.return_value(None)
        else:
            fail(invocation, "Busy", "busy with another change")

    def on_bus(connection, name):
        connection.register_object(PATH, node.interfaces[0], on_call, None,
                                   None)

    def on_lost(connection, name):
        log("lost the name " + NAME)
        loop.quit()

    loop = GLib.MainLoop()
    Gio.bus_own_name(Gio.BusType.SYSTEM, NAME, Gio.BusNameOwnerFlags.NONE,
                     on_bus, None, on_lost)
    loop.run()
    sys.exit(1)


if __name__ == "__main__":
    main()

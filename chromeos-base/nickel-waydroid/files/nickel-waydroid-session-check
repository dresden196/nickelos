# At sign-in, as the user (nickel-waydroid-session.conf): without Android
# set up, Waydroid's launcher entries for their Android apps go.
W=/var/lib/waydroid
[ -f "${W}/waydroid.cfg" ] && [ -d "${W}/rootfs" ] && exit 0
rm -f "${XDG_DATA_HOME:-${HOME}/.local/share}"/applications/waydroid.*.desktop

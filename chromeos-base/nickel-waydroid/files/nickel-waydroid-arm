# nickel-waydroid-arm: ARM app support for Android in Waydroid, which the
# user turns on (Settings, after agreeing that it is proprietary software they
# install themselves; NickelOS neither makes nor hosts it).
#
# Android in Waydroid runs x86 code. Apps with native code built only for
# phones' ARM chips need a translator, which Android loads as its "native
# bridge": Intel's libhoudini on Intel CPUs, Google's libndk_translation on
# AMD CPUs. Both are downloaded from where waydroid_script (the Waydroid
# community's tool) takes them, at the commits it pins for Android 13, and
# checked against its MD5 and our SHA-256. They go into Waydroid's overlay
# over Android's system image, with the properties that make Android use them.
#   nickel-waydroid-arm status     on/off, which translator
#   nickel-waydroid-arm enable     download, install, configure (as root)
#   nickel-waydroid-arm disable    remove it again (as root)
#   --progress (before the command): "progress DONE TOTAL" lines while it
#   downloads, for nickel-waydroidd.
# A running Android restarts with the change (`waydroid upgrade`); the
# user's apps stay, their windows close.
import configparser
import glob
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import zipfile

W = "/var/lib/waydroid"
SYSTEM = W + "/overlay/system"
STATE = W + "/nickel-arm"
CACHE = "/mnt/stateful_partition/nickel/waydroid-arm"

TRANSLATORS = {
    # Intel's, from Google Play Games for PC's image (14.0.0), on Intel CPUs.
    "libhoudini": {
        "url": "https://github.com/supremegamers/vendor_intel_proprietary_houdini/archive/2f8f088671182e17e67321e098e8411a3972a628.zip",
        "md5": "37fe0899f1e4da7f9a724cca1c1ab1ea",
        "sha256": "2e82cdc88ddc4d418f7fb861aeebb7c49c83a91b97f57da10510b5e1146a4ed5",
        "size": 75152963,
        "props": {
            "ro.dalvik.vm.native.bridge": "libhoudini.so",
            "ro.enable.native.bridge.exec": "1",
        },
        # ARM programs (not only libraries) run through houdini: registered
        # with binfmt_misc at boot.
        "init": """
on early-init
    mount binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc

on property:ro.enable.native.bridge.exec=1
    exec -- /system/bin/sh -c "echo ':arm_exe:M::\\\\x7f\\\\x45\\\\x4c\\\\x46\\\\x01\\\\x01\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\x28::/system/bin/houdini:P' > /proc/sys/fs/binfmt_misc/register"
    exec -- /system/bin/sh -c "echo ':arm_dyn:M::\\\\x7f\\\\x45\\\\x4c\\\\x46\\\\x01\\\\x01\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x03\\\\x00\\\\x28::/system/bin/houdini:P' >> /proc/sys/fs/binfmt_misc/register"
    exec -- /system/bin/sh -c "echo ':arm64_exe:M::\\\\x7f\\\\x45\\\\x4c\\\\x46\\\\x02\\\\x01\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x02\\\\x00\\\\xb7::/system/bin/houdini64:P' >> /proc/sys/fs/binfmt_misc/register"
    exec -- /system/bin/sh -c "echo ':arm64_dyn:M::\\\\x7f\\\\x45\\\\x4c\\\\x46\\\\x02\\\\x01\\\\x01\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x00\\\\x03\\\\x00\\\\xb7::/system/bin/houdini64:P' >> /proc/sys/fs/binfmt_misc/register"
""",
    },
    # Google's, from ChromeOS's Android (zork, an AMD Chromebook), on AMD CPUs.
    "libndk": {
        "url": "https://github.com/supremegamers/vendor_google_proprietary_ndk_translation-prebuilt/archive/68734c52556d3d7a6db34c603dd9276915c29f2f.zip",
        "md5": "0b2207c490fcb400aa5c87fcf0d52d38",
        "sha256": "a142d1586c9eafb5edf62277110f2128bc03066179a6783bcaa33ee322e1cbd0",
        "size": 17827087,
        "props": {
            "ro.dalvik.vm.native.bridge": "libndk_translation.so",
            "ro.enable.native.bridge.exec": "1",
            "ro.vendor.enable.native.bridge.exec": "1",
            "ro.vendor.enable.native.bridge.exec64": "1",
            "ro.ndk_translation.version": "0.2.3",
        },
        "init": None,
    },
}
# What Android reports it runs, for both.
ABI_PROPS = {
    "ro.product.cpu.abilist": "x86_64,x86,arm64-v8a,armeabi-v7a,armeabi",
    "ro.product.cpu.abilist32": "x86,armeabi-v7a,armeabi",
    "ro.product.cpu.abilist64": "x86_64,arm64-v8a",
    "ro.dalvik.vm.isa.arm": "x86",
    "ro.dalvik.vm.isa.arm64": "x86_64",
}


def die(msg):
    print("nickel-waydroid-arm: " + msg, file=sys.stderr)
    sys.exit(1)


def translator_for_cpu():
    with open("/proc/cpuinfo") as f:
        vendor = next((l.split(":", 1)[1].strip() for l in f
                       if l.startswith("vendor_id")), "")
    return "libhoudini" if vendor == "GenuineIntel" else "libndk"


def installed():
    """The translator that is on, or None. STATE holds its name, then every
    file it put into the overlay (relative to SYSTEM), so it can go again."""
    try:
        with open(STATE) as f:
            return f.readline().strip() or None
    except OSError:
        return None


def installed_files():
    try:
        with open(STATE) as f:
            return [l.strip() for l in f.readlines()[1:] if l.strip()]
    except OSError:
        return []


def upgrade():
    """Waydroid's container from the new properties. A frozen container (idle
    Android) can't be stopped, which upgrade does first: thaw it."""
    subprocess.run(["lxc-unfreeze", "-P", W + "/lxc", "-n", "waydroid"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["waydroid", "upgrade", "-o"], check=True,
                   stdout=subprocess.DEVNULL)


def set_props(props, remove=False):
    cp = configparser.ConfigParser()
    cp.optionxform = str  # Android properties are case-sensitive
    cp.read(W + "/waydroid.cfg")
    if not cp.has_section("properties"):
        cp.add_section("properties")
    for k, v in props.items():
        if remove:
            cp.remove_option("properties", k)
        else:
            cp.set("properties", k, v)
    with open(W + "/waydroid.cfg", "w") as f:
        cp.write(f)


def download(t, progress):
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, os.path.basename(t["url"]))
    if not os.path.exists(path):
        print("Downloading " + t["url"], flush=True)
        tmp = path + ".part"
        try:
            with urllib.request.urlopen(t["url"], timeout=60) as r, \
                    open(tmp, "wb") as f:
                # GitHub makes these archives as it sends them: no length
                # given, so the pinned size (the checksums decide).
                done, shown = 0, -1
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    f.write(chunk)
                    done += len(chunk)
                    percent = done * 100 // t["size"]
                    if progress and percent != shown:
                        shown = percent
                        print("progress %d %d" % (min(done, t["size"]),
                                                  t["size"]), flush=True)
        except OSError as e:
            die("the download failed: %s" % e)
        os.replace(tmp, path)
    data = open(path, "rb").read()
    md5 = hashlib.md5(data).hexdigest()
    sha256 = hashlib.sha256(data).hexdigest()
    if md5 != t["md5"] or sha256 != t["sha256"]:
        os.remove(path)
        die("the download doesn't match its checksums (md5 %s, sha256 %s)"
            % (md5, sha256))
    print("Checked: md5 %s, sha256 %s" % (md5, sha256))
    return path


def remove_files():
    dirs = set()
    for rel in installed_files():
        p = os.path.join(SYSTEM, rel)
        if os.path.lexists(p) and not os.path.isdir(p):
            os.remove(p)
        d = os.path.dirname(rel)
        while d:
            dirs.add(d)
            d = os.path.dirname(d)
    # Directories they leave empty (the overlay's own lib/, lib64/... too,
    # once nothing else is in them: Waydroid makes what it needs).
    for d in sorted(dirs, key=len, reverse=True):
        try:
            os.rmdir(os.path.join(SYSTEM, d))
        except OSError:
            pass


def enable(progress):
    if not os.path.exists(W + "/waydroid.cfg"):
        die("Android isn't set up yet (waydroid init)")
    name = translator_for_cpu()
    if installed():
        disable()
    t = TRANSLATORS[name]
    path = download(t, progress)
    copied = []
    with tempfile.TemporaryDirectory() as tmp:
        with zipfile.ZipFile(path) as z:
            z.extractall(tmp)
        prebuilts = glob.glob(os.path.join(tmp, "*", "prebuilts"))
        if len(prebuilts) != 1:
            die("unexpected archive layout")
        src = prebuilts[0]
        for root, dirs, files in os.walk(src):
            for fn in files:
                rel = os.path.relpath(os.path.join(root, fn), src)
                dst = os.path.join(SYSTEM, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(os.path.join(root, fn), dst, follow_symlinks=False)
                copied.append(rel)
    if t["init"]:
        rel = "etc/init/" + name.replace("lib", "") + ".rc"
        os.makedirs(os.path.dirname(os.path.join(SYSTEM, rel)), exist_ok=True)
        with open(os.path.join(SYSTEM, rel), "w") as f:
            f.write(t["init"])
        copied.append(rel)
    # Android's own: root-owned; programs in bin/ group shell (2000) and 0755,
    # the rest 0644; directories 0755.
    for rel in copied:
        p = os.path.join(SYSTEM, rel)
        inbin = rel.startswith("bin/")
        if not os.path.islink(p):
            os.chown(p, 0, 2000 if inbin else 0)
            os.chmod(p, 0o755 if inbin else 0o644)
        d = os.path.dirname(rel)
        while d:
            os.chown(os.path.join(SYSTEM, d), 0, 0)
            os.chmod(os.path.join(SYSTEM, d), 0o755)
            d = os.path.dirname(d)
    with open(STATE, "w") as f:
        f.write(name + "\n" + "".join(r + "\n" for r in sorted(copied)))
    set_props(dict(ABI_PROPS, **t["props"]))
    upgrade()
    print("ARM app support is on (%s)." % name)


def unregister_binfmt():
    """Android's init registers the translator for ARM programs with the
    kernel's binfmt_misc, which its container shares with the host. The
    entries outlive the container: take back the ones that point into
    Android's /system, so ARM programs stop going to a translator that is
    gone. The host doesn't mount binfmt_misc: do it in a mount namespace of
    our own."""
    subprocess.run(["unshare", "-m", "sh", "-c", """
        mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc || exit
        for f in /proc/sys/fs/binfmt_misc/arm_exe /proc/sys/fs/binfmt_misc/arm_dyn \
                 /proc/sys/fs/binfmt_misc/arm64_exe /proc/sys/fs/binfmt_misc/arm64_dyn; do
            grep -q '^interpreter /system/bin/' "$f" 2>/dev/null && echo -1 > "$f"
        done
        true"""], stderr=subprocess.DEVNULL)


def disable():
    name = installed()
    if not name:
        return
    t = TRANSLATORS[name]
    remove_files()
    unregister_binfmt()
    set_props(dict(ABI_PROPS, **t["props"]), remove=True)
    upgrade()
    os.remove(STATE)
    print("ARM app support is off.")


def main():
    args = sys.argv[1:]
    progress = "--progress" in args
    args = [a for a in args if a != "--progress"]
    cmd = args[0] if args else "status"
    if cmd == "status":
        name = installed()
        print("on " + name if name else "off")
        return
    if os.geteuid() != 0:
        die("run as root")
    if cmd == "enable":
        enable(progress)
    elif cmd == "disable":
        disable()
    else:
        die("usage: nickel-waydroid-arm [--progress] status|enable|disable")


if __name__ == "__main__":
    main()

@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 NickelOS Authors
+
+/* NickelOS: GLib 2.80's functions that Valent uses, for GLib 2.76.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+#if !GLIB_CHECK_VERSION (2, 80, 0)
+static inline GDateTime *
+valent_compat_date_time_new_from_unix_local_usec (gint64 usecs)
+{
+  g_autoptr (GDateTime) seconds = NULL;
+
+  seconds = g_date_time_new_from_unix_local (usecs / G_USEC_PER_SEC);
+  if (seconds == NULL)
+    return NULL;
+
+  return g_date_time_add (seconds, usecs % G_USEC_PER_SEC);
+}
+#define g_date_time_new_from_unix_local_usec \
+  valent_compat_date_time_new_from_unix_local_usec
+
+static inline gint64
+valent_compat_date_time_to_unix_usec (GDateTime *datetime)
+{
+  return g_date_time_to_unix (datetime) * G_USEC_PER_SEC +
+         g_date_time_get_microsecond (datetime);
+}
+#define g_date_time_to_unix_usec valent_compat_date_time_to_unix_usec
+
+static inline void
+valent_compat_strv_builder_take (GStrvBuilder *builder,
+                                 char         *value)
+{
+  g_strv_builder_add (builder, value);
+  g_free (value);
+}
+#define g_strv_builder_take valent_compat_strv_builder_take
+#endif

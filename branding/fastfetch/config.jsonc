// NickelOS's fastfetch settings (/etc/xdg/fastfetch/config.jsonc): our logo,
// in the logo's own blue with the N in white, and fastfetch's own modules.
// The list has to be here: from a config file without one, fastfetch (2.69)
// shows the logo and nothing else. It is fastfetch's default list, as
// `fastfetch --gen-config` writes it. A config of your own
// (~/.config/fastfetch/config.jsonc) wins.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nickelos/fastfetch/nickelos.txt",
    "color": { "1": "38;2;58;119;160", "2": "97" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages",
    "shell", "display", "de", "wm", "wmtheme", "theme", "icons", "font",
    "cursor", "terminal", "terminalfont", "cpu", "gpu", "memory", "swap",
    "disk", "localip", "battery", "poweradapter", "locale", "break", "colors"
  ]
}

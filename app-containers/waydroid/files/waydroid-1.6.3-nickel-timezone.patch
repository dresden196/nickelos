+# NickelOS: Android follows ChromeOS's time zone. Waydroid gives Android none,
+# and Android keeps the zone it saved at its first boot (UTC), so it is set the
+# way Android's own Settings sets it (AlarmManager.setTimeZone, which tells
+# apps too): once Android has booted, and again whenever ChromeOS's zone
+# changes (checked every 10 s; /etc/localtime links through /var/lib/timezone/localtime to
+# /usr/share/zoneinfo/<zone>). While the container is frozen, it waits.
+def nickel_host_timezone():
+    tz = os.path.realpath("/etc/localtime")
+    return tz.split("/zoneinfo/", 1)[1] if "/zoneinfo/" in tz else None
+
+def nickel_follow_timezone(args):
+    def android(*command):
+        return subprocess.run(
+            ["lxc-attach", "-P", tools.config.defaults["lxc"], "-n", "waydroid",
+             "--clear-env", "--"] + list(command),
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
+            timeout=30).stdout.strip()
+    applied = None
+    while True:
+        time.sleep(5 if applied is None else 10)
+        state = helpers.lxc.status(args)
+        if state == "STOPPED":
+            return
+        zone = nickel_host_timezone()
+        if state != "RUNNING" or zone is None or zone == applied:
+            continue
+        try:
+            if android("/system/bin/getprop", "sys.boot_completed") != "1":
+                continue
+            android("/system/bin/service", "call", "alarm", "3", "s16", zone)
+            applied = zone
+            logging.info("Android's time zone: " + zone)
+        except (OSError, subprocess.SubprocessError) as e:
+            logging.warning("Could not set Android's time zone: " + str(e))
+
 def do_start(args, session):
     if not actions.initializer.is_initialized(args):

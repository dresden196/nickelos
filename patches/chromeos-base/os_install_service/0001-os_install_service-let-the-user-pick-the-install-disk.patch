+    // Sort disks from largest to smallest, then (stably) put
+    // non-removable disks first: installing to a non-removable disk is
+    // preferred, though not required.
+    disks.sort_by_key(|dsk| std::cmp::Reverse(dsk.size_in_bytes));
+    disks.sort_by_key(|dsk| dsk.is_removable);
+
+    if let Some(best_disk) = disks.first() {
+        info!("best disk: {:?}", best_disk);
+    }
+    disks

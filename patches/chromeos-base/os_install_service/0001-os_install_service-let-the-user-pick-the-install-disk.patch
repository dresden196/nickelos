+/// An install destination offered to the user (NickelOS disk picker).
+#[derive(Debug, Serialize)]
+pub struct Destination {
+    pub path: String,
+    pub model: String,
+    pub size_in_bytes: u64,
+    pub removable: bool,
+    /// What an automatic install would choose.
+    pub recommended: bool,
+}
+
+/// List the disks the OS can be installed to, best first.
+pub fn list_destinations() -> std::result::Result<Vec<Destination>, Error> {
+    let disks = disk::get_disks().map_err(Error::DiskEnumerationFailed)?;
+    Ok(candidate_disks(disks)
+        .into_iter()
+        .enumerate()
+        .map(|(i, dsk)| Destination {
+            path: dsk.device_path.to_string_lossy().into_owned(),
+            model: dsk.model,
+            size_in_bytes: dsk.size_in_bytes,
+            removable: dsk.is_removable,
+            recommended: i == 0,
+        })
+        .collect())
 }
 

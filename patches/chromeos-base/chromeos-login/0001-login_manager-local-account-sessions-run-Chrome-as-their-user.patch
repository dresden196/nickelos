@@ -262,9 +264,25 @@
     extra_one_time_arguments_.push_back(crash_loop_before_arg);
   }
 
+  // NickelOS: in a local account's session Chrome runs as the account's
+  // Linux user, otherwise as chronos. Chrome's state outside the vault goes
+  // to whichever of them is about to run it.
+  const std::optional<uid_t> uid =
+      session_user_ ? std::optional<uid_t>(session_user_->uid) : default_uid_;
+  if (uid && uid != state_owner_uid_) {
+    gid_t gid = 0;
+    std::vector<gid_t> groups;
+    if (system_utils_->GetGidAndGroups(*uid, &gid, &groups)) {
+      GiveChromeStateTo(*uid, gid);
+      state_owner_uid_ = uid;
+    }
+  }
+  subprocess_->SetDesiredUid(uid);
+
   const std::vector<std::string> argv(ExportArgv());
   const std::vector<std::string> env_vars(ExportEnvironmentVariables());
-  LOG(INFO) << "Running browser " << base::JoinString(argv, " ");
+  LOG(INFO) << "Running browser " << base::JoinString(argv, " ")
+            << (uid ? " as uid " + base::NumberToString(*uid) : "");
 
   bool enter_existing_mount_ns = false;
   if (IsGuestSession()) {
@@ -383,11 +401,15 @@
     login_arguments_.clear();
     login_arguments_.push_back(kLoginUserFlag + account_id);
     login_arguments_.push_back(kLoginProfileFlag + userhash);
+    // NickelOS: Chrome restarts itself into a local account's session, and
+    // from then on runs as the account's user.
+    session_user_ = ResolveNickelSessionUser(account_id);
   }
   session_already_started_ = true;
 }
 
 void BrowserJob::StopSession() {
+  session_user_.reset();
   login_arguments_.clear();
   if (removed_login_manager_flag_) {
     login_arguments_.push_back(kLoginManagerFlag);
@@ -547,6 +569,15 @@
   std::vector<std::string> vars = environment_variables_;
   vars.insert(vars.end(), additional_environment_variables_.begin(),
               additional_environment_variables_.end());
+  if (session_user_) {
+    for (std::string& var : vars) {
+      if (base::StartsWith(var, "USER=")) {
+        var = "USER=" + session_user_->name;
+      } else if (base::StartsWith(var, "LOGNAME=")) {
+        var = "LOGNAME=" + session_user_->name;
+      }
+    }
+  }
   return vars;
 }
 

diff -ruN a/login_manager/subprocess.h b/login_manager/subprocess.h
--- a/login_manager/subprocess.h
+++ b/login_manager/subprocess.h
@@ -43,6 +43,11 @@
 
   virtual pid_t GetPid() const = 0;

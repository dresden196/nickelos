From: dresden196 <50474030+dresden196@users.noreply.github.com>
Subject: [PATCH] minijail: bind-mount sources through merged /usr's links

NickelOS Unified's root is merged /usr: /bin, /sbin and /usr/sbin lead to
/usr/bin, /lib and /lib64 to /usr/lib and /usr/lib64. minijail refused a
bind-mount source with a symlink in it, so services that bind /sbin or
/lib64 never started (dns-proxy: no DNS; system-proxy, vm_concierge). The
links are root's, on the read-only verified root; the check is for
symlinks someone could write. Paths through them are accepted when they are
links owned by root, so a root that isn't merged behaves as before.
---
--- a/libminijail.c
+++ b/libminijail.c
@@ -1166,6 +1166,27 @@
 	return j->fs_rules_fd >= 0;
 }
 
+/*
+ * NickelOS: a merged-/usr root's links (/bin, /sbin and /usr/sbin lead to
+ * /usr/bin, /lib and /lib64 to /usr/lib and /usr/lib64). They are part of the
+ * read-only, verified root, so a bind-mount source through them is as safe as
+ * its canonical path: the check is for symlinks someone could write.
+ */
+static bool is_merged_usr_path(const char *path)
+{
+	static const char *const links[] = {"/bin", "/sbin", "/usr/sbin",
+					    "/lib", "/lib64"};
+	struct stat st;
+	for (size_t i = 0; i < ARRAY_SIZE(links); i++) {
+		if ((streq(links[i], path) || path_is_parent(links[i], path)) &&
+		    lstat(links[i], &st) == 0 && S_ISLNK(st.st_mode) &&
+		    st.st_uid == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 static bool is_valid_bind_path(const char *path)
 {
 	if (!block_symlinks_in_bindmount_paths()) {
@@ -1191,7 +1212,7 @@
 				break;
 			}
 		}
-		if (!found_prefix) {
+		if (!found_prefix && !is_merged_usr_path(path)) {
 			/*
 			 * If the path does not include one of the allowed
 			 * prefixes, fail.

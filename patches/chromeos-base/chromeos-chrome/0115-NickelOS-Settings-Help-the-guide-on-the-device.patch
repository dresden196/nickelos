new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui/ash/settings/pages/about/nickel_help_handler.cc
@@ -0,0 +1,79 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/about/nickel_help_handler.h"
+
+#include <string>
+
+#include "ash/public/cpp/new_window_delegate.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/web_ui.h"
+#include "url/gurl.h"
+
+namespace ash::settings {
+
+namespace {
+
+constexpr char kGuideDir[] = "/usr/share/chromeos-assets/nickel-guide";
+constexpr char kGuideOnline[] = "https://nickelos.dev/help/";
+
+// The guide's page names: "index", "learning-gentoo" and the like.
+bool IsPageName(const std::string& page) {
+  if (page.empty() || page.size() > 64) {
+    return false;
+  }
+  for (char c : page) {
+    if (!base::IsAsciiLower(c) && c != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The copy on the device when it has the page, else the website's.
+GURL GuideUrl(const std::string& page) {
+  const base::FilePath file = base::FilePath(kGuideDir).Append(page + ".html");
+  if (base::PathExists(file)) {
+    return GURL("file://" + file.value());
+  }
+  return GURL(std::string(kGuideOnline) +
+              (page == "index" ? std::string() : page + "/"));
+}
+
+void OpenInBrowser(const GURL& url) {
+  NewWindowDelegate::GetInstance()->OpenUrl(
+      url, NewWindowDelegate::OpenUrlFrom::kUserInteraction,
+      NewWindowDelegate::Disposition::kNewForegroundTab);
+}
+
+}  // namespace
+
+NickelHelpHandler::NickelHelpHandler() = default;
+NickelHelpHandler::~NickelHelpHandler() = default;
+
+void NickelHelpHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "openNickelGuide",
+      base::BindRepeating(&NickelHelpHandler::HandleOpenGuide,
+                          base::Unretained(this)));
+}
+
+void NickelHelpHandler::HandleOpenGuide(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_string()) {
+    return;
+  }
+  const std::string page = args[0].GetString();
+  if (!IsPageName(page)) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&GuideUrl, page), base::BindOnce(&OpenInBrowser));
+}
+
+}  // namespace ash::settings

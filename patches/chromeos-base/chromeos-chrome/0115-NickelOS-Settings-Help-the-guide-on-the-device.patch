+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_HELP_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_HELP_HANDLER_H_
+
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace ash::settings {
+
+// NickelOS: Settings > Help opens a page of the guide that came with the OS
+// (/usr/share/chromeos-assets/nickel-guide, where Chrome may open local
+// files), in a browser tab; the page on nickelos.dev if this OS has no copy
+// of it.
+class NickelHelpHandler : public content::WebUIMessageHandler {
+ public:
+  NickelHelpHandler();
+  NickelHelpHandler(const NickelHelpHandler&) = delete;
+  NickelHelpHandler& operator=(const NickelHelpHandler&) = delete;
+  ~NickelHelpHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  void HandleOpenGuide(const base::ListValue& args);
+};
+
+}  // namespace ash::settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_HELP_HANDLER_H_

+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: Settings > Help. The NickelOS guide as it came with
+ * this version of the OS (chromeos-base/nickel-guide), which works offline,
+ * opened in the browser by NickelHelpHandler; and the guide and the
+ * community pages on nickelos.dev.
+ */
+
+import 'chrome://resources/ash/common/cr_elements/cr_link_row/cr_link_row.js';
+import '../settings_shared.css.js';
+
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {OpenWindowProxyImpl} from 'chrome://resources/js/open_window_proxy.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_help_subpage.html.js';
+
+const NickelHelpSubpageElementBase = I18nMixin(PolymerElement);
+
+export class NickelHelpSubpageElement extends NickelHelpSubpageElementBase {
+  static get is() {
+    return 'nickel-help-subpage' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  // A page of the guide on the device: index, learning-gentoo, ...
+  private openGuide_(page: string): void {
+    chrome.send('openNickelGuide', [page]);
+  }
+
+  private onGuideClick_(): void {
+    this.openGuide_('index');
+  }
+
+  private onGentooClick_(): void {
+    this.openGuide_('learning-gentoo');
+  }
+
+  private onTroubleshootingClick_(): void {
+    this.openGuide_('troubleshooting');
+  }
+
+  private onCommunityClick_(): void {
+    OpenWindowProxyImpl.getInstance().openUrl(
+        'https://nickelos.dev/help/community/');
+  }
+
+  private onOnlineClick_(): void {
+    OpenWindowProxyImpl.getInstance().openUrl('https://nickelos.dev/help/');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelHelpSubpageElement.is]: NickelHelpSubpageElement;
+  }
+}
+
+customElements.define(NickelHelpSubpageElement.is, NickelHelpSubpageElement);

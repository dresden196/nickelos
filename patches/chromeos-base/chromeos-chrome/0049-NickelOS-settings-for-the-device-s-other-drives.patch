+bool VolumeManager::IsNickelDriveNotShown(const ash::disks::Disk& disk) const {
+  return IsNickelDrive(disk) &&
+         NickelListPrefHas(CHECK_DEREF(profile_->GetPrefs()),
+                           guest_os::prefs::kNickelDrivesNotShown,
+                           disk.fs_uuid());
+}
+
+std::vector<std::string> VolumeManager::NickelMountOptions(
+    const ash::disks::Disk& disk) const {
+  // cros-disks mounts Windows' own volume read-only unless this says the
+  // user allowed changes to it (cros-disks takes the option out).
+  if (IsNickelDrive(disk) &&
+      NickelListPrefHas(CHECK_DEREF(profile_->GetPrefs()),
+                        guest_os::prefs::kNickelWindowsDrivesWritable,
+                        disk.fs_uuid())) {
+    return {"nickel-windows-writable"};
+  }
+  return {};
+}
+
+void VolumeManager::OnNickelDrivesChanged() {
+  std::set<std::string> writable;
+  for (const base::Value& value : profile_->GetPrefs()->GetList(
+           guest_os::prefs::kNickelWindowsDrivesWritable)) {
+    if (value.is_string()) {
+      writable.insert(value.GetString());
+    }
+  }
+  for (const auto& disk : disk_mount_manager_->disks()) {
+    if (!IsNickelDrive(*disk)) {
+      continue;
+    }
+    const bool mounted = !disk->mount_path().empty();
+    if (IsNickelDriveNotShown(*disk)) {
+      if (mounted) {
+        disk_mount_manager_->UnmountPath(disk->mount_path(),
+                                         base::DoNothing());
+      }
+      continue;
+    }
+    if (!mounted) {
+      if (disk->has_media()) {
+        MountNickelDrive(disk->device_path(), ash::MountError::kSuccess);
+      }
+      continue;
+    }
+    // Whether a volume is writable is settled when cros-disks mounts it
+    // (it starts ntfs-3g read-only or not): it is mounted again.
+    const std::string& uuid = disk->fs_uuid();
+    if (writable.contains(uuid) != nickel_writable_drives_.contains(uuid)) {
+      disk_mount_manager_->UnmountPath(
+          disk->mount_path(),
+          base::BindOnce(&VolumeManager::MountNickelDrive,
+                         weak_ptr_factory_.GetWeakPtr(), disk->device_path()));
+    }
+  }
+  nickel_writable_drives_ = std::move(writable);
+  // Written now rather than with the next batch of pref writes: taking
+  // back changes to Windows' drive must hold even if the session does not
+  // end cleanly (a restart lost it in testing).
+  profile_->GetPrefs()->CommitPendingWrite();
+}
+
+void VolumeManager::MountNickelDrive(const std::string& device_path,
+                                     ash::MountError error) {
+  if (error != ash::MountError::kSuccess) {
+    LOG(ERROR) << "Cannot unmount " << device_path << " to mount it again: "
+               << error;
+    return;
+  }
+  const ash::disks::Disk* const disk =
+      disk_mount_manager_->FindDiskBySourcePath(device_path);
+  if (!disk || !disk->mount_path().empty() || IsNickelDriveNotShown(*disk)) {
+    return;
+  }
+  disk_mount_manager_->MountPath(
+      device_path, {}, disk->device_label(), NickelMountOptions(*disk),
+      ash::MountType::kDevice,
+      GetExternalStorageAccessMode(profile_,
+                                   policy::DeviceId::FromDisk(disk)),
+      base::DoNothing());
+}

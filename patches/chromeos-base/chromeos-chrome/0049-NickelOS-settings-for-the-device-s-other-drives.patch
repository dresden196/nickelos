+// NickelOS: whether the list pref |name| holds |uuid|.
+bool NickelListPrefHas(const PrefService& prefs,
+                       const char* name,
+                       const std::string& uuid) {
+  if (uuid.empty()) {
+    return false;
+  }
+  for (const base::Value& value : prefs.GetList(name)) {
+    if (value.is_string() && value.GetString() == uuid) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// NickelOS: a drive the user's drive settings are for: a volume of one of
+// the device's other internal disks (not removable, not NickelOS's own).
+bool IsNickelDrive(const ash::disks::Disk& disk) {
+  return !disk.on_removable_device() && !disk.on_boot_device() &&
+         !disk.is_hidden() && !disk.fs_uuid().empty();
+}

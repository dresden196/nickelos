+<!-- NickelOS: the device's other drives (StorageHandler::UpdateNickelDrives):
+     whether Files shows each, and changes to the drive that holds Windows. -->
+<template is="dom-if" if="[[nickelDrives_.length]]">
+  <div class="settings-box two-line hr">
+    <div class="start">
+      <div>$i18n{nickelDrivesTitle}</div>
+      <div class="secondary">$i18n{nickelDrivesDescription}</div>
+    </div>
+  </div>
+  <template is="dom-repeat" items="[[nickelDrives_]]">
+    <div class="settings-box two-line">
+      <div class="start">
+        <div>[[item.label]]</div>
+        <div class="secondary">[[item.size]]</div>
+      </div>
+    </div>
+    <div class="settings-box continuation nickel-drive-option">
+      <div class="start" id="nickelDriveShow[[index]]" aria-hidden="true">
+        $i18n{nickelDriveShow}
+      </div>
+      <cr-toggle on-change="onNickelDriveShowChange_"
+          checked="[[isNickelDriveShown_(item,
+              prefs.nickel.drives_not_shown.value.*)]]"
+          aria-labelledby$="nickelDriveShow[[index]]">
+      </cr-toggle>
+    </div>
+    <template is="dom-if" if="[[canAllowNickelDriveChanges_(item,
+        prefs.nickel.drives_not_shown.value.*,
+        prefs.nickel.windows_drives_writable.value.*)]]" restamp>
+      <div class="settings-box continuation two-line nickel-drive-option">
+        <div class="start" aria-hidden="true">
+          <div id="nickelDriveAllow[[index]]">$i18n{nickelDriveAllowChanges}</div>
+          <div class="secondary">[[nickelDriveAllowSubLabel_(item,
+              prefs.nickel.windows_drives_writable.value.*)]]</div>
+        </div>
+        <cr-toggle on-change="onNickelDriveAllowChange_"
+            checked="[[isNickelDriveWritable_(item,
+                prefs.nickel.windows_drives_writable.value.*)]]"
+            aria-labelledby$="nickelDriveAllow[[index]]">
+        </cr-toggle>
+      </div>
+    </template>
+  </template>
+</template>
+<cr-dialog id="nickelDriveDialog" on-cancel="onNickelDriveDialogCancel_">
+  <div slot="title">$i18n{nickelDriveDialogTitle}</div>
+  <div slot="body">$i18n{nickelDriveDialogBody}</div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" on-click="onNickelDriveDialogCancel_">
+      $i18n{cancel}
+    </cr-button>
+    <cr-button class="action-button" on-click="onNickelDriveDialogConfirm_">
+      $i18n{nickelDriveAllowChanges}
+    </cr-button>
+  </div>
+</cr-dialog>

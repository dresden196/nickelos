+
+void StorageHandler::UpdateNickelDrives() {
+  const DiskMountManager* const manager = DiskMountManager::GetInstance();
+  base::ListValue drives;
+  for (const auto& disk : manager->disks()) {
+    // The volumes of internal disks other than NickelOS's own; cros-disks
+    // hides other systems' own partitions (EFI, recovery, ...).
+    if (disk->on_removable_device() || disk->on_boot_device() ||
+        disk->is_hidden() || disk->fs_uuid().empty()) {
+      continue;
+    }
+    bool read_only = false;
+    const bool mounted = !disk->mount_path().empty();
+    if (mounted) {
+      const auto it = manager->mount_points().find(disk->mount_path());
+      read_only = it != manager->mount_points().end() && it->read_only;
+    }
+    std::string label = disk->device_label();
+    if (label.empty()) {
+      label = disk->drive_label().empty() ? disk->fs_uuid()
+                                          : disk->drive_label();
+    }
+    base::DictValue drive;
+    drive.Set("uuid", disk->fs_uuid());
+    drive.Set("label", label);
+    drive.Set("size",
+              ui::FormatBytes(base::ByteSize(disk->total_size_in_bytes())));
+    drive.Set("fileSystem", disk->file_system_type());
+    drive.Set("mounted", mounted);
+    drive.Set("readOnly", read_only);
+    drives.Append(std::move(drive));
+  }
+  FireWebUIListener("onNickelDrivesUpdated", drives);
+}

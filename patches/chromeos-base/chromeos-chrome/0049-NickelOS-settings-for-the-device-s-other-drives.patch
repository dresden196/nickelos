+
+  // NickelOS: the device's other drives. A drive's UUID in
+  // nickel.drives_not_shown keeps it out of Files; in
+  // nickel.windows_drives_writable, the volume that holds Windows is
+  // mounted writable (file_manager::VolumeManager).
+  private nickelDriveList_(pref: string): string[] {
+    return this.getPref<string[]>(pref).value;
+  }
+
+  private isNickelDriveShown_(drive: NickelDrive): boolean {
+    return !this.nickelDriveList_('nickel.drives_not_shown')
+                .includes(drive.uuid);
+  }
+
+  private isNickelDriveWritable_(drive: NickelDrive): boolean {
+    return this.nickelDriveList_('nickel.windows_drives_writable')
+        .includes(drive.uuid);
+  }
+
+  // cros-disks mounts Windows' own volume read-only, so an NTFS drive that
+  // came up read-only holds Windows (or Windows did not shut down fully).
+  private canAllowNickelDriveChanges_(drive: NickelDrive): boolean {
+    return drive.fileSystem === 'ntfs' && this.isNickelDriveShown_(drive) &&
+        ((drive.mounted && drive.readOnly) ||
+         this.isNickelDriveWritable_(drive));
+  }
+
+  private nickelDriveAllowSubLabel_(drive: NickelDrive): string {
+    return this.isNickelDriveWritable_(drive) && drive.readOnly ?
+        this.i18n('nickelDriveHibernated') :
+        this.i18n('nickelDriveAllowChangesDescription');
+  }
+
+  private onNickelDriveShowChange_(e: DomRepeatEvent<NickelDrive>): void {
+    const pref = 'nickel.drives_not_shown';
+    if ((e.target as CrToggleElement).checked) {
+      this.deletePrefListItem(pref, e.model.item.uuid);
+    } else {
+      this.appendPrefListItem(pref, e.model.item.uuid);
+    }
+  }
+
+  // Changes to Windows' drive are allowed only after the dialog: the toggle
+  // stays off until then.
+  private onNickelDriveAllowChange_(e: DomRepeatEvent<NickelDrive>): void {
+    const toggle = e.target as CrToggleElement;
+    if (!toggle.checked) {
+      this.deletePrefListItem(
+          'nickel.windows_drives_writable', e.model.item.uuid);
+      return;
+    }
+    toggle.checked = false;
+    this.nickelDriveToAllow_ = e.model.item;
+    this.shadowRoot!.querySelector<CrDialogElement>(
+                        '#nickelDriveDialog')!.showModal();
+  }
+
+  private onNickelDriveDialogConfirm_(): void {
+    if (this.nickelDriveToAllow_) {
+      this.appendPrefListItem(
+          'nickel.windows_drives_writable', this.nickelDriveToAllow_.uuid);
+    }
+    this.nickelDriveToAllow_ = null;
+    this.shadowRoot!.querySelector<CrDialogElement>(
+                        '#nickelDriveDialog')!.close();
+  }
+
+  private onNickelDriveDialogCancel_(): void {
+    this.nickelDriveToAllow_ = null;
+    const dialog =
+        this.shadowRoot!.querySelector<CrDialogElement>('#nickelDriveDialog')!;
+    if (dialog.open) {
+      dialog.close();
+    }

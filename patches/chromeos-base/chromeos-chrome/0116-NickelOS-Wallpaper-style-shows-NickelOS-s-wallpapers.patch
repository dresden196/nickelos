+#ifndef CHROME_BROWSER_ASH_WALLPAPER_HANDLERS_NICKEL_WALLPAPER_FETCHERS_H_
+#define CHROME_BROWSER_ASH_WALLPAPER_HANDLERS_NICKEL_WALLPAPER_FETCHERS_H_
+
+#include <string>
+
+#include "chrome/browser/ash/wallpaper_handlers/wallpaper_handlers.h"
+
+namespace wallpaper_handlers {
+
+// NickelOS: Wallpaper & style's collections, which ChromeOS fetches from
+// Google's servers (Backdrop), are NickelOS's own wallpapers: one
+// collection, the pictures in the image at
+// /usr/share/chromeos-assets/wallpaper/nickel, listed in its collection.json
+// (chromeos-bsp-nickel). A picture with a dark-mode twin is one unit of two
+// images, light and dark, which ChromeOS switches with the color mode. Their
+// addresses are chrome://personalization/nickel-wallpaper/NAME.jpg: the app
+// shows a thumbnail from there, and the wallpaper downloader reads the
+// picture itself from disk for them (wallpaper_image_downloader.cc).
+class NickelCollectionInfoFetcher : public BackdropCollectionInfoFetcher {
+ public:
+  NickelCollectionInfoFetcher();
+  ~NickelCollectionInfoFetcher() override;
+
+  void Start(OnCollectionsInfoFetched callback) override;
+};
+
+class NickelImageInfoFetcher : public BackdropImageInfoFetcher {
+ public:
+  explicit NickelImageInfoFetcher(const std::string& collection_id);
+  ~NickelImageInfoFetcher() override;
+
+  void Start(OnImagesInfoFetched callback) override;
+
+ private:
+  const std::string collection_id_;
+};
+
+// "Surprise me" and the daily change: one of the pictures at random.
+class NickelSurpriseMeImageFetcher : public BackdropSurpriseMeImageFetcher {
+ public:
+  NickelSurpriseMeImageFetcher();
+  ~NickelSurpriseMeImageFetcher() override;
+
+  void Start(OnSurpriseMeImageFetched callback) override;
+};
+
+}  // namespace wallpaper_handlers
+
+#endif  // CHROME_BROWSER_ASH_WALLPAPER_HANDLERS_NICKEL_WALLPAPER_FETCHERS_H_

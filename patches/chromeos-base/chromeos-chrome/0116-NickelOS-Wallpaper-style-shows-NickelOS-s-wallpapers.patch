diff --git a/chrome/browser/ash/wallpaper_handlers/nickel_wallpaper_fetchers.cc b/chrome/browser/ash/wallpaper_handlers/nickel_wallpaper_fetchers.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ash/wallpaper_handlers/nickel_wallpaper_fetchers.cc
@@ -0,0 +1,225 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/wallpaper_handlers/nickel_wallpaper_fetchers.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "ash/webui/personalization_app/proto/backdrop_wallpaper.pb.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/json/json_reader.h"
+#include "base/rand_util.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+
+namespace wallpaper_handlers {
+
+namespace {
+
+constexpr char kManifest[] =
+    "/usr/share/chromeos-assets/wallpaper/nickel/collection.json";
+constexpr char kCollectionId[] = "nickelos";
+constexpr char kCollectionName[] = "NickelOS";
+constexpr char kUrlPrefix[] = "chrome://personalization/nickel-wallpaper/";
+
+struct Wallpaper {
+  std::string name;
+  std::string dark;  // The dark-mode twin's name, or "".
+  std::string photographer;
+  std::string source;
+};
+
+struct Manifest {
+  std::string default_name;
+  std::vector<Wallpaper> wallpapers;
+};
+
+// A file name in the wallpaper folder: letters, digits, "-" and "_".
+bool IsName(const std::string& name) {
+  if (name.empty() || name.size() > 128) {
+    return false;
+  }
+  for (char c : name) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '-' && c != '_') {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<Manifest> ReadManifest() {
+  std::string text;
+  if (!base::ReadFileToString(base::FilePath(kManifest), &text)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  Manifest manifest;
+  if (const std::string* name = value->GetDict().FindString("default")) {
+    manifest.default_name = *name;
+  }
+  const base::ListValue* list = value->GetDict().FindList("wallpapers");
+  if (!list) {
+    return std::nullopt;
+  }
+  for (const base::Value& item : *list) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = item.GetDict();
+    const std::string* name = dict.FindString("name");
+    if (!name || !IsName(*name)) {
+      continue;
+    }
+    Wallpaper wallpaper;
+    wallpaper.name = *name;
+    if (const std::string* dark = dict.FindString("dark");
+        dark && IsName(*dark)) {
+      wallpaper.dark = *dark;
+    }
+    if (const std::string* by = dict.FindString("photographer")) {
+      wallpaper.photographer = *by;
+    }
+    if (const std::string* source = dict.FindString("source")) {
+      wallpaper.source = *source;
+    }
+    manifest.wallpapers.push_back(std::move(wallpaper));
+  }
+  if (manifest.wallpapers.empty()) {
+    return std::nullopt;
+  }
+  if (manifest.default_name.empty()) {
+    manifest.default_name = manifest.wallpapers.front().name;
+  }
+  return manifest;
+}
+
+std::string Url(const std::string& name) {
+  return std::string(kUrlPrefix) + name + ".jpg";
+}
+
+// Ids that stay the same from one session to the next: ChromeOS keeps the
+// chosen picture's asset id.
+uint64_t Id(const std::string& name) {
+  return base::PersistentHash(name) | (uint64_t{1} << 32);
+}
+
+backdrop::Image MakeImage(const Wallpaper& wallpaper,
+                          const std::string& name,
+                          backdrop::Image::ImageType type) {
+  backdrop::Image image;
+  image.set_asset_id(Id(name));
+  image.set_image_url(Url(name));
+  image.set_unit_id(Id(wallpaper.name));
+  image.set_image_type(type);
+  if (!wallpaper.photographer.empty()) {
+    image.add_attribution()->set_text(wallpaper.photographer);
+  }
+  if (!wallpaper.source.empty()) {
+    image.add_attribution()->set_text(wallpaper.source);
+  }
+  return image;
+}
+
+std::vector<backdrop::Image> MakeImages(const Manifest& manifest) {
+  std::vector<backdrop::Image> images;
+  for (const Wallpaper& wallpaper : manifest.wallpapers) {
+    if (wallpaper.dark.empty()) {
+      images.push_back(MakeImage(wallpaper, wallpaper.name,
+                                 backdrop::Image::IMAGE_TYPE_UNKNOWN));
+      continue;
+    }
+    images.push_back(MakeImage(wallpaper, wallpaper.name,
+                               backdrop::Image::IMAGE_TYPE_LIGHT_MODE));
+    images.push_back(MakeImage(wallpaper, wallpaper.dark,
+                               backdrop::Image::IMAGE_TYPE_DARK_MODE));
+  }
+  return images;
+}
+
+}  // namespace
+
+NickelCollectionInfoFetcher::NickelCollectionInfoFetcher() = default;
+NickelCollectionInfoFetcher::~NickelCollectionInfoFetcher() = default;
+
+void NickelCollectionInfoFetcher::Start(OnCollectionsInfoFetched callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadManifest),
+      base::BindOnce(
+          [](OnCollectionsInfoFetched callback,
+             std::optional<Manifest> manifest) {
+            if (!manifest) {
+              std::move(callback).Run(false, {});
+              return;
+            }
+            backdrop::Collection collection;
+            collection.set_collection_id(kCollectionId);
+            collection.set_collection_name(kCollectionName);
+            backdrop::Image* preview = collection.add_preview();
+            preview->set_image_url(Url(manifest->default_name));
+            std::move(callback).Run(true, {std::move(collection)});
+          },
+          std::move(callback)));
+}
+
+NickelImageInfoFetcher::NickelImageInfoFetcher(const std::string& collection_id)
+    : collection_id_(collection_id) {}
+NickelImageInfoFetcher::~NickelImageInfoFetcher() = default;
+
+void NickelImageInfoFetcher::Start(OnImagesInfoFetched callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadManifest),
+      base::BindOnce(
+          [](std::string collection_id, OnImagesInfoFetched callback,
+             std::optional<Manifest> manifest) {
+            if (!manifest || collection_id != kCollectionId) {
+              std::move(callback).Run(false, collection_id, {});
+              return;
+            }
+            std::move(callback).Run(true, collection_id,
+                                    MakeImages(*manifest));
+          },
+          collection_id_, std::move(callback)));
+}
+
+NickelSurpriseMeImageFetcher::NickelSurpriseMeImageFetcher() = default;
+NickelSurpriseMeImageFetcher::~NickelSurpriseMeImageFetcher() = default;
+
+void NickelSurpriseMeImageFetcher::Start(OnSurpriseMeImageFetched callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadManifest),
+      base::BindOnce(
+          [](OnSurpriseMeImageFetched callback,
+             std::optional<Manifest> manifest) {
+            if (!manifest) {
+              std::move(callback).Run(false, backdrop::Image(), "");
+              return;
+            }
+            const Wallpaper& wallpaper = manifest->wallpapers[base::RandGenerator(
+                manifest->wallpapers.size())];
+            std::move(callback).Run(
+                true,
+                MakeImage(wallpaper, wallpaper.name,
+                          wallpaper.dark.empty()
+                              ? backdrop::Image::IMAGE_TYPE_UNKNOWN
+                              : backdrop::Image::IMAGE_TYPE_LIGHT_MODE),
+                "");
+          },
+          std::move(callback)));
+}
+
+}  // namespace wallpaper_handlers

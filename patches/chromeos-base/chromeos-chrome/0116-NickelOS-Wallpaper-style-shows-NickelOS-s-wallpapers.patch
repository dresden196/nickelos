+// NickelOS: the thumbnails of NickelOS's wallpapers (Wallpaper & style's
+// collection, nickel_wallpaper_fetchers.h), from the image.
+constexpr char kNickelWallpaperPath[] = "nickel-wallpaper/";
+constexpr char kNickelThumbDir[] =
+    "/usr/share/chromeos-assets/wallpaper/nickel/thumbs";
+
 bool ShouldHandleWebUIRequest(const std::string& path) {
-  return base::StartsWith(path, "wallpaper.jpg");
+  return base::StartsWith(path, "wallpaper.jpg") ||
+         base::StartsWith(path, kNickelWallpaperPath);
+}
+
+// A thumbnail's bytes, or nothing for a name that isn't one.
+scoped_refptr<base::RefCountedMemory> ReadNickelThumbnail(std::string name) {
+  const size_t query = name.find('?');
+  if (query != std::string::npos) {
+    name.resize(query);
+  }
+  if (name.empty() || name.size() > 160 ||
+      name.find_first_not_of("abcdefghijklmnopqrstuvwxyz"
+                             "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.") !=
+          std::string::npos ||
+      name.find("..") != std::string::npos) {
+    return nullptr;
+  }
+  std::string bytes;
+  if (!base::ReadFileToString(base::FilePath(kNickelThumbDir).Append(name),
+                              &bytes)) {
+    return nullptr;
+  }
+  return base::MakeRefCounted<base::RefCountedString>(std::move(bytes));
 }
 
 }  // namespace
@@ -581,6 +613,14 @@
 void PersonalizationAppUI::HandleWebUIRequest(
     const std::string& path,
     content::WebUIDataSource::GotDataCallback callback) {
+  if (base::StartsWith(path, kNickelWallpaperPath)) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadNickelThumbnail,
+                       path.substr(sizeof(kNickelWallpaperPath) - 1)),
+        std::move(callback));
+    return;
+  }
   DCHECK(path.contains("?key="))
       << "wallpaper key must be provided to prevent browser cache collisions";
   wallpaper_provider_->GetWallpaperAsJpegBytes(std::move(callback));

+// NickelOS: the RemoteDesktop portal's backend asks whether an app may
+// control the keyboard and pointer; the answer is a token ("" for no).
+void VmApplicationsServiceProvider::NickelRemoteDesktopAsk(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string app_name;
+  if (!reader.PopString(&app_name)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS, "Expected the app's name"));
+    return;
+  }
+  NickelRemoteDesktop::Ask(
+      app_name,
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             const std::string& token) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter(response.get()).AppendString(token);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
+// NickelOS: one input event of an allowed session: (token, kind, source,
+// x, y, code, down), kind one of "move-to" (x, y in the source's pixels),
+// "move-by" (x, y), "button" (code, down), "key" (code, down), "scroll"
+// (x, y in pixels), "scroll-steps" (x, y in wheel steps), "end". Answers
+// false once the session has ended.
+void VmApplicationsServiceProvider::NickelRemoteDesktopInput(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string token;
+  std::string kind;
+  std::string source_id;
+  double x = 0;
+  double y = 0;
+  uint32_t code = 0;
+  bool down = false;
+  if (!reader.PopString(&token) || !reader.PopString(&kind) ||
+      !reader.PopString(&source_id) || !reader.PopDouble(&x) ||
+      !reader.PopDouble(&y) || !reader.PopUint32(&code) ||
+      !reader.PopBool(&down)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected token, kind, source, x, y, code, down"));
+    return;
+  }
+  bool ok = false;
+  if (kind == "move-to") {
+    ok = NickelRemoteDesktop::MovePointerTo(token, source_id, x, y);
+  } else if (kind == "move-by") {
+    ok = NickelRemoteDesktop::MovePointerBy(token, x, y);
+  } else if (kind == "button") {
+    ok = NickelRemoteDesktop::Button(token, code, down);
+  } else if (kind == "key") {
+    ok = NickelRemoteDesktop::Key(token, code, down);
+  } else if (kind == "scroll" || kind == "scroll-steps") {
+    ok = NickelRemoteDesktop::Scroll(token, x, y, kind == "scroll-steps");
+  } else if (kind == "end") {
+    NickelRemoteDesktop::End(token);
+  }
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter(response.get()).AppendBool(ok);
+  std::move(response_sender).Run(std::move(response));
+}
+

@@ -0,0 +1,219 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_remote_desktop.h"
+
+#include <map>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "chrome/browser/ui/screen_capture_notification_ui.h"
+#include "chrome/browser/ui/simple_message_box.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/desktop_media_id.h"
+#include "ui/aura/env.h"
+#include "ui/aura/window.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/ozone/public/ozone_platform.h"
+#include "ui/ozone/public/system_input_injector.h"
+
+namespace ash {
+
+namespace {
+
+// evdev button codes (linux/input-event-codes.h).
+constexpr uint32_t kBtnLeft = 0x110;
+constexpr uint32_t kBtnRight = 0x111;
+constexpr uint32_t kBtnMiddle = 0x112;
+// One wheel step, as ui::MouseWheelEvent counts them.
+constexpr int kWheelStep = 120;
+
+struct Control {
+  std::unique_ptr<ui::SystemInputInjector> injector;
+  std::unique_ptr<ScreenCaptureNotificationUI> notification;
+};
+
+std::map<std::string, Control>& Controls() {
+  static base::NoDestructor<std::map<std::string, Control>> controls;
+  return *controls;
+}
+
+ui::SystemInputInjector* Injector(const std::string& token) {
+  auto it = Controls().find(token);
+  return it == Controls().end() ? nullptr : it->second.injector.get();
+}
+
+std::u16string DisplayName(const std::string& app_name) {
+  return app_name.empty()
+             ? l10n_util::GetStringUTF16(
+                   IDS_APP_MANAGEMENT_APP_DETAILS_TYPE_NICKEL_HOST)
+             : base::UTF8ToUTF16(app_name);
+}
+
+void OnAnswered(const std::string& app_name,
+                base::OnceCallback<void(const std::string&)> callback,
+                chrome::MessageBoxResult result) {
+  if (result != chrome::MESSAGE_BOX_RESULT_YES) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  std::unique_ptr<ui::SystemInputInjector> injector =
+      ui::OzonePlatform::GetInstance()->CreateSystemInputInjector();
+  if (!injector) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  const std::string token = base::Token::CreateRandom().ToString();
+  Control& control = Controls()[token];
+  control.injector = std::move(injector);
+  control.notification = ScreenCaptureNotificationUI::Create(
+      l10n_util::GetStringFUTF16(IDS_NICKEL_REMOTE_CONTROL_NOTIFICATION,
+                                 DisplayName(app_name)),
+      /*capturing_web_contents=*/nullptr);
+  control.notification->OnStarted(
+      base::BindOnce(&NickelRemoteDesktop::End, token),
+      content::MediaStreamUI::SourceCallback(),
+      std::vector<content::DesktopMediaID>{});
+  std::move(callback).Run(token);
+}
+
+}  // namespace
+
+// static
+void NickelRemoteDesktop::Ask(
+    const std::string& app_name,
+    base::OnceCallback<void(const std::string& token)> callback) {
+  const std::u16string name = DisplayName(app_name);
+  chrome::ShowQuestionMessageBoxAsync(
+      /*parent=*/nullptr,
+      l10n_util::GetStringUTF16(IDS_NICKEL_REMOTE_CONTROL_TITLE),
+      l10n_util::GetStringFUTF16(IDS_NICKEL_REMOTE_CONTROL_MESSAGE, name),
+      base::BindOnce(&OnAnswered, app_name, std::move(callback)));
+}
+
+// static
+void NickelRemoteDesktop::End(const std::string& token) {
+  Controls().erase(token);
+}
+
+// static
+bool NickelRemoteDesktop::MovePointerTo(const std::string& token,
+                                        const std::string& source_id,
+                                        double x,
+                                        double y) {
+  ui::SystemInputInjector* injector = Injector(token);
+  if (!injector) {
+    return false;
+  }
+  // The injector takes physical screen coordinates: the source's origin in
+  // pixels, plus the position in it.
+  display::Display display = display::Screen::Get()->GetPrimaryDisplay();
+  gfx::PointF origin;
+  if (!source_id.empty()) {
+    const content::DesktopMediaID id =
+        content::DesktopMediaID::Parse(source_id);
+    if (aura::Window* window =
+            content::DesktopMediaID::GetNativeWindowById(id)) {
+      display = display::Screen::Get()->GetDisplayNearestWindow(window);
+      if (id.type == content::DesktopMediaID::TYPE_WINDOW) {
+        const gfx::Point window_origin = window->GetBoundsInScreen().origin();
+        origin = gfx::PointF(
+            (window_origin.x() - display.bounds().x()) *
+                display.device_scale_factor(),
+            (window_origin.y() - display.bounds().y()) *
+                display.device_scale_factor());
+      }
+    }
+  }
+  origin += gfx::Vector2dF(display.bounds().x() * display.device_scale_factor(),
+                           display.bounds().y() * display.device_scale_factor());
+  injector->MoveCursorTo(gfx::PointF(origin.x() + x, origin.y() + y));
+  return true;
+}
+
+// static
+bool NickelRemoteDesktop::MovePointerBy(const std::string& token,
+                                        double dx,
+                                        double dy) {
+  ui::SystemInputInjector* injector = Injector(token);
+  if (!injector) {
+    return false;
+  }
+  const gfx::Point at = aura::Env::GetInstance()->last_mouse_location();
+  const display::Display display =
+      display::Screen::Get()->GetDisplayNearestPoint(at);
+  const float scale = display.device_scale_factor();
+  injector->MoveCursorTo(gfx::PointF(at.x() * scale + dx, at.y() * scale + dy));
+  return true;
+}
+
+// static
+bool NickelRemoteDesktop::Button(const std::string& token,
+                                 uint32_t button,
+                                 bool down) {
+  ui::SystemInputInjector* injector = Injector(token);
+  if (!injector) {
+    return false;
+  }
+  ui::EventFlags flag = ui::EF_NONE;
+  switch (button) {
+    case kBtnLeft:
+      flag = ui::EF_LEFT_MOUSE_BUTTON;
+      break;
+    case kBtnRight:
+      flag = ui::EF_RIGHT_MOUSE_BUTTON;
+      break;
+    case kBtnMiddle:
+      flag = ui::EF_MIDDLE_MOUSE_BUTTON;
+      break;
+    default:
+      // The injector has no other buttons.
+      return true;
+  }
+  injector->InjectMouseButton(flag, down);
+  return true;
+}
+
+// static
+bool NickelRemoteDesktop::Key(const std::string& token,
+                              uint32_t keycode,
+                              bool down) {
+  ui::SystemInputInjector* injector = Injector(token);
+  if (!injector) {
+    return false;
+  }
+  const ui::DomCode code = ui::KeycodeConverter::EvdevCodeToDomCode(keycode);
+  if (code != ui::DomCode::NONE) {
+    injector->InjectKeyEvent(code, down, /*suppress_auto_repeat=*/true);
+  }
+  return true;
+}
+
+// static
+bool NickelRemoteDesktop::Scroll(const std::string& token,
+                                 double dx,
+                                 double dy,
+                                 bool discrete) {
+  ui::SystemInputInjector* injector = Injector(token);
+  if (!injector) {
+    return false;
+  }
+  // The portal's positive values scroll down/right; ui's wheel deltas are
+  // positive up/left.
+  const double unit = discrete ? kWheelStep : 1;
+  injector->InjectMouseWheel(static_cast<int>(-dx * unit),
+                             static_cast<int>(-dy * unit));
+  return true;
+}
+
+}  // namespace ash

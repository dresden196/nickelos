+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_REMOTE_DESKTOP_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_REMOTE_DESKTOP_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/functional/callback.h"
+
+namespace ash {
+
+// NickelOS: remote control for Linux apps (AnyDesk, RustDesk: the
+// RemoteDesktop portal). NickelOS's portal backend calls these through
+// VmApplicationsService. Input goes in through the system input injector,
+// as for Chrome Remote Desktop's host, and only for a session the user
+// allowed; while it lasts, a notification says so and can stop it.
+class NickelRemoteDesktop {
+ public:
+  // Asks the user whether |app_name| may control the keyboard and pointer.
+  // Answers with a token for the calls below, or "" if not allowed.
+  static void Ask(const std::string& app_name,
+                  base::OnceCallback<void(const std::string& token)> callback);
+  static void End(const std::string& token);
+
+  // Each returns false once the session has ended (the user stopped it).
+  // Pointer positions are in the pixels of |source_id| (a screen or window
+  // the app shares, DesktopMediaID); "" means the primary screen.
+  static bool MovePointerTo(const std::string& token,
+                            const std::string& source_id,
+                            double x,
+                            double y);
+  static bool MovePointerBy(const std::string& token, double dx, double dy);
+  // evdev codes (BTN_LEFT, KEY_A, ...).
+  static bool Button(const std::string& token, uint32_t button, bool down);
+  static bool Key(const std::string& token, uint32_t keycode, bool down);
+  // Scroll, in pixels (|discrete|: in wheel steps), positive down/right.
+  static bool Scroll(const std::string& token,
+                     double dx,
+                     double dy,
+                     bool discrete);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_REMOTE_DESKTOP_H_

+// NickelOS's wallpapers (chromeos-bsp-nickel: the pictures of
+// collection.json, Wallpaper & style's NickelOS collection), the dark twin of
+// one that has it in dark mode, in random order.
+constexpr char kNickelWallpaperDir[] =
+    "/usr/share/chromeos-assets/wallpaper/nickel";
+
+bool IsWallpaperName(const std::string& name) {
+  if (name.empty() || name.size() > 128) {
+    return false;
+  }
+  for (char c : name) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '-' && c != '_') {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<base::FilePath> FindNickelWallpapers(bool dark) {
+  std::vector<base::FilePath> images;
+  const base::FilePath dir(kNickelWallpaperDir);
+  std::string text;
+  if (!base::ReadFileToString(dir.Append("collection.json"), &text)) {
+    return images;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return images;
+  }
+  const base::ListValue* list = value->GetDict().FindList("wallpapers");
+  if (!list) {
+    return images;
+  }
+  for (const base::Value& item : *list) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const std::string* name = item.GetDict().FindString("name");
+    const std::string* dark_name = item.GetDict().FindString("dark");
+    const std::string* pick = dark && dark_name ? dark_name : name;
+    if (!pick || !IsWallpaperName(*pick)) {
+      continue;
+    }
+    const base::FilePath file = dir.Append(*pick + ".jpg");
+    if (base::PathExists(file)) {
+      images.push_back(file);
+    }
+  }
+  base::RandomShuffle(images.begin(), images.end());
+  return images;
+}
+
+// The screen saver's pictures: NickelOS's wallpapers, its default (Dresden,

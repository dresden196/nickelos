+void ScreensaverImagesPolicyHandler::Refresh() {
+  folder_retry_timer_.Stop();
+  if (finding_folder_images_) {
+    refresh_pending_ = true;
+    return;
+  }
+  // An empty list, so the new one is taken at once (OnFolderImagesFound).
+  folder_images_.clear();
+  FindFolderImages();
+}
+
 void ScreensaverImagesPolicyHandler::OnFolderImagesFound(
     std::vector<base::FilePath> images) {
   finding_folder_images_ = false;
+  if (refresh_pending_) {
+    refresh_pending_ = false;
+    folder_images_.clear();
+    FindFolderImages();
+    return;
+  }
   // The new list is for the next screen saver (GetScreensaverImages), not
   // the one showing: it would start over. Unless the last list had too few
   // pictures to show at all, when it is what makes one possible.

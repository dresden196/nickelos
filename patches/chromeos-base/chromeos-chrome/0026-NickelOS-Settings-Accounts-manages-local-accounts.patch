+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_PEOPLE_NICKEL_ACCOUNTS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_PEOPLE_NICKEL_ACCOUNTS_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class Profile;
+
+namespace dbus {
+class ErrorResponse;
+class Response;
+}  // namespace dbus
+
+namespace ash::settings {
+
+// NickelOS: Settings > Accounts for local accounts, which are Linux users
+// (nickel-accountsd, org.nickelos.Accounts). Lists the accounts on the
+// device with the signed-in one first; changes the Linux password (the
+// page changes the encrypted home's own through PasswordFactorEditor);
+// for administrators, makes others administrators or not and removes them,
+// each with the administrator's password; and "Add person", which signs out
+// to the sign-in screen's account creation.
+//
+// Messages (all answered with a promise):
+//   nickelGetAccounts() -> {me: Account, others: Account[]}
+//     Account: {username, name, admin, owner, pic}
+//   nickelSetLinuxPassword(old, new) -> error ("" when done)
+//   nickelSetAdmin(username, admin, password) -> error
+//   nickelRemovePerson(username, password) -> error

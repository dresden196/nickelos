+<template is="dom-if" if="[[me_.admin]]" restamp>
+  <settings-card header-text="$i18n{nickelAccountsOtherPeople}">
+    <div class="settings-box first">
+      <div class="secondary">$i18n{nickelAccountsOtherPeopleDescription}</div>
+    </div>
+    <template is="dom-repeat" items="[[others_]]">

+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/people/nickel_accounts_handler.h"
+
+#include <cstdint>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ash/profiles/profile_helper.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/ash/user_image/user_image_source.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "components/prefs/pref_service.h"
+#include "components/user_manager/nickel_local_account.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+#include "ui/base/webui/web_ui_util.h"
+
+namespace ash::settings {
+
+namespace {
+
+constexpr char kAccountsService[] = "org.nickelos.Accounts";
+constexpr char kAccountsPath[] = "/org/nickelos/Accounts";
+constexpr char kAccountsInterface[] = "org.nickelos.Accounts";
+constexpr char kErrorPrefix[] = "org.nickelos.Accounts.Error.";
+
+dbus::ObjectProxy* AccountsProxy() {
+  return DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      kAccountsService, dbus::ObjectPath(kAccountsPath));
+}
+
+// nickel-accountsd's error, as the page names it.
+std::string ErrorCode(dbus::ErrorResponse* error) {
+  if (!error) {
+    return "failed";
+  }
+  const std::string name = error->GetErrorName();
+  if (name == base::StrCat({kErrorPrefix, "WrongPassword"})) {
+    return "wrong-password";
+  }
+  if (name == base::StrCat({kErrorPrefix, "LastAdmin"})) {
+    return "last-admin";
+  }
+  if (name == base::StrCat({kErrorPrefix, "NotAllowed"})) {
+    return "not-allowed";
+  }
+  return "failed";
+}
+
+// An account for the page: the Linux user (name, admin) with what ChromeOS
+// knows of it (the name it shows, its picture, whether it owns the device).
+base::DictValue AccountDict(const std::string& username,
+                            const std::string& linux_name,
+                            bool admin) {
+  const AccountId account_id = user_manager::MakeNickelLocalAccountId(username);
+  auto* manager = user_manager::UserManager::Get();
+  const user_manager::User* user = manager->FindUser(account_id);
+  std::string name = linux_name.empty() ? username : linux_name;
+  std::string pic;
+  if (user) {
+    if (!user->GetDisplayName().empty()) {
+      name = base::UTF16ToUTF8(user->GetDisplayName());
+    }
+    scoped_refptr<base::RefCountedMemory> image =
+        UserImageSource::GetUserImage(account_id);
+    if (image) {
+      pic = webui::GetPngDataUrl(*image);
+    }
+  }
+  base::DictValue dict;
+  dict.Set("username", username);
+  dict.Set("name", name);
+  dict.Set("admin", admin);
+  dict.Set("owner", manager->GetOwnerAccountId() == account_id);
+  dict.Set("pic", pic);
+  return dict;
+}
+
+}  // namespace
+
+NickelAccountsHandler::NickelAccountsHandler(Profile* profile)
+    : profile_(profile) {}
+
+NickelAccountsHandler::~NickelAccountsHandler() = default;
+
+void NickelAccountsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "nickelGetAccounts",
+      base::BindRepeating(&NickelAccountsHandler::HandleGetAccounts,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelSetLinuxPassword",
+      base::BindRepeating(&NickelAccountsHandler::HandleSetLinuxPassword,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelSetAdmin",
+      base::BindRepeating(&NickelAccountsHandler::HandleSetAdmin,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelRemovePerson",
+      base::BindRepeating(&NickelAccountsHandler::HandleRemovePerson,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelAddPerson",
+      base::BindRepeating(&NickelAccountsHandler::HandleAddPerson,
+                          base::Unretained(this)));
+}
+
+void NickelAccountsHandler::OnJavascriptDisallowed() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+std::string NickelAccountsHandler::MyUsername() const {
+  const user_manager::User* user =
+      ProfileHelper::Get()->GetUserByProfile(profile_);
+  if (!user || !user_manager::IsNickelLocalAccount(user->GetAccountId())) {
+    return std::string();
+  }
+  return user_manager::NickelLocalAccountUsername(user->GetAccountId());
+}
+
+void NickelAccountsHandler::HandleGetAccounts(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAccountsInterface, "ListUsers");
+  AccountsProxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelAccountsHandler::OnUsersListed,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void NickelAccountsHandler::OnUsersListed(const std::string& callback_id,
+                                          dbus::Response* response,
+                                          dbus::ErrorResponse* error) {
+  const std::string me = MyUsername();
+  base::DictValue result;
+  base::ListValue others;
+  result.Set("me", AccountDict(me, std::string(), false));
+  dbus::MessageReader reader(response);
+  dbus::MessageReader array(nullptr);
+  if (response && reader.PopArray(&array)) {
+    while (array.HasMoreData()) {
+      dbus::MessageReader entry(nullptr);
+      std::string name, display_name;
+      uint32_t uid = 0;
+      bool admin = false;
+      if (!array.PopStruct(&entry) || !entry.PopString(&name) ||
+          !entry.PopUint32(&uid) || !entry.PopBool(&admin) ||
+          !entry.PopString(&display_name)) {
+        break;
+      }
+      if (name == me) {
+        result.Set("me", AccountDict(name, display_name, admin));
+      } else {
+        others.Append(AccountDict(name, display_name, admin));
+      }
+    }
+  }
+  result.Set("others", std::move(others));
+  ResolveJavascriptCallback(base::Value(callback_id), result);
+}
+
+void NickelAccountsHandler::HandleSetLinuxPassword(
+    const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAccountsInterface, "SetPassword");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(MyUsername());
+  writer.AppendString(args[1].GetString());
+  writer.AppendString(args[2].GetString());
+  AccountsProxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelAccountsHandler::OnDone,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void NickelAccountsHandler::HandleSetAdmin(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAccountsInterface, "SetAdmin");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(args[3].GetString());
+  writer.AppendString(args[1].GetString());
+  writer.AppendBool(args[2].GetBool());
+  AccountsProxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelAccountsHandler::OnDone,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void NickelAccountsHandler::OnDone(const std::string& callback_id,
+                                   dbus::Response* response,
+                                   dbus::ErrorResponse* error) {
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(response ? std::string() : ErrorCode(error)));
+}
+
+void NickelAccountsHandler::HandleRemovePerson(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string callback_id = args[0].GetString();
+  const std::string username = args[1].GetString();
+  // ChromeOS keeps the device owner and the signed-in account: never take
+  // away a Linux user whose ChromeOS account stays.
+  const AccountId account_id = user_manager::MakeNickelLocalAccountId(username);
+  if (username.empty() || username == MyUsername() ||
+      user_manager::UserManager::Get()->GetOwnerAccountId() == account_id) {
+    ResolveJavascriptCallback(base::Value(callback_id),
+                              base::Value("not-allowed"));
+    return;
+  }
+  dbus::MethodCall method_call(kAccountsInterface, "RemoveUser");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(args[2].GetString());
+  writer.AppendString(username);
+  AccountsProxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelAccountsHandler::OnPersonRemovedFromLinux,
+                     weak_ptr_factory_.GetWeakPtr(), callback_id, username));
+}
+
+void NickelAccountsHandler::OnPersonRemovedFromLinux(
+    const std::string& callback_id,
+    const std::string& username,
+    dbus::Response* response,
+    dbus::ErrorResponse* error) {
+  if (!response) {
+    ResolveJavascriptCallback(base::Value(callback_id),
+                              base::Value(ErrorCode(error)));
+    return;
+  }
+  // Then ChromeOS's side: its list of accounts and the encrypted home.
+  const AccountId account_id = user_manager::MakeNickelLocalAccountId(username);
+  auto* manager = user_manager::UserManager::Get();
+  if (manager->FindUser(account_id)) {
+    manager->RemoveUser(account_id,
+                        user_manager::UserRemovalReason::LOCAL_USER_INITIATED);
+  }
+  ResolveJavascriptCallback(base::Value(callback_id),
+                            base::Value(std::string()));
+}
+
+void NickelAccountsHandler::HandleAddPerson(const base::ListValue& args) {
+  AllowJavascript();
+  // The sign-in screen opens account creation when it sees this
+  // (LoginDisplayHostMojo::OnStartSignInScreen).
+  g_browser_process->local_state()->SetBoolean(
+      user_manager::kNickelAddPersonAtSignIn, true);
+  ResolveJavascriptCallback(base::Value(args[0].GetString()), base::Value());
+  chrome::AttemptUserExit();
+}
+
+}  // namespace ash::settings

+// NickelOS: a local account is also a Linux user (nickel-accountsd). Once
+// ChromeOS has removed one from the sign-in screen (it may refuse, e.g. the
+// device owner), the Linux user goes too. Settings > Accounts removes the
+// Linux user itself, with the administrator's password, before ChromeOS's
+// side; this only acts with no session running, the case nickel-accountsd
+// allows without a password.
+class NickelLinuxUserRemover : public user_manager::UserManager::Observer {
+ public:
+  static void Ensure() { static base::NoDestructor<NickelLinuxUserRemover> r; }
+
+  NickelLinuxUserRemover() {
+    user_manager::UserManager::Get()->AddObserver(this);
+  }
+
+  void OnUserRemoved(const AccountId& account_id,
+                     user_manager::UserRemovalReason reason) override {
+    if (!user_manager::IsNickelLocalAccount(account_id) ||
+        session_manager::SessionManager::Get()->IsSessionStarted()) {
+      return;
+    }
+    dbus::MethodCall method_call("org.nickelos.Accounts", "DeleteUser");
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendString(user_manager::NickelLocalAccountUsername(account_id));
+    ash::DBusThreadManager::Get()
+        ->GetSystemBus()
+        ->GetObjectProxy("org.nickelos.Accounts",
+                         dbus::ObjectPath("/org/nickelos/Accounts"))
+        ->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                     base::DoNothing());
+  }
+};
+

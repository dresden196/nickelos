diff --git a/chrome/browser/resources/ash/settings/os_people_page/nickel_accounts_card.ts b/chrome/browser/resources/ash/settings/os_people_page/nickel_accounts_card.ts
new file mode 100644
index 0000000000000..985c67bbb73a4
--- /dev/null
+++ b/chrome/browser/resources/ash/settings/os_people_page/nickel_accounts_card.ts
@@ -0,0 +1,298 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: Settings > Accounts for local accounts, which are
+ * Linux users. Your account (name, whether you are an administrator) and
+ * changing its password; for administrators, the other people on the device:
+ * making them administrators or not, removing them, and adding a person
+ * (NickelAccountsHandler, nickel-accountsd).
+ *
+ * A password lives in two places, the encrypted home (cryptohome's
+ * "local-password" factor, what signing in checks) and the Linux user (sudo,
+ * polkit). Changing it checks the current password with cryptohome for a
+ * token, changes the Linux one (nickel-accountsd checks the current password
+ * again), then cryptohome's with the token; if that fails the Linux one goes
+ * back, so the two never differ.
+ */
+
+import 'chrome://resources/ash/common/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/ash/common/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/ash/common/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/ash/common/cr_elements/cr_toggle/cr_toggle.js';
+import 'chrome://resources/ash/common/cr_elements/icons.html.js';
+import 'chrome://resources/polymer/v3_0/iron-icon/iron-icon.js';
+import '../os_settings_page/settings_card.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrToggleElement} from 'chrome://resources/ash/common/cr_elements/cr_toggle/cr_toggle.js';
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {ConfigureResult, PasswordFactorEditor} from 'chrome://resources/mojo/chromeos/ash/services/auth_factor_config/public/mojom/auth_factor_config.mojom-webui.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_accounts_card.html.js';
+
+interface NickelAccount {
+  username: string;
+  name: string;
+  admin: boolean;
+  owner: boolean;
+  pic: string;
+}
+
+interface NickelAccounts {
+  me: NickelAccount;
+  others: NickelAccount[];
+}
+
+// What the confirmation dialog does when confirmed.
+type PendingAction = {kind: 'admin', account: NickelAccount, admin: boolean}|
+    {kind: 'remove', account: NickelAccount}|{kind: 'add-person'};
+
+const NickelAccountsCardElementBase = I18nMixin(PolymerElement);
+
+export class NickelAccountsCardElement extends NickelAccountsCardElementBase {
+  static get is() {
+    return 'nickel-accounts-card' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      me_: Object,
+      others_: Array,
+      currentPassword_: String,
+      newPassword_: String,
+      confirmPassword_: String,
+      adminPassword_: String,
+      dialogError_: String,
+      busy_: Boolean,
+      confirmTitle_: String,
+      confirmBody_: String,
+      confirmButton_: String,
+      confirmNeedsPassword_: Boolean,
+    };
+  }
+
+  declare private me_: NickelAccount;
+  declare private others_: NickelAccount[];
+  declare private currentPassword_: string;
+  declare private newPassword_: string;
+  declare private confirmPassword_: string;
+  declare private adminPassword_: string;
+  declare private dialogError_: string;
+  declare private busy_: boolean;
+  declare private confirmTitle_: string;
+  declare private confirmBody_: string;
+  declare private confirmButton_: string;
+  declare private confirmNeedsPassword_: boolean;
+  private pending_: PendingAction|null = null;
+
+  constructor() {
+    super();
+    this.me_ = {username: '', name: '', admin: false, owner: false, pic: ''};
+    this.others_ = [];
+    this.resetDialog_();
+  }
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.refresh_();
+  }
+
+  private async refresh_(): Promise<void> {
+    const accounts: NickelAccounts = await sendWithPromise('nickelGetAccounts');
+    this.me_ = accounts.me;
+    this.others_ = accounts.others;
+  }
+
+  private roleText_(account: NickelAccount): string {
+    const role = account.owner ?
+        this.i18n('nickelAccountsOwner') :
+        this.i18n(
+            account.admin ? 'nickelAccountsAdministrator' :
+                            'nickelAccountsStandard');
+    return `${account.username} · ${role}`;
+  }
+
+  private resetDialog_(): void {
+    this.currentPassword_ = '';
+    this.newPassword_ = '';
+    this.confirmPassword_ = '';
+    this.adminPassword_ = '';
+    this.dialogError_ = '';
+    this.busy_ = false;
+  }
+
+  private dialog_(id: string): CrDialogElement {
+    return this.shadowRoot!.getElementById(id) as CrDialogElement;
+  }
+
+  private errorText_(code: string): string {
+    switch (code) {
+      case 'wrong-password':
+        return this.i18n('nickelAccountsWrongPassword');
+      case 'last-admin':
+        return this.i18n('nickelAccountsLastAdmin');
+      default:
+        return this.i18n('nickelAccountsFailed');
+    }
+  }
+
+  private onDialogCancel_(e: Event): void {
+    (e.target as HTMLElement).closest('cr-dialog')?.cancel();
+  }
+
+  // Closed without the action done (Cancel, Esc): an administrator toggle
+  // the user flipped goes back to what is true.
+  private onConfirmClosed_(): void {
+    if (this.pending_) {
+      this.pending_ = null;
+      this.refresh_();
+    }
+  }
+
+  // --- Change password ---------------------------------------------------
+
+  private onChangePasswordClick_(): void {
+    this.resetDialog_();
+    this.dialog_('passwordDialog').showModal();
+  }
+
+  private getAuthToken_(password: string): Promise<string|null> {
+    return new Promise(resolve => {
+      chrome.quickUnlockPrivate.getAuthToken(password, tokenInfo => {
+        const failed = chrome.runtime.lastError || !tokenInfo;
+        resolve(failed ? null : tokenInfo.token);
+      });
+    });
+  }
+
+  private async onPasswordSubmit_(): Promise<void> {
+    const current = this.currentPassword_;
+    const next = this.newPassword_;
+    if (!next) {
+      this.dialogError_ = this.i18n('nickelAccountsEmptyPassword');
+      return;
+    }
+    if (next !== this.confirmPassword_) {
+      this.dialogError_ = this.i18n('nickelAccountsPasswordsDontMatch');
+      return;
+    }
+    this.busy_ = true;
+    this.dialogError_ = '';
+    const token = await this.getAuthToken_(current);
+    if (!token) {
+      this.busy_ = false;
+      this.dialogError_ = this.i18n('nickelAccountsWrongPassword');
+      return;
+    }
+    const linuxError: string =
+        await sendWithPromise('nickelSetLinuxPassword', current, next);
+    if (linuxError) {
+      this.busy_ = false;
+      this.dialogError_ = this.errorText_(linuxError);
+      return;
+    }
+    const {result} =
+        await PasswordFactorEditor.getRemote().updateOrSetLocalPassword(
+            token, next);
+    if (result !== ConfigureResult.kSuccess) {
+      // Back to the old one, so sudo and signing in agree.
+      await sendWithPromise('nickelSetLinuxPassword', next, current);
+      this.busy_ = false;
+      this.dialogError_ = this.i18n('nickelAccountsFailed');
+      return;
+    }
+    this.busy_ = false;
+    this.dialog_('passwordDialog').close();
+  }
+
+  // --- Other people --------------------------------------------------------
+
+  private showConfirm_(
+      action: PendingAction, title: string, body: string, button: string,
+      needsPassword: boolean): void {
+    this.resetDialog_();
+    this.pending_ = action;
+    this.confirmTitle_ = title;
+    this.confirmBody_ = body;
+    this.confirmButton_ = button;
+    this.confirmNeedsPassword_ = needsPassword;
+    this.dialog_('confirmDialog').showModal();
+  }
+
+  private onAdminToggle_(e: Event&{model: {item: NickelAccount}}): void {
+    const account = e.model.item;
+    const admin = (e.target as CrToggleElement).checked;
+    this.showConfirm_(
+        {kind: 'admin', account, admin},
+        this.i18n(
+            admin ? 'nickelAccountsMakeAdminTitle' :
+                    'nickelAccountsRemoveAdminTitle',
+            account.name),
+        this.i18n('nickelAccountsAdminBody'),
+        this.i18n('nickelAccountsConfirm'), true);
+  }
+
+  private onRemoveClick_(e: Event&{model: {item: NickelAccount}}): void {
+    const account = e.model.item;
+    this.showConfirm_(
+        {kind: 'remove', account},
+        this.i18n('nickelAccountsRemoveTitle', account.name),
+        this.i18n('nickelAccountsRemoveBody'),
+        this.i18n('nickelAccountsRemove'), true);
+  }
+
+  private onAddPersonClick_(): void {
+    this.showConfirm_(
+        {kind: 'add-person'}, this.i18n('nickelAccountsAddPerson'),
+        this.i18n('nickelAccountsAddPersonBody'),
+        this.i18n('nickelAccountsSignOut'), false);
+  }
+
+  private async onConfirmSubmit_(): Promise<void> {
+    const action = this.pending_;
+    if (!action) {
+      return;
+    }
+    this.busy_ = true;
+    this.dialogError_ = '';
+    let error = '';
+    if (action.kind === 'add-person') {
+      await sendWithPromise('nickelAddPerson');
+      return;
+    }
+    if (action.kind === 'admin') {
+      error = await sendWithPromise(
+          'nickelSetAdmin', action.account.username, action.admin,
+          this.adminPassword_);
+    } else {
+      error = await sendWithPromise(
+          'nickelRemovePerson', action.account.username, this.adminPassword_);
+    }
+    this.busy_ = false;
+    if (error) {
+      this.dialogError_ = this.errorText_(error);
+      return;
+    }
+    this.pending_ = null;
+    this.dialog_('confirmDialog').close();
+    this.refresh_();
+  }
+}
+

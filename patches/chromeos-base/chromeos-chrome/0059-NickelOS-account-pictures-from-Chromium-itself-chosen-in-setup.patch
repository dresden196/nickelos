+// NickelOS: a default image is one of Chromium's own avatars, in the
+// resource pack (default_user_images.cc), so nothing is downloaded. Its PNG
+// goes with it, for WebUI (chrome://userimage) and for saving.
+std::unique_ptr<user_manager::UserImage> LoadBundledDefaultImage(int index) {
+  ui::ResourceBundle& bundle = ui::ResourceBundle::GetSharedInstance();
+  int resource_id = default_user_image::GetDefaultImageResourceId(index);
+  if (!resource_id) {
+    resource_id = IDR_LOGIN_DEFAULT_USER;
+  }
+  const gfx::ImageSkia& image = *bundle.GetImageSkiaNamed(resource_id);
+  scoped_refptr<base::RefCountedMemory> png =
+      bundle.LoadDataResourceBytesForScale(resource_id, ui::k100Percent);
+  if (!png) {
+    return std::make_unique<user_manager::UserImage>(image);
+  }
+  auto user_image = std::make_unique<user_manager::UserImage>(
+      image,
+      base::MakeRefCounted<base::RefCountedBytes>(
+          base::span<const uint8_t>(*png)),
+      user_manager::UserImage::FORMAT_PNG);
+  user_image->MarkAsSafe();
+  return user_image;
+}

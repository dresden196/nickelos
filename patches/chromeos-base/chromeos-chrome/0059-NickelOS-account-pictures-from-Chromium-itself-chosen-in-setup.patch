+void LocalAccountCreationScreen::SetPendingAvatar(const std::string& username,
+                                                  int avatar_index) {
+  PrefService* local_state = g_browser_process->local_state();
+  const std::string email =
+      user_manager::MakeNickelLocalAccountId(username).GetUserEmail();
+  {
+    ScopedDictPrefUpdate update(local_state,
+                                prefs::kNickelSetupPendingAvatars);
+    if (default_user_image::IsInCurrentImageSet(avatar_index)) {
+      update->Set(email, avatar_index);
+    } else {
+      update->Remove(email);
+    }
+  }
+  // NickelOS restarts Chrome right after signing in (as the account's Linux
+  // user): the choice must be on disk by then.
+  local_state->CommitPendingWrite();
+}

 void UserImageManagerImpl::SetInitialUserImage() {
+  // NickelOS: the picture chosen while creating the account
+  // (LocalAccountCreationScreen), if any.
+  const std::string email = GetUser()->GetAccountId().GetUserEmail();
+  if (const base::DictValue& pending =
+          local_state_->GetDict(prefs::kNickelSetupPendingAvatars);
+      pending.contains(email)) {
+    const std::optional<int> chosen = pending.FindInt(email);
+    ScopedDictPrefUpdate(&local_state_.get(), prefs::kNickelSetupPendingAvatars)
+        ->Remove(email);
+    if (chosen && default_user_image::IsInCurrentImageSet(*chosen)) {
+      SaveUserDefaultImageIndex(*chosen);
+      return;
+    }
+  }
   // Choose a random default image.
   SaveUserDefaultImageIndex(default_user_image::GetRandomDefaultImageIndex());
 }

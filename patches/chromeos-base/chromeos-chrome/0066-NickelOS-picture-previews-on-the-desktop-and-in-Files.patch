+  void LoadThumbnail() {
+    NickelDesktopClient* client = NickelDesktopClient::Get();
+    if (!client) {
+      return;
+    }
+    is_video_ = IsVideo(path_);
+    client->LoadThumbnail(
+        path_, kThumbnailWidth * kThumbnailScale,
+        base::BindOnce(&NickelDesktopIconView::OnThumbnail,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnThumbnail(const SkBitmap& bitmap) {
+    if (bitmap.drawsNothing()) {
+      return;
+    }
+    thumbnail_ = gfx::ImageSkia::CreateFromBitmap(bitmap, kThumbnailScale);
+    image_view_->SetVisible(false);
+    SchedulePaint();
+  }
+
+  // The preview, in proportion, centred where the tile would be (a small
+  // picture no bigger than it is), with a thin edge that shows on any
+  // wallpaper, and a play badge on videos.
+  void PaintThumbnail(gfx::Canvas* canvas) {
+    const gfx::Rect tile = GetTileBounds();
+    const float scale =
+        std::min({kThumbnailWidth / static_cast<float>(thumbnail_.width()),
+                  kThumbnailHeight / static_cast<float>(thumbnail_.height()),
+                  kThumbnailScale});
+    const gfx::Size size = gfx::ToRoundedSize(
+        gfx::ScaleSize(gfx::SizeF(thumbnail_.size()), scale));
+    const gfx::Rect rect(tile.CenterPoint().x() - size.width() / 2,
+                         tile.CenterPoint().y() - size.height() / 2,
+                         size.width(), size.height());
+    {
+      gfx::ScopedCanvas scoped_canvas(canvas);
+      canvas->ClipPath(SkPath::RRect(SkRRect::MakeRectXY(
+                           gfx::RectToSkRect(rect), kThumbnailRadius,
+                           kThumbnailRadius)),
+                       /*do_anti_alias=*/true);
+      canvas->DrawImageInt(thumbnail_, 0, 0, thumbnail_.width(),
+                           thumbnail_.height(), rect.x(), rect.y(),
+                           rect.width(), rect.height(), /*filter=*/true);
+    }
+    cc::PaintFlags edge;
+    edge.setAntiAlias(true);
+    edge.setStyle(cc::PaintFlags::kStroke_Style);
+    edge.setStrokeWidth(1);
+    edge.setColor(SkColorSetA(SK_ColorBLACK, 0x40));
+    gfx::RectF edge_rect(rect);
+    edge_rect.Inset(0.5f);
+    canvas->DrawRoundRect(edge_rect, kThumbnailRadius - 0.5f, edge);
+    if (!is_video_) {
+      return;
+    }
+    const gfx::PointF center(rect.right() - 11, rect.bottom() - 11);
+    cc::PaintFlags badge;
+    badge.setAntiAlias(true);
+    badge.setColor(SkColorSetA(SK_ColorBLACK, 0x99));
+    canvas->DrawCircle(center, 8, badge);
+    badge.setColor(SK_ColorWHITE);
+    SkPathBuilder play;
+    play.moveTo(center.x() - 2.5f, center.y() - 4);
+    play.lineTo(center.x() + 4.5f, center.y());
+    play.lineTo(center.x() - 2.5f, center.y() + 4);
+    play.close();
+    canvas->DrawPath(play.detach(), badge);
+  }
+
   gfx::Rect GetTileBounds() const {
     return gfx::Rect((width() - kTileSize) / 2, kTileTop, kTileSize,
                      kTileSize);

+// NickelOS: thumbnails can wait behind others nickel-appd is making.
+constexpr int kNickelThumbnailTimeoutMs = 120 * 1000;
+
+// nickel-appd's Thumbnail(path, size) -> (png).
+void GetNickelThumbnail(
+    const base::FilePath& path,
+    int size,
+    base::OnceCallback<void(std::optional<std::vector<uint8_t>>)> callback) {
+  dbus::ObjectProxy* proxy =
+      ash::DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+          crostini::kNickelAppsServiceName,
+          dbus::ObjectPath(crostini::kNickelAppsServicePath));
+  dbus::MethodCall method_call(crostini::kNickelAppsServiceInterface,
+                               "Thumbnail");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(path.value());
+  writer.AppendUint32(static_cast<uint32_t>(size));
+  proxy->CallMethod(
+      &method_call, kNickelThumbnailTimeoutMs,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<std::vector<uint8_t>>)>
+                 callback,
+             dbus::Response* response) {
+            if (!response) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            dbus::MessageReader reader(response);
+            base::span<const uint8_t> png;
+            if (!reader.PopArrayOfBytes(&png) || png.empty()) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            std::move(callback).Run(std::vector<uint8_t>(png.begin(), png.end()));
+          },
+          std::move(callback)));
+}
+
 // The maximum size of the input PDF file for which thumbnails are generated.

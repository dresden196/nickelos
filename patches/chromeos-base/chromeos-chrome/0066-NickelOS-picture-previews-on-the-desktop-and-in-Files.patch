+// A picture's, video's or PDF's preview: in proportion, at most this big,
+// where the tile would be; fetched at twice the size for HiDPI screens.
+constexpr int kThumbnailWidth = 68;
+constexpr int kThumbnailHeight = 58;
+constexpr float kThumbnailRadius = 6;
+constexpr float kThumbnailScale = 2;
+
+// The files that get a preview, as in Files: pictures (HEIC/HEIF through the
+// system's thumbnailers), RAW photos, videos and PDFs.
+bool HasExtension(const base::FilePath& path,
+                  std::initializer_list<const char*> extensions) {
+  const std::string extension = base::ToLowerASCII(path.FinalExtension());
+  for (const char* candidate : extensions) {
+    if (extension == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsVideo(const base::FilePath& path) {
+  return HasExtension(path, {".mp4", ".m4v", ".mov", ".mkv", ".webm", ".avi",
+                             ".3gp", ".3gpp", ".ogv", ".mpg", ".mpeg"});
+}
+
+bool HasPreview(const base::FilePath& path) {
+  return IsVideo(path) ||
+         HasExtension(path, {".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif",
+                             ".bmp", ".ico", ".tif", ".tiff", ".svg", ".heic",
+                             ".heif", ".arw", ".cr2", ".dng", ".nef", ".nrw",
+                             ".orf", ".raf", ".rw2", ".pdf"});
+}
 

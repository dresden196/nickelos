+
+void NickelDesktopClientImpl::LoadThumbnail(const base::FilePath& path,
+                                            int size,
+                                            ThumbnailCallback callback) {
+  Profile* profile = GetProfile();
+  if (!profile) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  if (!thumbnail_loader_ || thumbnail_profile_ != profile) {
+    thumbnail_loader_ = std::make_unique<ash::ThumbnailLoader>(profile);
+    thumbnail_profile_ = profile;
+  }
+  // The whole picture, as macOS and Windows show them (Files' grid cuts
+  // them to squares).
+  thumbnail_loader_->Load(
+      ash::ThumbnailLoader::ThumbnailRequest(path, gfx::Size(size, size),
+                                             /*crop=*/false),
+      base::BindOnce(
+          [](ThumbnailCallback callback, const SkBitmap* bitmap,
+             base::File::Error) {
+            std::move(callback).Run(bitmap ? *bitmap : SkBitmap());
+          },
+          std::move(callback)));
+}

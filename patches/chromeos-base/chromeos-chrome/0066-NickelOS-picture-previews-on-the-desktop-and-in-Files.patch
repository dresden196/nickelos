+ImageLoaderPrivateGetNickelThumbnailFunction::
+    ImageLoaderPrivateGetNickelThumbnailFunction() = default;
+
+ImageLoaderPrivateGetNickelThumbnailFunction::
+    ~ImageLoaderPrivateGetNickelThumbnailFunction() = default;
+
+ExtensionFunction::ResponseAction
+ImageLoaderPrivateGetNickelThumbnailFunction::Run() {
+  using extensions::api::image_loader_private::GetNickelThumbnail::Params;
+  const std::optional<Params> params = Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  scoped_refptr<storage::FileSystemContext> file_system_context =
+      file_manager::util::GetFileManagerFileSystemContext(profile);
+  const GURL url = GURL(params->url);
+  const storage::FileSystemURL file_system_url =
+      file_system_context->CrackURLInFirstPartyContext(url);
+  if (file_system_url.type() != storage::kFileSystemTypeLocal) {
+    return RespondNow(Error("Expected a native local URL"));
+  }
+  const base::FilePath path =
+      file_manager::util::GetLocalPathFromURL(file_system_context, url);
+  if (path.empty()) {
+    return RespondNow(Error("Expected a native local URL"));
+  }
+  // As Linux apps know it (in the home, not My files): the thumbnail's
+  // name in ~/.cache/thumbnails, which file managers share, comes from it.
+  GetNickelThumbnail(
+      crostini::NickelPathForLinuxApps(profile, path),
+      std::max(params->width, params->height),
+      base::BindOnce(
+          &ImageLoaderPrivateGetNickelThumbnailFunction::GotThumbnail, this));
+  return RespondLater();
+}
+
+void ImageLoaderPrivateGetNickelThumbnailFunction::GotThumbnail(
+    std::optional<std::vector<uint8_t>> png) {
+  if (!png) {
+    Respond(Error("No thumbnail"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::vector<uint8_t> png) {
+            return MakeThumbnailDataUrlOnThreadPool(kMimeTypeImagePng, png);
+          },
+          std::move(*png)),
+      base::BindOnce(
+          &ImageLoaderPrivateGetNickelThumbnailFunction::SendEncodedThumbnail,
+          this));
+}

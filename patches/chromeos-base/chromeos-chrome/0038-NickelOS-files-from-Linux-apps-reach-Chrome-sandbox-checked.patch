+  // (/proc/<pid>/mountinfo, which Chrome may read; its /proc/<pid>/root it
+  // may not). A document portal path is a file the portal gave the app.
+  bool CanReadFile(const base::FilePath& path) const override {
+    pid_t pid = 0;
+    uid_t uid = 0;
+    gid_t gid = 0;
+    wl_client_get_credentials(client_, &pid, &uid, &gid);
+    if (pid <= 0 || !path.IsAbsolute() || path.ReferencesParent()) {
+      return false;

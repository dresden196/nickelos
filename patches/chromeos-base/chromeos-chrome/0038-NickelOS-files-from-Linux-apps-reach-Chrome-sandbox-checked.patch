+// NickelOS: the default server's clients (no VM) are Linux apps running on
+// the device itself, as the user. Their files are the user's, named in their
+// home's terms (one home); Exo has dropped those a sandboxed app cannot read
+// itself (ClientsRunOnTheHost). They reach Chrome as dragged or pasted
+// files, as from the Files app.
+std::vector<FileInfo> TranslateLinuxAppsToHost(
+    std::vector<ui::FileInfo> app_paths) {
+  Profile* profile = ProfileManager::GetPrimaryUserProfile();
+  storage::ExternalMountPoints* mount_points =
+      storage::ExternalMountPoints::GetSystemInstance();
+  std::vector<FileInfo> file_infos;
+  for (ui::FileInfo& info : app_paths) {
+    base::FilePath path = crostini::NickelPathFromLinuxApps(profile, info.path);
+    storage::FileSystemURL url;
+    base::FilePath virtual_path;
+    if (mount_points->GetVirtualPath(path, &virtual_path)) {
+      url = mount_points->CreateCrackedFileSystemURL(
+          blink::StorageKey(), storage::kFileSystemTypeExternal, virtual_path);
+    }
+    file_infos.push_back({std::move(path), std::move(url)});
+  }
+  return file_infos;
+}

+  // mount it is under (the longest mount point; a later mount covers an
+  // earlier one) and its path in that file system.
+  static std::optional<std::string> FileSystemPlace(
+      const std::string& mountinfo,
+      const std::string& path) {
+    std::string table;
+    if (!base::ReadFileToString(base::FilePath(mountinfo), &table)) {
+      return std::nullopt;
+    }
+    std::string device;
+    std::string root;
+    std::string point;
+    for (std::string_view line : base::SplitStringPiece(
+             table, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      // ID PARENT MAJOR:MINOR ROOT MOUNT-POINT ...
+      std::vector<std::string> fields = base::SplitString(
+          line, " ", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+      if (fields.size() < 5) {
+        continue;
+      }
+      const std::string mount_point = Unescape(fields[4]);
+      const bool under = mount_point == "/" || path == mount_point ||
+                         base::StartsWith(path, mount_point + "/");

+bool ChromeCaptureModeDelegate::NickelLaunchScreenshotTool(
+    base::OnceClosure on_failure) {
+  Profile* profile = ProfileManager::GetActiveUserProfile();
+  if (!profile || !profile->GetPrefs()) {
+    return false;
+  }
+  const std::string tool =
+      profile->GetPrefs()->GetString(ash::prefs::kNickelScreenshotTool);
+  dbus::Bus* bus = ash::DBusThreadManager::IsInitialized()
+                       ? ash::DBusThreadManager::Get()->GetSystemBus()
+                       : nullptr;
+  if (tool.empty() || !bus) {
+    return false;
+  }
+  // nickel-appd starts it in the session, with its capture action when it
+  // has one (org.nickelos.Apps, as crostini_util.h names it).
+  dbus::ObjectProxy* proxy = bus->GetObjectProxy(
+      "org.nickelos.Apps", dbus::ObjectPath("/org/nickelos/Apps"));
+  dbus::MethodCall method_call("org.nickelos.Apps", "LaunchTool");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(tool);
+  writer.AppendString("screenshot");
+  proxy->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(
+          [](const std::string& tool, base::OnceClosure on_failure,
+             dbus::Response* response, dbus::ErrorResponse* error) {
+            if (response) {
+              return;
+            }
+            LOG(WARNING) << "NickelOS: the screenshot app " << tool
+                         << " did not start: "
+                         << (error ? error->GetErrorName() : "no answer");
+            std::move(on_failure).Run();
+          },
+          tool, std::move(on_failure)));
+  return true;
+}

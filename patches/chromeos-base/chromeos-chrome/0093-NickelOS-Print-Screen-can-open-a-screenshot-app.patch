+// The app Print Screen opens: ChromeOS's screen capture (this id; the pref
+// is empty for it) or a Linux app that takes screenshots (its desktop file
+// id), which nickel-appd starts (CaptureModeDelegate::
+// NickelLaunchScreenshotTool).
+constexpr char kScreenshotKind[] = "screenshot";
+constexpr char kScreenCapture[] = "chromeos";
+
+// A Linux app whose name or keywords say it takes screenshots: Flameshot,
+// Spectacle, GNOME Screenshot, ksnip...
+bool IsScreenshotApp(
+    const guest_os::GuestOsRegistryService::Registration& app) {
+  auto mentions = [](const std::string& text) {
+    const std::string lower = base::ToLowerASCII(text);
+    return lower.find("screenshot") != std::string::npos ||
+           lower.find("screen shot") != std::string::npos ||
+           lower.find("screen capture") != std::string::npos;
+  };
+  if (mentions(app.Name())) {
+    return true;
+  }
+  for (const std::string& keyword : app.Keywords()) {
+    if (mentions(keyword)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::DictValue ScreenshotKind(Profile* profile) {
+  base::ListValue apps;
+  apps.Append(base::DictValue()
+                  .Set("taskId", kScreenCapture)
+                  .Set("title", l10n_util::GetStringUTF16(
+                                    IDS_SETTINGS_NICKEL_DEFAULT_APPS_SCREEN_CAPTURE)));
+  const std::string chosen =
+      profile->GetPrefs()->GetString(ash::prefs::kNickelScreenshotTool);
+  bool chosen_there = false;
+  if (auto* registry =
+          guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile)) {
+    std::vector<std::pair<std::string, std::string>> found;  // Name, id.
+    // NickelOS's own Linux apps (nickel-appd's, VM type NICKEL_HOST).
+    for (const auto& [app_id, app] :
+         registry->GetRegisteredApps(guest_os::VmType::NICKEL_HOST)) {
+      if (!app.NoDisplay() && IsScreenshotApp(app)) {
+        found.emplace_back(app.Name(), app.DesktopFileId());
+      }
+    }
+    std::sort(found.begin(), found.end());
+    for (const auto& [name, desktop_file_id] : found) {
+      apps.Append(base::DictValue()
+                      .Set("taskId", desktop_file_id)
+                      .Set("title", name));
+      chosen_there |= desktop_file_id == chosen;
+    }
+  }
+  // An app removed since it was chosen: Print Screen falls back to the
+  // screen capture, as shown.
+  return base::DictValue()
+      .Set("id", kScreenshotKind)
+      .Set("apps", std::move(apps))
+      .Set("defaultTaskId", chosen_there ? chosen : kScreenCapture);
+}

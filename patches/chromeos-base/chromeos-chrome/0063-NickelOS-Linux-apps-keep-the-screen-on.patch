@@ -0,0 +1,30 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_INHIBIT_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_INHIBIT_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/files/scoped_file.h"
+
+namespace ash {
+
+// NickelOS: wake locks for Linux apps keeping the screen on or the device
+// awake (the Inhibit portal's backend and org.freedesktop.ScreenSaver,
+// xdg-desktop-portal-nickel; VmApplicationsService.NickelInhibit).
+class NickelInhibit {
+ public:
+  // The portal's flags: 8 (idle) keeps the screen on, 4 (suspend) the device
+  // awake. The lock lasts while `socket` stays open.
+  static void Hold(const std::string& app_name,
+                   const std::string& reason,
+                   uint32_t flags,
+                   base::ScopedFD socket);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_INHIBIT_H_

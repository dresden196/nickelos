diff --git a/chrome/browser/ash/dbus/vm/nickel_inhibit.cc b/chrome/browser/ash/dbus/vm/nickel_inhibit.cc
new file mode 100644
index 0000000000000..3e0587f8506fb
--- /dev/null
+++ b/chrome/browser/ash/dbus/vm/nickel_inhibit.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_inhibit.h"
+
+#include <unistd.h>
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/strcat.h"
+#include "chromeos/dbus/power/power_policy_controller.h"
+
+namespace ash {
+
+namespace {
+
+constexpr uint32_t kFlagSuspend = 4;
+constexpr uint32_t kFlagIdle = 8;
+
+class Lock;
+
+std::vector<std::unique_ptr<Lock>>& Locks() {
+  static base::NoDestructor<std::vector<std::unique_ptr<Lock>>> locks;
+  return *locks;
+}
+
+// One wake lock, removed when its socket closes (the app let go, quit or
+// crashed, or the portal's backend went away).
+class Lock {
+ public:
+  Lock(base::ScopedFD socket, int id) : socket_(std::move(socket)), id_(id) {
+    watch_ = base::FileDescriptorWatcher::WatchReadable(
+        socket_.get(),
+        base::BindRepeating(&Lock::OnReadable, base::Unretained(this)));
+  }
+  Lock(const Lock&) = delete;
+  Lock& operator=(const Lock&) = delete;
+  ~Lock() { chromeos::PowerPolicyController::Get()->RemoveWakeLock(id_); }
+
+ private:
+  void OnReadable() {
+    char byte;
+    if (HANDLE_EINTR(read(socket_.get(), &byte, 1)) > 0) {
+      return;
+    }
+    // Closed: this goes away, and its wake lock with it.
+    std::erase_if(Locks(), [this](const std::unique_ptr<Lock>& lock) {
+      return lock.get() == this;
+    });
+  }
+
+  base::ScopedFD socket_;
+  const int id_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> watch_;
+};
+
+}  // namespace
+
+// static
+void NickelInhibit::Hold(const std::string& app_name,
+                         const std::string& reason,
+                         uint32_t flags,
+                         base::ScopedFD socket) {
+  if (!socket.is_valid() || !chromeos::PowerPolicyController::IsInitialized() ||
+      !(flags & (kFlagIdle | kFlagSuspend))) {
+    return;
+  }
+  const std::string description =
+      base::StrCat({"NickelOS: ", app_name, reason.empty() ? "" : " (",
+                    reason, reason.empty() ? "" : ")"});
+  chromeos::PowerPolicyController* power =
+      chromeos::PowerPolicyController::Get();
+  const int id =
+      (flags & kFlagIdle)
+          ? power->AddScreenWakeLock(
+                chromeos::PowerPolicyController::REASON_OTHER, description)
+          : power->AddSystemWakeLock(
+                chromeos::PowerPolicyController::REASON_OTHER, description);
+  Locks().push_back(std::make_unique<Lock>(std::move(socket), id));
+}
+
+}  // namespace ash

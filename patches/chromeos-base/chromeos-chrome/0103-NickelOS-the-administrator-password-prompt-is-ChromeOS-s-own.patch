--- /dev/null
+++ b/chrome/browser/ash/dbus/vm/nickel_admin_auth.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_ADMIN_AUTH_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_ADMIN_AUTH_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+
+namespace ash {
+
+// NickelOS: an administrator's password for polkit, asked with ChromeOS's own
+// "Verify your identity" prompt (ActiveSessionAuthView, system-modal) instead
+// of a GTK window. nickel-polkit-agent asks (VmApplicationsService's
+// NickelAdminAuthAsk, which only root may call) and checks the password
+// through polkit's helper; Chrome only shows the prompt and hands back what
+// was typed. One prompt at a time.
+class NickelAdminAuth {
+ public:
+  // The administrator whose password was typed (a Linux user name) and the
+  // password; ("", "") when the prompt was closed.
+  using Callback = base::OnceCallback<void(const std::string& user,
+                                           const std::string& password)>;
+
+  // Shows the prompt for |request_id|, with polkit's |message|, for one of
+  // |administrators| (the signed-in user when they are one). With the id of
+  // the prompt already showing, shows |error| ("": "Incorrect password") and
+  // asks again. Another request's prompt still showing is left over (the
+  // agent closes each one): it is closed, its answer ("", ""). False when
+  // there is no account to ask a password of.
+  static bool Ask(const std::string& request_id,
+                  const std::string& message,
+                  const std::vector<std::string>& administrators,
+                  const std::string& error,
+                  Callback callback);
+
+  // Closes |request_id|'s prompt (the password was right, or polkit gave up).
+  static void Close(const std::string& request_id);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_ADMIN_AUTH_H_

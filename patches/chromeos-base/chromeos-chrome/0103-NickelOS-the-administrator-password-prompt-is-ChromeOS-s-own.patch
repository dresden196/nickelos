 }
 
+// NickelOS: nickel-polkit-agent asks for an administrator's password
+// (request id, polkit's message, its icon name, its details, the
+// administrators, an error to show when asking again); the answer is the
+// administrator and the password as typed, ("", "") when the prompt was
+// closed. Only root may call this (org.nickelos.PolkitAgent.conf); the
+// password is never logged.
+void VmApplicationsServiceProvider::NickelAdminAuthAsk(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string request_id;
+  std::string message;
+  std::string icon_name;
+  dbus::MessageReader details(nullptr);
+  std::vector<std::string> administrators;
+  std::string error;
+  if (!reader.PopString(&request_id) || !reader.PopString(&message) ||
+      !reader.PopString(&icon_name) || !reader.PopArray(&details) ||
+      !reader.PopArrayOfStrings(&administrators) ||
+      !reader.PopString(&error)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected request id, message, icon name, details, "
+            "administrators, error"));
+    return;
+  }
+  auto answer = base::BindOnce(
+      [](dbus::MethodCall* method_call,
+         dbus::ExportedObject::ResponseSender response_sender,
+         const std::string& user, const std::string& password) {
+        std::unique_ptr<dbus::Response> response =
+            dbus::Response::FromMethodCall(method_call);
+        dbus::MessageWriter writer(response.get());
+        writer.AppendString(user);
+        writer.AppendString(password);
+        std::move(response_sender).Run(std::move(response));
+      },
+      method_call, std::move(response_sender));
+  // The answer goes back once the prompt has one; when there is no account
+  // to ask a password of, the callback isn't kept and the agent gets ("", "")
+  // at once, as for Cancel.
+  auto [ask_answer, busy_answer] = base::SplitOnceCallback(std::move(answer));
+  if (!NickelAdminAuth::Ask(request_id, message, administrators, error,
+                            std::move(ask_answer))) {
+    std::move(busy_answer).Run(std::string(), std::string());
+  }
+}
+
+void VmApplicationsServiceProvider::NickelAdminAuthClose(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string request_id;
+  if (!reader.PopString(&request_id)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS, "Expected the request id"));
+    return;
+  }
+  NickelAdminAuth::Close(request_id);
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
 // NickelOS: one input event of an allowed session: (token, kind, source,
 // x, y, code, down), kind one of "move-to" (x, y in the source's pixels),
 // "move-by" (x, y), "button" (code, down), "key" (code, down), "scroll"

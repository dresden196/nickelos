new file mode 100644
index 0000000..9f5e329
--- /dev/null
+++ b/chrome/browser/ash/dbus/vm/nickel_admin_auth.cc
@@ -0,0 +1,216 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_admin_auth.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "ash/auth/views/active_session_auth_view.h"
+#include "ash/auth/views/auth_common.h"
+#include "ash/public/cpp/shell_window_ids.h"
+#include "ash/shell.h"
+#include "ash/strings/grit/ash_strings.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/account_id/account_id.h"
+#include "components/user_manager/nickel_local_account.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "ui/aura/window.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/mojom/ui_base_types.mojom-shared.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/chromeos/strings/grit/ui_chromeos_strings.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+namespace ash {
+namespace {
+
+// The local account of a Linux user, if it is one ChromeOS knows.
+const user_manager::User* LocalAccountOf(const std::string& linux_user) {
+  return user_manager::UserManager::Get()->FindUser(
+      user_manager::MakeNickelLocalAccountId(linux_user));
+}
+
+class Prompt : public ActiveSessionAuthView::Observer {
+ public:
+  Prompt(const std::string& request_id,
+         const std::string& user,
+         const AccountId& account_id,
+         const std::u16string& description)
+      : request_id_(request_id), user_(user) {
+    auto view = std::make_unique<ActiveSessionAuthView>(
+        account_id, l10n_util::GetStringUTF16(IDS_ASH_IN_SESSION_AUTH_TITLE),
+        description, AuthFactorSet{AuthInputType::kPassword});
+    view_ = view.get();
+
+    // As ChromeOS's own prompt (ActiveSessionAuthControllerImpl::InitUi).
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    // The delegate is the prompt's own (ChromeOS's widgets hand theirs to
+    // the widget, by a key only Chrome's own classes may make).
+    delegate_ = std::make_unique<views::WidgetDelegate>();
+    params.delegate = delegate_.get();
+    params.show_state = ui::mojom::WindowShowState::kNormal;
+    params.parent = Shell::GetPrimaryRootWindow()->GetChildById(
+        kShellWindowId_SystemModalContainer);
+    params.autosize = true;
+    params.name = "NickelAdminAuthWidget";
+    params.delegate->SetInitiallyFocusedView(view.get());
+    params.delegate->SetModalType(ui::mojom::ModalType::kSystem);
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+    widget_->SetVisibilityAnimationTransition(views::Widget::ANIMATE_NONE);
+    widget_->SetContentsView(std::move(view));
+    view_->AddObserver(this);
+    widget_->CenterWindow(widget_->GetContentsView()->GetPreferredSize());
+    widget_->Show();
+    // ChromeOS's own prompt opens from a click in Chrome; this one also when
+    // no window is active (a program started from a terminal or at login):
+    // it takes the keyboard itself.
+    widget_->Activate();
+  }
+  Prompt(const Prompt&) = delete;
+  Prompt& operator=(const Prompt&) = delete;
+  ~Prompt() override {
+    // Replaced unanswered (NickelAdminAuth::Ask): cancelled.
+    if (callback_) {
+      std::move(callback_).Run(std::string(), std::string());
+    }
+    view_->RemoveObserver(this);
+    view_ = nullptr;
+    widget_.reset();
+  }
+
+  const std::string& request_id() const { return request_id_; }
+
+  void Ask(const std::string& error, NickelAdminAuth::Callback callback) {
+    callback_ = std::move(callback);
+    if (asked_) {
+      // The fields first: clearing them puts the title back.
+      view_->ResetInputfields();
+      view_->SetErrorTitle(
+          error.empty()
+              ? l10n_util::GetStringUTF16(
+                    IDS_ASH_IN_SESSION_AUTH_PASSWORD_INCORRECT)
+              : base::UTF8ToUTF16(error));
+    }
+    asked_ = true;
+    view_->SetInputEnabled(true);
+    view_->RequestFocus();
+  }
+
+  // ActiveSessionAuthView::Observer:
+  void OnPasswordSubmit(std::u16string_view password) override {
+    if (!callback_) {
+      return;
+    }
+    // Until polkit's helper has checked it: Ask again, or Close.
+    view_->SetInputEnabled(false);
+    std::string typed = base::UTF16ToUTF8(password);
+    std::move(callback_).Run(user_, typed);
+    std::fill(typed.begin(), typed.end(), '\0');
+  }
+
+  void OnClose() override {
+    if (callback_) {
+      std::move(callback_).Run(std::string(), std::string());
+    }
+    NickelAdminAuth::Close(request_id_);
+  }
+
+ private:
+  const std::string request_id_;
+  const std::string user_;
+  // Before the widget, which uses it until it is gone.
+  std::unique_ptr<views::WidgetDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<ActiveSessionAuthView> view_ = nullptr;
+  NickelAdminAuth::Callback callback_;
+  bool asked_ = false;
+};
+
+std::unique_ptr<Prompt>& Current() {
+  static base::NoDestructor<std::unique_ptr<Prompt>> prompt;
+  return *prompt;
+}
+
+}  // namespace
+
+// static
+bool NickelAdminAuth::Ask(const std::string& request_id,
+                          const std::string& message,
+                          const std::vector<std::string>& administrators,
+                          const std::string& error,
+                          Callback callback) {
+  std::unique_ptr<Prompt>& current = Current();
+  if (current && current->request_id() != request_id) {
+    // The agent asks one request at a time and closes each prompt: another
+    // request means the one showing is left over (its agent was restarted).
+    current.reset();
+  }
+  if (!current) {
+    if (administrators.empty()) {
+      return false;
+    }
+    // Whose password: the signed-in user's when they are an administrator,
+    // else the first administrator with an account here (the prompt shows
+    // their picture and says so), else the first one.
+    const user_manager::User* active =
+        user_manager::UserManager::Get()->GetActiveUser();
+    std::string user;
+    const user_manager::User* account = nullptr;
+    for (const std::string& admin : administrators) {
+      const user_manager::User* local = LocalAccountOf(admin);
+      if (local && local == active) {
+        user = admin;
+        account = local;
+        break;
+      }
+      if (local && !account) {
+        user = admin;
+        account = local;
+      }
+    }
+    if (!account) {
+      user = administrators.front();
+      account = active;
+    }
+    if (!account) {
+      return false;
+    }
+    std::u16string description = base::UTF8ToUTF16(message);
+    if (account != active || LocalAccountOf(user) != account) {
+      description += u"\n\n" + l10n_util::GetStringFUTF16(
+                                   IDS_NICKEL_ADMIN_AUTH_OTHER_ADMIN,
+                                   base::UTF8ToUTF16(user));
+    }
+    current = std::make_unique<Prompt>(request_id, user,
+                                       account->GetAccountId(), description);
+  }
+  current->Ask(error, std::move(callback));
+  return true;
+}
+
+// static
+void NickelAdminAuth::Close(const std::string& request_id) {
+  std::unique_ptr<Prompt>& current = Current();
+  if (!current || current->request_id() != request_id) {
+    return;
+  }
+  // Not from inside the view's own call (OnClose): the next task.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, current.release());
+}
+
+}  // namespace ash

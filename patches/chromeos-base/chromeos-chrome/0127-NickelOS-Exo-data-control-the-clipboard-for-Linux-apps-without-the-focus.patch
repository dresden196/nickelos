+  // NickelOS: data control, for Linux apps: the clipboard without the
+  // keyboard focus (nickel_data_control.h).
+  wl_global_create(wl_display_.get(), &ext_data_control_manager_v1_interface,
+                   /*version=*/1, display_, bind_ext_data_control_manager);
+  wl_global_create(wl_display_.get(), &zwlr_data_control_manager_v1_interface,
+                   /*version=*/2, display_, bind_wlr_data_control_manager);
 
   zcr_text_input_extension_data_ =
       std::make_unique<WaylandTextInputExtension>();

+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_EXO_WAYLAND_NICKEL_DATA_CONTROL_H_
+#define COMPONENTS_EXO_WAYLAND_NICKEL_DATA_CONTROL_H_
+
+#include <stdint.h>
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// NickelOS: data control, for Linux apps: ext_data_control_manager_v1
+// (wayland-protocols, staging) and zwlr_data_control_manager_v1 (wlroots'
+// protocol, the same requests and events, for apps that know only that one).
+// A client sets ChromeOS's clipboard without the keyboard focus, and is
+// offered the clipboard whenever it changes, as on KDE and wlroots
+// desktops. Password managers copy that way (1Password's own connection has
+// no window), and so do wl-copy and wl-paste in a terminal. The primary
+// selection isn't part of it here (set_primary_selection is ignored, no
+// primary_selection events): it stays with zwp_primary_selection.h.
+void bind_ext_data_control_manager(wl_client* client,
+                                   void* data,
+                                   uint32_t version,
+                                   uint32_t id);
+void bind_wlr_data_control_manager(wl_client* client,
+                                   void* data,
+                                   uint32_t version,
+                                   uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_NICKEL_DATA_CONTROL_H_

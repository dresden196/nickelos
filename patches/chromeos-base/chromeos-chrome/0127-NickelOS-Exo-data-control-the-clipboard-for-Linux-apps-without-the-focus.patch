@@ -0,0 +1,397 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/nickel_data_control.h"
+
+#include <ext-data-control-v1-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+#include <wlr-data-control-unstable-v1-server-protocol.h>
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/containers/flat_set.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/exo/data_offer.h"
+#include "components/exo/data_offer_delegate.h"
+#include "components/exo/data_source.h"
+#include "components/exo/data_source_delegate.h"
+#include "components/exo/seat.h"
+#include "components/exo/wayland/server_util.h"
+#include "components/exo/wayland/wl_seat.h"
+#include "ui/base/clipboard/clipboard.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/clipboard_monitor.h"
+#include "ui/base/clipboard/clipboard_observer.h"
+#include "ui/base/data_transfer_policy/data_transfer_endpoint.h"
+
+namespace exo::wayland {
+namespace {
+
+// The two protocols' interfaces and events, which are the same but for
+// their names.
+struct ExtDataControl {
+  static constexpr const wl_interface* kSourceInterface =
+      &ext_data_control_source_v1_interface;
+  static constexpr const wl_interface* kDeviceInterface =
+      &ext_data_control_device_v1_interface;
+  static constexpr const wl_interface* kOfferInterface =
+      &ext_data_control_offer_v1_interface;
+  static void SendSourceSend(wl_resource* source,
+                             const char* mime_type,
+                             int fd) {
+    ext_data_control_source_v1_send_send(source, mime_type, fd);
+  }
+  static void SendSourceCancelled(wl_resource* source) {
+    ext_data_control_source_v1_send_cancelled(source);
+  }
+  static void SendDataOffer(wl_resource* device, wl_resource* offer) {
+    ext_data_control_device_v1_send_data_offer(device, offer);
+  }
+  static void SendSelection(wl_resource* device, wl_resource* offer) {
+    ext_data_control_device_v1_send_selection(device, offer);
+  }
+  static void SendOffer(wl_resource* offer, const char* mime_type) {
+    ext_data_control_offer_v1_send_offer(offer, mime_type);
+  }
+};
+
+struct WlrDataControl {
+  static constexpr const wl_interface* kSourceInterface =
+      &zwlr_data_control_source_v1_interface;
+  static constexpr const wl_interface* kDeviceInterface =
+      &zwlr_data_control_device_v1_interface;
+  static constexpr const wl_interface* kOfferInterface =
+      &zwlr_data_control_offer_v1_interface;
+  static void SendSourceSend(wl_resource* source,
+                             const char* mime_type,
+                             int fd) {
+    zwlr_data_control_source_v1_send_send(source, mime_type, fd);
+  }
+  static void SendSourceCancelled(wl_resource* source) {
+    zwlr_data_control_source_v1_send_cancelled(source);
+  }
+  static void SendDataOffer(wl_resource* device, wl_resource* offer) {
+    zwlr_data_control_device_v1_send_data_offer(device, offer);
+  }
+  static void SendSelection(wl_resource* device, wl_resource* offer) {
+    zwlr_data_control_device_v1_send_selection(device, offer);
+  }
+  static void SendOffer(wl_resource* offer, const char* mime_type) {
+    zwlr_data_control_offer_v1_send_offer(offer, mime_type);
+  }
+};
+
+// A data-control source as an Exo DataSource: Seat::SetSelection reads it
+// into ChromeOS's clipboard. Unlike a wl_data_source, it needs no keyboard
+// focus (any surface, or none, may be focused).
+template <typename P>
+class DataControlSourceDelegate : public DataSourceDelegate {
+ public:
+  DataControlSourceDelegate(wl_client* client, wl_resource* resource)
+      : client_(client), resource_(resource) {}
+  DataControlSourceDelegate(const DataControlSourceDelegate&) = delete;
+  DataControlSourceDelegate& operator=(const DataControlSourceDelegate&) =
+      delete;
+
+  // DataSourceDelegate:
+  void OnDataSourceDestroying(DataSource* source) override { delete this; }
+  base::WeakPtr<DataSourceDelegate> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+  void OnTarget(const std::optional<std::string>& mime_type) override {}
+  void OnSend(const std::string& mime_type, base::ScopedFD fd) override {
+    P::SendSourceSend(resource_, mime_type.c_str(), fd.get());
+    wl_client_flush(client_);
+  }
+  void OnCancelled() override {
+    P::SendSourceCancelled(resource_);
+    wl_client_flush(client_);
+  }
+  void OnDndDropPerformed() override {}
+  void OnDndFinished() override {}
+  void OnAction(DndAction dnd_action) override {}
+  bool CanAcceptDataEventsForSurface(Surface* surface) const override {
+    return true;
+  }
+  SecurityDelegate* GetSecurityDelegate() const override {
+    return ::exo::wayland::GetSecurityDelegate(client_);
+  }
+
+ private:
+  ~DataControlSourceDelegate() override = default;
+
+  const raw_ptr<wl_client> client_;
+  const raw_ptr<wl_resource> resource_;
+  base::WeakPtrFactory<DataControlSourceDelegate> weak_factory_{this};
+};
+
+// An offer of what ChromeOS's clipboard held when it was made.
+template <typename P>
+class DataControlOfferDelegate : public DataOfferDelegate {
+ public:
+  DataControlOfferDelegate(wl_client* client, wl_resource* resource)
+      : client_(client), resource_(resource) {}
+  DataControlOfferDelegate(const DataControlOfferDelegate&) = delete;
+  DataControlOfferDelegate& operator=(const DataControlOfferDelegate&) =
+      delete;
+
+  // DataOfferDelegate:
+  void OnDataOfferDestroying(DataOffer* offer) override { delete this; }
+  base::WeakPtr<DataOfferDelegate> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+  void OnOffer(const std::string& mime_type) override {
+    P::SendOffer(resource_, mime_type.c_str());
+  }
+  void OnSourceActions(
+      const base::flat_set<DndAction>& source_actions) override {}
+  void OnAction(DndAction action) override {}
+  SecurityDelegate* GetSecurityDelegate() const override {
+    return ::exo::wayland::GetSecurityDelegate(client_);
+  }
+
+ private:
+  ~DataControlOfferDelegate() override = default;
+
+  const raw_ptr<wl_client> client_;
+  const raw_ptr<wl_resource> resource_;
+  base::WeakPtrFactory<DataControlOfferDelegate> weak_factory_{this};
+};
+
+template <typename P>
+void offer_receive(wl_client* client,
+                   wl_resource* resource,
+                   const char* mime_type,
+                   int32_t fd) {
+  GetUserDataAs<DataOffer>(resource)->Receive(mime_type, base::ScopedFD(fd));
+}
+
+void offer_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_offer_v1_interface kExtOfferImplementation =
+    {offer_receive<ExtDataControl>, offer_destroy};
+constexpr struct zwlr_data_control_offer_v1_interface kWlrOfferImplementation =
+    {offer_receive<WlrDataControl>, offer_destroy};
+
+template <typename P>
+const void* OfferImplementation();
+template <>
+const void* OfferImplementation<ExtDataControl>() {
+  return &kExtOfferImplementation;
+}
+template <>
+const void* OfferImplementation<WlrDataControl>() {
+  return &kWlrOfferImplementation;
+}
+
+// A client's device: sets the clipboard, and is offered it each time it
+// changes (and once when made).
+template <typename P>
+class DataControlDevice : public ui::ClipboardObserver {
+ public:
+  DataControlDevice(wl_resource* resource, Seat* seat)
+      : resource_(resource), seat_(seat->GetWeakPtr()) {
+    ui::ClipboardMonitor::GetInstance()->AddObserver(this);
+    OfferClipboard();
+  }
+  DataControlDevice(const DataControlDevice&) = delete;
+  DataControlDevice& operator=(const DataControlDevice&) = delete;
+  ~DataControlDevice() override {
+    ui::ClipboardMonitor::GetInstance()->RemoveObserver(this);
+  }
+
+  void SetSelection(DataSource* source) {
+    if (!seat_) {
+      if (source) {
+        source->Cancelled();
+      }
+      return;
+    }
+    if (source) {
+      seat_->SetSelection(source);
+      return;
+    }
+    // No source: no selection (a password manager clearing what it copied).
+    ui::Clipboard::GetForCurrentThread()->Clear(
+        ui::ClipboardBuffer::kCopyPaste);
+  }
+
+ private:
+  // ui::ClipboardObserver:
+  void OnClipboardDataChanged() override { OfferClipboard(); }
+
+  void OfferClipboard() {
+    wl_client* client = wl_resource_get_client(resource_);
+    if (!seat_) {
+      P::SendSelection(resource_, nullptr);
+      wl_client_flush(client);
+      return;
+    }
+    wl_resource* offer_resource = wl_resource_create(
+        client, P::kOfferInterface, wl_resource_get_version(resource_), 0);
+    auto offer = std::make_unique<DataOffer>(
+        new DataControlOfferDelegate<P>(client, offer_resource));
+    DataOffer* data_offer = offer.get();
+    SetImplementation(offer_resource, OfferImplementation<P>(),
+                      std::move(offer));
+    // data_offer first, then the offer's types, then selection.
+    P::SendDataOffer(resource_, offer_resource);
+    data_offer->SetClipboardData(seat_->data_exchange_delegate(),
+                                 *ui::Clipboard::GetForCurrentThread(),
+                                 ui::EndpointType::kDefault);
+    P::SendSelection(resource_, offer_resource);
+    wl_client_flush(client);
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  const base::WeakPtr<Seat> seat_;
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// Sources:
+
+void source_offer(wl_client* client,
+                  wl_resource* resource,
+                  const char* mime_type) {
+  GetUserDataAs<DataSource>(resource)->Offer(mime_type);
+}
+
+void source_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_source_v1_interface
+    kExtSourceImplementation = {source_offer, source_destroy};
+constexpr struct zwlr_data_control_source_v1_interface
+    kWlrSourceImplementation = {source_offer, source_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// Devices:
+
+template <typename P>
+void device_set_selection(wl_client* client,
+                          wl_resource* resource,
+                          wl_resource* source_resource) {
+  GetUserDataAs<DataControlDevice<P>>(resource)->SetSelection(
+      source_resource ? GetUserDataAs<DataSource>(source_resource) : nullptr);
+}
+
+void device_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+// The primary selection stays with zwp_primary_selection (see the header).
+void device_set_primary_selection(wl_client* client,
+                                  wl_resource* resource,
+                                  wl_resource* source_resource) {}
+
+constexpr struct ext_data_control_device_v1_interface
+    kExtDeviceImplementation = {device_set_selection<ExtDataControl>,
+                                device_destroy, device_set_primary_selection};
+constexpr struct zwlr_data_control_device_v1_interface
+    kWlrDeviceImplementation = {device_set_selection<WlrDataControl>,
+                                device_destroy, device_set_primary_selection};
+
+////////////////////////////////////////////////////////////////////////////////
+// Managers:
+
+template <typename P>
+void manager_create_data_source(wl_client* client,
+                                wl_resource* resource,
+                                uint32_t id,
+                                const void* implementation) {
+  wl_resource* source_resource = wl_resource_create(
+      client, P::kSourceInterface, wl_resource_get_version(resource), id);
+  SetImplementation(source_resource, implementation,
+                    std::make_unique<DataSource>(
+                        new DataControlSourceDelegate<P>(client,
+                                                         source_resource)));
+}
+
+template <typename P>
+void manager_get_data_device(wl_client* client,
+                             wl_resource* resource,
+                             uint32_t id,
+                             wl_resource* seat_resource,
+                             const void* implementation) {
+  Seat* seat = GetUserDataAs<WaylandSeat>(seat_resource)->seat;
+  wl_resource* device_resource = wl_resource_create(
+      client, P::kDeviceInterface, wl_resource_get_version(resource), id);
+  SetImplementation(device_resource, implementation,
+                    std::make_unique<DataControlDevice<P>>(device_resource,
+                                                           seat));
+}
+
+void ext_manager_create_data_source(wl_client* client,
+                                    wl_resource* resource,
+                                    uint32_t id) {
+  manager_create_data_source<ExtDataControl>(client, resource, id,
+                                             &kExtSourceImplementation);
+}
+
+void ext_manager_get_data_device(wl_client* client,
+                                 wl_resource* resource,
+                                 uint32_t id,
+                                 wl_resource* seat) {
+  manager_get_data_device<ExtDataControl>(client, resource, id, seat,
+                                          &kExtDeviceImplementation);
+}
+
+void wlr_manager_create_data_source(wl_client* client,
+                                    wl_resource* resource,
+                                    uint32_t id) {
+  manager_create_data_source<WlrDataControl>(client, resource, id,
+                                             &kWlrSourceImplementation);
+}
+
+void wlr_manager_get_data_device(wl_client* client,
+                                 wl_resource* resource,
+                                 uint32_t id,
+                                 wl_resource* seat) {
+  manager_get_data_device<WlrDataControl>(client, resource, id, seat,
+                                          &kWlrDeviceImplementation);
+}
+
+void manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_manager_v1_interface
+    kExtManagerImplementation = {ext_manager_create_data_source,
+                                 ext_manager_get_data_device, manager_destroy};
+constexpr struct zwlr_data_control_manager_v1_interface
+    kWlrManagerImplementation = {wlr_manager_create_data_source,
+                                 wlr_manager_get_data_device, manager_destroy};
+
+}  // namespace
+
+void bind_ext_data_control_manager(wl_client* client,
+                                   void* data,
+                                   uint32_t version,
+                                   uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_data_control_manager_v1_interface, version, id);
+  wl_resource_set_implementation(resource, &kExtManagerImplementation, data,
+                                 nullptr);
+}
+
+void bind_wlr_data_control_manager(wl_client* client,
+                                   void* data,
+                                   uint32_t version,
+                                   uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &zwlr_data_control_manager_v1_interface, version, id);
+  wl_resource_set_implementation(resource, &kWlrManagerImplementation, data,
+                                 nullptr);
+}
+
+}  // namespace exo::wayland

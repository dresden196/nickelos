@@ -0,0 +1,99 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/apps/app_service/publishers/nickel_host_apps.h"
+
+#include <utility>
+
+#include "ash/public/cpp/app_menu_constants.h"
+#include "ash/strings/grit/ash_strings.h"
+#include "chrome/browser/apps/app_service/app_service_proxy.h"
+#include "chrome/browser/apps/app_service/menu_util.h"
+#include "chrome/browser/ash/crostini/crostini_util.h"
+#include "chrome/grit/chrome_unscaled_resources.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/services/app_service/public/cpp/intent.h"
+#include "ui/display/types/display_constants.h"
+
+namespace apps {
+
+NickelHostApps::NickelHostApps(AppServiceProxy* proxy) : GuestOSApps(proxy) {}
+
+NickelHostApps::~NickelHostApps() = default;
+
+bool NickelHostApps::CouldBeAllowed() const {
+  return crostini::IsNickelNativeAppsAllowed(profile());
+}
+
+apps::AppType NickelHostApps::AppType() const {
+  return AppType::kNickelHost;
+}
+
+guest_os::VmType NickelHostApps::VmType() const {
+  return guest_os::VmType::NICKEL_HOST;
+}
+
+int NickelHostApps::DefaultIconResourceId() const {
+  return IDR_LOGO_CROSTINI_DEFAULT;
+}
+
+// Host apps are still registered under VM "nickel" (the name only feeds
+// their app ids), which crostini::LaunchCrostiniApp hands to nickel-appd
+// before any Crostini step.
+void NickelHostApps::Launch(const std::string& app_id,
+                            int32_t event_flags,
+                            LaunchSource launch_source,
+                            WindowInfoPtr window_info) {
+  crostini::LaunchCrostiniApp(
+      profile(), app_id,
+      window_info ? window_info->display_id : display::kInvalidDisplayId);
+}
+
+void NickelHostApps::LaunchAppWithIntent(const std::string& app_id,
+                                         int32_t event_flags,
+                                         IntentPtr intent,
+                                         LaunchSource launch_source,
+                                         WindowInfoPtr window_info,
+                                         LaunchCallback callback) {
+  auto args = ArgsFromIntent(intent.get());
+  crostini::LaunchCrostiniAppWithIntent(
+      profile(), app_id,
+      window_info ? window_info->display_id : display::kInvalidDisplayId,
+      std::move(intent), std::move(args),
+      base::BindOnce([](bool success, const std::string& failure_reason) {
+        LOG_IF(ERROR, !success) << "NickelOS app launch error: "
+                                << failure_reason;
+        return success ? LaunchResult::kSuccess : LaunchResult::kFailed;
+      }).Then(std::move(callback)));
+}
+
+void NickelHostApps::GetMenuModel(
+    const std::string& app_id,
+    MenuType menu_type,
+    int64_t display_id,
+    base::OnceCallback<void(MenuItems)> callback) {
+  MenuItems menu_items;
+  if (menu_type == MenuType::kShelf) {
+    AddCommandItem(ash::APP_CONTEXT_MENU_NEW_WINDOW, IDS_APP_LIST_NEW_WINDOW,
+                   menu_items);
+  }
+  if (ShouldAddOpenItem(app_id, menu_type, profile())) {
+    AddCommandItem(ash::LAUNCH_NEW, IDS_APP_CONTEXT_MENU_ACTIVATE_ARC,
+                   menu_items);
+  }
+  if (ShouldAddCloseItem(app_id, menu_type, profile())) {
+    AddCommandItem(ash::MENU_CLOSE, IDS_SHELF_CONTEXT_MENU_CLOSE, menu_items);
+  }
+  std::move(callback).Run(std::move(menu_items));
+}
+
+void NickelHostApps::CreateAppOverrides(
+    const guest_os::GuestOsRegistryService::Registration& registration,
+    App* app) {
+  // App Management and uninstalling come with nickel-appd's uninstall
+  // support (docs/host-apps.md, step 3).
+  app->show_in_management = false;
+}
+
+}  // namespace apps

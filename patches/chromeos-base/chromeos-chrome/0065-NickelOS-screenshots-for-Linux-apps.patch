+// One screenshot (NickelScreenCast::Shot). It owns itself until it answers.
+class OneShot {
+ public:
+  OneShot(aura::Window* window,
+          uint8_t* frame,
+          size_t frame_size,
+          int width,
+          int height,
+          NickelScreenCast::ShotCallback callback)
+      : frame_(frame),
+        frame_size_(frame_size),
+        width_(width),
+        height_(height),
+        callback_(std::move(callback)) {
+    window_.Add(window);
+  }
+
+  OneShot(const OneShot&) = delete;
+  OneShot& operator=(const OneShot&) = delete;
+
+  ~OneShot() { munmap(frame_, frame_size_); }
+
+  // Copies the source once its screen is still.
+  static void Take(std::unique_ptr<OneShot> shot) {
+    if (shot->window_.windows().empty()) {
+      // The source went away.
+      std::move(shot->callback_).Run(false);
+      return;
+    }
+    aura::Window* window = shot->window_.windows().front();
+    if (Animating(window->GetRootWindow()->layer()) &&
+        ++shot->tries_ < kShotSettleTries) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, base::BindOnce(&OneShot::Take, std::move(shot)),
+          kShotSettleInterval);
+      return;
+    }
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(&OneShot::OnCaptured, std::move(shot)));
+    request->set_result_task_runner(
+        base::SequencedTaskRunner::GetCurrentDefault());
+    window->layer()->RequestCopyOfOutput(std::move(request));
+  }
+
+ private:
+  static void OnCaptured(std::unique_ptr<OneShot> shot,
+                         std::unique_ptr<viz::CopyOutputResult> result) {
+    if (result->IsEmpty()) {
+      std::move(shot->callback_).Run(false);
+      return;
+    }
+    auto scoped_bitmap = result->ScopedAccessSkBitmap();
+    const SkBitmap& bitmap = scoped_bitmap.bitmap();
+    if (bitmap.drawsNothing()) {
+      std::move(shot->callback_).Run(false);
+      return;
+    }
+    CopyFrame(bitmap, shot->frame_, shot->width_, shot->height_);
+    std::move(shot->callback_).Run(true);
+  }
+
+  aura::WindowTracker window_;
+  uint8_t* const frame_;
+  const size_t frame_size_;
+  const int width_;
+  const int height_;
+  int tries_ = 0;
+  NickelScreenCast::ShotCallback callback_;
+};
+
 void OnChosen(std::unique_ptr<DesktopMediaPicker> picker,

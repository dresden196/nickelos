+// static
+void NickelScreenCast::Shot(const std::string& source_id,
+                            base::ScopedFD frame,
+                            int width,
+                            int height,
+                            ShotCallback callback) {
+  gfx::Size size;
+  aura::Window* window =
+      SourceWindow(content::DesktopMediaID::Parse(source_id), &size);
+  if (!window || width <= 0 || height <= 0 || width > kMaxShotSide ||
+      height > kMaxShotSide) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // Writing past the end of a smaller buffer would crash Chrome.
+  const size_t frame_size = static_cast<size_t>(width) * height * 4;
+  struct stat frame_stat;
+  if (fstat(frame.get(), &frame_stat) < 0 ||
+      static_cast<size_t>(frame_stat.st_size) < frame_size) {
+    std::move(callback).Run(false);
+    return;
+  }
+  void* memory = mmap(nullptr, frame_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                      frame.get(), 0);
+  if (memory == MAP_FAILED) {
+    PLOG(ERROR) << "NickelOS screenshot: cannot map the frame buffer";
+    std::move(callback).Run(false);
+    return;
+  }
+  OneShot::Take(std::make_unique<OneShot>(window, static_cast<uint8_t*>(memory),
+                                          frame_size, width, height,
+                                          std::move(callback)));
+}
+
 }  // namespace ash

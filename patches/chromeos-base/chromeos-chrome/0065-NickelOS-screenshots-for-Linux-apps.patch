+// Copies |bitmap| into |frame| (|width| x |height|, BGRx). A window that
+// changed size meanwhile is cut to the frame's size, or padded with black.
+void CopyFrame(const SkBitmap& bitmap, uint8_t* frame, int width, int height) {
+  const int rows = std::min(height, bitmap.height());
+  const int columns = std::min(width, bitmap.width());
+  if (rows < height || columns < width) {
+    memset(frame, 0, static_cast<size_t>(width) * height * 4);
+  }
+  for (int y = 0; y < rows; ++y) {
+    memcpy(frame + static_cast<size_t>(y) * width * 4, bitmap.getAddr32(0, y),
+           static_cast<size_t>(columns) * 4);
+  }
+}
+
+// Whether |layer| or anything in it is animating: a window or a dialog
+// fading in or out, the dimming behind a dialog.
+bool Animating(ui::Layer* layer) {
+  if (layer->GetAnimator()->is_animating()) {
+    return true;
+  }
+  for (ui::Layer* child : layer->children()) {
+    if (Animating(child)) {
+      return true;
+    }
+  }
+  return false;
+}

 constexpr base::TimeDelta kFrameInterval = base::Milliseconds(33);
+// A screenshot waits for the screen to be still, checking this often, but
+// not past kShotSettleTries (a second): something may move for good.
+constexpr base::TimeDelta kShotSettleInterval = base::Milliseconds(50);
+constexpr int kShotSettleTries = 20;
+// The largest screenshot side, so its size fits in a size_t.
+constexpr int kMaxShotSide = 16384;
 

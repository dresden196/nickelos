+// Email: the app mail links open with. A Linux mail app (one whose desktop
+// file takes x-scheme-handler/mailto) or a mail website registered with the
+// browser (navigator.registerProtocolHandler, Settings' protocol handlers);
+// the choice reaches the browser's mail links (the registry's default, or
+// prefs::kNickelMailApp for GuestOsRegistryService::GetHandler) and Linux
+// apps' (nickel-appd's SetDefaultHandler: nickelos-mimeapps.list).
+constexpr char kEmailKind[] = "email";
+constexpr char kMailScheme[] = "mailto";
+constexpr char kLinuxPrefix[] = "linux:";
+constexpr char kSitePrefix[] = "site:";
+
+base::DictValue EmailKind(Profile* profile) {
+  base::ListValue apps;
+  std::string default_id;
+  if (custom_handlers::ProtocolHandlerRegistry* handlers =
+          ProtocolHandlerRegistryFactory::GetForBrowserContext(profile)) {
+    for (const custom_handlers::ProtocolHandler& handler :
+         handlers->GetHandlersFor(kMailScheme)) {
+      apps.Append(base::DictValue()
+                      .Set("taskId", kSitePrefix + handler.url().spec())
+                      .Set("title", l10n_util::GetStringFUTF16(
+                                        IDS_SETTINGS_NICKEL_DEFAULT_APPS_WEBSITE,
+                                        base::UTF8ToUTF16(handler.url().host()))));
+    }
+    if (handlers->IsHandledProtocol(kMailScheme)) {
+      default_id =
+          kSitePrefix + handlers->GetHandlerFor(kMailScheme).url().spec();
+    }
+  }
+  const std::string chosen =
+      profile->GetPrefs()->GetString(ash::prefs::kNickelMailApp);
+  if (auto* registry =
+          guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile)) {
+    std::vector<std::pair<std::string, std::string>> found;  // Name, id.
+    for (const auto& [app_id, app] :
+         registry->GetRegisteredApps(guest_os::VmType::NICKEL_HOST)) {
+      if (!app.NoDisplay() &&
+          app.MimeTypes().contains("x-scheme-handler/mailto")) {
+        found.emplace_back(app.Name(), app.DesktopFileId());
+      }
+    }
+    std::sort(found.begin(), found.end());
+    for (const auto& [name, desktop_file_id] : found) {
+      apps.Append(base::DictValue()
+                      .Set("taskId", kLinuxPrefix + desktop_file_id)
+                      .Set("title", name));
+      if (default_id.empty() && desktop_file_id == chosen) {
+        default_id = kLinuxPrefix + desktop_file_id;
+      }
+    }
+  }
+  return base::DictValue()
+      .Set("id", kEmailKind)
+      .Set("apps", std::move(apps))
+      .Set("defaultTaskId", default_id);
+}
+
+// Tells nickel-appd which desktop file Linux apps' mail links go to ("":
+// ChromeOS, which opens the website chosen).
+void SetLinuxMailApp(const std::string& desktop_file_id) {
+  dbus::MethodCall method_call("org.nickelos.Apps", "SetDefaultHandler");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString("x-scheme-handler/mailto");
+  writer.AppendString(desktop_file_id);
+  ash::DBusThreadManager::Get()
+      ->GetSystemBus()
+      ->GetObjectProxy("org.nickelos.Apps", dbus::ObjectPath("/org/nickelos/Apps"))
+      ->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                   base::DoNothing());
+}

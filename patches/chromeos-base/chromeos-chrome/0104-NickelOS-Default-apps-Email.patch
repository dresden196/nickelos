+// NickelOS: a mail link a page gives an app loses its attachments (attach=,
+// attachment=): Evolution, KMail and Geary attach local files a page names.
+GURL WithoutAttachments(const GURL& url) {
+  if (!url.SchemeIs(url::kMailToScheme) || !url.has_query()) {
+    return url;
+  }
+  std::vector<std::string> kept;
+  for (const std::string& part : base::SplitString(
+           url.query(), "&", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    const std::string key =
+        base::ToLowerASCII(part.substr(0, part.find('=')));
+    if (key != "attach" && key != "attachment") {
+      kept.push_back(part);
+    }
+  }
+  const std::string query = base::JoinString(kept, "&");
+  GURL::Replacements replacements;
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}

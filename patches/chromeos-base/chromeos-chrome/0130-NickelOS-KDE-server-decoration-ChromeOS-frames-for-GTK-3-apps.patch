diff --git a/components/exo/wayland/nickel_server_decoration.cc b/components/exo/wayland/nickel_server_decoration.cc
new file mode 100644
index 0000000..063490e
--- /dev/null
+++ b/components/exo/wayland/nickel_server_decoration.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/nickel_server_decoration.h"
+
+#include <server-decoration-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "components/exo/surface.h"
+#include "components/exo/surface_observer.h"
+#include "components/exo/wayland/server_util.h"
+
+namespace exo::wayland {
+namespace {
+
+constexpr uint32_t kDefaultMode = ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER;
+
+// The decoration of one wl_surface: the frame of its shell surface (an
+// xdg_toplevel's; popups keep theirs, see ShellSurfaceBase::OnSetFrame).
+// The client asks for a mode before its toplevel's first commit, as Exo's
+// frames need.
+class ServerDecoration : public SurfaceObserver {
+ public:
+  ServerDecoration(wl_resource* resource, Surface* surface)
+      : resource_(resource), surface_(surface) {
+    surface_->AddSurfaceObserver(this);
+  }
+
+  ServerDecoration(const ServerDecoration&) = delete;
+  ServerDecoration& operator=(const ServerDecoration&) = delete;
+
+  ~ServerDecoration() override {
+    if (surface_) {
+      surface_->RemoveSurfaceObserver(this);
+    }
+  }
+
+  void SetMode(uint32_t mode) {
+    // The protocol has no error for an unknown mode: the default.
+    if (mode > ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER) {
+      mode = kDefaultMode;
+    }
+    if (surface_) {
+      surface_->SetFrame(mode == ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER
+                             ? SurfaceFrameType::NORMAL
+                             : SurfaceFrameType::NONE);
+    }
+    org_kde_kwin_server_decoration_send_mode(resource_, mode);
+  }
+
+  // SurfaceObserver:
+  void OnSurfaceDestroying(Surface* surface) override {
+    surface->RemoveSurfaceObserver(this);
+    surface_ = nullptr;
+  }
+
+ private:
+  const raw_ptr<wl_resource> resource_;
+  raw_ptr<Surface> surface_;
+};
+
+void server_decoration_release(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void server_decoration_request_mode(wl_client* client,
+                                    wl_resource* resource,
+                                    uint32_t mode) {
+  GetUserDataAs<ServerDecoration>(resource)->SetMode(mode);
+}
+
+const struct org_kde_kwin_server_decoration_interface
+    server_decoration_implementation = {
+        .release = server_decoration_release,
+        .request_mode = server_decoration_request_mode,
+};
+
+void server_decoration_manager_create(wl_client* client,
+                                      wl_resource* resource,
+                                      uint32_t id,
+                                      wl_resource* surface_resource) {
+  wl_resource* decoration_resource =
+      wl_resource_create(client, &org_kde_kwin_server_decoration_interface,
+                         wl_resource_get_version(resource), id);
+  if (!decoration_resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  auto decoration = std::make_unique<ServerDecoration>(
+      decoration_resource, GetUserDataAs<Surface>(surface_resource));
+  ServerDecoration* decoration_ptr = decoration.get();
+  SetImplementation(decoration_resource, &server_decoration_implementation,
+                    std::move(decoration));
+  // As KWin: a new decoration is in the default mode until the client asks
+  // for another.
+  decoration_ptr->SetMode(kDefaultMode);
+}
+
+const struct org_kde_kwin_server_decoration_manager_interface
+    server_decoration_manager_implementation = {
+        .create = server_decoration_manager_create,
+};
+
+}  // namespace
+
+void bind_server_decoration_manager(wl_client* client,
+                                    void* data,
+                                    uint32_t version,
+                                    uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &org_kde_kwin_server_decoration_manager_interface, version, id);
+  if (!resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  wl_resource_set_implementation(
+      resource, &server_decoration_manager_implementation, data, nullptr);
+  org_kde_kwin_server_decoration_manager_send_default_mode(resource,
+                                                           kDefaultMode);
+}
+
+}  // namespace exo::wayland
diff --git a/components/exo/wayland/nickel_server_decoration.h b/components/exo/wayland/nickel_server_decoration.h
new file mode 100644
index 0000000..3d41d0e
--- /dev/null
+++ b/components/exo/wayland/nickel_server_decoration.h
@@ -0,0 +1,29 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_EXO_WAYLAND_NICKEL_SERVER_DECORATION_H_
+#define COMPONENTS_EXO_WAYLAND_NICKEL_SERVER_DECORATION_H_
+
+#include <stdint.h>
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// NickelOS: KDE's server decoration protocol
+// (org_kde_kwin_server_decoration_manager), for Linux apps. GTK 3 asks for
+// the compositor's window frame only through this protocol (never through
+// xdg-decoration), so without it every GTK 3 window drew its own GTK title
+// bar instead of ChromeOS's frame. As KWin does, the default mode is the
+// server's: a window gets ChromeOS's frame unless the client asks to draw
+// its own (GTK 3 windows with their own header bar do, and so does Firefox
+// with its tabs in the title bar).
+void bind_server_decoration_manager(wl_client* client,
+                                    void* data,
+                                    uint32_t version,
+                                    uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_NICKEL_SERVER_DECORATION_H_

+            $i18n{nickelDefaultAppsNotSet}
+          </option>
+          <template is="dom-repeat" items="[[kind.apps]]" as="app">
+            <option value="[[app.taskId]]"
+                selected$="[[isDefault_(app, kind)]]">[[app.title]]</option>
+          </template>
+        </select>
+      </template>
+      <template is="dom-if" if="[[!hasApps_(kind)]]" restamp>
+        <div class="secondary">$i18n{nickelDefaultAppsNone}</div>
+      </template>
+    </div>
+  </template>
+</settings-card>

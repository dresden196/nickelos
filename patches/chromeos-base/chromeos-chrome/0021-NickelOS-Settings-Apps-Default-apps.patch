+<style include="settings-shared md-select"></style>
+<settings-card header-text="$i18n{nickelDefaultAppsTitle}">
+  <div class="settings-box first">
+    <div class="secondary">$i18n{nickelDefaultAppsDescription}</div>
+  </div>
+  <template is="dom-repeat" items="[[kinds_]]" as="kind">
+    <div class="settings-box">
+      <div class="start">[[kindName_(kind.id)]]</div>
+      <template is="dom-if" if="[[hasApps_(kind)]]" restamp>
+        <select class="md-select" data-kind$="[[kind.id]]"

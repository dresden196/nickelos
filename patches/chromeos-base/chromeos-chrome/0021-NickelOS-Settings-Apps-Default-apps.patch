diff --git a/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_default_apps_handler.cc b/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_default_apps_handler.cc
new file mode 100644
index 0000000000000..5435d02127ed5
--- /dev/null
+++ b/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_default_apps_handler.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/apps/nickel_default_apps_handler.h"
+
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_split.h"
+#include "chrome/browser/ash/file_manager/file_tasks.h"
+#include "chrome/browser/ash/file_manager/fileapi_util.h"
+#include "chrome/browser/ash/file_manager/path_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_ui.h"
+#include "extensions/browser/entry_info.h"
+#include "url/gurl.h"
+
+namespace ash::settings {
+
+namespace {
+
+// A kind of file: the sample its apps are looked up for, and the types its
+// default is set for.
+struct Kind {
+  const char* id;
+  const char* sample_suffix;
+  const char* sample_mime_type;
+  const char* suffixes;    // Space-separated.
+  const char* mime_types;  // Space-separated.
+};
+
+constexpr Kind kKinds[] = {
+    {"images", ".png", "image/png",
+     ".png .jpg .jpeg .gif .webp .bmp .avif .heic .svg .tif .tiff",
+     "image/png image/jpeg image/gif image/webp image/bmp image/avif "
+     "image/heic image/svg+xml image/tiff"},
+    {"videos", ".mp4", "video/mp4", ".mp4 .webm .mkv .mov .m4v .avi .ogv",
+     "video/mp4 video/webm video/x-matroska video/quicktime video/x-m4v "
+     "video/x-msvideo video/ogg"},
+    {"music", ".mp3", "audio/mpeg",
+     ".mp3 .ogg .oga .opus .flac .wav .m4a .aac",
+     "audio/mpeg audio/ogg audio/opus audio/flac audio/wav audio/x-wav "
+     "audio/mp4 audio/aac"},
+    {"pdf", ".pdf", "application/pdf", ".pdf", "application/pdf"},
+    {"text", ".txt", "text/plain", ".txt .md .log", "text/plain text/markdown"},
+};
+
+std::set<std::string> SplitSet(const char* list) {
+  std::vector<std::string> items = base::SplitString(
+      list, " ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  return std::set<std::string>(items.begin(), items.end());
+}
+
+}  // namespace
+
+NickelDefaultAppsHandler::NickelDefaultAppsHandler(Profile* profile)
+    : profile_(profile) {}
+
+NickelDefaultAppsHandler::~NickelDefaultAppsHandler() = default;
+
+void NickelDefaultAppsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getNickelDefaultApps",
+      base::BindRepeating(&NickelDefaultAppsHandler::HandleGetDefaultApps,
+                          weak_ptr_factory_.GetWeakPtr()));
+  web_ui()->RegisterMessageCallback(
+      "setNickelDefaultApp",
+      base::BindRepeating(&NickelDefaultAppsHandler::HandleSetDefaultApp,
+                          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void NickelDefaultAppsHandler::HandleGetDefaultApps(
+    const base::ListValue& args) {
+  AllowJavascript();
+  FindApps(args[0].GetString(), base::ListValue(), 0);
+}
+
+void NickelDefaultAppsHandler::FindApps(std::string callback_id,
+                                        base::ListValue categories,
+                                        size_t index) {
+  if (index == std::size(kKinds)) {
+    ResolveJavascriptCallback(base::Value(callback_id),
+                              base::Value(std::move(categories)));
+    return;
+  }
+  // A file of this kind in Downloads (it need not exist): the apps are
+  // matched on its type and extension, as for a real file in Files.
+  const Kind& kind = kKinds[index];
+  const base::FilePath path =
+      file_manager::util::GetDownloadsFolderForProfile(profile_).Append(
+          std::string("sample") + kind.sample_suffix);
+  GURL url;
+  if (!file_manager::util::ConvertAbsoluteFilePathToFileSystemUrl(
+          profile_, path, file_manager::util::GetFileManagerURL(), &url)) {
+    OnAppsFound(std::move(callback_id), std::move(categories), index, nullptr);
+    return;
+  }
+  file_manager::file_tasks::FindAllTypesOfTasks(
+      profile_, {extensions::EntryInfo(path, kind.sample_mime_type, false)},
+      {url}, {std::string()},
+      base::BindOnce(&NickelDefaultAppsHandler::OnAppsFound,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback_id),
+                     std::move(categories), index));
+}
+
+void NickelDefaultAppsHandler::OnAppsFound(
+    std::string callback_id,
+    base::ListValue categories,
+    size_t index,
+    std::unique_ptr<file_manager::file_tasks::ResultingTasks> tasks) {
+  base::ListValue apps;
+  std::string default_task_id;
+  if (tasks) {
+    for (const auto& task : tasks->tasks) {
+      // Apps that open any file, and virtual tasks, are not defaults.
+      if (task.is_generic_file_handler || task.is_dlp_blocked ||
+          task.task_title.empty()) {
+        continue;
+      }
+      const std::string task_id =
+          file_manager::file_tasks::TaskDescriptorToId(task.task_descriptor);
+      apps.Append(base::DictValue()
+                      .Set("taskId", task_id)
+                      .Set("title", task.task_title));
+      if (task.is_default) {
+        default_task_id = task_id;
+      }
+    }
+  }
+  categories.Append(base::DictValue()
+                        .Set("id", kKinds[index].id)
+                        .Set("apps", std::move(apps))
+                        .Set("defaultTaskId", default_task_id));
+  FindApps(std::move(callback_id), std::move(categories), index + 1);
+}
+
+void NickelDefaultAppsHandler::HandleSetDefaultApp(
+    const base::ListValue& args) {
+  AllowJavascript();
+  const base::Value& callback_id = args[0];
+  const std::string& kind_id = args[1].GetString();
+  std::optional<file_manager::file_tasks::TaskDescriptor> task =
+      file_manager::file_tasks::ParseTaskID(args[2].GetString());
+  for (const Kind& kind : kKinds) {
+    if (kind_id == kind.id && task) {
+      file_manager::file_tasks::UpdateDefaultTask(
+          profile_, *task, SplitSet(kind.suffixes), SplitSet(kind.mime_types));
+      ResolveJavascriptCallback(callback_id, base::Value(true));
+      return;
+    }
+  }
+  ResolveJavascriptCallback(callback_id, base::Value(false));
+}
+
+}  // namespace ash::settings

+/**
+ * @fileoverview NickelOS: the Default apps card on the Apps page. For each
+ * kind of file, the app Files and Linux apps open it with, chosen from the
+ * apps that can (NickelDefaultAppsHandler).
+ */
+
+import 'chrome://resources/ash/common/cr_elements/md_select.css.js';
+import '../os_settings_page/settings_card.js';
+import '../settings_shared.css.js';
+
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_default_apps.html.js';
+
+interface DefaultAppChoice {
+  taskId: string;
+  title: string;
+}
+
+interface DefaultAppKind {
+  id: string;
+  apps: DefaultAppChoice[];
+  defaultTaskId: string;
+}
+
+// The name shown for each kind of file.
+const KIND_NAMES: Record<string, string> = {
+  images: 'nickelDefaultAppsImages',
+  videos: 'nickelDefaultAppsVideos',
+  music: 'nickelDefaultAppsMusic',
+  pdf: 'nickelDefaultAppsPdf',
+  text: 'nickelDefaultAppsText',
+};
+
+const NickelDefaultAppsElementBase = I18nMixin(PolymerElement);
+
+export class NickelDefaultAppsElement extends NickelDefaultAppsElementBase {
+  static get is() {
+    return 'nickel-default-apps' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      kinds_: {
+        type: Array,
+        value: () => [],
+      },
+    };
+  }
+
+  declare private kinds_: DefaultAppKind[];
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.refresh_();
+  }
+
+  private async refresh_(): Promise<void> {
+    this.kinds_ = await sendWithPromise('getNickelDefaultApps');
+  }
+
+  private kindName_(id: string): string {
+    return this.i18n(KIND_NAMES[id] || 'nickelDefaultAppsTitle');
+  }
+
+  private hasApps_(kind: DefaultAppKind): boolean {
+    return kind.apps.length > 0;
+  }
+
+  private hasDefault_(kind: DefaultAppKind): boolean {
+    return !!kind.defaultTaskId;
+  }
+
+  private isDefault_(app: DefaultAppChoice, kind: DefaultAppKind): boolean {
+    return app.taskId === kind.defaultTaskId;
+  }
+
+  private async onChange_(e: Event): Promise<void> {
+    const select = e.target as HTMLSelectElement;
+    const kindId = select.dataset['kind'];
+    if (!kindId || !select.value) {
+      return;
+    }
+    await sendWithPromise('setNickelDefaultApp', kindId, select.value);
+    await this.refresh_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelDefaultAppsElement.is]: NickelDefaultAppsElement;
+  }
+}
+
+customElements.define(NickelDefaultAppsElement.is, NickelDefaultAppsElement);

+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_DEFAULT_APPS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_DEFAULT_APPS_HANDLER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class Profile;
+
+namespace file_manager::file_tasks {
+struct ResultingTasks;
+}  // namespace file_manager::file_tasks
+
+namespace ash::settings {
+
+// NickelOS: Settings > Apps > Default apps. For each kind of file (images,
+// videos, music, PDF, text), the apps that can open it (ChromeOS's own, web
+// apps, Linux apps) and the one it opens with. Choosing one makes it Files'
+// default for that kind, the default Files' "Change default" sets; Linux apps
+// open files through ChromeOS (nickel-open), so it applies to them too.
+class NickelDefaultAppsHandler : public content::WebUIMessageHandler {
+ public:
+  explicit NickelDefaultAppsHandler(Profile* profile);
+  NickelDefaultAppsHandler(const NickelDefaultAppsHandler&) = delete;
+  NickelDefaultAppsHandler& operator=(const NickelDefaultAppsHandler&) =
+      delete;
+  ~NickelDefaultAppsHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  // getNickelDefaultApps() -> [{id, apps: [{taskId, title}], defaultTaskId}]
+  void HandleGetDefaultApps(const base::ListValue& args);
+  // setNickelDefaultApp(categoryId, taskId) -> bool
+  void HandleSetDefaultApp(const base::ListValue& args);
+
+  // Finds the apps for the kinds of files from |index| on, one at a time.
+  void FindApps(std::string callback_id,
+                base::ListValue categories,
+                size_t index);
+  void OnAppsFound(
+      std::string callback_id,
+      base::ListValue categories,
+      size_t index,
+      std::unique_ptr<file_manager::file_tasks::ResultingTasks> tasks);
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<NickelDefaultAppsHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace ash::settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_DEFAULT_APPS_HANDLER_H_

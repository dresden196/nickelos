+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_CREATION_SCREEN_H_
+#define CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_CREATION_SCREEN_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ash/login/screens/base_screen.h"
+#include "chromeos/ash/components/login/auth/auth_status_consumer.h"
+
+namespace dbus {
+class ErrorResponse;
+class Response;
+}  // namespace dbus
+
+namespace ash {
+
+class LocalAccountCreationView;
+
+// NickelOS: creates a local account and signs into it. A local account is a
+// Linux user (created by nickel-accountsd) with an encrypted home protected
+// by its password, and no Google account. Shown instead of Google sign-in in
+// setup and for "Add person".
+class LocalAccountCreationScreen : public BaseScreen,
+                                   public AuthStatusConsumer {
+ public:
+  using TView = LocalAccountCreationView;
+
+  enum class Result {
+    BACK,
+  };
+
+  static std::string GetResultString(Result result);
+
+  using ScreenExitCallback = base::RepeatingCallback<void(Result result)>;
+
+  LocalAccountCreationScreen(base::WeakPtr<LocalAccountCreationView> view,
+                             const ScreenExitCallback& exit_callback);
+  LocalAccountCreationScreen(const LocalAccountCreationScreen&) = delete;
+  LocalAccountCreationScreen& operator=(const LocalAccountCreationScreen&) =
+      delete;
+  ~LocalAccountCreationScreen() override;
+
+  // AuthStatusConsumer:
+  void OnAuthFailure(const AuthFailure& error) override;
+  void OnAuthSuccess(const UserContext& user_context) override;
+
+ private:
+  // BaseScreen:
+  void ShowImpl() override;
+  void HideImpl() override;
+  void OnUserAction(const base::ListValue& args) override;
+
+  void HandleCreate(const std::string& display_name,
+                    const std::string& username,
+                    const std::string& password);
+  void OnUserCreated(const std::string& username,
+                     const std::string& password,
+                     dbus::Response* response,
+                     dbus::ErrorResponse* error);
+  void ShowError(const std::string& message);
+  void StopObservingLogin();
+
+  base::WeakPtr<LocalAccountCreationView> view_;
+  ScreenExitCallback exit_callback_;
+
+  // The Linux user this screen created; removed again if signing in fails.
+  std::string pending_username_;
+  bool observing_login_ = false;
+
+  base::WeakPtrFactory<LocalAccountCreationScreen> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_CREATION_SCREEN_H_

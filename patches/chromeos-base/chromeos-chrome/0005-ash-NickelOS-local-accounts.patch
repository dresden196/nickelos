+++ b/chrome/browser/resources/chromeos/login/screens/login/local_account_creation.ts
@@ -0,0 +1,168 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: create a local account (a Linux user with an
+ * encrypted home and no Google account).
+ */
+
+import '//resources/ash/common/cr_elements/cros_color_overrides.css.js';
+import '//resources/ash/common/cr_elements/cr_shared_style.css.js';
+import '//resources/ash/common/cr_elements/cr_input/cr_input.js';
+import '//resources/polymer/v3_0/iron-icon/iron-icon.js';
+import '../../components/oobe_icons.html.js';
+import '../../components/common_styles/oobe_common_styles.css.js';
+import '../../components/common_styles/oobe_dialog_host_styles.css.js';
+import '../../components/dialogs/oobe_adaptive_dialog.js';
+import '../../components/dialogs/oobe_loading_dialog.js';
+import '../../components/buttons/oobe_next_button.js';
+import '../../components/buttons/oobe_back_button.js';
+
+import type {PolymerElementProperties} from '//resources/polymer/v3_0/polymer/interfaces.js';
+import {PolymerElement} from '//resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {OobeUiState} from '../../components/display_manager_types.js';
+import {LoginScreenMixin} from '../../components/mixins/login_screen_mixin.js';
+import {MultiStepMixin} from '../../components/mixins/multi_step_mixin.js';
+import {OobeDialogHostMixin} from '../../components/mixins/oobe_dialog_host_mixin.js';
+import {OobeI18nMixin} from '../../components/mixins/oobe_i18n_mixin.js';
+
+import {getTemplate} from './local_account_creation.html.js';
+
+enum LocalAccountCreationStep {
+  FORM = 'form',
+  PROGRESS = 'progress',
+}
+
+// Same rule as nickel-accountsd.
+const USERNAME_PATTERN = /^[a-z_][a-z0-9_-]{0,31}$/;
+
+const LocalAccountCreationBase = OobeDialogHostMixin(
+    LoginScreenMixin(MultiStepMixin(OobeI18nMixin(PolymerElement))));
+
+export class LocalAccountCreation extends LocalAccountCreationBase {
+  static get is() {
+    return 'local-account-creation-element' as const;
+  }
+
+  static get template(): HTMLTemplateElement {
+    return getTemplate();
+  }
+
+  static get properties(): PolymerElementProperties {
+    return {
+      displayName: {type: String, value: ''},
+      username: {type: String, value: ''},
+      password: {type: String, value: ''},
+      confirm: {type: String, value: ''},
+      errorMessage: {type: String, value: ''},
+      usernameEdited: {type: Boolean, value: false},
+    };
+  }
+
+  declare private displayName: string;
+  declare private username: string;
+  declare private password: string;
+  declare private confirm: string;
+  declare private errorMessage: string;
+  declare private usernameEdited: boolean;
+
+  override get EXTERNAL_API(): string[] {
+    return ['showError'];
+  }
+
+  // eslint-disable-next-line @typescript-eslint/naming-convention
+  override defaultUIStep(): LocalAccountCreationStep {
+    return LocalAccountCreationStep.FORM;
+  }
+
+  override get UI_STEPS() {
+    return LocalAccountCreationStep;
+  }
+
+  override ready(): void {
+    super.ready();
+    this.initializeLoginScreen('LocalAccountCreationScreen');
+  }
+
+  // eslint-disable-next-line @typescript-eslint/naming-convention
+  override getOobeUIInitialState(): OobeUiState {
+    return OobeUiState.USER_CREATION;
+  }
+
+  override onBeforeShow(data: any): void {
+    super.onBeforeShow(data);
+    this.displayName = '';
+    this.username = '';
+    this.password = '';
+    this.confirm = '';
+    this.errorMessage = '';
+    this.usernameEdited = false;
+    this.setUIStep(LocalAccountCreationStep.FORM);
+  }
+
+  /** Called from C++: creating or signing in failed. */
+  showError(message: string): void {
+    this.errorMessage = message;
+    this.password = '';
+    this.confirm = '';
+    this.setUIStep(LocalAccountCreationStep.FORM);
+  }
+
+  /** Suggests a username from the name until the user types one. */
+  private onNameInput(): void {
+    if (this.usernameEdited) {
+      return;
+    }
+    const first = this.displayName.trim().split(/\s+/)[0] || '';
+    this.username =
+        first.toLowerCase().replace(/[^a-z0-9_-]/g, '').substring(0, 32);
+  }
+
+  private onUsernameInput(): void {
+    this.usernameEdited = true;
+  }
+
+  private onKeydown(e: KeyboardEvent): void {
+    if (e.key === 'Enter') {
+      this.onSubmit();
+    }
+  }
+
+  private onBackClicked(): void {
+    this.userActed('back');
+  }
+
+  private onSubmit(): void {
+    if (!this.isValid(this.username, this.password, this.confirm)) {
+      return;
+    }
+    this.errorMessage = '';
+    this.setUIStep(LocalAccountCreationStep.PROGRESS);
+    this.userActed(
+        ['create', this.displayName.trim(), this.username, this.password]);
+  }
+
+  private usernameOk(username: string): boolean {
+    return !username || USERNAME_PATTERN.test(username);
+  }
+
+  private mismatch(password: string, confirm: string): boolean {
+    return !!confirm && password !== confirm;
+  }
+
+  private isValid(username: string, password: string, confirm: string):
+      boolean {
+    return USERNAME_PATTERN.test(username) && !!password &&
+        password === confirm;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [LocalAccountCreation.is]: LocalAccountCreation;
+  }
+}
+
+customElements.define(LocalAccountCreation.is, LocalAccountCreation);

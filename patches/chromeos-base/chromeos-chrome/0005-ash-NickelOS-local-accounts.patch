+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_LOCAL_ACCOUNT_CREATION_SCREEN_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_LOCAL_ACCOUNT_CREATION_SCREEN_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/webui/ash/login/base_screen_handler.h"
+
+namespace ash {
+
+// NickelOS: the screen that creates a local account.
+class LocalAccountCreationView {
+ public:
+  inline constexpr static StaticOobeScreenId kScreenId{
+      "local-account-creation", "LocalAccountCreationScreen"};
+
+  virtual ~LocalAccountCreationView() = default;
+
+  virtual void Show() = 0;
+  // Shows `message` and returns to the form.
+  virtual void ShowError(const std::string& message) = 0;
+  virtual base::WeakPtr<LocalAccountCreationView> AsWeakPtr() = 0;
+};
+
+class LocalAccountCreationScreenHandler final
+    : public BaseScreenHandler,
+      public LocalAccountCreationView {
+ public:
+  using TView = LocalAccountCreationView;
+
+  LocalAccountCreationScreenHandler();
+  LocalAccountCreationScreenHandler(const LocalAccountCreationScreenHandler&) =

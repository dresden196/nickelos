diff --git a/chrome/browser/ash/login/screens/local_account_creation_screen.cc b/chrome/browser/ash/login/screens/local_account_creation_screen.cc
new file mode 100644
index 0000000000000..f78e8a3b90099
--- /dev/null
+++ b/chrome/browser/ash/login/screens/local_account_creation_screen.cc
@@ -0,0 +1,209 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/login/screens/local_account_creation_screen.h"
+
+#include "ash/public/cpp/login_screen.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ash/login/existing_user_controller.h"
+#include "chrome/browser/ui/ash/login/login_display_host.h"
+#include "chrome/browser/ui/webui/ash/login/local_account_creation_screen_handler.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "chromeos/ash/components/login/auth/public/auth_failure.h"
+#include "chromeos/ash/components/login/auth/public/auth_types.h"
+#include "chromeos/ash/components/login/auth/public/key.h"
+#include "chromeos/ash/components/login/auth/public/user_context.h"
+#include "components/user_manager/nickel_local_account.h"
+#include "components/user_manager/user_manager.h"
+#include "components/user_manager/user_type.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+
+namespace ash {
+namespace {
+
+constexpr char kUserActionBack[] = "back";
+constexpr char kUserActionCreate[] = "create";
+
+// nickel-accountsd: creates the Linux user behind a local account.
+constexpr char kAccountsService[] = "org.nickelos.Accounts";
+constexpr char kAccountsPath[] = "/org/nickelos/Accounts";
+constexpr char kAccountsInterface[] = "org.nickelos.Accounts";
+
+// Same rule as nickel-accountsd: ^[a-z_][a-z0-9_-]{0,31}$.
+bool IsValidUsername(const std::string& name) {
+  if (name.empty() || name.size() > 32 ||
+      !(base::IsAsciiLower(name[0]) || name[0] == '_')) {
+    return false;
+  }
+  for (char c : name) {
+    if (!(base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '_' ||
+          c == '-')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+dbus::ObjectProxy* AccountsProxy() {
+  return DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      kAccountsService, dbus::ObjectPath(kAccountsPath));
+}
+
+}  // namespace
+
+// static
+std::string LocalAccountCreationScreen::GetResultString(Result result) {
+  switch (result) {
+    case Result::BACK:
+      return "Back";
+  }
+}
+
+LocalAccountCreationScreen::LocalAccountCreationScreen(
+    base::WeakPtr<LocalAccountCreationView> view,
+    const ScreenExitCallback& exit_callback)
+    : BaseScreen(LocalAccountCreationView::kScreenId,
+                 OobeScreenPriority::DEFAULT),
+      view_(std::move(view)),
+      exit_callback_(exit_callback) {}
+
+LocalAccountCreationScreen::~LocalAccountCreationScreen() {
+  StopObservingLogin();
+}
+
+void LocalAccountCreationScreen::ShowImpl() {
+  // Keeps "Browse as Guest" and friends on the shelf, as on the screens this
+  // one replaces.
+  LoginScreen::Get()->SetIsFirstSigninStep(true);
+  if (view_) {
+    view_->Show();
+  }
+}
+
+void LocalAccountCreationScreen::HideImpl() {}
+
+void LocalAccountCreationScreen::OnUserAction(const base::ListValue& args) {
+  const std::string& action_id = args[0].GetString();
+  if (action_id == kUserActionBack) {
+    exit_callback_.Run(Result::BACK);
+  } else if (action_id == kUserActionCreate && args.size() == 4) {
+    HandleCreate(args[1].GetString(), args[2].GetString(),
+                 args[3].GetString());
+  } else {
+    BaseScreen::OnUserAction(args);
+  }
+}
+
+void LocalAccountCreationScreen::HandleCreate(const std::string& display_name,
+                                              const std::string& username,
+                                              const std::string& password) {
+  if (!IsValidUsername(username)) {
+    return ShowError(
+        "Usernames start with a lowercase letter and use only lowercase "
+        "letters, digits, - and _ (up to 32).");
+  }
+  if (password.empty()) {
+    return ShowError("Choose a password.");
+  }
+  if (user_manager::UserManager::Get()->FindUser(
+          user_manager::MakeNickelLocalAccountId(username))) {
+    return ShowError("That username is taken.");
+  }
+  // The first account on the device is its owner and an administrator
+  // (sudo).
+  const bool admin =
+      user_manager::UserManager::Get()->GetPersistedUsers().empty();
+
+  dbus::MethodCall method_call(kAccountsInterface, "CreateUser");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(username);
+  writer.AppendString(display_name.empty() ? username : display_name);
+  writer.AppendString(password);
+  writer.AppendBool(admin);
+  AccountsProxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&LocalAccountCreationScreen::OnUserCreated,
+                     weak_ptr_factory_.GetWeakPtr(), username, password));
+}
+
+void LocalAccountCreationScreen::OnUserCreated(const std::string& username,
+                                               const std::string& password,
+                                               dbus::Response* response,
+                                               dbus::ErrorResponse* error) {
+  if (!response) {
+    std::string message = "Could not create the account.";
+    if (error) {
+      std::string detail;
+      dbus::MessageReader(error).PopString(&detail);
+      if (!detail.empty()) {
+        message = "Could not create the account: " + detail + ".";
+      }
+    }
+    return ShowError(message);
+  }
+  pending_username_ = username;
+
+  // A new regular user: AuthSessionAuthenticator creates the encrypted home
+  // and, for local accounts, protects it with this password (label
+  // "local-password", the offline password ChromeOS signs in with).
+  UserContext user_context(user_manager::UserType::kRegular,
+                           user_manager::MakeNickelLocalAccountId(username));
+  user_context.SetKey(Key(password));
+  user_context.SetPasswordKey(Key(password));
+  user_context.SetLocalPasswordInput(LocalPasswordInput{password});
+  user_context.SetIsUsingOAuth(false);
+  user_context.SetAuthFlow(UserContext::AUTH_FLOW_OFFLINE);
+
+  if (auto* controller = ExistingUserController::current_controller();
+      controller && !observing_login_) {
+    controller->AddLoginStatusConsumer(this);
+    observing_login_ = true;
+  }
+  LoginDisplayHost::default_host()->CompleteLogin(user_context);
+}
+
+void LocalAccountCreationScreen::OnAuthFailure(const AuthFailure& error) {
+  StopObservingLogin();
+  LOG(ERROR) << "Signing into the new local account failed: "
+             << error.GetErrorString();
+  if (!pending_username_.empty()) {
+    // Don't leave a Linux user behind without its account.
+    dbus::MethodCall method_call(kAccountsInterface, "DeleteUser");
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendString(pending_username_);
+    AccountsProxy()->CallMethodWithErrorResponse(
+        &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+        base::DoNothing());
+    pending_username_.clear();
+  }
+  ShowError("Could not set up the account: " + error.GetErrorString());
+}
+
+void LocalAccountCreationScreen::OnAuthSuccess(
+    const UserContext& user_context) {
+  StopObservingLogin();
+  pending_username_.clear();
+}
+
+void LocalAccountCreationScreen::ShowError(const std::string& message) {
+  if (view_) {
+    view_->ShowError(message);
+  }
+}
+
+void LocalAccountCreationScreen::StopObservingLogin() {
+  if (!observing_login_) {
+    return;
+  }
+  observing_login_ = false;
+  if (auto* controller = ExistingUserController::current_controller()) {
+    controller->RemoveLoginStatusConsumer(this);
+  }
+}
+
+}  // namespace ash

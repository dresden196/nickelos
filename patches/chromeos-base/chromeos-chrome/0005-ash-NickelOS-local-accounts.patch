diff --git a/components/user_manager/nickel_local_account.h b/components/user_manager/nickel_local_account.h
new file mode 100644
index 0000000000000..c71040d705c2f
--- /dev/null
+++ b/components/user_manager/nickel_local_account.h
@@ -0,0 +1,44 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_USER_MANAGER_NICKEL_LOCAL_ACCOUNT_H_
+#define COMPONENTS_USER_MANAGER_NICKEL_LOCAL_ACCOUNT_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "components/account_id/account_id.h"
+
+namespace user_manager {
+
+// NickelOS local accounts are real Linux users with an offline password and
+// no Google account. They are regular users whose AccountId email is
+// "<Linux username>@nickel.localhost": session_manager requires an email-like
+// id, and the domain is what marks them, since an AccountId without a Gaia id
+// is stored and reloaded as a Google account with an empty Gaia id.
+inline constexpr std::string_view kNickelLocalAccountDomain =
+    "nickel.localhost";
+
+inline bool IsNickelLocalAccount(const AccountId& account_id) {
+  return account_id.is_valid() &&
+         base::EndsWith(account_id.GetUserEmail(),
+                        base::StrCat({"@", kNickelLocalAccountDomain}));
+}
+
+inline AccountId MakeNickelLocalAccountId(std::string_view username) {
+  return AccountId::FromUserEmail(
+      base::StrCat({username, "@", kNickelLocalAccountDomain}));
+}
+
+// The Linux username of a local account.
+inline std::string NickelLocalAccountUsername(const AccountId& account_id) {
+  const std::string& email = account_id.GetUserEmail();
+  return email.substr(0, email.find('@'));
+}
+
+}  // namespace user_manager
+
+#endif  // COMPONENTS_USER_MANAGER_NICKEL_LOCAL_ACCOUNT_H_

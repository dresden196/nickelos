+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/login/local_account_creation_screen_handler.h"
+
+#include "components/login/localized_values_builder.h"
+
+namespace ash {
+
+LocalAccountCreationScreenHandler::LocalAccountCreationScreenHandler()
+    : BaseScreenHandler(kScreenId) {}
+
+LocalAccountCreationScreenHandler::~LocalAccountCreationScreenHandler() =
+    default;
+
+// TODO(NickelOS): move the strings into a .grd so they can be translated.
+void LocalAccountCreationScreenHandler::DeclareLocalizedValues(
+    ::login::LocalizedValuesBuilder* builder) {
+  builder->Add("localAccountCreationTitle", "Create your account");
+  builder->Add("localAccountCreationSubtitle",
+               "Your account and its files live on this device, encrypted "
+               "with your password. Without a Google account there is no way "
+               "to recover them if you forget it.");
+  builder->Add("localAccountCreationName", "Your name");
+  builder->Add("localAccountCreationUsername", "Username");
+  builder->Add("localAccountCreationUsernameError",
+               "Start with a lowercase letter; use lowercase letters, digits, "
+               "- and _ (up to 32)");
+  builder->Add("localAccountCreationPassword", "Password");
+  builder->Add("localAccountCreationConfirm", "Confirm password");
+  builder->Add("localAccountCreationMismatch", "The passwords don't match");
+  builder->Add("localAccountCreationCreating", "Creating your account...");
+}
+
+void LocalAccountCreationScreenHandler::Show() {
+  ShowInWebUI();
+}
+
+void LocalAccountCreationScreenHandler::ShowError(const std::string& message) {
+  CallExternalAPI("showError", message);
+}
+
+base::WeakPtr<LocalAccountCreationView>
+LocalAccountCreationScreenHandler::AsWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+}  // namespace ash

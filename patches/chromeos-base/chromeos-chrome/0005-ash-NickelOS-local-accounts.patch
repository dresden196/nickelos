+<!--
+Copyright 2026 The NickelOS Authors
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<!--
+  NickelOS: create a local account (name, username, password).
+-->
+<style include="oobe-dialog-host-styles cros-color-overrides">
+  cr-input {
+    --cr-input-padding-start: 0px;
+    margin-bottom: 12px;
+  }
+
+  #errorMessage {
+    color: var(--cros-sys-error);
+  }
+</style>
+<oobe-adaptive-dialog role="dialog" for-step="form">
+  <iron-icon slot="icon" icon="oobe-32:avatar"></iron-icon>
+  <h1 slot="title">
+    [[i18nDynamic(locale, 'localAccountCreationTitle')]]
+  </h1>
+  <p slot="subtitle">
+    [[i18nDynamic(locale, 'localAccountCreationSubtitle')]]
+  </p>
+  <div slot="content" class="landscape-vertical-centered">
+    <cr-input id="nameInput" class="focus-on-show" value="{{displayName}}"
+        label="[[i18nDynamic(locale, 'localAccountCreationName')]]"
+        on-input="onNameInput">
+    </cr-input>
+    <cr-input id="usernameInput" value="{{username}}"
+        label="[[i18nDynamic(locale, 'localAccountCreationUsername')]]"
+        invalid="[[!usernameOk(username)]]"
+        error-message="[[i18nDynamic(locale,
+                         'localAccountCreationUsernameError')]]"
+        on-input="onUsernameInput">
+    </cr-input>
+    <cr-input id="passwordInput" type="password" value="{{password}}"
+        label="[[i18nDynamic(locale, 'localAccountCreationPassword')]]">
+    </cr-input>
+    <cr-input id="confirmInput" type="password" value="{{confirm}}"
+        label="[[i18nDynamic(locale, 'localAccountCreationConfirm')]]"
+        invalid="[[mismatch(password, confirm)]]"
+        error-message="[[i18nDynamic(locale,
+                         'localAccountCreationMismatch')]]"
+        on-keydown="onKeydown">
+    </cr-input>
+    <p id="errorMessage" hidden="[[!errorMessage]]" aria-live="polite">
+      [[errorMessage]]
+    </p>
+  </div>
+  <div slot="back-navigation">
+    <oobe-back-button id="backButton" on-click="onBackClicked">
+    </oobe-back-button>
+  </div>
+  <div slot="bottom-buttons">
+    <oobe-next-button id="nextButton" on-click="onSubmit" inverse
+        disabled="[[!isValid(username, password, confirm)]]">
+    </oobe-next-button>
+  </div>
+</oobe-adaptive-dialog>
+<oobe-loading-dialog id="progress" role="dialog" for-step="progress"
+    title-key="localAccountCreationCreating">
+  <iron-icon slot="icon" icon="oobe-32:avatar"></iron-icon>
+</oobe-loading-dialog>

+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_ANDROID_APPS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_ANDROID_APPS_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace dbus {
+class ErrorResponse;
+class Response;
+}  // namespace dbus
+
+namespace ash::settings {
+
+// NickelOS: Settings > Apps > Android apps. Android runs in Waydroid;
+// nickel-waydroidd (root, org.nickelos.Android on the system bus) sets it
+// up, turns ARM app support on and off and removes it, for administrators,
+// and says how far along it is. Android's own Settings app opens through
+// nickel-appd (org.nickelos.AndroidSettings.desktop).
+//
+// Messages (all answered with a promise):
+//   getNickelAndroidState() -> {android, arm, translator, progress, error,
+//                               admin, diskText}
+//     android: "absent", "setting-up", "ready", "removing", or
+//     "unavailable" when the service doesn't answer.
+//   nickelAndroidSetUp(), nickelAndroidCancel(), nickelAndroidSetArm(on),
+//   nickelAndroidRemove() -> error ("" when started)
+//   nickelAndroidOpenSettings()
+// Errors: "not-allowed", "busy", "failed".
+class NickelAndroidAppsHandler : public content::WebUIMessageHandler {
+ public:
+  NickelAndroidAppsHandler();
+  NickelAndroidAppsHandler(const NickelAndroidAppsHandler&) = delete;
+  NickelAndroidAppsHandler& operator=(const NickelAndroidAppsHandler&) =
+      delete;
+  ~NickelAndroidAppsHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGetState(const base::ListValue& args);
+  void HandleCall(const std::string& method, const base::ListValue& args);
+  void HandleOpenSettings(const base::ListValue& args);
+
+  void OnState(const std::string& callback_id,
+               dbus::Response* response,
+               dbus::ErrorResponse* error);
+  // Answers |callback_id| with "" or the error's name.
+  void OnDone(const std::string& callback_id,
+              dbus::Response* response,
+              dbus::ErrorResponse* error);
+
+  base::WeakPtrFactory<NickelAndroidAppsHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace ash::settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_APPS_NICKEL_ANDROID_APPS_HANDLER_H_

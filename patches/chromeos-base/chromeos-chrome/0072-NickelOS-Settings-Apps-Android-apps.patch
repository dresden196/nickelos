diff --git a/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_android_apps_handler.cc b/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_android_apps_handler.cc
new file mode 100644
index 0000000000000..e4ecfb918a55e
--- /dev/null
+++ b/chrome/browser/ui/webui/ash/settings/pages/apps/nickel_android_apps_handler.cc
@@ -0,0 +1,186 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/apps/nickel_android_apps_handler.h"
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "base/byte_size.h"
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "content/public/browser/web_ui.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+#include "ui/base/text/bytes_formatting.h"
+
+namespace ash::settings {
+
+namespace {
+
+constexpr char kAndroidService[] = "org.nickelos.Android";
+constexpr char kAndroidPath[] = "/org/nickelos/Android";
+constexpr char kAndroidInterface[] = "org.nickelos.Android";
+constexpr char kErrorPrefix[] = "org.nickelos.Android.Error.";
+
+// nickel-appd: launches the session's apps from their desktop files.
+constexpr char kAppsService[] = "org.nickelos.Apps";
+constexpr char kAppsPath[] = "/org/nickelos/Apps";
+constexpr char kAppsInterface[] = "org.nickelos.Apps";
+// Android's Settings app (waydroid app launch com.android.settings).
+constexpr char kAndroidSettingsApp[] = "org.nickelos.AndroidSettings";
+
+dbus::ObjectProxy* Proxy(const char* service, const char* path) {
+  return DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      service, dbus::ObjectPath(path));
+}
+
+// nickel-waydroidd's error, as the page names it.
+std::string ErrorCode(dbus::ErrorResponse* error) {
+  if (!error) {
+    return "failed";
+  }
+  const std::string name = error->GetErrorName();
+  if (name == base::StrCat({kErrorPrefix, "NotAllowed"})) {
+    return "not-allowed";
+  }
+  if (name == base::StrCat({kErrorPrefix, "Busy"})) {
+    return "busy";
+  }
+  return "failed";
+}
+
+}  // namespace
+
+NickelAndroidAppsHandler::NickelAndroidAppsHandler() = default;
+
+NickelAndroidAppsHandler::~NickelAndroidAppsHandler() = default;
+
+void NickelAndroidAppsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getNickelAndroidState",
+      base::BindRepeating(&NickelAndroidAppsHandler::HandleGetState,
+                          base::Unretained(this)));
+  for (const auto& [message, method] :
+       {std::pair{"nickelAndroidSetUp", "SetUp"},
+        std::pair{"nickelAndroidCancel", "Cancel"},
+        std::pair{"nickelAndroidSetArm", "SetArm"},
+        std::pair{"nickelAndroidRemove", "Remove"}}) {
+    web_ui()->RegisterMessageCallback(
+        message, base::BindRepeating(&NickelAndroidAppsHandler::HandleCall,
+                                     base::Unretained(this),
+                                     std::string(method)));
+  }
+  web_ui()->RegisterMessageCallback(
+      "nickelAndroidOpenSettings",
+      base::BindRepeating(&NickelAndroidAppsHandler::HandleOpenSettings,
+                          base::Unretained(this)));
+}
+
+void NickelAndroidAppsHandler::OnJavascriptDisallowed() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void NickelAndroidAppsHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAndroidInterface, "GetState");
+  Proxy(kAndroidService, kAndroidPath)
+      ->CallMethodWithErrorResponse(
+          &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+          base::BindOnce(&NickelAndroidAppsHandler::OnState,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         args[0].GetString()));
+}
+
+void NickelAndroidAppsHandler::OnState(const std::string& callback_id,
+                                       dbus::Response* response,
+                                       dbus::ErrorResponse* error) {
+  // GetState's a{sv}: strings, but for admin (b), progress (d) and disk
+  // (t, sent as its size in words).
+  base::DictValue state;
+  state.Set("android", "unavailable");
+  state.Set("arm", "off");
+  state.Set("translator", "");
+  state.Set("progress", -1.0);
+  state.Set("error", "");
+  state.Set("admin", false);
+  state.Set("diskText", "");
+  dbus::MessageReader reader(response);
+  dbus::MessageReader array(nullptr);
+  if (response && reader.PopArray(&array)) {
+    while (array.HasMoreData()) {
+      dbus::MessageReader entry(nullptr);
+      std::string key;
+      if (!array.PopDictEntry(&entry) || !entry.PopString(&key)) {
+        break;
+      }
+      if (key == "admin") {
+        bool value = false;
+        if (entry.PopVariantOfBool(&value)) {
+          state.Set(key, value);
+        }
+      } else if (key == "progress") {
+        double value = -1;
+        if (entry.PopVariantOfDouble(&value)) {
+          state.Set(key, value);
+        }
+      } else if (key == "disk") {
+        uint64_t value = 0;
+        if (entry.PopVariantOfUint64(&value) && value > 0) {
+          state.Set("diskText", ui::FormatBytes(base::ByteSize(value)));
+        }
+      } else {
+        std::string value;
+        if (entry.PopVariantOfString(&value)) {
+          state.Set(key, value);
+        }
+      }
+    }
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), state);
+}
+
+void NickelAndroidAppsHandler::HandleCall(const std::string& method,
+                                          const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAndroidInterface, method);
+  if (method == "SetArm") {
+    dbus::MessageWriter writer(&method_call);
+    writer.AppendBool(args.size() > 1 && args[1].is_bool() && args[1].GetBool());
+  }
+  Proxy(kAndroidService, kAndroidPath)
+      ->CallMethodWithErrorResponse(
+          &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+          base::BindOnce(&NickelAndroidAppsHandler::OnDone,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         args[0].GetString()));
+}
+
+void NickelAndroidAppsHandler::OnDone(const std::string& callback_id,
+                                      dbus::Response* response,
+                                      dbus::ErrorResponse* error) {
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(response ? std::string() : ErrorCode(error)));
+}
+
+void NickelAndroidAppsHandler::HandleOpenSettings(
+    const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kAppsInterface, "LaunchApplication");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(kAndroidSettingsApp);
+  writer.AppendArrayOfStrings(std::vector<std::string>());
+  Proxy(kAppsService, kAppsPath)
+      ->CallMethodWithErrorResponse(
+          &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+          base::BindOnce(&NickelAndroidAppsHandler::OnDone,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         args[0].GetString()));
+}
+
+}  // namespace ash::settings

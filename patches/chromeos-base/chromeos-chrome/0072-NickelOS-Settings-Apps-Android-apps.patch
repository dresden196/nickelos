@@ -0,0 +1,147 @@
+<style include="settings-shared">
+  progress {
+    accent-color: var(--cros-sys-primary);
+    margin-top: 8px;
+    width: 100%;
+  }
+
+  .nickel-android-error {
+    color: var(--cros-sys-error);
+  }
+
+  cr-dialog p {
+    margin: 0 0 12px;
+  }
+</style>
+<settings-card header-text="$i18n{nickelAndroidTitle}">
+  <template is="dom-if" if="[[is_(state_.android, 'unavailable')]]" restamp>
+    <div class="settings-box first">
+      <div class="secondary">$i18n{nickelAndroidUnavailable}</div>
+    </div>
+  </template>
+
+  <!-- Not set up yet. -->
+  <template is="dom-if" if="[[is_(state_.android, 'absent')]]" restamp>
+    <div class="settings-box first two-line">
+      <div class="start settings-box-text">
+        <div id="nickelAndroidSetUpLabel">$i18n{nickelAndroidSetUpLabel}</div>
+        <div class="secondary">$i18n{nickelAndroidSetUpDescription}</div>
+        <div class="secondary nickel-android-error"
+            hidden$="[[!errorText_(state_.error)]]">
+          [[errorText_(state_.error)]]
+        </div>
+      </div>
+      <div class="separator"></div>
+      <cr-button id="nickelAndroidSetUp" on-click="onSetUpClick_"
+          disabled="[[!state_.admin]]"
+          aria-describedby="nickelAndroidSetUpLabel">
+        $i18n{nickelAndroidSetUp}
+      </cr-button>
+    </div>
+  </template>
+
+  <!-- Downloading and setting up, or removing. -->
+  <template is="dom-if" if="[[isWorking_(state_.android)]]" restamp>
+    <div class="settings-box first two-line">
+      <div class="start settings-box-text">
+        <div>[[workText_(state_.android, state_.progress)]]</div>
+        <template is="dom-if" if="[[hasProgress_(state_.progress)]]" restamp>
+          <progress max="1" value="[[state_.progress]]"></progress>
+        </template>
+        <template is="dom-if" if="[[!hasProgress_(state_.progress)]]" restamp>
+          <progress></progress>
+        </template>
+      </div>
+      <template is="dom-if" if="[[is_(state_.android, 'setting-up')]]"
+          restamp>
+        <div class="separator"></div>
+        <cr-button on-click="onCancelClick_" disabled="[[!state_.admin]]">
+          $i18n{cancel}
+        </cr-button>
+      </template>
+    </div>
+  </template>
+
+  <!-- Set up. -->
+  <template is="dom-if" if="[[is_(state_.android, 'ready')]]" restamp>
+    <cr-link-row id="nickelAndroidOpenSettings" class="settings-box first"
+        label="$i18n{nickelAndroidOpenSettings}"
+        sub-label="[[usesText_(state_.diskText)]]"
+        on-click="onOpenSettingsClick_" external>
+    </cr-link-row>
+    <div class="settings-box two-line">
+      <div class="start settings-box-text" aria-hidden="true">
+        <div id="nickelAndroidArmLabel">$i18n{nickelAndroidArmLabel}</div>
+        <div class="secondary">[[armSubLabel_(state_.arm)]]</div>
+        <div class="secondary nickel-android-error"
+            hidden$="[[!errorText_(state_.error)]]">
+          [[errorText_(state_.error)]]
+        </div>
+        <template is="dom-if" if="[[isArmWorking_(state_.arm)]]" restamp>
+          <template is="dom-if" if="[[hasProgress_(state_.progress)]]"
+              restamp>
+            <progress max="1" value="[[state_.progress]]"></progress>
+          </template>
+          <template is="dom-if" if="[[!hasProgress_(state_.progress)]]"
+              restamp>
+            <progress></progress>
+          </template>
+        </template>
+      </div>
+      <cr-toggle id="nickelAndroidArmToggle"
+          checked="[[isArmOn_(state_.arm)]]"
+          disabled="[[!canChangeArm_(state_.admin, state_.arm)]]"
+          on-change="onArmChange_"
+          aria-labelledby="nickelAndroidArmLabel">
+      </cr-toggle>
+    </div>
+    <div class="settings-box two-line">
+      <div class="start settings-box-text">
+        <div id="nickelAndroidRemoveLabel">$i18n{nickelAndroidRemoveLabel}</div>
+        <div class="secondary">$i18n{nickelAndroidRemoveDescription}</div>
+      </div>
+      <div class="separator"></div>
+      <cr-button id="nickelAndroidRemove" on-click="onRemoveClick_"
+          disabled="[[!canChangeArm_(state_.admin, state_.arm)]]"
+          aria-describedby="nickelAndroidRemoveLabel">
+        $i18n{nickelAndroidRemove}
+      </cr-button>
+    </div>
+  </template>
+
+  <template is="dom-if" if="[[showAdminOnly_(state_.android, state_.admin)]]"
+      restamp>
+    <div class="settings-box">
+      <div class="secondary">$i18n{nickelAndroidAdminOnly}</div>
+    </div>
+  </template>
+</settings-card>
+
+<cr-dialog id="armDialog" on-cancel="onArmDialogCancel_">
+  <div slot="title">$i18n{nickelAndroidArmDialogTitle}</div>
+  <div slot="body">
+    <p>[[armDialogBody_(state_.translator)]]</p>
+    <p>$i18n{nickelAndroidArmDialogBody2}</p>
+  </div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" on-click="onArmDialogCancel_">
+      $i18n{cancel}
+    </cr-button>
+    <cr-button class="action-button" on-click="onArmDialogConfirm_">
+      $i18n{nickelAndroidArmDialogConfirm}
+    </cr-button>
+  </div>
+</cr-dialog>
+
+<cr-dialog id="removeDialog" on-cancel="onRemoveDialogCancel_">
+  <div slot="title">$i18n{nickelAndroidRemoveDialogTitle}</div>
+  <div slot="body">$i18n{nickelAndroidRemoveDialogBody}</div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" on-click="onRemoveDialogCancel_">
+      $i18n{cancel}
+    </cr-button>
+    <cr-button class="action-button" on-click="onRemoveDialogConfirm_">
+      $i18n{nickelAndroidRemove}
+    </cr-button>
+  </div>
+</cr-dialog>
diff --git a/chrome/browser/resources/ash/settings/os_apps_page/nickel_android_apps.ts b/chrome/browser/resources/ash/settings/os_apps_page/nickel_android_apps.ts
new file mode 100644
index 0000000000000..bfc7cbb580226
--- /dev/null
+++ b/chrome/browser/resources/ash/settings/os_apps_page/nickel_android_apps.ts
@@ -0,0 +1,252 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: the Android apps card on the Apps page. Android
+ * runs in Waydroid; this sets it up (a download, with its progress), turns
+ * ARM app support on (after the user agrees: proprietary software they
+ * install) and off, opens Android's own Settings app, and removes Android
+ * (NickelAndroidAppsHandler, nickel-waydroidd). Changes are for
+ * administrators of the device.
+ */
+
+import 'chrome://resources/ash/common/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/ash/common/cr_elements/cr_link_row/cr_link_row.js';
+import 'chrome://resources/ash/common/cr_elements/cr_toggle/cr_toggle.js';
+import '../os_settings_page/settings_card.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrToggleElement} from 'chrome://resources/ash/common/cr_elements/cr_toggle/cr_toggle.js';
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {afterNextRender, PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_android_apps.html.js';
+
+interface AndroidState {
+  // "absent", "setting-up", "ready", "removing" or "unavailable".
+  android: string;
+  // "off", "on", "turning-on" or "turning-off".
+  arm: string;
+  // What ARM app support installs here: "libhoudini" or "libndk".
+  translator: string;
+  // 0 to 1 while something downloads, else -1.
+  progress: number;
+  // Why the last change failed: "download", "failed", or "".
+  error: string;
+  admin: boolean;
+  diskText: string;
+}
+
+// While something is under way, the page asks again this often (ms).
+const POLL_MS = 1000;
+
+const NickelAndroidAppsElementBase = I18nMixin(PolymerElement);
+
+export class NickelAndroidAppsElement extends NickelAndroidAppsElementBase {
+  static get is() {
+    return 'nickel-android-apps' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      state_: {
+        type: Object,
+        value: () => ({
+          android: '',
+          arm: 'off',
+          translator: '',
+          progress: -1,
+          error: '',
+          admin: false,
+          diskText: '',
+        }),
+      },
+    };
+  }
+
+  declare private state_: AndroidState;
+  private pollTimer_: number|null = null;
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.refresh_().then(() => this.scrollIntoViewIfAsked_());
+  }
+
+  // Opened as chrome://os-settings/apps?nickel=android (nickel-waydroid's APK
+  // handler and Waydroid's launcher entry send people here to set Android up
+  // or turn on ARM app support): the card comes into view by itself.
+  private scrollIntoViewIfAsked_(): void {
+    if (new URLSearchParams(window.location.search).get('nickel') !==
+        'android') {
+      return;
+    }
+    afterNextRender(this, () => this.scrollIntoView({block: 'center'}));
+  }
+
+  override disconnectedCallback(): void {
+    super.disconnectedCallback();
+    this.stopPolling_();
+  }
+
+  private stopPolling_(): void {
+    if (this.pollTimer_ !== null) {
+      clearTimeout(this.pollTimer_);
+      this.pollTimer_ = null;
+    }
+  }
+
+  private async refresh_(): Promise<void> {
+    this.stopPolling_();
+    this.state_ = await sendWithPromise('getNickelAndroidState');
+    const s = this.state_;
+    if (this.isWorking_(s.android) || this.isArmWorking_(s.arm)) {
+      this.pollTimer_ = setTimeout(() => this.refresh_(), POLL_MS);
+    }
+  }
+
+  private is_(value: string, expected: string): boolean {
+    return value === expected;
+  }
+
+  private isWorking_(android: string): boolean {
+    return android === 'setting-up' || android === 'removing';
+  }
+
+  private isArmWorking_(arm: string): boolean {
+    return arm === 'turning-on' || arm === 'turning-off';
+  }
+
+  private isArmOn_(arm: string): boolean {
+    return arm === 'on' || arm === 'turning-on';
+  }
+
+  private canChangeArm_(admin: boolean, arm: string): boolean {
+    return admin && !this.isArmWorking_(arm);
+  }
+
+  private hasProgress_(progress: number): boolean {
+    return progress >= 0;
+  }
+
+  private showAdminOnly_(android: string, admin: boolean): boolean {
+    return !admin && android !== '' && android !== 'unavailable';
+  }
+
+  private workText_(android: string, progress: number): string {
+    if (android === 'removing') {
+      return this.i18n('nickelAndroidRemoving');
+    }
+    if (progress < 0 || progress >= 1) {
+      return this.i18n('nickelAndroidPreparing');
+    }
+    return `${this.i18n('nickelAndroidDownloading')} · ${
+        Math.floor(progress * 100)}%`;
+  }
+
+  private usesText_(diskText: string): string {
+    return diskText ? this.i18n('nickelAndroidUses', diskText) : '';
+  }
+
+  private armSubLabel_(arm: string): string {
+    if (arm === 'turning-on') {
+      return this.i18n('nickelAndroidArmTurningOn');
+    }
+    if (arm === 'turning-off') {
+      return this.i18n('nickelAndroidArmTurningOff');
+    }
+    return this.i18n('nickelAndroidArmDescription');
+  }
+
+  private errorText_(error: string): string {
+    if (error === 'download') {
+      return this.i18n('nickelAndroidErrorDownload');
+    }
+    return error ? this.i18n('nickelAndroidErrorFailed') : '';
+  }
+
+  private armDialogBody_(translator: string): string {
+    return this.i18n(
+        'nickelAndroidArmDialogBody1',
+        this.i18n(
+            translator === 'libhoudini' ? 'nickelAndroidTranslatorHoudini' :
+                                          'nickelAndroidTranslatorNdk'));
+  }
+
+  private async onSetUpClick_(): Promise<void> {
+    await sendWithPromise('nickelAndroidSetUp');
+    await this.refresh_();
+  }
+
+  private async onCancelClick_(): Promise<void> {
+    await sendWithPromise('nickelAndroidCancel');
+    await this.refresh_();
+  }
+
+  private onOpenSettingsClick_(): void {
+    sendWithPromise('nickelAndroidOpenSettings');
+  }
+
+  private dialog_(id: string): CrDialogElement {
+    return this.shadowRoot!.querySelector<CrDialogElement>(`#${id}`)!;
+  }
+
+  private closeDialog_(id: string): void {
+    const dialog = this.dialog_(id);
+    if (dialog.open) {
+      dialog.close();
+    }
+  }
+
+  // Turning ARM app support on waits for the agreement: the switch stays
+  // off until then.
+  private async onArmChange_(e: Event): Promise<void> {
+    const toggle = e.target as CrToggleElement;
+    if (!toggle.checked) {
+      await sendWithPromise('nickelAndroidSetArm', false);
+      await this.refresh_();
+      return;
+    }
+    toggle.checked = false;
+    this.dialog_('armDialog').showModal();
+  }
+
+  private async onArmDialogConfirm_(): Promise<void> {
+    this.closeDialog_('armDialog');
+    await sendWithPromise('nickelAndroidSetArm', true);
+    await this.refresh_();
+  }
+
+  private onArmDialogCancel_(): void {
+    this.closeDialog_('armDialog');
+  }
+
+  private onRemoveClick_(): void {
+    this.dialog_('removeDialog').showModal();
+  }
+
+  private async onRemoveDialogConfirm_(): Promise<void> {
+    this.closeDialog_('removeDialog');
+    await sendWithPromise('nickelAndroidRemove');
+    await this.refresh_();
+  }
+
+  private onRemoveDialogCancel_(): void {
+    this.closeDialog_('removeDialog');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelAndroidAppsElement.is]: NickelAndroidAppsElement;
+  }
+}
+
+customElements.define(NickelAndroidAppsElement.is, NickelAndroidAppsElement);

@@ -0,0 +1,132 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_notifications.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "ash/resources/vector_icons/vector_icons.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ash/crostini/crostini_util.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "components/exo/wayland/xdg_activation.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/image/image.h"
+#include "ui/message_center/message_center.h"
+#include "ui/message_center/public/cpp/notification.h"
+#include "ui/message_center/public/cpp/notification_delegate.h"
+#include "url/gurl.h"
+
+namespace ash {
+
+namespace {
+
+constexpr char kIdPrefix[] = "nickel-notification-";
+
+// To the portal backend, through nickel-appd.
+void SendEvent(const std::string& key,
+               const std::string& event,
+               int button,
+               const std::string& token) {
+  dbus::ObjectProxy* proxy =
+      DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+          crostini::kNickelAppsServiceName,
+          dbus::ObjectPath(crostini::kNickelAppsServicePath));
+  dbus::MethodCall method_call(crostini::kNickelAppsServiceInterface,
+                               "NotificationEvent");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(key);
+  writer.AppendString(event);
+  writer.AppendInt32(button);
+  writer.AppendString(token);
+  proxy->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                    base::DoNothing());
+}
+
+class Delegate : public message_center::NotificationDelegate {
+ public:
+  explicit Delegate(std::string key) : key_(std::move(key)) {}
+  Delegate(const Delegate&) = delete;
+  Delegate& operator=(const Delegate&) = delete;
+
+  // message_center::NotificationDelegate:
+  // Only the user's closing is news to the app: it closed the others itself
+  // (and may already have shown another under the same key).
+  void Close(bool by_user) override {
+    if (by_user) {
+      SendEvent(key_, "closed", 1, std::string());
+    }
+  }
+  void Click(const std::optional<int>& button_index,
+             const std::optional<std::u16string>& reply) override {
+    // The click hands the focus on: the app may bring a window forward.
+    SendEvent(key_, "clicked", button_index.value_or(-1),
+              exo::wayland::MakeActivationToken());
+  }
+
+ private:
+  ~Delegate() override = default;
+
+  const std::string key_;
+};
+
+}  // namespace
+
+// static
+void NickelNotifications::Show(const Content& content) {
+  // As Crostini's apps' notifications (exo::Notification): ChromeOS lists
+  // their apps among those that may notify.
+  message_center::NotifierId notifier(
+      message_center::NotifierType::CROSTINI_APPLICATION,
+      content.app_id.empty() ? "nickel" : content.app_id);
+  if (const user_manager::User* user =
+          user_manager::UserManager::Get()->GetPrimaryUser()) {
+    notifier.profile_id = user->GetAccountId().GetUserEmail();
+  }
+  message_center::RichNotificationData data;
+  data.vector_small_image = &kNotificationLinuxIcon;
+  data.remove_on_click = true;
+  for (const std::string& label : content.buttons) {
+    data.buttons.emplace_back(base::UTF8ToUTF16(label));
+  }
+  if (content.urgent) {
+    data.never_timeout = true;
+    data.priority = message_center::HIGH_PRIORITY;
+  }
+  gfx::Image icon;
+  if (!content.icon_png.empty()) {
+    icon = gfx::Image::CreateFrom1xPNGBytes(content.icon_png);
+  }
+  const std::string id = base::StrCat({kIdPrefix, content.key});
+  auto notification = std::make_unique<message_center::Notification>(
+      message_center::NOTIFICATION_TYPE_SIMPLE, id,
+      base::UTF8ToUTF16(content.title), base::UTF8ToUTF16(content.body),
+      icon.IsEmpty() ? ui::ImageModel() : ui::ImageModel::FromImage(icon),
+      base::UTF8ToUTF16(content.app_name), GURL(), notifier, data,
+      base::MakeRefCounted<Delegate>(content.key));
+  auto* message_center = message_center::MessageCenter::Get();
+  if (message_center->FindNotificationById(id)) {
+    message_center->UpdateNotification(id, std::move(notification));
+  } else {
+    message_center->AddNotification(std::move(notification));
+  }
+}
+
+// static
+void NickelNotifications::Close(const std::string& key) {
+  message_center::MessageCenter::Get()->RemoveNotification(
+      base::StrCat({kIdPrefix, key}), /*by_user=*/false);
+}
+
+}  // namespace ash

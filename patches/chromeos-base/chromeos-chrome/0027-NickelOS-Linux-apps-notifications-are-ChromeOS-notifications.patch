   std::move(response_sender).Run(std::move(response));
 }
 
+// NickelNotify(key, app_id, app_name, title, body, icon (PNG), buttons,
+// urgent): shows a Linux app's notification, or replaces the one with that
+// key (see NickelNotifications).
+void VmApplicationsServiceProvider::NickelNotify(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  NickelNotifications::Content content;
+  base::span<const uint8_t> icon;
+  if (!reader.PopString(&content.key) || !reader.PopString(&content.app_id) ||
+      !reader.PopString(&content.app_name) ||
+      !reader.PopString(&content.title) || !reader.PopString(&content.body) ||
+      !reader.PopArrayOfBytes(&icon) ||
+      !reader.PopArrayOfStrings(&content.buttons) ||
+      !reader.PopBool(&content.urgent) || content.key.empty()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected key, app_id, app_name, title, body, icon, buttons, "
+            "urgent"));
+    return;
+  }
+  content.icon_png.assign(icon.begin(), icon.end());
+  NickelNotifications::Show(content);
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
+void VmApplicationsServiceProvider::NickelNotifyClose(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string key;
+  if (reader.PopString(&key)) {
+    NickelNotifications::Close(key);
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}

+++ b/chrome/browser/ash/dbus/vm/nickel_notifications.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_NOTIFICATIONS_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_NOTIFICATIONS_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ash {
+
+// NickelOS: Linux apps' notifications as ChromeOS's own. NickelOS's portal
+// backend serves org.freedesktop.Notifications (native apps) and the
+// Notification portal (Flatpak apps) and asks for each through
+// vm_applications' NickelNotify and NickelNotifyClose. What the user does
+// with one goes back through nickel-appd (org.nickelos.Apps
+// NotificationEvent(key, event, button, token)): "clicked", button -1 for
+// the notification itself, with an xdg-activation token so the app may
+// bring a window forward; "closed" (button 1) when the user closed it.
+class NickelNotifications {
+ public:
+  struct Content {
+    // The backend's name for it; showing the same key again replaces it.
+    std::string key;
+    // The app's desktop file id, and the name shown for it.
+    std::string app_id;
+    std::string app_name;
+    std::string title;
+    std::string body;
+    // PNG; none for no icon.
+    std::vector<uint8_t> icon_png;
+    std::vector<std::string> buttons;
+    // Stays until the user closes it, ahead of others.
+    bool urgent = false;
+  };
+
+  static void Show(const Content& content);
+  static void Close(const std::string& key);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_NOTIFICATIONS_H_

+  if (unsealed_fd.is_valid()) {
+    auto* entry = new UnsealedPool;
+    entry->pool = shared_memory.get();
+    entry->fd = std::move(unsealed_fd);
+    entry->destroy_listener.notify = OnUnsealedPoolDestroyed;
+    UnsealedPools()[entry->pool] = entry;
+    wl_resource_add_destroy_listener(shm_pool_resource,
+                                     &entry->destroy_listener);
+  }
+
   SetImplementation(shm_pool_resource, &shm_pool_implementation,
                     std::move(shared_memory));
 }
@@ -145,6 +217,16 @@ const struct wl_shm_interface shm_implementation = {shm_create_pool};
 
 }  // namespace
 
+bool ShmBufferFitsItsFile(Buffer* buffer) {
+  auto it = UnsealedBuffers().find(buffer);
+  if (it == UnsealedBuffers().end()) {
+    return true;
+  }
+  struct stat st;
+  return fstat(it->second->fd.get(), &st) == 0 && st.st_size >= 0 &&
+         static_cast<uint64_t>(st.st_size) >= it->second->end;
+}

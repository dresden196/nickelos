 #include <fcntl.h>
 #include <sys/stat.h>
+#include <unistd.h>
 #include <wayland-server-protocol-core.h>
 
 #include <algorithm>
+#include <map>
 
 #include "base/functional/bind.h"
+#include "base/no_destructor.h"

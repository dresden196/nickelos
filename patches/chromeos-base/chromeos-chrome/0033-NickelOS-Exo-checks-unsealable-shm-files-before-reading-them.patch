   // the client allows seals (memfds made with MFD_ALLOW_SEALING, as toolkits
   // make them); the client may still grow it for wl_shm_pool.resize.
   fcntl(scoped_fd.get(), F_ADD_SEALS, F_SEAL_SHRINK);
+  const int seals = fcntl(scoped_fd.get(), F_GET_SEALS);
+  base::ScopedFD unsealed_fd;
+  if (seals < 0 || !(seals & F_SEAL_SHRINK)) {

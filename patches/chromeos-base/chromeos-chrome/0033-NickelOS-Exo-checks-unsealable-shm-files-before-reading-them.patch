+    entry->end = static_cast<uint64_t>(offset) +
+                 static_cast<uint64_t>(stride) * static_cast<uint64_t>(height);
+    entry->destroy_listener.notify = OnUnsealedBufferDestroyed;
+    UnsealedBuffers()[entry->buffer] = entry;
+    wl_resource_add_destroy_listener(buffer_resource, &entry->destroy_listener);
+  }

 struct wl_client;
 
 namespace exo {
+class Buffer;
+
 namespace wayland {
 
 void bind_shm(wl_client* client, void* data, uint32_t version, uint32_t id);
 
+// NickelOS: false if `buffer` is from a wl_shm pool whose file could not be
+// sealed against shrinking and is now shorter than the buffer: reading it
+// would kill the reader (the GPU process, the browser for a cursor) with
+// SIGBUS. Buffers from sealed pools, and other buffers, always fit.
+bool ShmBufferFitsItsFile(Buffer* buffer);
+

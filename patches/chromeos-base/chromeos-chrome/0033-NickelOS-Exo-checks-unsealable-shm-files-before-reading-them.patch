@@ -27,6 +31,47 @@ void buffer_destroy(wl_client* client, wl_resource* resource) {
 
 const struct wl_buffer_interface buffer_implementation = {buffer_destroy};
 
+// NickelOS: pools whose file could not be sealed against shrinking (a plain
+// file, not a memfd made with MFD_ALLOW_SEALING), and the buffers made from
+// them, with their own descriptor of the file so its size can be checked
+// when they are used (ShmBufferFitsItsFile()). Entries go when their
+// resource is destroyed, before its user data. The listener comes first, so
+// the entry is found from it.
+struct UnsealedPool {
+  wl_listener destroy_listener;
+  SharedMemory* pool;
+  base::ScopedFD fd;
+};
+
+struct UnsealedBuffer {
+  wl_listener destroy_listener;
+  Buffer* buffer;
+  base::ScopedFD fd;
+  uint64_t end;  // offset + stride * height: how much of the file it reads
+};
+
+std::map<SharedMemory*, UnsealedPool*>& UnsealedPools() {
+  static base::NoDestructor<std::map<SharedMemory*, UnsealedPool*>> pools;
+  return *pools;
+}
+
+std::map<Buffer*, UnsealedBuffer*>& UnsealedBuffers() {
+  static base::NoDestructor<std::map<Buffer*, UnsealedBuffer*>> buffers;
+  return *buffers;
+}
+
+void OnUnsealedPoolDestroyed(wl_listener* listener, void* data) {
+  auto* entry = reinterpret_cast<UnsealedPool*>(listener);
+  UnsealedPools().erase(entry->pool);
+  delete entry;
+}
+
+void OnUnsealedBufferDestroyed(wl_listener* listener, void* data) {
+  auto* entry = reinterpret_cast<UnsealedBuffer*>(listener);
+  UnsealedBuffers().erase(entry->buffer);
+  delete entry;
+}

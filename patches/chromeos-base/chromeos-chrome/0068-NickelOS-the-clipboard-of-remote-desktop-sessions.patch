+// NickelOS: the clipboard of remote desktop sessions (NickelClipboard):
+// (token) -> (state, MIME types).
+void VmApplicationsServiceProvider::NickelClipboardFormats(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string token;
+  if (!reader.PopString(&token)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS, "Expected a token"));
+    return;
+  }
+  NickelClipboard::Formats(
+      token,
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             const std::string& state,
+             const std::vector<std::string>& mime_types) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter writer(response.get());
+            writer.AppendString(state);
+            writer.AppendArrayOfStrings(mime_types);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
+// (token, MIME type) -> (found, data).
+void VmApplicationsServiceProvider::NickelClipboardRead(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string token;
+  std::string mime_type;
+  if (!reader.PopString(&token) || !reader.PopString(&mime_type)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected a token and a MIME type"));
+    return;
+  }
+  NickelClipboard::Read(
+      token, mime_type,
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             std::optional<std::vector<uint8_t>> data) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter writer(response.get());
+            writer.AppendBool(data.has_value());
+            const std::vector<uint8_t> empty;
+            writer.AppendArrayOfBytes(data ? *data : empty);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
+// (token, MIME type, data) -> (done).
+void VmApplicationsServiceProvider::NickelClipboardWrite(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string token;
+  std::string mime_type;
+  base::span<const uint8_t> data;
+  if (!reader.PopString(&token) || !reader.PopString(&mime_type) ||
+      !reader.PopArrayOfBytes(&data)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected a token, a MIME type and data"));
+    return;
+  }
+  const bool done = NickelClipboard::Write(
+      token, mime_type, std::vector<uint8_t>(data.begin(), data.end()));
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter(response.get()).AppendBool(done);
+  std::move(response_sender).Run(std::move(response));
+}
+

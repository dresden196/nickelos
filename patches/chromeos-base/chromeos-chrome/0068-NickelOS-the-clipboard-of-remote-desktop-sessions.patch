+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_CLIPBOARD_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_CLIPBOARD_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+
+namespace ash {
+
+// NickelOS: the clipboard for the Clipboard portal of remote desktop sessions
+// (RustDesk, AnyDesk, Deskflow), for the NickelOS portal backend
+// (xdg-desktop-portal-nickel) through VmApplicationsService: what the other
+// computer copies reaches this one's clipboard, and the other way round.
+// Only during a session the user allowed (a NickelRemoteDesktop token);
+// otherwise nothing, so no other process reads the clipboard through here.
+class NickelClipboard {
+ public:
+  // The clipboard's state (a token, new with every change) and its MIME
+  // types: text as text/plain;charset=utf-8, text/plain, UTF8_STRING, STRING
+  // and TEXT (what X11 and Wayland apps ask for), text/html, image/png.
+  using FormatsCallback =
+      base::OnceCallback<void(const std::string& state,
+                              const std::vector<std::string>& mime_types)>;
+  static void Formats(const std::string& token, FormatsCallback callback);
+
+  // The clipboard's text (UTF-8), HTML (UTF-8) or PNG, as `mime_type` asks;
+  // nothing if it has none.
+  using ReadCallback =
+      base::OnceCallback<void(std::optional<std::vector<uint8_t>> data)>;
+  static void Read(const std::string& token,
+                   const std::string& mime_type,
+                   ReadCallback callback);
+
+  // Puts text or HTML (UTF-8) on the clipboard. Pictures are not taken:
+  // decoding another computer's images here, in Chrome's browser process,
+  // is not worth the risk.
+  static bool Write(const std::string& token,
+                    const std::string& mime_type,
+                    const std::vector<uint8_t>& data);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_CLIPBOARD_H_

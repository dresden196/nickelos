@@ -0,0 +1,135 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_clipboard.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ash/dbus/vm/nickel_remote_desktop.h"
+#include "ui/base/clipboard/clipboard.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "url/gurl.h"
+
+namespace ash {
+
+namespace {
+
+constexpr ui::ClipboardBuffer kBuffer = ui::ClipboardBuffer::kCopyPaste;
+// The names text goes by for X11 and Wayland apps.
+constexpr const char* kTextTypes[] = {"text/plain;charset=utf-8", "text/plain",
+                                      "UTF8_STRING", "STRING", "TEXT"};
+constexpr char kHtml[] = "text/html";
+constexpr char kPng[] = "image/png";
+
+bool IsText(const std::string& mime_type) {
+  for (const char* type : kTextTypes) {
+    if (mime_type == type) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::vector<uint8_t> Bytes(const std::u16string& text) {
+  const std::string utf8 = base::UTF16ToUTF8(text);
+  return std::vector<uint8_t>(utf8.begin(), utf8.end());
+}
+
+}  // namespace
+
+// static
+void NickelClipboard::Formats(const std::string& token,
+                              FormatsCallback callback) {
+  if (!NickelRemoteDesktop::IsActive(token)) {
+    std::move(callback).Run(std::string(), {});
+    return;
+  }
+  ui::Clipboard* clipboard = ui::Clipboard::GetForCurrentThread();
+  const std::string state = clipboard->GetSequenceNumber(kBuffer).ToString();
+  clipboard->ReadAvailableTypes(
+      kBuffer, std::nullopt,
+      base::BindOnce(
+          [](FormatsCallback callback, const std::string& state,
+             std::vector<std::u16string> types) {
+            std::vector<std::string> mime_types;
+            for (const std::u16string& type : types) {
+              const std::string mime_type = base::UTF16ToUTF8(type);
+              if (mime_type == "text/plain") {
+                mime_types.insert(mime_types.end(), std::begin(kTextTypes),
+                                  std::end(kTextTypes));
+              } else if (mime_type == kHtml || mime_type == kPng) {
+                mime_types.push_back(mime_type);
+              }
+            }
+            std::move(callback).Run(state, mime_types);
+          },
+          std::move(callback), state));
+}
+
+// static
+void NickelClipboard::Read(const std::string& token,
+                           const std::string& mime_type,
+                           ReadCallback callback) {
+  if (!NickelRemoteDesktop::IsActive(token)) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  ui::Clipboard* clipboard = ui::Clipboard::GetForCurrentThread();
+  if (IsText(mime_type)) {
+    clipboard->ReadText(kBuffer, std::nullopt,
+                        base::BindOnce(
+                            [](ReadCallback callback, std::u16string text) {
+                              std::move(callback).Run(Bytes(text));
+                            },
+                            std::move(callback)));
+  } else if (mime_type == kHtml) {
+    clipboard->ReadHTML(
+        kBuffer, std::nullopt,
+        base::BindOnce(
+            [](ReadCallback callback, std::u16string markup, GURL, uint32_t,
+               uint32_t) { std::move(callback).Run(Bytes(markup)); },
+            std::move(callback)));
+  } else if (mime_type == kPng) {
+    clipboard->ReadPng(kBuffer, std::nullopt,
+                       base::BindOnce(
+                           [](ReadCallback callback,
+                              const std::vector<uint8_t>& png) {
+                             if (png.empty()) {
+                               std::move(callback).Run(std::nullopt);
+                             } else {
+                               std::move(callback).Run(png);
+                             }
+                           },
+                           std::move(callback)));
+  } else {
+    std::move(callback).Run(std::nullopt);
+  }
+}
+
+// static
+bool NickelClipboard::Write(const std::string& token,
+                            const std::string& mime_type,
+                            const std::vector<uint8_t>& data) {
+  if (!NickelRemoteDesktop::IsActive(token) ||
+      (!IsText(mime_type) && mime_type != kHtml)) {
+    return false;
+  }
+  const std::string utf8(data.begin(), data.end());
+  if (!base::IsStringUTF8(utf8)) {
+    return false;
+  }
+  ui::ScopedClipboardWriter writer(kBuffer);
+  if (mime_type == kHtml) {
+    writer.WriteHTML(base::UTF8ToUTF16(utf8), std::string());
+  } else {
+    writer.WriteText(base::UTF8ToUTF16(utf8));
+  }
+  return true;
+}
+
+}  // namespace ash

+  nickel_loader_ = NickelLoader(GURL(kNickelLocationUrl), "POST",
+                                kNickelLocationTag);
+  nickel_loader_->AttachStringForUpload("{}", "application/json");
+  nickel_loader_->DownloadToString(
+      GetURLLoaderFactory().get(),
+      base::BindOnce(&AmbientClientImpl::OnNickelLocation,
+                     weak_factory_.GetWeakPtr()),
+      kNickelMaxResponseBytes);
+}
+
+void AmbientClientImpl::OnNickelLocation(std::optional<std::string> body) {
+  nickel_loader_.reset();
+  auto reply = body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+                    : std::nullopt;
+  const base::DictValue* location =
+      reply ? reply->FindDict("location") : nullptr;
+  const std::optional<double> lat =
+      location ? location->FindDouble("lat") : std::nullopt;
+  const std::optional<double> lng =
+      location ? location->FindDouble("lng") : std::nullopt;
+  if (!lat || !lng) {
+    LOG(WARNING) << "nickel: no location for the screen saver's weather";
+    FinishNickelWeather(std::nullopt);
+    return;
+  }
+  // About a kilometre: all the weather needs.
+  nickel_location_ = std::make_pair(std::round(*lat * 100) / 100,
+                                    std::round(*lng * 100) / 100);
+  nickel_location_time_ = base::Time::Now();
+  FetchNickelForecast();
+}
+
+void AmbientClientImpl::FetchNickelForecast() {
+  const GURL url(base::StrCat(
+      {kNickelForecastUrl,
+       "?latitude=", base::NumberToString(nickel_location_->first),
+       "&longitude=", base::NumberToString(nickel_location_->second),
+       "&current=temperature_2m,weather_code,is_day"
+       "&temperature_unit=fahrenheit"}));
+  nickel_loader_ = NickelLoader(url, "GET", kNickelWeatherTag);
+  nickel_loader_->DownloadToString(
+      GetURLLoaderFactory().get(),
+      base::BindOnce(&AmbientClientImpl::OnNickelForecast,
+                     weak_factory_.GetWeakPtr()),
+      kNickelMaxResponseBytes);
+}
+
+void AmbientClientImpl::OnNickelForecast(std::optional<std::string> body) {
+  nickel_loader_.reset();
+  auto reply = body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+                    : std::nullopt;
+  const base::DictValue* current = reply ? reply->FindDict("current") : nullptr;
+  const std::optional<double> temp_f =
+      current ? current->FindDouble("temperature_2m") : std::nullopt;
+  const std::optional<int> code =
+      current ? current->FindInt("weather_code") : std::nullopt;
+  if (!temp_f || !code) {
+    LOG(WARNING) << "nickel: no weather for the screen saver";
+    FinishNickelWeather(std::nullopt);
+    return;
+  }
+  const bool day = current->FindInt("is_day").value_or(1) != 0;
+  ash::WeatherInfo weather;
+  weather.temp_f = static_cast<float>(*temp_f);
+  weather.condition_icon_url =
+      base::StrCat({"nickel-weather:", NickelWeatherKind(*code, day)});
+  nickel_weather_ = weather;
+  nickel_weather_time_ = base::Time::Now();
+  FinishNickelWeather(weather);
+}
+
+void AmbientClientImpl::FinishNickelWeather(
+    const std::optional<ash::WeatherInfo>& weather) {
+  if (nickel_weather_callback_) {
+    std::move(nickel_weather_callback_).Run(weather);
+  }
+}

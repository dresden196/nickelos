   base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
       FROM_HERE,
       base::BindOnce(std::move(callback),
@@ -66,9 +86,25 @@ void NickelAmbientBackendController::FetchSettingsAndAlbums(
 void NickelAmbientBackendController::FetchWeather(
     std::optional<std::string> weather_client_id,
     FetchWeatherCallback callback) {
-  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
-      FROM_HERE,
-      base::BindOnce(std::move(callback), std::optional<WeatherInfo>()));
+  PrefService* prefs = GetPrefs();
+  if (!prefs || !prefs->GetBoolean(prefs::kNickelScreenSaverWeather) ||
+      !AmbientClient::Get()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(std::move(callback), std::optional<WeatherInfo>()));
+    return;
+  }
+  const bool celsius = prefs->GetBoolean(prefs::kNickelScreenSaverCelsius);
+  AmbientClient::Get()->FetchNickelWeather(base::BindOnce(
+      [](bool celsius, FetchWeatherCallback callback,
+         const std::optional<WeatherInfo>& weather) {
+        std::optional<WeatherInfo> shown = weather;
+        if (shown) {
+          shown->show_celsius = celsius;
+        }
+        std::move(callback).Run(shown);
+      },
+      celsius, std::move(callback)));
 }
 

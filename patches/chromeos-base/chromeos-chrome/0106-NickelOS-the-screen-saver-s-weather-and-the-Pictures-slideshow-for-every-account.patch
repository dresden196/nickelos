+// NickelOS: the weather's icon (AmbientClient::FetchNickelWeather names one,
+// "nickel-weather:<kind>"), drawn from the system's emoji font: nothing to
+// download, and colours as the rest of the system shows the weather.
+constexpr char kNickelWeatherPrefix[] = "nickel-weather:";
+constexpr int kNickelWeatherIconDip = 32;
+
+class NickelWeatherIconSource : public gfx::CanvasImageSource {
+ public:
+  explicit NickelWeatherIconSource(std::u16string emoji)
+      : gfx::CanvasImageSource(
+            gfx::Size(kNickelWeatherIconDip, kNickelWeatherIconDip)),
+        emoji_(std::move(emoji)) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    const gfx::FontList font({"Noto Color Emoji"}, gfx::Font::NORMAL,
+                             kNickelWeatherIconDip * 3 / 4,
+                             gfx::Font::Weight::NORMAL);
+    canvas->DrawStringRectWithFlags(emoji_, font, SK_ColorWHITE,
+                                    gfx::Rect(size()),
+                                    gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const std::u16string emoji_;
+};
+
+gfx::ImageSkia NickelWeatherIcon(std::string_view kind) {
+  static constexpr struct {
+    const char* kind;
+    const char16_t* emoji;
+  } kIcons[] = {
+      {"clear-day", u"\u2600\uFE0F"},
+      {"clear-night", u"\U0001F319"},
+      {"mostly-clear-day", u"\U0001F324\uFE0F"},
+      {"partly-cloudy-day", u"\u26C5"},
+      {"partly-cloudy-night", u"\u2601\uFE0F"},
+      {"cloudy", u"\u2601\uFE0F"},
+      {"fog", u"\U0001F32B\uFE0F"},
+      {"drizzle", u"\U0001F327\uFE0F"},
+      {"rain", u"\U0001F327\uFE0F"},
+      {"showers-day", u"\U0001F326\uFE0F"},
+      {"snow", u"\U0001F328\uFE0F"},
+      {"thunderstorm", u"\u26C8\uFE0F"},
+  };
+  for (const auto& icon : kIcons) {
+    if (kind == icon.kind) {
+      const gfx::Size size(kNickelWeatherIconDip, kNickelWeatherIconDip);
+      return gfx::ImageSkia(
+          std::make_unique<NickelWeatherIconSource>(icon.emoji), size);
+    }
+  }
+  return gfx::ImageSkia();
+}
+
 }  // namespace
 
 AmbientWeatherController::ScopedRefresher::ScopedRefresher(
@@ -143,6 +204,9 @@ void AmbientWeatherController::StartDownloadingWeatherConditionIcon(
     const std::optional<WeatherInfo>& weather_info) {
   if (!weather_info) {
     LOG(WARNING) << "No weather info included in the response.";
+    // NickelOS: none (turned off, or nothing to be had): none shown, rather
+    // than what there was before.
+    ClearAmbientWeatherModel();
     return;
   }
 
@@ -157,6 +221,15 @@ void AmbientWeatherController::StartDownloadingWeatherConditionIcon(
     return;
   }
 
+  const std::string& icon_url = weather_info->condition_icon_url.value();
+  if (base::StartsWith(icon_url, kNickelWeatherPrefix)) {
+    OnWeatherConditionIconDownloaded(
+        weather_info->temp_f.value(), weather_info->show_celsius,
+        NickelWeatherIcon(
+            std::string_view(icon_url).substr(strlen(kNickelWeatherPrefix))));
+    return;
+  }
+
   // Ideally we should avoid downloading from the same url again to reduce the
   // overhead, as it's unlikely that the weather condition is changing
   // frequently during the day.

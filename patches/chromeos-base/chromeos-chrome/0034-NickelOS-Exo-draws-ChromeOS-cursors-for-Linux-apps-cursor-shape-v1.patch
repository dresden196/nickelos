+
+#ifndef COMPONENTS_EXO_WAYLAND_WP_CURSOR_SHAPE_H_
+#define COMPONENTS_EXO_WAYLAND_WP_CURSOR_SHAPE_H_
+
+#include <stdint.h>
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// NickelOS: wp_cursor_shape_v1 (wayland-protocols, staging). A Linux app names
+// the cursor it wants (CSS cursor names) and Ash draws its own, ChromeOS's,
+// cursor of that shape, as zcr_cursor_shapes_v1 does for ChromeOS's own
+// clients; apps that draw their own cursor need a cursor theme instead.
+void bind_cursor_shape(wl_client* client,
+                       void* data,
+                       uint32_t version,
+                       uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_WP_CURSOR_SHAPE_H_

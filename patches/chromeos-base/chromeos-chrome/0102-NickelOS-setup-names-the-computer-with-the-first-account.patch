+      user_manager::UserManager::Get()->GetPersistedUsers().empty();
+  if (!ask_computer_name_) {
+    view_->Show(std::move(data));
+    return;
+  }
+  dbus::MethodCall method_call(dbus::kPropertiesInterface,
+                               dbus::kPropertiesGetAll);
+  dbus::MessageWriter(&method_call).AppendString(kHostnameInterface);
+  HostnameProxy()->CallMethod(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&LocalAccountCreationScreen::OnComputerInfo,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(data)));
+}
+
+void LocalAccountCreationScreen::OnComputerInfo(base::DictValue data,
+                                                dbus::Response* response) {
+  if (!view_) {
+    return;
+  }
+  std::string vendor, model, chassis;
+  if (response) {
+    dbus::MessageReader reader(response);
+    dbus::MessageReader properties(nullptr);
+    if (reader.PopArray(&properties)) {
+      while (properties.HasMoreData()) {
+        dbus::MessageReader entry(nullptr);
+        std::string key, value;
+        if (!properties.PopDictEntry(&entry) || !entry.PopString(&key)) {
+          break;
+        }
+        if (!entry.PopVariantOfString(&value)) {
+          continue;
+        }
+        if (key == "HardwareVendor") {
+          vendor = value;
+        } else if (key == "HardwareModel") {
+          model = value;
+        } else if (key == "Chassis") {
+          chassis = value;
+        }
+      }
+    }
+  }
+  data.Set("askComputerName", true);
+  data.Set("computerModel", ComputerModel(vendor, model, chassis));
+  data.Set("computerChassis", chassis);
+  view_->Show(std::move(data));
 }
 

+// nickel-hostnamed: the computer's name (org.freedesktop.hostname1, and
+// org.nickelos.Hostname1's SetName for the name as typed).
+constexpr char kHostnameService[] = "org.freedesktop.hostname1";
+constexpr char kHostnamePath[] = "/org/freedesktop/hostname1";
+constexpr char kHostnameInterface[] = "org.freedesktop.hostname1";
+constexpr char kNickelHostnameInterface[] = "org.nickelos.Hostname1";
+
+dbus::ObjectProxy* HostnameProxy() {
+  return DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      kHostnameService, dbus::ObjectPath(kHostnamePath));
+}
+
+// The computer's model for its default name, or "" when the firmware's is no
+// use: placeholders board makers leave, or a desktop's motherboard name.
+std::string ComputerModel(const std::string& vendor,
+                          const std::string& model,
+                          const std::string& chassis) {
+  const std::string lower = base::ToLowerASCII(model);
+  for (const char* junk :
+       {"default string", "to be filled by o.e.m.", "system product name",
+        "not applicable", "none", "system version", "o.e.m.", "unknown"}) {
+    if (lower.empty() || lower == junk) {
+      return "";
+    }
+  }
+  if (chassis == "desktop") {
+    const std::string maker = base::ToLowerASCII(vendor);
+    for (const char* board : {"gigabyte", "asrock", "micro-star", "asustek",
+                              "biostar", "supermicro"}) {
+      if (maker.find(board) != std::string::npos) {
+        return "";
+      }
+    }
+  }
+  return model;
+}

+// NickelOS: what clients limited to the standard protocols see
+// (Server::LimitToStandardProtocols): the protocols of wayland and
+// wayland-protocols that Exo serves, and Chrome's text-input extension, which
+// sommelier passes on to Crostini's apps too. Exo's own protocols were written
+// for trusted clients (ARC, Lacros, sommelier); Linux apps that found them
+// could take the whole desktop down (Chrome patch 0011). A client cannot bind
+// what it is not shown: libwayland answers with a protocol error.
+bool IsStandardGlobal(const wl_client* client,
+                      const wl_global* global,
+                      void* data) {
+  static constexpr auto kStandard = base::MakeFixedFlatSet<std::string_view>({
+      "wl_compositor",
+      "wl_data_device_manager",
+      "wl_output",
+      "wl_seat",
+      "wl_shell",
+      "wl_shm",
+      "wl_subcompositor",
+      "wp_content_type_manager_v1",
+      "wp_fractional_scale_manager_v1",
+      "wp_presentation",
+      "wp_single_pixel_buffer_manager_v1",
+      "wp_viewporter",
+      "xdg_activation_v1",
+      "xdg_wm_base",
+      "zcr_text_input_extension_v1",
+      "zwp_idle_inhibit_manager_v1",
+      "zwp_input_timestamps_manager_v1",
+      "zwp_keyboard_shortcuts_inhibit_manager_v1",
+      "zwp_linux_dmabuf_v1",
+      "zwp_pointer_constraints_v1",
+      "zwp_pointer_gestures_v1",
+      "zwp_relative_pointer_manager_v1",
+      "zwp_text_input_manager_v1",
+      "zxdg_decoration_manager_v1",
+      "zxdg_output_manager_v1",
+  });
+  return kStandard.contains(wl_global_get_interface(global)->name);
+}

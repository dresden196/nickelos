+// NickelOS: nickel-open, the handler Linux apps open files and folders with
+// (xdg-open, GIO, the OpenURI portal), asks ChromeOS to open a file with the
+// app it opens that kind of file with (the user's default), to open a folder
+// in Files ("folder"), or to show a file in its folder ("show"), as the Files
+// app does. Failures show ChromeOS's own notification.
+void VmApplicationsServiceProvider::NickelOpenPath(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string path_string;
+  std::string how;
+  if (!reader.PopString(&path_string) || !reader.PopString(&how)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected a path and how to open it"));
+    return;
+  }
+  base::FilePath path(path_string);
+  Profile* profile = ProfileManager::GetPrimaryUserProfile();
+  if (!path.IsAbsolute() || path.ReferencesParent() || !profile) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS, "Not an absolute path"));
+    return;
+  }
+  // Linux apps' home, /home/chronos/user, is a bind mount of the profile
+  // directory (/home/chronos/u-<hash>), under which ChromeOS's volumes are.
+  base::FilePath in_home;
+  if (base::FilePath("/home/chronos/user").AppendRelativePath(path, &in_home)) {
+    path = profile->GetPath().Append(in_home);
+  }
+  if (how == "show") {
+    platform_util::ShowItemInFolder(profile, path);
+  } else {
+    platform_util::OpenItem(profile, path,
+                            how == "folder" ? platform_util::OPEN_FOLDER
+                                            : platform_util::OPEN_FILE,
+                            platform_util::OpenOperationCallback());
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}

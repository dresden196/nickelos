+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_EXO_WAYLAND_ZWP_PRIMARY_SELECTION_H_
+#define COMPONENTS_EXO_WAYLAND_ZWP_PRIMARY_SELECTION_H_
+
+#include <stdint.h>
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// NickelOS: zwp_primary_selection_device_manager_v1 (wayland-protocols,
+// unstable): the primary selection, middle-click paste, between Linux apps.
+// The last app to select text owns it; the app with the keyboard focus is
+// offered it. ChromeOS has no primary selection of its own, so it stays
+// among Linux apps (Exo's sockets share it, X11 apps' through sommelier).
+void bind_primary_selection_device_manager(wl_client* client,
+                                           void* data,
+                                           uint32_t version,
+                                           uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_ZWP_PRIMARY_SELECTION_H_

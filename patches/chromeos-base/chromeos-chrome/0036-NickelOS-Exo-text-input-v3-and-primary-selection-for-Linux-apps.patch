diff --git a/components/exo/wayland/zwp_primary_selection.cc b/components/exo/wayland/zwp_primary_selection.cc
new file mode 100644
index 0000000000000..a3942de313c7e
--- /dev/null
+++ b/components/exo/wayland/zwp_primary_selection.cc
@@ -0,0 +1,307 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/zwp_primary_selection.h"
+
+#include <primary-selection-unstable-v1-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "components/exo/seat.h"
+#include "components/exo/seat_observer.h"
+#include "components/exo/surface.h"
+#include "components/exo/wayland/server_util.h"
+#include "components/exo/wayland/wl_seat.h"
+
+namespace exo::wayland {
+namespace {
+
+constexpr int kPrimarySelectionSeatObserverPriority = 1;
+
+class PrimarySelectionSource;
+class PrimarySelectionDevice;
+
+// The primary selection: its source, and every client's devices, which are
+// offered it while their client has the keyboard focus. One for all of
+// Exo's servers.
+struct PrimarySelection {
+  raw_ptr<PrimarySelectionSource> source = nullptr;
+  std::set<raw_ptr<PrimarySelectionDevice>> devices;
+};
+
+PrimarySelection& GetPrimarySelection() {
+  static base::NoDestructor<PrimarySelection> selection;
+  return *selection;
+}
+
+void OfferToFocusedClient();
+
+class PrimarySelectionSource {
+ public:
+  explicit PrimarySelectionSource(wl_resource* resource)
+      : resource_(resource) {}
+  PrimarySelectionSource(const PrimarySelectionSource&) = delete;
+  PrimarySelectionSource& operator=(const PrimarySelectionSource&) = delete;
+  ~PrimarySelectionSource() {
+    PrimarySelection& selection = GetPrimarySelection();
+    if (selection.source == this) {
+      selection.source = nullptr;
+      OfferToFocusedClient();
+    }
+  }
+
+  void Offer(const char* mime_type) { mime_types_.emplace_back(mime_type); }
+  const std::vector<std::string>& mime_types() const { return mime_types_; }
+
+  // The client writes the selection into |fd| (libwayland sends a copy).
+  void Send(const std::string& mime_type, int fd) {
+    zwp_primary_selection_source_v1_send_send(resource_, mime_type.c_str(),
+                                              fd);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  void Cancel() {
+    zwp_primary_selection_source_v1_send_cancelled(resource_);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  base::WeakPtr<PrimarySelectionSource> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  const raw_ptr<wl_resource> resource_;
+  std::vector<std::string> mime_types_;
+  base::WeakPtrFactory<PrimarySelectionSource> weak_factory_{this};
+};
+
+// An offer of the source that was the selection when it was made; once
+// another selection replaced it, receiving gets nothing (the fd is closed).
+class PrimarySelectionOffer {
+ public:
+  explicit PrimarySelectionOffer(base::WeakPtr<PrimarySelectionSource> source)
+      : source_(std::move(source)) {}
+
+  void Receive(const char* mime_type, int fd) {
+    base::ScopedFD owned_fd(fd);
+    if (source_ && GetPrimarySelection().source == source_.get()) {
+      source_->Send(mime_type, owned_fd.get());
+    }
+  }
+
+ private:
+  base::WeakPtr<PrimarySelectionSource> source_;
+};
+
+void offer_receive(wl_client* client,
+                   wl_resource* resource,
+                   const char* mime_type,
+                   int32_t fd) {
+  GetUserDataAs<PrimarySelectionOffer>(resource)->Receive(mime_type, fd);
+}
+
+void offer_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct zwp_primary_selection_offer_v1_interface offer_implementation =
+    {
+        offer_receive,
+        offer_destroy,
+};
+
+class PrimarySelectionDevice : public SeatObserver {
+ public:
+  PrimarySelectionDevice(wl_resource* resource, Seat* seat)
+      : resource_(resource), seat_(seat->GetWeakPtr()) {
+    GetPrimarySelection().devices.insert(this);
+    seat->AddObserver(this, kPrimarySelectionSeatObserverPriority);
+    if (HasFocus()) {
+      Offer();
+    }
+  }
+  PrimarySelectionDevice(const PrimarySelectionDevice&) = delete;
+  PrimarySelectionDevice& operator=(const PrimarySelectionDevice&) = delete;
+  ~PrimarySelectionDevice() override {
+    GetPrimarySelection().devices.erase(this);
+    if (seat_) {
+      seat_->RemoveObserver(this);
+    }
+  }
+
+  void SetSelection(PrimarySelectionSource* source) {
+    PrimarySelection& selection = GetPrimarySelection();
+    if (selection.source == source) {
+      return;
+    }
+    PrimarySelectionSource* previous = selection.source;
+    selection.source = source;
+    if (previous) {
+      previous->Cancel();
+    }
+    OfferToFocusedClient();
+  }
+
+  // True if this device's client has the keyboard focus.
+  bool HasFocus() const {
+    Surface* focused = seat_ ? seat_->GetFocusedSurface() : nullptr;
+    if (!focused) {
+      return false;
+    }
+    wl_resource* surface_resource = GetSurfaceResource(focused);
+    return surface_resource && wl_resource_get_client(surface_resource) ==
+                                   wl_resource_get_client(resource_);
+  }
+
+  // Offers the client the current selection (or none).
+  void Offer() {
+    PrimarySelectionSource* source = GetPrimarySelection().source;
+    wl_client* client = wl_resource_get_client(resource_);
+    if (!source) {
+      zwp_primary_selection_device_v1_send_selection(resource_, nullptr);
+      wl_client_flush(client);
+      return;
+    }
+    wl_resource* offer_resource =
+        wl_resource_create(client, &zwp_primary_selection_offer_v1_interface,
+                           wl_resource_get_version(resource_), 0);
+    SetImplementation(
+        offer_resource, &offer_implementation,
+        std::make_unique<PrimarySelectionOffer>(source->GetWeakPtr()));
+    zwp_primary_selection_device_v1_send_data_offer(resource_, offer_resource);
+    for (const std::string& mime_type : source->mime_types()) {
+      zwp_primary_selection_offer_v1_send_offer(offer_resource,
+                                                mime_type.c_str());
+    }
+    zwp_primary_selection_device_v1_send_selection(resource_, offer_resource);
+    wl_client_flush(client);
+  }
+
+ private:
+  // SeatObserver:
+  void OnSurfaceFocused(Surface* gained_focus,
+                        Surface* lost_focus,
+                        bool has_focused_client) override {
+    if (gained_focus && HasFocus()) {
+      Offer();
+    }
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  const base::WeakPtr<Seat> seat_;
+};
+
+void OfferToFocusedClient() {
+  // Copied: offering creates resources, not devices, but stay safe.
+  std::vector<PrimarySelectionDevice*> devices;
+  for (PrimarySelectionDevice* device : GetPrimarySelection().devices) {
+    devices.push_back(device);
+  }
+  for (PrimarySelectionDevice* device : devices) {
+    if (device->HasFocus()) {
+      device->Offer();
+    }
+  }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// zwp_primary_selection_source_v1 interface:
+
+void source_offer(wl_client* client,
+                  wl_resource* resource,
+                  const char* mime_type) {
+  GetUserDataAs<PrimarySelectionSource>(resource)->Offer(mime_type);
+}
+
+void source_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct zwp_primary_selection_source_v1_interface
+    source_implementation = {
+        source_offer,
+        source_destroy,
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// zwp_primary_selection_device_v1 interface:
+
+void device_set_selection(wl_client* client,
+                          wl_resource* resource,
+                          wl_resource* source_resource,
+                          uint32_t serial) {
+  GetUserDataAs<PrimarySelectionDevice>(resource)->SetSelection(
+      source_resource ? GetUserDataAs<PrimarySelectionSource>(source_resource)
+                      : nullptr);
+}
+
+void device_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct zwp_primary_selection_device_v1_interface
+    device_implementation = {
+        device_set_selection,
+        device_destroy,
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// zwp_primary_selection_device_manager_v1 interface:
+
+void manager_create_source(wl_client* client,
+                           wl_resource* resource,
+                           uint32_t id) {
+  wl_resource* source_resource =
+      wl_resource_create(client, &zwp_primary_selection_source_v1_interface,
+                         wl_resource_get_version(resource), id);
+  SetImplementation(source_resource, &source_implementation,
+                    std::make_unique<PrimarySelectionSource>(source_resource));
+}
+
+void manager_get_device(wl_client* client,
+                        wl_resource* resource,
+                        uint32_t id,
+                        wl_resource* seat_resource) {
+  Seat* seat = GetUserDataAs<WaylandSeat>(seat_resource)->seat;
+  wl_resource* device_resource =
+      wl_resource_create(client, &zwp_primary_selection_device_v1_interface,
+                         wl_resource_get_version(resource), id);
+  SetImplementation(
+      device_resource, &device_implementation,
+      std::make_unique<PrimarySelectionDevice>(device_resource, seat));
+}
+
+void manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct zwp_primary_selection_device_manager_v1_interface
+    manager_implementation = {
+        manager_create_source,
+        manager_get_device,
+        manager_destroy,
+};
+
+}  // namespace
+
+void bind_primary_selection_device_manager(wl_client* client,
+                                           void* data,
+                                           uint32_t version,
+                                           uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &zwp_primary_selection_device_manager_v1_interface, 1, id);
+  wl_resource_set_implementation(resource, &manager_implementation, data,
+                                 nullptr);
+}
+
+}  // namespace exo::wayland

new file mode 100644
index 0000000000000..a9582d3499f72
--- /dev/null
+++ b/components/exo/wayland/zwp_text_input_v3.cc
@@ -0,0 +1,560 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/zwp_text_input_v3.h"
+
+#include <text-input-unstable-v3-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_offset_string_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/exo/seat.h"
+#include "components/exo/seat_observer.h"
+#include "components/exo/surface.h"
+#include "components/exo/surface_observer.h"
+#include "components/exo/text_input.h"
+#include "components/exo/wayland/server_util.h"
+#include "components/exo/wayland/wl_seat.h"
+#include "ui/base/ime/composition_text.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/base/ime/text_input_flags.h"
+#include "ui/base/ime/text_input_mode.h"
+#include "ui/base/ime/text_input_type.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/range/range.h"
+
+namespace exo::wayland {
+namespace {
+
+// Seat observers of this priority run after the keyboard's (1 is the
+// highest Seat allows), so wl_keyboard.enter comes first.
+constexpr int kTextInputV3SeatObserverPriority = 1;
+
+class TextInputV3;
+
+// The input method's side: TextInput owns it and calls it; it passes the
+// calls on to the protocol object.
+class TextInputV3Delegate : public TextInput::Delegate {
+ public:
+  explicit TextInputV3Delegate(TextInputV3* owner) : owner_(owner) {}
+  ~TextInputV3Delegate() override = default;
+
+ private:
+  // TextInput::Delegate:
+  void Activated() override {}
+  void Deactivated() override {}
+  void OnVirtualKeyboardVisibilityChanged(bool is_visible) override {}
+  void OnVirtualKeyboardOccludedBoundsChanged(
+      const gfx::Rect& screen_bounds) override {}
+  bool SupportsFinalizeVirtualKeyboardChanges() override { return false; }
+  void SetCompositionText(const ui::CompositionText& composition) override;
+  void Commit(std::u16string_view text) override;
+  // text-input-v3 cannot move the client's cursor.
+  void SetCursor(std::u16string_view surrounding_text,
+                 const gfx::Range& selection) override {}
+  void DeleteSurroundingText(std::u16string_view surrounding_text,
+                             const gfx::Range& range) override;
+  void SendKey(const ui::KeyEvent& event) override;
+  void OnTextDirectionChanged(base::i18n::TextDirection direction) override {}
+  void SetCompositionFromExistingText(
+      std::u16string_view surrounding_text,
+      const gfx::Range& cursor,
+      const gfx::Range& range,
+      const std::vector<ui::ImeTextSpan>& ui_ime_text_spans) override {}
+  void ClearGrammarFragments(std::u16string_view surrounding_text,
+                             const gfx::Range& range) override {}
+  void AddGrammarFragment(std::u16string_view surrounding_text,
+                          const ui::GrammarFragment& fragment) override {}
+  void SetAutocorrectRange(std::u16string_view surrounding_text,
+                           const gfx::Range& range) override {}
+  // Not supported: TextInput then commits the composition itself.
+  bool ConfirmComposition(bool keep_selection) override { return false; }
+  bool SupportsConfirmPreedit() override { return false; }
+  bool HasImageInsertSupport() override { return false; }
+  void InsertImage(const GURL& src) override {}
+
+  const raw_ptr<TextInputV3> owner_;
+};
+
+// One zwp_text_input_v3. The compositor tells it where the keyboard focus is
+// (enter and leave, for the client's own surfaces); the client enables it on
+// a text field and sends its state, applied at commit; the input method's
+// preedit, commits and deletions go back as events, each batch closed by
+// done with the number of commits received so far.
+class TextInputV3 : public SeatObserver, public SurfaceObserver {
+ public:
+  TextInputV3(wl_resource* resource, Seat* seat)
+      : resource_(resource),
+        seat_(seat->GetWeakPtr()),
+        text_input_(std::make_unique<TextInput>(
+            std::make_unique<TextInputV3Delegate>(this))) {
+    seat->AddObserver(this, kTextInputV3SeatObserverPriority);
+    Surface* focused = seat->GetFocusedSurface();
+    if (focused && OwnsSurface(focused)) {
+      Enter(focused);
+    }
+  }
+
+  TextInputV3(const TextInputV3&) = delete;
+  TextInputV3& operator=(const TextInputV3&) = delete;
+
+  ~TextInputV3() override {
+    text_input_.reset();
+    if (focus_) {
+      focus_->RemoveSurfaceObserver(this);
+    }
+    if (seat_) {
+      seat_->RemoveObserver(this);
+    }
+  }
+
+  // Requests.
+  void Enable() {
+    // Enabling resets all state from earlier requests.
+    pending_ = State();
+    pending_.enabled = true;
+  }
+  void Disable() { pending_.enabled = false; }
+  void SetSurroundingText(const char* text, int32_t cursor, int32_t anchor) {
+    pending_.surrounding_text = text;
+    pending_.cursor = cursor;
+    pending_.anchor = anchor;
+  }
+  void SetContentType(uint32_t hint, uint32_t purpose) {
+    pending_.content_type = std::make_pair(hint, purpose);
+  }
+  void SetCursorRectangle(const gfx::Rect& rect) {
+    pending_.cursor_rectangle = rect;
+  }
+  void Commit();
+
+  // From the input method.
+  void SendPreedit(const ui::CompositionText& composition);
+  void SendCommit(std::u16string_view text);
+  void SendDeleteSurroundingText(std::u16string_view surrounding_text,
+                                 const gfx::Range& range);
+
+ private:
+  struct State {
+    bool enabled = false;
+    std::optional<std::string> surrounding_text;
+    int32_t cursor = 0;
+    int32_t anchor = 0;
+    std::optional<std::pair<uint32_t, uint32_t>> content_type;
+    std::optional<gfx::Rect> cursor_rectangle;
+  };
+
+  // SeatObserver:
+  void OnSurfaceFocused(Surface* gained_focus,
+                        Surface* lost_focus,
+                        bool has_focused_client) override {
+    if (focus_ && gained_focus != focus_) {
+      Leave();
+    }
+    if (gained_focus && gained_focus != focus_ && OwnsSurface(gained_focus)) {
+      Enter(gained_focus);
+    }
+  }
+
+  // SurfaceObserver:
+  void OnSurfaceDestroying(Surface* surface) override {
+    if (surface != focus_) {
+      return;
+    }
+    // Its resource is gone already: no leave.
+    SetEnabled(false);
+    focus_->RemoveSurfaceObserver(this);
+    focus_ = nullptr;
+  }
+
+  bool OwnsSurface(Surface* surface) const {
+    wl_resource* surface_resource = GetSurfaceResource(surface);
+    return surface_resource && wl_resource_get_client(surface_resource) ==
+                                   wl_resource_get_client(resource_);
+  }
+
+  void Enter(Surface* surface) {
+    focus_ = surface;
+    focus_->AddSurfaceObserver(this);
+    zwp_text_input_v3_send_enter(resource_, GetSurfaceResource(surface));
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  void Leave() {
+    // The client is to disable it; the input method lets go now.
+    SetEnabled(false);
+    pending_ = State();
+    wl_resource* surface_resource = GetSurfaceResource(focus_);
+    focus_->RemoveSurfaceObserver(this);
+    focus_ = nullptr;
+    if (surface_resource) {
+      zwp_text_input_v3_send_leave(resource_, surface_resource);
+      wl_client_flush(wl_resource_get_client(resource_));
+    }
+  }
+
+  void SetEnabled(bool enabled) {
+    if (enabled == enabled_) {
+      return;
+    }
+    if (enabled) {
+      if (!focus_ || !seat_) {
+        return;
+      }
+      text_input_->Activate(seat_.get(), focus_,
+                            ui::TextInputClient::FOCUS_REASON_OTHER);
+    } else {
+      text_input_->Deactivate();
+      surrounding_text_.clear();
+      cursor_ = 0;
+      has_surrounding_text_ = false;
+    }
+    enabled_ = enabled;
+  }
+
+  void ApplyContentType(uint32_t hint, uint32_t purpose);
+  void ApplySurroundingText(const std::string& text,
+                            int32_t cursor,
+                            int32_t anchor);
+
+  void SendDone() {
+    zwp_text_input_v3_send_done(resource_, serial_);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  const base::WeakPtr<Seat> seat_;
+  std::unique_ptr<TextInput> text_input_;
+  // The client's surface with the keyboard focus (enter was sent for it).
+  raw_ptr<Surface> focus_ = nullptr;
+  State pending_;
+  bool enabled_ = false;
+  // The surrounding text and cursor (UTF-8 byte offset) the client last sent.
+  std::string surrounding_text_;
+  int32_t cursor_ = 0;
+  bool has_surrounding_text_ = false;
+  // Commit requests received.
+  uint32_t serial_ = 0;
+};
+
+void TextInputV3::Commit() {
+  ++serial_;
+  const bool was_enabled = enabled_;
+  SetEnabled(pending_.enabled);
+  if (enabled_) {
+    if (pending_.surrounding_text) {
+      ApplySurroundingText(*pending_.surrounding_text, pending_.cursor,
+                           pending_.anchor);
+    }
+    if (pending_.content_type) {
+      ApplyContentType(pending_.content_type->first,
+                       pending_.content_type->second);
+    } else if (!was_enabled) {
+      // An input method needs a text field to work on.
+      text_input_->SetTypeModeFlags(
+          ui::TEXT_INPUT_TYPE_TEXT, ui::TEXT_INPUT_MODE_DEFAULT,
+          ui::TEXT_INPUT_FLAG_NONE, /*should_do_learning=*/true,
+          /*can_compose_inline=*/true, has_surrounding_text_);
+    }
+    if (pending_.cursor_rectangle) {
+      text_input_->SetCaretBounds(*pending_.cursor_rectangle);
+    }
+  }
+  // The state of a commit is applied once; enabled stays.
+  pending_.surrounding_text.reset();
+  pending_.content_type.reset();
+  pending_.cursor_rectangle.reset();
+}
+
+void TextInputV3::ApplySurroundingText(const std::string& text,
+                                       int32_t cursor,
+                                       int32_t anchor) {
+  if (cursor < 0 || anchor < 0) {
+    return;
+  }
+  auto minmax = std::minmax(cursor, anchor);
+  std::vector<size_t> offsets{static_cast<size_t>(minmax.first),
+                              static_cast<size_t>(minmax.second)};
+  std::u16string u16_text = base::UTF8ToUTF16AndAdjustOffsets(text, &offsets);
+  if (offsets[0] == std::u16string::npos ||
+      offsets[1] == std::u16string::npos) {
+    return;
+  }
+  surrounding_text_ = text;
+  cursor_ = cursor;
+  has_surrounding_text_ = true;
+  text_input_->SetSurroundingText(u16_text, /*offset=*/0,
+                                  gfx::Range(offsets[0], offsets[1]),
+                                  std::nullopt, std::nullopt);
+}
+
+void TextInputV3::ApplyContentType(uint32_t hint, uint32_t purpose) {
+  ui::TextInputType type = ui::TEXT_INPUT_TYPE_TEXT;
+  ui::TextInputMode mode = ui::TEXT_INPUT_MODE_DEFAULT;
+  int flags = ui::TEXT_INPUT_FLAG_NONE;
+  bool should_do_learning = true;
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_COMPLETION) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCOMPLETE_ON;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_SPELLCHECK) {
+    flags |= ui::TEXT_INPUT_FLAG_SPELLCHECK_ON |
+             ui::TEXT_INPUT_FLAG_AUTOCORRECT_ON;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_AUTO_CAPITALIZATION) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_SENTENCES;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_LOWERCASE) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_NONE;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_UPPERCASE) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_CHARACTERS;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_TITLECASE) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_WORDS;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_HIDDEN_TEXT) {
+    flags |= ui::TEXT_INPUT_FLAG_AUTOCOMPLETE_OFF |
+             ui::TEXT_INPUT_FLAG_AUTOCORRECT_OFF;
+  }
+  if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_SENSITIVE_DATA) {
+    should_do_learning = false;
+  }
+  // Unused hints: LATIN, MULTILINE.
+
+  switch (purpose) {
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DIGITS:
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PIN:
+      mode = ui::TEXT_INPUT_MODE_DECIMAL;
+      type = ui::TEXT_INPUT_TYPE_NUMBER;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NUMBER:
+      mode = ui::TEXT_INPUT_MODE_NUMERIC;
+      type = ui::TEXT_INPUT_TYPE_NUMBER;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PHONE:
+      mode = ui::TEXT_INPUT_MODE_TEL;
+      type = ui::TEXT_INPUT_TYPE_TELEPHONE;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_URL:
+      mode = ui::TEXT_INPUT_MODE_URL;
+      type = ui::TEXT_INPUT_TYPE_URL;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_EMAIL:
+      mode = ui::TEXT_INPUT_MODE_EMAIL;
+      type = ui::TEXT_INPUT_TYPE_EMAIL;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PASSWORD:
+      should_do_learning = false;
+      type = ui::TEXT_INPUT_TYPE_PASSWORD;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATE:
+      type = ui::TEXT_INPUT_TYPE_DATE;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TIME:
+      type = ui::TEXT_INPUT_TYPE_TIME;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATETIME:
+      type = ui::TEXT_INPUT_TYPE_DATE_TIME;
+      break;
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NORMAL:
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_ALPHA:
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NAME:
+    case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TERMINAL:
+      break;
+  }
+
+  text_input_->SetTypeModeFlags(type, mode, flags, should_do_learning,
+                                /*can_compose_inline=*/true,
+                                has_surrounding_text_);
+}
+
+void TextInputV3::SendPreedit(const ui::CompositionText& composition) {
+  if (composition.text.empty()) {
+    zwp_text_input_v3_send_preedit_string(resource_, nullptr, 0, 0);
+  } else {
+    std::vector<size_t> offsets{composition.selection.GetMin(),
+                                composition.selection.GetMax()};
+    const std::string utf8 =
+        base::UTF16ToUTF8AndAdjustOffsets(composition.text, &offsets);
+    // An unknown cursor puts it at the end of the preedit.
+    const int32_t begin = offsets[0] == std::string::npos
+                              ? static_cast<int32_t>(utf8.size())
+                              : static_cast<int32_t>(offsets[0]);
+    const int32_t end = offsets[1] == std::string::npos
+                            ? begin
+                            : static_cast<int32_t>(offsets[1]);
+    zwp_text_input_v3_send_preedit_string(resource_, utf8.c_str(), begin, end);
+  }
+  SendDone();
+}
+
+void TextInputV3::SendCommit(std::u16string_view text) {
+  zwp_text_input_v3_send_commit_string(resource_,
+                                       base::UTF16ToUTF8(text).c_str());
+  SendDone();
+}
+
+void TextInputV3::SendDeleteSurroundingText(
+    std::u16string_view surrounding_text,
+    const gfx::Range& range) {
+  // text-input-v3 deletes around the cursor, in bytes; TextInput knows where
+  // its idea of the cursor is in the same text.
+  gfx::Range selection;
+  if (!text_input_->GetEditableSelectionRange(&selection)) {
+    return;
+  }
+  std::vector<size_t> offsets{range.GetMin(), range.GetMax(),
+                              selection.GetMin(), selection.GetMax()};
+  base::UTF16ToUTF8AndAdjustOffsets(surrounding_text, &offsets);
+  if (std::ranges::find(offsets, std::string::npos) != offsets.end()) {
+    return;
+  }
+  const size_t before =
+      offsets[2] > offsets[0] ? std::min(offsets[2], offsets[1]) - offsets[0]
+                              : 0;
+  const size_t after =
+      offsets[1] > offsets[3] ? offsets[1] - std::max(offsets[3], offsets[0])
+                              : 0;
+  zwp_text_input_v3_send_delete_surrounding_text(
+      resource_, static_cast<uint32_t>(before), static_cast<uint32_t>(after));
+  SendDone();
+}
+
+void TextInputV3Delegate::SetCompositionText(
+    const ui::CompositionText& composition) {
+  owner_->SendPreedit(composition);
+}
+
+void TextInputV3Delegate::Commit(std::u16string_view text) {
+  owner_->SendCommit(text);
+}
+
+void TextInputV3Delegate::DeleteSurroundingText(
+    std::u16string_view surrounding_text,
+    const gfx::Range& range) {
+  owner_->SendDeleteSurroundingText(surrounding_text, range);
+}
+
+void TextInputV3Delegate::SendKey(const ui::KeyEvent& event) {
+  // text-input-v3 has no key event: a character the input method made from
+  // a key it took is committed as text. Other keys reach the client through
+  // wl_keyboard.
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  const char16_t character = event.GetCharacter();
+  if (character >= 0x20 && character != 0x7f) {
+    owner_->SendCommit(std::u16string_view(&character, 1));
+  }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// zwp_text_input_v3 interface:
+
+void text_input_v3_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void text_input_v3_enable(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<TextInputV3>(resource)->Enable();
+}
+
+void text_input_v3_disable(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<TextInputV3>(resource)->Disable();
+}
+
+void text_input_v3_set_surrounding_text(wl_client* client,
+                                        wl_resource* resource,
+                                        const char* text,
+                                        int32_t cursor,
+                                        int32_t anchor) {
+  GetUserDataAs<TextInputV3>(resource)->SetSurroundingText(text, cursor,
+                                                           anchor);
+}
+
+void text_input_v3_set_text_change_cause(wl_client* client,
+                                         wl_resource* resource,
+                                         uint32_t cause) {}
+
+void text_input_v3_set_content_type(wl_client* client,
+                                    wl_resource* resource,
+                                    uint32_t hint,
+                                    uint32_t purpose) {
+  GetUserDataAs<TextInputV3>(resource)->SetContentType(hint, purpose);
+}
+
+void text_input_v3_set_cursor_rectangle(wl_client* client,
+                                        wl_resource* resource,
+                                        int32_t x,
+                                        int32_t y,
+                                        int32_t width,
+                                        int32_t height) {
+  GetUserDataAs<TextInputV3>(resource)->SetCursorRectangle(
+      gfx::Rect(x, y, width, height));
+}
+
+void text_input_v3_commit(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<TextInputV3>(resource)->Commit();
+}
+
+constexpr struct zwp_text_input_v3_interface text_input_v3_implementation = {
+    text_input_v3_destroy,
+    text_input_v3_enable,
+    text_input_v3_disable,
+    text_input_v3_set_surrounding_text,
+    text_input_v3_set_text_change_cause,
+    text_input_v3_set_content_type,
+    text_input_v3_set_cursor_rectangle,
+    text_input_v3_commit,
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// zwp_text_input_manager_v3 interface:
+
+void text_input_manager_v3_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void text_input_manager_v3_get_text_input(wl_client* client,
+                                          wl_resource* resource,
+                                          uint32_t id,
+                                          wl_resource* seat_resource) {
+  Seat* seat = GetUserDataAs<WaylandSeat>(seat_resource)->seat;
+  wl_resource* text_input_resource =
+      wl_resource_create(client, &zwp_text_input_v3_interface, 1, id);
+  SetImplementation(text_input_resource, &text_input_v3_implementation,
+                    std::make_unique<TextInputV3>(text_input_resource, seat));
+}
+
+constexpr struct zwp_text_input_manager_v3_interface
+    text_input_manager_v3_implementation = {
+        text_input_manager_v3_destroy,
+        text_input_manager_v3_get_text_input,
+};
+
+}  // namespace
+
+void bind_text_input_manager_v3(wl_client* client,
+                                void* data,
+                                uint32_t version,
+                                uint32_t id) {
+  wl_resource* resource =
+      wl_resource_create(client, &zwp_text_input_manager_v3_interface, 1, id);
+  wl_resource_set_implementation(resource,
+                                 &text_input_manager_v3_implementation, data,
+                                 nullptr);
+}
+
+}  // namespace exo::wayland

index a7dafe7..acbc251 100644
--- a/chrome/browser/ui/ash/nickel_desktop/BUILD.gn
+++ b/chrome/browser/ui/ash/nickel_desktop/BUILD.gn
@@ -17,9 +17,13 @@ static_library("nickel_desktop") {

 #include "storage/browser/file_system/file_system_context.h"
 #include "storage/browser/file_system/file_system_url.h"
 #include "third_party/skia/include/core/SkBitmap.h"
@@ -30,6 +42,28 @@
 
 namespace {
 
+// nickel-appd (chromeos-base/nickel-appd), which reads launchers and starts
+// Linux apps, on the system bus.
+constexpr char kNickelAppsServiceName[] = "org.nickelos.Apps";
+constexpr char kNickelAppsServicePath[] = "/org/nickelos/Apps";
+constexpr char kNickelAppsServiceInterface[] = "org.nickelos.Apps";
+constexpr int kDesktopEntryTimeoutMs = 5000;
+// A launcher's icon file: an icon, not a picture.
+constexpr int64_t kMaxIconFileSize = 4 * 1024 * 1024;
+
+dbus::ObjectProxy* NickelApps() {
+  return ash::DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      kNickelAppsServiceName, dbus::ObjectPath(kNickelAppsServicePath));
+}
+
+std::optional<std::string> ReadIconFile(const base::FilePath& path) {
+  std::string data;
+  if (!base::ReadFileToStringWithMaxSize(path, &data, kMaxIconFileSize)) {
+    return std::nullopt;
+  }
+  return data;
+}
+
 // The file system URLs of `paths` for Files' operations; those Files does not
 // know are left out.
 std::vector<storage::FileSystemURL> ToFileSystemUrls(
@@ -175,3 +209,122 @@ void NickelDesktopClientImpl::LoadThumbnail(const base::FilePath& path,
           },
           std::move(callback)));
 }
+
+void NickelDesktopClientImpl::LoadDesktopEntry(const base::FilePath& path,
+                                               int size,
+                                               DesktopEntryCallback callback) {
+  // The desktop reads its folder as the session starts, before nickel-appd
+  // is on the bus (the calls failed with ServiceUnknown on the NVIDIA test PC,
+  // 16852.17.19): ask once it is.
+  NickelApps()->WaitForServiceToBeAvailable(base::BindOnce(
+      &NickelDesktopClientImpl::AskDesktopEntry, weak_factory_.GetWeakPtr(),
+      path, size, std::move(callback)));
+}
+
+void NickelDesktopClientImpl::AskDesktopEntry(const base::FilePath& path,
+                                              int size,
+                                              DesktopEntryCallback callback,
+                                              bool available) {
+  if (!available) {
+    std::move(callback).Run(false, std::u16string(), SkBitmap());
+    return;
+  }
+  dbus::MethodCall method_call(kNickelAppsServiceInterface, "DesktopEntry");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(path.value());
+  NickelApps()->CallMethod(
+      &method_call, kDesktopEntryTimeoutMs,
+      base::BindOnce(&NickelDesktopClientImpl::OnDesktopEntry,
+                     weak_factory_.GetWeakPtr(), size, std::move(callback)));
+}
+
+void NickelDesktopClientImpl::OnDesktopEntry(int size,
+                                             DesktopEntryCallback callback,
+                                             dbus::Response* response) {
+  bool launchable = false;
+  std::string name;
+  std::string icon;
+  if (response) {
+    dbus::MessageReader reader(response);
+    if (!reader.PopBool(&launchable) || !reader.PopString(&name) ||
+        !reader.PopString(&icon)) {
+      launchable = false;
+    }
+  }
+  if (!launchable) {
+    std::move(callback).Run(false, std::u16string(), SkBitmap());
+    return;
+  }
+  std::u16string name16 = base::UTF8ToUTF16(name);
+  if (icon.empty()) {
+    std::move(callback).Run(true, name16, SkBitmap());
+    return;
+  }
+  const bool svg = base::EndsWith(icon, ".svg",
+                                  base::CompareCase::INSENSITIVE_ASCII);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadIconFile, base::FilePath(icon)),
+      base::BindOnce(&NickelDesktopClientImpl::OnIconRead,
+                     weak_factory_.GetWeakPtr(), size, svg, std::move(name16),
+                     std::move(callback)));
+}
+
+void NickelDesktopClientImpl::OnIconRead(int size,
+                                         bool svg,
+                                         std::u16string name,
+                                         DesktopEntryCallback callback,
+                                         std::optional<std::string> data) {
+  if (!data || data->empty()) {
+    std::move(callback).Run(true, name, SkBitmap());
+    return;
+  }
+  if (!svg) {
+    DecodeIcon(size, std::move(name), std::move(callback), std::move(*data));
+    return;
+  }
+  Profile* profile = GetProfile();
+  if (!profile) {
+    std::move(callback).Run(true, name, SkBitmap());
+    return;
+  }
+  if (!svg_transcoder_ || svg_profile_ != profile) {
+    svg_transcoder_ = std::make_unique<apps::SvgIconTranscoder>(profile);
+    svg_profile_ = profile;
+  }
+  // No file for the PNG: it is only shown.
+  svg_transcoder_->Transcode(
+      *data, base::FilePath(), gfx::Size(size, size),
+      base::BindOnce(&NickelDesktopClientImpl::DecodeIcon,
+                     weak_factory_.GetWeakPtr(), size, std::move(name),
+                     std::move(callback)));
+}
+
+void NickelDesktopClientImpl::DecodeIcon(int size,
+                                         std::u16string name,
+                                         DesktopEntryCallback callback,
+                                         std::string png) {
+  if (png.empty()) {
+    std::move(callback).Run(true, name, SkBitmap());
+    return;
+  }
+  data_decoder::DecodeImageIsolated(
+      base::as_byte_span(png), data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/true, static_cast<uint64_t>(size) * size * 4 * 4,
+      gfx::Size(size, size),
+      base::BindOnce(
+          [](std::u16string name, DesktopEntryCallback callback,
+             const SkBitmap& bitmap) {
+            std::move(callback).Run(true, name, bitmap);
+          },
+          std::move(name), std::move(callback)));
+}
+
+void NickelDesktopClientImpl::LaunchDesktopEntry(const base::FilePath& path) {
+  dbus::MethodCall method_call(kNickelAppsServiceInterface,
+                               "LaunchDesktopFile");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(path.value());
+  NickelApps()->CallMethod(&method_call, kDesktopEntryTimeoutMs,
+                           base::DoNothing());
+}

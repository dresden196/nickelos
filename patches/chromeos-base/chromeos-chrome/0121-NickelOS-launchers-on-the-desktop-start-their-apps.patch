 // NickelOS: the desktop's way into the active user's profile (Files' open,
@@ -38,15 +49,46 @@ class NickelDesktopClientImpl : public ash::NickelDesktopClient {
   void LoadThumbnail(const base::FilePath& path,
                      int size,
                      ThumbnailCallback callback) override;
+  void LoadDesktopEntry(const base::FilePath& path,
+                        int size,
+                        DesktopEntryCallback callback) override;

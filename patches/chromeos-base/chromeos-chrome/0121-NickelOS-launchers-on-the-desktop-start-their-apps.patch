  private:
   // The signed-in user's profile, or null.
   Profile* GetProfile();
 
+  // A launcher: asked once nickel-appd is on the bus.
+  void AskDesktopEntry(const base::FilePath& path,
+                       int size,
+                       DesktopEntryCallback callback,
+                       bool available);
+  // A launcher's icon: nickel-appd's answer, the icon file read, an SVG
+  // made a PNG, the PNG decoded in the data decoder's sandbox.
+  void OnDesktopEntry(int size,
+                      DesktopEntryCallback callback,
+                      dbus::Response* response);
+  void OnIconRead(int size,
+                  bool svg,
+                  std::u16string name,
+                  DesktopEntryCallback callback,
+                  std::optional<std::string> data);
+  void DecodeIcon(int size,
+                  std::u16string name,
+                  DesktopEntryCallback callback,
+                  std::string png);
+
   // Previews come from Files' image loader through this, for the profile it
   // was made for.
   std::unique_ptr<ash::ThumbnailLoader> thumbnail_loader_;
   raw_ptr<Profile, DanglingUntriaged> thumbnail_profile_ = nullptr;
+
+  // Launchers' SVG icons become PNGs through this (a renderer draws them),
+  // for the profile it was made for.
+  std::unique_ptr<apps::SvgIconTranscoder> svg_transcoder_;
+  raw_ptr<Profile, DanglingUntriaged> svg_profile_ = nullptr;
+
+  base::WeakPtrFactory<NickelDesktopClientImpl> weak_factory_{this};
 };
 
 #endif  // CHROME_BROWSER_UI_ASH_NICKEL_DESKTOP_NICKEL_DESKTOP_CLIENT_IMPL_H_

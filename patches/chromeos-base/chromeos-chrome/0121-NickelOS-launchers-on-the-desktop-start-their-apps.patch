diff --git a/chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.cc b/chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.cc
index e4fa478..2e24ae1 100644
--- a/chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.cc
+++ b/chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.cc
@@ -8,7 +8,12 @@
 #include <utility>
 
 #include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"

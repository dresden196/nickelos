     return true;
   }
 
+  // NickelOS: the web apps of setup's Full experience (Proton's), for every
+  // account on a device whose setup chose it. The choice is in local state
+  // before the first account exists, so it is there for the first sync.
+  if (feature_name == "NickelFullExperience") {
+#if BUILDFLAG(IS_CHROMEOS)
+    PrefService* local_state =
+        g_browser_process ? g_browser_process->local_state() : nullptr;
+    if (!local_state) {
+      return false;
+    }
+    const std::string& experience =
+        local_state->GetString(ash::prefs::kNickelSetupPendingExperience);
+    return experience == "full" || experience == "default" ||
+           experience == "privacy";
+#else
+    return false;
+#endif  // BUILDFLAG(IS_CHROMEOS)
+  }
+
   for (std::string_view feature : kShippedPreinstalledAppInstallFeatures) {
     if (feature == feature_name) {
       return true;

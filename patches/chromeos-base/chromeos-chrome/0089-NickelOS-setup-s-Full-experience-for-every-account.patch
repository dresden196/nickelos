-// Sets up what `experience` ("default" or "minimal"; "privacy" is what
-// builds before 2026-10-22 called the default) means for `profile`.
+// Sets up what `experience` ("full" or "minimal"; "default" and "privacy"
+// are what earlier builds called the full one) means for `profile`. Full
+// experience's web apps (Proton's) come from Chrome's preinstalled web app
+// configs, gated on NickelFullExperience; its Flatpaks from
+// nickel-flatpak-defaults, which reads the device's choice too.
 void Apply(Profile* profile, const std::string& experience) {
   // Minimal: the launcher searches the device only (no web results).
   if (experience == "minimal") {
@@ -132,13 +72,8 @@ void Apply(Profile* profile, const std::string& experience) {
     return;
   }
 
-  // Default: Proton's apps bookmarked, and DuckDuckGo as the search engine
-  // for the browser and the launcher (whose web results follow the
-  // browser's).
-  if (bookmarks::BookmarkModel* model =
-          BookmarkModelFactory::GetForBrowserContext(profile)) {
-    ProtonBookmarks::Add(model);
-  }
+  // Full experience: DuckDuckGo as the search engine for the browser and
+  // the launcher (whose web results follow the browser's).
   const std::u16string keyword = u"duckduckgo.com";
   TemplateURLService* service =
       TemplateURLServiceFactory::GetForProfile(profile);
@@ -181,8 +116,8 @@ void NickelSetupScreen::MaybeApplyChoice(Profile* profile) {
       !profile->GetPrefs()->GetString(prefs::kNickelSetupExperience).empty()) {
     return;
   }
-  // The device's first account takes it, once.
-  local_state->ClearPref(prefs::kNickelSetupPendingExperience);
+  // The device's choice, kept: every account takes it at its first sign-in
+  // (and the Flatpaks and web apps follow it for all of them).
   profile->GetPrefs()->SetString(prefs::kNickelSetupExperience, experience);
   Apply(profile, experience);
 }

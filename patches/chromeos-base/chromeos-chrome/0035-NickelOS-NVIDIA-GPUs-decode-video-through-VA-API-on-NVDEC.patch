+// NickelOS: NVIDIA's own driver (nvidia-open), whose VA-API driver
+// (nvidia-vaapi-driver) decodes through CUDA and NVDEC. Both are loaded and
+// initialized before the sandbox (VaapiWrapper::PreSandboxInitialization() in
+// utility_main.cc); in it, they open NVIDIA's device files for each decoder,
+// and minigbm, allocating the decoded frames' buffers, opens the render node
+// read-write and loads NVIDIA's allocator.
+void AddNvidiaPermissions(std::vector<BrokerFilePermission>& permissions) {
+  for (const char* device : {"/dev/nvidiactl", "/dev/nvidia-modeset",
+                             "/dev/nvidia-uvm", "/dev/nvidia-uvm-tools"}) {
+    permissions.push_back(BrokerFilePermission::ReadWrite(device));
+  }
+  for (int i = 0; i < 16; ++i) {
+    permissions.push_back(BrokerFilePermission::ReadWrite(
+        base::StringPrintf("/dev/nvidia%d", i)));
+  }
+  permissions.push_back(
+      BrokerFilePermission::ReadOnlyRecursive("/proc/driver/nvidia/"));
+  permissions.push_back(
+      BrokerFilePermission::ReadOnlyRecursive("/usr/share/nvidia/"));
+  // CUDA reads these as it starts threads and allocates.
+  permissions.push_back(BrokerFilePermission::ReadOnly(
+      "/sys/devices/system/memory/block_size_bytes"));
+  permissions.push_back(
+      BrokerFilePermission::ReadOnly("/sys/devices/system/cpu/online"));
+  permissions.push_back(BrokerFilePermission::ReadOnly("/dev/dri"));
+  AllowAccessToRenderNodes(permissions, /*include_sys_dev_char=*/true,
+                           /*read_write=*/true);
+  if (!dlopen("libnvidia-allocator.so.1",
+              RTLD_NOW | RTLD_GLOBAL | RTLD_NODELETE)) {
+    LOG(WARNING) << "dlopen(libnvidia-allocator.so.1) failed: " << dlerror();
+  }
+}

+// NickelOS: as on Intel, and CUDA's threads ask for the scheduling priority
+// range as they start (a crash on sched_get_priority_min() before), read
+// sysinfo() and list directories.
+ResultExpr HardwareVideoDecodingProcessPolicy::EvaluateSyscallForVaapiOnNvidia(
+    int system_call_number) const {
+  switch (system_call_number) {
+    case __NR_getdents64:
+    case __NR_sysinfo:
+    case __NR_sched_get_priority_max:
+    case __NR_sched_get_priority_min:
+      return Allow();
+  }
+  return EvaluateSyscallForVaapiOnIntel(system_call_number);

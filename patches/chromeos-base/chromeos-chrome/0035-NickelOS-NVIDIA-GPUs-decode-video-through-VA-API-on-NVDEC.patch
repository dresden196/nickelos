+// NickelOS: VA-API on NVIDIA GPUs is nvidia-vaapi-driver, which decodes with
+// NVDEC through CUDA. Video is decoded in the video decoder process, whose
+// sandbox lets NVIDIA's driver work and covers CUDA's threads
+// (hardware_video_decoding_sandbox_hook_linux.cc, utility_main.cc); nowhere
+// else: CUDA's threads would leave the GPU process unsandboxed and keep other
+// sandboxed processes (the video encoder's) from starting. Chrome's media test
+// programs, which have no sandbox, opt in with NICKEL_VAAPI_ON_NVIDIA=1.
+bool UseVaapiOnNvidiaInThisProcess() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (command_line.GetSwitchValueASCII("type") == "utility" &&
+      command_line.GetSwitchValueASCII("utility-sub-type") ==
+          "media.mojom.VideoDecoderFactoryProcess") {
+    return true;
+  }
+  return base::Environment::Create()->HasVar("NICKEL_VAAPI_ON_NVIDIA");
+}

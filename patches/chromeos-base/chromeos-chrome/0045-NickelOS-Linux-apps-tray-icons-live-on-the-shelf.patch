+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/shelf/nickel_tray_shelf_item_controller.h"
+
+#include <set>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/ash/dbus/vm/nickel_tray.h"
+
+namespace {
+
+// The shelf ids these controllers stand for (ShelfItemDelegate has no type
+// to ask).
+std::multiset<ash::ShelfID>& TrayItems() {
+  static base::NoDestructor<std::multiset<ash::ShelfID>> items;
+  return *items;
+}
+
+}  // namespace
+
+NickelTrayShelfItemController::NickelTrayShelfItemController(
+    const ash::ShelfID& shelf_id)
+    : AppShortcutShelfItemController(shelf_id) {
+  TrayItems().insert(shelf_id);
+}
+
+NickelTrayShelfItemController::~NickelTrayShelfItemController() {
+  auto it = TrayItems().find(shelf_id());
+  if (it != TrayItems().end()) {
+    TrayItems().erase(it);
+  }
+}
+
+// static
+bool NickelTrayShelfItemController::IsTrayItem(const ash::ShelfID& shelf_id) {
+  return TrayItems().count(shelf_id) > 0;
+}
+
+void NickelTrayShelfItemController::ItemSelected(
+    std::unique_ptr<ui::Event> event,
+    int64_t display_id,
+    ash::ShelfLaunchSource source,
+    ItemSelectedCallback callback,
+    const ItemFilterPredicate& filter_predicate) {
+  // As a click on its tray icon: the app shows its window, which then takes
+  // over this item.
+  ash::NickelTray::Get()->Activate(shelf_id().app_id);
+  std::move(callback).Run(ash::SHELF_ACTION_NONE, {});
+}
+
+void NickelTrayShelfItemController::Close() {
+  ash::NickelTray::Get()->Quit(shelf_id().app_id);
+}

+// static
+void NickelHostApps::AddTrayMenu(const base::ListValue& menu,
+                                 const std::string& prefix,
+                                 int& command_id,
+                                 bool& first,
+                                 bool& separate,
+                                 MenuItems& menu_items) {
+  // Shortcut items are flat: a submenu's entries follow its name
+  // ("Friends > Online"), a checked entry has a check mark, disabled ones
+  // (headings, status lines) are left out.
+  for (const base::Value& value : menu) {
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    if (entry->FindBool("separator").value_or(false)) {
+      separate = true;
+      continue;
+    }
+    const std::string* label = entry->FindString("label");
+    if (!label || label->empty()) {
+      continue;
+    }
+    const base::ListValue* children = entry->FindList("children");
+    if (children && !children->empty()) {
+      AddTrayMenu(*children, prefix + *label + " \u203a ", command_id, first,
+                  separate, menu_items);
+      continue;
+    }
+    const std::optional<int> id = entry->FindInt("id");
+    if (!id || !entry->FindBool("enabled").value_or(true) ||
+        command_id > ash::LAUNCH_APP_SHORTCUT_LAST) {
+      continue;
+    }
+    if (separate) {
+      AddSeparator(first ? ui::DOUBLE_SEPARATOR : ui::PADDED_SEPARATOR,
+                   menu_items);
+      first = false;
+      separate = false;
+    }
+    std::string text = prefix + *label;
+    if (entry->FindBool("checked").value_or(false)) {
+      text = "\u2713 " + text;
+    }
+    AddShortcutCommandItem(command_id++, base::NumberToString(*id), text,
+                           gfx::ImageSkia(), menu_items);
+  }
+}

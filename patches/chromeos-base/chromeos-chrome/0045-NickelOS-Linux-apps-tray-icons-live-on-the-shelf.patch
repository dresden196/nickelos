+void NickelHostApps::OnNickelTrayChanged(const std::string& app_id) {
+  bool known = false;
+  proxy()->AppRegistryCache().ForOneApp(
+      app_id, [&known](const AppUpdate& update) {
+        known = update.AppType() == AppType::kNickelHost;
+      });
+  if (!known) {
+    return;
+  }
+  const ash::NickelTray::Item* tray = ash::NickelTray::Get()->ForApp(app_id);
+  auto app = std::make_unique<App>(AppType::kNickelHost, app_id);
+  app->has_badge = tray && tray->attention;
+  AppPublisher::Publish(std::move(app));
+}

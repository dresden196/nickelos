@@ -0,0 +1,130 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_tray.h"
+
+#include <utility>
+
+#include "base/functional/callback_helpers.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "components/exo/wayland/xdg_activation.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+
+namespace ash {
+
+namespace {
+
+constexpr char kNickelAppsServiceName[] = "org.nickelos.Apps";
+constexpr char kNickelAppsServicePath[] = "/org/nickelos/Apps";
+constexpr char kNickelAppsServiceInterface[] = "org.nickelos.Apps";
+
+}  // namespace
+
+NickelTray::Item::Item() = default;
+NickelTray::Item::Item(Item&&) = default;
+NickelTray::Item& NickelTray::Item::operator=(Item&&) = default;
+NickelTray::Item::~Item() = default;
+
+NickelTray::NickelTray() = default;
+NickelTray::~NickelTray() = default;
+
+// static
+NickelTray* NickelTray::Get() {
+  static base::NoDestructor<NickelTray> tray;
+  return tray.get();
+}
+
+void NickelTray::Update(Item item) {
+  std::string old_app_id;
+  auto it = items_.find(item.key);
+  if (it != items_.end() && it->second.app_id != item.app_id) {
+    old_app_id = it->second.app_id;
+  }
+  const std::string app_id = item.app_id;
+  items_[item.key] = std::move(item);
+  if (!old_app_id.empty()) {
+    Notify(old_app_id);
+  }
+  Notify(app_id);
+}
+
+void NickelTray::Remove(const std::string& key) {
+  auto it = items_.find(key);
+  if (it == items_.end()) {
+    return;
+  }
+  const std::string app_id = it->second.app_id;
+  items_.erase(it);
+  Notify(app_id);
+}
+
+const NickelTray::Item* NickelTray::ForApp(const std::string& app_id) const {
+  for (const auto& [key, item] : items_) {
+    if (item.app_id == app_id) {
+      return &item;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<std::string> NickelTray::AppIds() const {
+  std::vector<std::string> app_ids;
+  for (const auto& [key, item] : items_) {
+    app_ids.push_back(item.app_id);
+  }
+  return app_ids;
+}
+
+void NickelTray::Activate(const std::string& app_id) {
+  SendEvent(app_id, "activate", 0);
+}
+
+void NickelTray::MenuCommand(const std::string& app_id, int item_id) {
+  SendEvent(app_id, "menu", item_id);
+}
+
+void NickelTray::Quit(const std::string& app_id) {
+  SendEvent(app_id, "quit", 0);
+}
+
+void NickelTray::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void NickelTray::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void NickelTray::SendEvent(const std::string& app_id,
+                           const std::string& event,
+                           int item_id) {
+  const Item* item = ForApp(app_id);
+  if (!item) {
+    return;
+  }
+  dbus::ObjectProxy* proxy =
+      DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+          kNickelAppsServiceName, dbus::ObjectPath(kNickelAppsServicePath));
+  dbus::MethodCall method_call(kNickelAppsServiceInterface, "TrayEvent");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(item->key);
+  writer.AppendString(event);
+  writer.AppendInt32(item_id);
+  // The click hands the focus on: the app may bring a window forward.
+  writer.AppendString(event == "quit" ? std::string()
+                                      : exo::wayland::MakeActivationToken());
+  proxy->CallMethod(&method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                    base::DoNothing());
+}
+
+void NickelTray::Notify(const std::string& app_id) {
+  for (Observer& observer : observers_) {
+    observer.OnNickelTrayChanged(app_id);
+  }
+}
+
+}  // namespace ash

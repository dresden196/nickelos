+#ifndef CHROME_BROWSER_UI_ASH_SHELF_NICKEL_TRAY_SHELF_ITEM_CONTROLLER_H_
+#define CHROME_BROWSER_UI_ASH_SHELF_NICKEL_TRAY_SHELF_ITEM_CONTROLLER_H_
+
+#include <memory>
+
+#include "chrome/browser/ui/ash/shelf/app_shortcut_shelf_item_controller.h"
+
+// NickelOS: the shelf item of a Linux app that runs on in its tray icon with
+// no window (ash::NickelTray): shown as running; a click asks the app to show
+// itself, Close quits it. Its menu is the app's (NickelHostApps adds the tray
+// menu). A window of the app replaces it with a window item.
+class NickelTrayShelfItemController : public AppShortcutShelfItemController {
+ public:
+  explicit NickelTrayShelfItemController(const ash::ShelfID& shelf_id);
+  NickelTrayShelfItemController(const NickelTrayShelfItemController&) = delete;
+  NickelTrayShelfItemController& operator=(
+      const NickelTrayShelfItemController&) = delete;
+  ~NickelTrayShelfItemController() override;
+
+  // Whether the item for |shelf_id| is one of these.
+  static bool IsTrayItem(const ash::ShelfID& shelf_id);
+
+  // ash::ShelfItemDelegate:
+  void ItemSelected(std::unique_ptr<ui::Event> event,
+                    int64_t display_id,
+                    ash::ShelfLaunchSource source,
+                    ItemSelectedCallback callback,
+                    const ItemFilterPredicate& filter_predicate) override;
+  void Close() override;
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_SHELF_NICKEL_TRAY_SHELF_ITEM_CONTROLLER_H_

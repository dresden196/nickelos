+// NickelTrayItem(key, app_id, title, attention, menu as JSON): a Linux app's
+// tray icon, new or changed (see NickelTray).
+void VmApplicationsServiceProvider::NickelTrayItem(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  NickelTray::Item item;
+  std::string menu;
+  if (!reader.PopString(&item.key) || !reader.PopString(&item.app_id) ||
+      !reader.PopString(&item.title) || !reader.PopBool(&item.attention) ||
+      !reader.PopString(&menu) || item.key.empty() || item.app_id.empty()) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected key, app_id, title, attention, menu"));
+    return;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(menu, base::JSON_PARSE_RFC);
+  if (parsed && parsed->is_list()) {
+    item.menu = std::move(parsed->GetList());
+  }
+  NickelTray::Get()->Update(std::move(item));
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+
+void VmApplicationsServiceProvider::NickelTrayItemRemoved(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string key;
+  if (reader.PopString(&key)) {
+    NickelTray::Get()->Remove(key);
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}

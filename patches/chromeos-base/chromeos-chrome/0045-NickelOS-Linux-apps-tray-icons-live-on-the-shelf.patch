+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_TRAY_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_TRAY_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+
+namespace ash {
+
+// NickelOS: Linux apps' tray icons (StatusNotifierItem). Apps such as
+// Discord, Slack, Steam and Telegram keep running in the system tray when
+// their window closes; ChromeOS has no tray for apps, its shelf is where
+// running apps are. nickel-appd is the tray Linux apps register with and
+// reports each item (vm_applications' NickelTrayItem, NickelTrayItemRemoved).
+// While an app has one, the shelf keeps it, running, and a click asks it to
+// show itself (ChromeShelfController, NickelTrayShelfItemController); its
+// menu goes into the app's shelf and launcher menu and its badge shows when
+// it needs attention (NickelHostApps). What the user does goes back to
+// nickel-appd (TrayEvent).
+class NickelTray {
+ public:
+  struct Item {
+    Item();
+    Item(Item&&);
+    Item& operator=(Item&&);
+    ~Item();
+
+    std::string key;
+    std::string app_id;
+    std::string title;
+    bool attention = false;
+    // [{"id", "label", "separator", "enabled", "toggle", "checked",
+    // "children"}...], from the app's dbusmenu.
+    base::ListValue menu;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // |app_id| got, changed or lost its tray item.
+    virtual void OnNickelTrayChanged(const std::string& app_id) = 0;
+  };
+
+  static NickelTray* Get();
+
+  NickelTray(const NickelTray&) = delete;
+  NickelTray& operator=(const NickelTray&) = delete;
+
+  void Update(Item item);
+  void Remove(const std::string& key);
+
+  // The app's tray item (the first, should it have several), or null.
+  const Item* ForApp(const std::string& app_id) const;
+  // The apps that have one.
+  std::vector<std::string> AppIds() const;
+
+  // A click on the app's shelf icon while it has no window: the app shows
+  // itself.
+  void Activate(const std::string& app_id);
+  // A click on its menu entry |item_id|.
+  void MenuCommand(const std::string& app_id, int item_id);
+  // Close on the shelf: the app quits.
+  void Quit(const std::string& app_id);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  friend class base::NoDestructor<NickelTray>;
+
+  NickelTray();
+  ~NickelTray();
+
+  void SendEvent(const std::string& app_id,
+                 const std::string& event,
+                 int item_id);
+  void Notify(const std::string& app_id);
+
+  std::map<std::string, Item> items_;  // By key.
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_TRAY_H_

+// NickelOS host apps (crostini::kNickelVmName / kNickelContainerName).
+constexpr char kNickelVmName[] = "nickel";
+constexpr char kNickelContainerName[] = "host";
+
 const std::string* GetAppNameForWMClass(std::string_view wmclass) {
   // A hard-coded mapping from WMClass to app names.
   // This is used to deal with the Linux apps that don't specify the correct
@@ -220,6 +224,17 @@ std::string GetGuestOsShelfAppId(Profile* profile,
   // If the window_id does not follow the expected format, return a generic id.
   if (!base::StartsWith(*window_app_id, kGuestOsWindowAppIdPrefix,
                         base::CompareCase::SENSITIVE)) {
+    // NickelOS host apps are Exo's own clients, with no sommelier to prefix
+    // their app id: it is the app's desktop file id, or its StartupWMClass.
+    const GuestId host(VmType::TERMINA, kNickelVmName, kNickelContainerName);
+    if (FindAppId(apps, guest_os::prefs::kAppDesktopFileIdKey, *window_app_id,
+                  host, &app_id) == FindAppIdResult::UniqueMatch ||
+        FindAppId(apps, guest_os::prefs::kAppStartupWMClassKey,
+                  *window_app_id, host, &app_id,
+                  false /* require_startup_notification */,
+                  true /* need_display */) == FindAppIdResult::UniqueMatch) {
+      return app_id;
+    }
     LOG(ERROR) << "window_app_id:" << *window_app_id
                << " provided is not prefixed with "
                << kGuestOsWindowAppIdPrefix;

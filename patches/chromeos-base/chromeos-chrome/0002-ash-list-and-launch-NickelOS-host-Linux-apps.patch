+void OnNickelAppLaunched(const std::string& app_id,
+                         crostini::CrostiniSuccessCallback callback,
+                         dbus::Response* response,
+                         dbus::ErrorResponse* error) {
+  if (!response) {
+    std::string reason = "nickel-appd did not launch " + app_id;
+    if (error) {
+      std::string message;
+      dbus::MessageReader(error).PopString(&message);
+      reason += ": " + error->GetErrorName() + ": " + message;
+    }
+    return OnLaunchFailed(app_id, std::move(callback), reason,
+                          CrostiniResult::UNKNOWN_ERROR);
+  }
+  OnApplicationLaunched(app_id, std::move(callback),
+                        CrostiniResult::UNKNOWN_ERROR, true, std::string());
+}
+
+// NickelOS host apps run on the device itself: launching one is a single call
+// to nickel-appd, which starts it as the session user.
+void LaunchNickelApp(
+    Profile* profile,
+    const std::string& app_id,
+    const guest_os::GuestOsRegistryService::Registration& registration,
+    int64_t display_id,
+    const std::vector<guest_os::LaunchArg>& args,
+    CrostiniSuccessCallback callback) {
+  RecordAppLaunchHistogram(CrostiniAppLaunchAppType::kRegisteredApp);
+  guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile)->AppLaunched(
+      app_id);
+  // Lets the window tracker put the app's window on |display_id|.
+  if (auto* shelf_controller = ChromeShelfController::instance()) {
+    if (auto* window_controller =
+            shelf_controller->app_service_app_window_controller()) {
+      if (auto* tracker = window_controller->app_service_crostini_tracker()) {
+        tracker->OnAppLaunchRequested(app_id, display_id);
+      }
+    }
+  }
+
+  // nickel-appd and its apps share Chrome's mount namespace, so files are
+  // passed as their paths.
+  std::vector<std::string> launch_args;
+  for (const auto& arg : args) {
+    if (const auto* url = std::get_if<storage::FileSystemURL>(&arg)) {
+      launch_args.push_back(url->path().value());
+    } else {
+      launch_args.push_back(std::get<std::string>(arg));
+    }
+  }
+
+  dbus::ObjectProxy* proxy =
+      ash::DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+          kNickelAppsServiceName, dbus::ObjectPath(kNickelAppsServicePath));
+  dbus::MethodCall method_call(kNickelAppsServiceInterface,
+                               "LaunchApplication");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(registration.DesktopFileId());
+  writer.AppendArrayOfStrings(launch_args);
+  proxy->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&OnNickelAppLaunched, app_id, std::move(callback)));
+}
+
 }  // namespace
 
+bool IsNickelNativeAppsAllowed(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  // Guest sessions run their apps in the off-the-record profile.
+  if (profile->IsOffTheRecord() && !profile->IsGuestSession()) {
+    return false;
+  }
+  return ash::ProfileHelper::IsPrimaryProfile(profile->GetOriginalProfile());
+}
+
 bool IsCrostiniRunning(Profile* profile) {
   auto* manager = crostini::CrostiniManager::GetForProfile(profile);
   return manager && manager->IsVmRunning(kCrostiniDefaultVmName);
@@ -246,6 +325,18 @@ void LaunchCrostiniAppWithIntent(Profile* profile,
                                  apps::IntentPtr intent,
                                  const std::vector<guest_os::LaunchArg>& args,
                                  CrostiniSuccessCallback callback) {
+  // NickelOS host apps need no VM, so none of the Crostini checks apply.
+  if (auto* registry_service =
+          guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile)) {
+    std::optional<guest_os::GuestOsRegistryService::Registration> host_app =
+        registry_service->GetRegistration(app_id);
+    if (host_app && host_app->VmName() == kNickelVmName &&
+        IsNickelNativeAppsAllowed(profile)) {
+      return LaunchNickelApp(profile, app_id, *host_app, display_id, args,
+                             std::move(callback));
+    }
+  }
+
   // Policies can change under us, and crostini may now be forbidden.
   std::string reason;
   if (!CrostiniFeatures::Get()->IsAllowedNow(profile, &reason)) {

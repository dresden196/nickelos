+// host instead of in a VM. nickel-appd launches them for Chrome.
+inline constexpr char kNickelVmName[] = "nickel";
+inline constexpr char kNickelContainerName[] = "host";
+inline constexpr char kNickelAppsServiceName[] = "org.nickelos.Apps";
+inline constexpr char kNickelAppsServicePath[] = "/org/nickelos/Apps";
+inline constexpr char kNickelAppsServiceInterface[] = "org.nickelos.Apps";
+
+// Whether |profile| may list and launch NickelOS host apps. Unlike Crostini,
+// this needs no virtualization support and includes guest sessions.
+bool IsNickelNativeAppsAllowed(Profile* profile);

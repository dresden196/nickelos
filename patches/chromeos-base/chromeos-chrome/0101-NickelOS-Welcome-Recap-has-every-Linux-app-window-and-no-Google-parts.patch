index d8aa09e..a6eefd4 100644
--- a/chrome/browser/ui/ash/shelf/app_service/exo_app_type_resolver.cc
+++ b/chrome/browser/ui/ash/shelf/app_service/exo_app_type_resolver.cc
@@ -13,19 +13,25 @@
 #include "chrome/browser/ash/guest_os/guest_os_registry_service.h"
 #include "chrome/browser/ash/guest_os/guest_os_registry_service_factory.h"
 #include "chrome/browser/ash/guest_os/guest_os_shelf_utils.h"
+#include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/profiles/profile_manager.h"
 #include "chromeos/ash/components/borealis/borealis_util.h"
 #include "chromeos/ash/experiences/arc/arc_util.h"
 #include "chromeos/ui/base/app_types.h"
 #include "chromeos/ui/base/window_properties.h"
+#include "components/app_restore/app_launch_info.h"
 #include "components/app_restore/app_restore_utils.h"
 #include "components/app_restore/full_restore_read_handler.h"
+#include "components/app_restore/full_restore_utils.h"
 #include "components/app_restore/window_properties.h"
 #include "components/exo/permission.h"
 #include "components/exo/window_properties.h"
+#include "components/services/app_service/public/cpp/app_launch_util.h"
 #include "components/sessions/core/session_id.h"
 #include "ui/aura/client/aura_constants.h"
 #include "ui/base/class_property.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/display/types/display_constants.h"
 
 namespace {
 
@@ -105,6 +111,20 @@ void UpdatePropertiesForNickelHostApp(
     ui::PropertyHandler& out_properties_container) {
   out_properties_container.SetProperty(chromeos::kAppTypeKey,
                                        chromeos::AppType::CROSTINI_APP);
+  // Every window of an app ChromeOS launched is saved, not only the first:
+  // the launch's own record goes to the first window that opens, and an app
+  // whose first window is a short-lived one (Steam's "Starting Steam")
+  // would otherwise leave nothing for the window that stays.
+  if (crostini::WasNickelAppLaunched(app_id)) {
+    if (Profile* profile = ProfileManager::GetPrimaryUserProfile()) {
+      ::full_restore::SaveAppLaunchInfo(
+          profile->GetPath(),
+          std::make_unique<app_restore::AppLaunchInfo>(
+              app_id, apps::LaunchContainer::kLaunchContainerNone,
+              WindowOpenDisposition::NEW_WINDOW, display::kInvalidDisplayId,
+              std::vector<base::FilePath>(), /*intent=*/nullptr));
+    }
+  }
   out_properties_container.SetProperty(app_restore::kWindowIdKey,
                                        SessionID::NewUnique().id());
   out_properties_container.SetProperty(app_restore::kAppIdKey, app_id);

From: dresden196 <50474030+dresden196@users.noreply.github.com>
Subject: [PATCH] NickelOS: Welcome Recap has every Linux app window, and no
 Google parts

Full restore (0018) saved a Linux app's window only when it was the first
window after a launch: the launch's single record went to that window, and
when it closed the record went with it. Steam signed in to an account opens
a short-lived "Starting Steam" window first, so its library window was
never saved and Welcome Recap (the restore prompt after a sign-in) left
Steam out. Every window of a host app ChromeOS launched in the session
(from the launcher, the shelf, a file, full restore) now gets a record of
its own; windows of apps started some other way (a terminal, another app)
stay unsaved, as before.

The prompt's Google parts go: its first-time introduction (whose picture
shows Google's apps and which promises personalized suggestions) is off,
the prompt comes straight away; so is the nudge about suggestions in
Overview; and Overview's suggestions that come from Google (Calendar,
Drive's file suggestions, tabs from other devices, weather, release notes,
the AI grouping) are off by default, the local one (media left playing)
stays.

---
diff --git a/ash/birch/birch_model.cc b/ash/birch/birch_model.cc
index b178925..b9bbd37 100644
--- a/ash/birch/birch_model.cc
+++ b/ash/birch/birch_model.cc
@@ -94,14 +94,17 @@ void BirchModel::RemoveObserver(Observer* observer) {
 
 // static
 void BirchModel::RegisterProfilePrefs(PrefRegistrySimple* registry) {
-  registry->RegisterBooleanPref(prefs::kBirchUseCalendar, true);
-  registry->RegisterBooleanPref(prefs::kBirchUseFileSuggest, true);
-  registry->RegisterBooleanPref(prefs::kBirchUseChromeTabs, true);
+  // NickelOS: Overview's suggestions that come from Google (Calendar, Drive's
+  // file suggestions, tabs from other devices through Sync, Google's
+  // weather, Google's release notes, the AI grouping "Coral") are off; the
+  // local one (media left playing) stays.
+  registry->RegisterBooleanPref(prefs::kBirchUseCalendar, false);
+  registry->RegisterBooleanPref(prefs::kBirchUseFileSuggest, false);
+  registry->RegisterBooleanPref(prefs::kBirchUseChromeTabs, false);
   registry->RegisterBooleanPref(prefs::kBirchUseLostMedia, true);
-  registry->RegisterBooleanPref(prefs::kBirchUseWeather, true);
-  registry->RegisterBooleanPref(prefs::kBirchUseReleaseNotes, true);
-  // TODO(zxdan): Change this to false once there is a way to opt-in.
-  registry->RegisterBooleanPref(prefs::kBirchUseCoral, true);
+  registry->RegisterBooleanPref(prefs::kBirchUseWeather, false);
+  registry->RegisterBooleanPref(prefs::kBirchUseReleaseNotes, false);
+  registry->RegisterBooleanPref(prefs::kBirchUseCoral, false);
   // NOTE: If you add a pref here, also update birch_browsertest.cc and
   // birch_model_unittest.cc which have code that disables all prefs.
 }
diff --git a/ash/wm/window_restore/informed_restore_controller.cc b/ash/wm/window_restore/informed_restore_controller.cc
index 1ab90d2..3649a20 100644
--- a/ash/wm/window_restore/informed_restore_controller.cc
+++ b/ash/wm/window_restore/informed_restore_controller.cc
@@ -318,6 +318,12 @@ void InformedRestoreController::OnOverviewModeEndingAnimationComplete(bool cance
 
   in_informed_restore_ = false;
 
+  // NickelOS: no nudge about personalized suggestions in Overview (Google's
+  // ones are off, birch_model.cc).
+  if ((true)) {
+    return;
+  }
+
   PrefService* prefs = GetActivePrefService();
   if (!prefs) {
     return;
diff --git a/ash/wm/window_restore/window_restore_util.cc b/ash/wm/window_restore/window_restore_util.cc
index ce499da..be41b2a 100644
--- a/ash/wm/window_restore/window_restore_util.cc
+++ b/ash/wm/window_restore/window_restore_util.cc
@@ -93,7 +93,10 @@ void RegisterProfilePrefsFullRestore(PrefRegistrySimple* registry) {
       static_cast<int>(full_restore::RestoreOption::kAskEveryTime),
       user_prefs::PrefRegistrySyncable::SYNCABLE_OS_PREF);
 
-  registry->RegisterBooleanPref(prefs::kShowInformedRestoreOnboarding, true);
+  // NickelOS: no first-time introduction to the restore prompt (its
+  // picture shows Google's apps, and it promises Google's personalized
+  // suggestions); the prompt itself comes straight away.
+  registry->RegisterBooleanPref(prefs::kShowInformedRestoreOnboarding, false);
   registry->RegisterIntegerPref(prefs::kInformedRestoreNudgeShownCount, 0);
   registry->RegisterTimePref(prefs::kInformedRestoreNudgeLastShown,
                              base::Time());
diff --git a/chrome/browser/ash/crostini/crostini_util.cc b/chrome/browser/ash/crostini/crostini_util.cc
index 585d5c3..837ca58 100644
--- a/chrome/browser/ash/crostini/crostini_util.cc
+++ b/chrome/browser/ash/crostini/crostini_util.cc
@@ -8,6 +8,8 @@
 #include <unistd.h>
 
 #include <array>
+#include <set>
+#include <string>
 #include <utility>
 #include <variant>
 
@@ -214,6 +216,12 @@ void OnNickelAppLaunched(const std::string& app_id,
                         CrostiniResult::UNKNOWN_ERROR, true, std::string());
 }
 
+// The NickelOS host apps ChromeOS launched in this session.
+std::set<std::string>& NickelLaunchedApps() {
+  static base::NoDestructor<std::set<std::string>> apps;
+  return *apps;
+}
+
 // NickelOS host apps run on the device itself: launching one is a single call
 // to nickel-appd, which starts it as the session user.
 void LaunchNickelApp(
@@ -237,7 +245,9 @@ void LaunchNickelApp(
   }
 
   // Full restore saves the window this launch opens (ExoAppTypeResolver gives
-  // it a window id under |app_id|).
+  // it a window id under |app_id|), and the app's later windows too
+  // (WasNickelAppLaunched).
+  NickelLaunchedApps().insert(app_id);
   ::full_restore::SaveAppLaunchInfo(
       profile->GetPath(),
       std::make_unique<app_restore::AppLaunchInfo>(
@@ -272,6 +282,10 @@ void LaunchNickelApp(
 
 }  // namespace
 
+bool WasNickelAppLaunched(const std::string& app_id) {
+  return NickelLaunchedApps().contains(app_id);
+}
+
 bool IsNickelNativeAppsAllowed(Profile* profile) {
   if (!profile) {
     return false;
diff --git a/chrome/browser/ash/crostini/crostini_util.h b/chrome/browser/ash/crostini/crostini_util.h
index 3150812..12a0a48 100644
--- a/chrome/browser/ash/crostini/crostini_util.h
+++ b/chrome/browser/ash/crostini/crostini_util.h
@@ -65,6 +65,11 @@ inline constexpr char kNickelAppsServiceInterface[] = "org.nickelos.Apps";
 // this needs no virtualization support and includes guest sessions.
 bool IsNickelNativeAppsAllowed(Profile* profile);
 
+// Whether ChromeOS launched this NickelOS host app in this session (from the
+// launcher, the shelf, a file, full restore): its windows are then saved for
+// full restore, all of them.
+bool WasNickelAppLaunched(const std::string& app_id);
+
 // NickelOS, one home: a local account's Linux home is /home/<name>, where
 // nickel-session-setup mounts the user's My files for the session. Linux apps
 // name files by that path, Chrome by its own (<profile>/MyFiles/...); these
diff --git a/chrome/browser/ui/ash/shelf/app_service/BUILD.gn b/chrome/browser/ui/ash/shelf/app_service/BUILD.gn
index ac60f0b..b0beedd 100644
--- a/chrome/browser/ui/ash/shelf/app_service/BUILD.gn
+++ b/chrome/browser/ui/ash/shelf/app_service/BUILD.gn
@@ -69,11 +69,14 @@ static_library("app_service") {
     "//components/app_restore",
     "//components/exo",
     "//components/favicon/content",
+    "//components/services/app_service",
     "//components/sessions:session_id",
     "//components/user_manager",
     "//components/webapps/common",
     "//extensions/browser",
     "//extensions/common",
+    "//ui/base",
+    "//ui/display",
   ]
 
   allow_circular_includes_from = [ "//chrome/browser/ash/crostini" ]

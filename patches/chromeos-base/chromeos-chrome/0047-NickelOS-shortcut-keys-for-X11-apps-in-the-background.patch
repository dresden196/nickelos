new file mode 100644
index 0000000000000..77be27333e062
--- /dev/null
+++ b/chrome/browser/ash/dbus/vm/nickel_x11_keys.cc
@@ -0,0 +1,202 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_x11_keys.h"
+
+#include <errno.h>
+#include <sys/socket.h>
+
+#include <string>
+#include <utility>
+
+#include "ash/session/session_controller_impl.h"
+#include "ash/shell.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ash/guest_os/guest_os_pref_names.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "components/prefs/pref_service.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+
+namespace ash {
+
+namespace {
+
+// Modifier keys X11 apps may see pressed alone (not AltGr, which types
+// characters on many layouts, nor the locks).
+bool IsForwardedModifier(ui::KeyboardCode key) {
+  switch (key) {
+    case ui::VKEY_SHIFT:
+    case ui::VKEY_LSHIFT:
+    case ui::VKEY_RSHIFT:
+    case ui::VKEY_CONTROL:
+    case ui::VKEY_LCONTROL:
+    case ui::VKEY_RCONTROL:
+    case ui::VKEY_MENU:
+    case ui::VKEY_LMENU:
+    case ui::VKEY_RMENU:
+    case ui::VKEY_LWIN:
+    case ui::VKEY_RWIN:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// The modifier flag a modifier key's evdev code holds down.
+int ModifierFlag(int evdev) {
+  switch (evdev) {
+    case 29:   // KEY_LEFTCTRL
+    case 97:   // KEY_RIGHTCTRL
+      return ui::EF_CONTROL_DOWN;
+    case 42:   // KEY_LEFTSHIFT
+    case 54:   // KEY_RIGHTSHIFT
+      return ui::EF_SHIFT_DOWN;
+    case 56:   // KEY_LEFTALT
+    case 100:  // KEY_RIGHTALT
+      return ui::EF_ALT_DOWN;
+    case 125:  // KEY_LEFTMETA
+    case 126:  // KEY_RIGHTMETA
+      return ui::EF_COMMAND_DOWN;
+    default:
+      return 0;
+  }
+}
+
+bool IsFunctionKey(ui::KeyboardCode key) {
+  return key >= ui::VKEY_F1 && key <= ui::VKEY_F24;
+}
+
+bool Enabled() {
+  Profile* profile = ProfileManager::GetPrimaryUserProfile();
+  return profile && profile->GetPrefs()->GetBoolean(
+                        guest_os::prefs::kNickelX11KeyForwarding);
+}
+
+}  // namespace
+
+// static
+NickelX11Keys* NickelX11Keys::Get() {
+  static base::NoDestructor<NickelX11Keys> keys;
+  return keys.get();
+}
+
+NickelX11Keys::NickelX11Keys() = default;
+
+NickelX11Keys::~NickelX11Keys() = default;
+
+void NickelX11Keys::Connect(base::ScopedFD socket) {
+  Disconnect();
+  if (!socket.is_valid() || !Shell::HasInstance()) {
+    return;
+  }
+  socket_ = std::move(socket);
+  watch_ = base::FileDescriptorWatcher::WatchReadable(
+      socket_.get(), base::BindRepeating(&NickelX11Keys::OnSocket,
+                                         base::Unretained(this)));
+  if (!observing_) {
+    // Presses after ChromeOS's own shortcuts (AcceleratorFilter), which
+    // keep their keys; releases before them.
+    Shell::Get()->AddPreTargetHandler(this);
+    Shell::Get()->AddPreTargetHandler(&release_watcher_,
+                                      ui::EventTarget::Priority::kSystem);
+    observing_ = true;
+  }
+}
+
+void NickelX11Keys::OnSocket() {
+  // The forwarder only ever closes its end (its session ended).
+  char buffer[16];
+  ssize_t n = HANDLE_EINTR(
+      recv(socket_.get(), buffer, sizeof(buffer), MSG_DONTWAIT));
+  if (n < 0 && errno == EAGAIN) {
+    return;
+  }
+  Disconnect();
+}
+
+void NickelX11Keys::Disconnect() {
+  watch_.reset();
+  socket_.reset();
+  held_.clear();
+  if (observing_ && Shell::HasInstance()) {
+    Shell::Get()->RemovePreTargetHandler(this);
+    Shell::Get()->RemovePreTargetHandler(&release_watcher_);
+  }
+  observing_ = false;
+}
+
+void NickelX11Keys::Send(char kind, int evdev) {
+  const std::string message =
+      base::StrCat({std::string(1, kind), " ", base::NumberToString(evdev)});
+  HANDLE_EINTR(send(socket_.get(), message.data(), message.size(),
+                    MSG_DONTWAIT | MSG_NOSIGNAL));
+}
+
+void NickelX11Keys::ReleaseLiftedModifiers(const ui::KeyEvent& event) {
+  for (auto it = held_.begin(); it != held_.end();) {
+    const int flag = ModifierFlag(*it);
+    if (flag && !(event.flags() & flag)) {
+      Send('u', *it);
+      it = held_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void NickelX11Keys::ReleaseWatcher::OnKeyEvent(ui::KeyEvent* event) {
+  keys_->OnRelease(event);
+}
+
+void NickelX11Keys::OnRelease(ui::KeyEvent* event) {
+  if (!socket_.is_valid() || event->type() != ui::EventType::kKeyReleased) {
+    return;
+  }
+  const int evdev = ui::KeycodeConverter::DomCodeToEvdevCode(event->code());
+  if (held_.erase(evdev)) {
+    Send('u', evdev);
+  }
+  ReleaseLiftedModifiers(*event);
+}
+
+void NickelX11Keys::OnKeyEvent(ui::KeyEvent* event) {
+  if (!socket_.is_valid() || event->type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  const int evdev = ui::KeycodeConverter::DomCodeToEvdevCode(event->code());
+  if (evdev <= 0) {
+    return;
+  }
+  if (held_.count(evdev)) {
+    if (event->is_repeat()) {
+      // Held down: X11 apps saw it go down once.
+      return;
+    }
+    // Pressed again without a release seen: release it first.
+    held_.erase(evdev);
+    Send('u', evdev);
+  }
+  ReleaseLiftedModifiers(*event);
+  if (!Enabled() || Shell::Get()->session_controller()->IsUserSessionBlocked()) {
+    return;
+  }
+  const bool with_modifier =
+      event->flags() &
+      (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN);
+  if (!with_modifier && !IsForwardedModifier(event->key_code()) &&
+      !IsFunctionKey(event->key_code())) {
+    // Text: stays with the window that has the focus.
+    return;
+  }
+  held_.insert(evdev);
+  Send('d', evdev);
+}
+
+}  // namespace ash
diff --git a/chrome/browser/ash/dbus/vm/nickel_x11_keys.h b/chrome/browser/ash/dbus/vm/nickel_x11_keys.h
new file mode 100644
index 0000000000000..f2637a63762f1
--- /dev/null
+++ b/chrome/browser/ash/dbus/vm/nickel_x11_keys.h
@@ -0,0 +1,80 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_X11_KEYS_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_X11_KEYS_H_
+
+#include <memory>
+#include <set>
+
+#include "base/files/file_descriptor_watcher_posix.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/events/event_handler.h"
+
+namespace ash {
+
+// NickelOS: shortcut keys for X11 apps while other windows have the focus,
+// so that X11 apps that watch the keyboard themselves (the official Discord
+// client's push-to-talk) work as they do on an X11 desktop. Under Xwayland
+// an X11 app sees keys only while an X11 window has the focus; KDE forwards
+// keys to Xwayland for this, GNOME does not. NickelOS forwards only what
+// cannot be text: the modifier keys, keys pressed with Ctrl, Alt or Search,
+// and the function keys; never what the user types, never on the lock
+// screen. The user can turn it off (Settings > Apps,
+// guest_os::prefs::kNickelX11KeyForwarding; on by default).
+//
+// nickel-x11-keys, in the Linux session, connects through
+// VmApplicationsService with one end of a socket pair; each forwarded key
+// goes into it ("d EVDEV" pressed, "u EVDEV" released) and it presses the
+// key in Xwayland (XTest) while no X11 window has the focus; an X11 window
+// with the focus gets its keys from sommelier as always. Keys ChromeOS's
+// own shortcuts take are not forwarded, but every release of a key that was
+// is, even when a shortcut takes it (tapping Search opens the launcher on
+// its release): no key stays held in Xwayland.
+class NickelX11Keys : public ui::EventHandler {
+ public:
+  static NickelX11Keys* Get();
+
+  NickelX11Keys();
+  NickelX11Keys(const NickelX11Keys&) = delete;
+  NickelX11Keys& operator=(const NickelX11Keys&) = delete;
+  ~NickelX11Keys() override;
+
+  // A forwarder connected; a new one replaces the old.
+  void Connect(base::ScopedFD socket);
+
+  // ui::EventHandler: key presses, after ChromeOS's own shortcuts.
+  void OnKeyEvent(ui::KeyEvent* event) override;
+
+ private:
+  // Sees key releases before ChromeOS's shortcuts, which may take them.
+  class ReleaseWatcher : public ui::EventHandler {
+   public:
+    explicit ReleaseWatcher(NickelX11Keys* keys) : keys_(keys) {}
+    void OnKeyEvent(ui::KeyEvent* event) override;
+
+   private:
+    raw_ptr<NickelX11Keys> keys_;
+  };
+
+  void OnRelease(ui::KeyEvent* event);
+  // Releases held modifiers the event shows up (their release went
+  // elsewhere).
+  void ReleaseLiftedModifiers(const ui::KeyEvent& event);
+  void OnSocket();
+  void Disconnect();
+  void Send(char kind, int evdev);
+
+  base::ScopedFD socket_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> watch_;
+  // Forwarded as pressed: their release follows them.
+  std::set<int> held_;
+  ReleaseWatcher release_watcher_{this};
+  bool observing_ = false;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_X11_KEYS_H_

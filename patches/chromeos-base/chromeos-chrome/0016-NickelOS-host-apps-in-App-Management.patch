+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// NickelOS: the App Management page of a Linux app installed on the device
+// itself (Flatpak, Portage, AppImage): pin to shelf, and what it is, what
+// installed it, its version and storage. Uninstall is in the page's header.
+
+import './app_details_item.js';
+import './pin_to_shelf_item.js';
+import './app_management_cros_shared_style.css.js';
+
+import type {App} from 'chrome://resources/cr_components/app_management/app_management.mojom-webui.js';
+import {getSelectedApp} from 'chrome://resources/cr_components/app_management/util.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {AppManagementStoreMixin} from '../../common/app_management/store_mixin.js';
+import type {PrefsState} from '../../common/types.js';
+
+import {getTemplate} from './nickel_detail_view.html.js';
+
+const AppManagementNickelDetailViewElementBase =
+    AppManagementStoreMixin(PolymerElement);
+
+export class AppManagementNickelDetailViewElement extends
+    AppManagementNickelDetailViewElementBase {
+  static get is() {
+    return 'app-management-nickel-detail-view';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      prefs: {
+        type: Object,
+        notify: true,
+      },
+
+      app_: {
+        type: Object,
+      },
+    };
+  }
+
+  declare prefs: PrefsState;
+  declare private app_: App;
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.watch('app_', state => getSelectedApp(state));
+    this.updateFromStore();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-management-nickel-detail-view': AppManagementNickelDetailViewElement;
+  }
+}
+
+customElements.define(
+    AppManagementNickelDetailViewElement.is,
+    AppManagementNickelDetailViewElement);

+// App Management asks for the app's size when it shows the app; nickel-appd
+// works out version, app size and data size from what installed it.
+void NickelHostApps::UpdateAppSize(const std::string& app_id) {
+  std::optional<guest_os::GuestOsRegistryService::Registration> registration =
+      registry()->GetRegistration(app_id);
+  if (!registration || registration->PackageId().empty()) {
+    return;
+  }
+  dbus::ObjectProxy* proxy =
+      ash::DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+          crostini::kNickelAppsServiceName,
+          dbus::ObjectPath(crostini::kNickelAppsServicePath));
+  dbus::MethodCall method_call(crostini::kNickelAppsServiceInterface,
+                               "GetAppDetails");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(registration->DesktopFileId());
+  proxy->CallMethod(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelHostApps::OnAppDetails,
+                     weak_ptr_factory_.GetWeakPtr(), app_id));
+}
+
+void NickelHostApps::OnAppDetails(const std::string& app_id,
+                                  dbus::Response* response) {
+  std::string version;
+  uint64_t app_size = 0;
+  uint64_t data_size = 0;
+  if (!response) {
+    return;
+  }
+  dbus::MessageReader reader(response);
+  if (!reader.PopString(&version) || !reader.PopUint64(&app_size) ||
+      !reader.PopUint64(&data_size)) {
+    return;
+  }
+  auto app = std::make_unique<App>(AppType(), app_id);
+  if (!version.empty()) {
+    app->version = version;
+  }
+  if (app_size) {
+    app->app_size_in_bytes = app_size;
+  }
+  if (data_size) {
+    app->data_size_in_bytes = data_size;
+  }
+  AppPublisher::Publish(std::move(app));
+}
+
 void NickelHostApps::GetMenuModel(
     const std::string& app_id,
     MenuType menu_type,
@@ -145,9 +193,19 @@ void NickelHostApps::GetMenuModel(
 void NickelHostApps::CreateAppOverrides(
     const guest_os::GuestOsRegistryService::Registration& registration,
     App* app) {
-  // App Management for host apps: docs/host-apps.md, step 2.
-  app->show_in_management = false;
-  app->allow_uninstall = !registration.PackageId().empty();
+  // In App Management with their own page (nickel_detail_view): what
+  // installed them (the package id: flatpak:..., portage, appimage:...),
+  // version and storage (UpdateAppSize). The OS image's own apps have no
+  // package id and count as system apps.
+  app->show_in_management = true;
+  const std::string package_id = registration.PackageId();
+  app->allow_uninstall = !package_id.empty();
+  if (!package_id.empty()) {
+    app->publisher_id = package_id;
+    app->install_reason = InstallReason::kUser;
+  } else {
+    app->install_reason = InstallReason::kSystem;
+  }
 }
 
 }  // namespace apps

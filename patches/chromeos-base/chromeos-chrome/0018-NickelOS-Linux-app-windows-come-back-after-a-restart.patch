+void AppLaunchHandler::LaunchNickelHostApp(
+    const std::string& app_id,
+    const ::app_restore::RestoreData::LaunchList& launch_list) {
+  // Started once, however many of its windows were saved. Each window it
+  // then opens takes the place of the next saved one (ExoAppTypeResolver
+  // asks for it), as Chrome apps' windows do.
+  OnExtensionLaunching(app_id);
+  RecordRestoredAppLaunch(GetHistogrameAppType(apps::AppType::kNickelHost));
+  const std::optional<int64_t>& display_id =
+      launch_list.begin()->second->display_id;
+  apps::AppServiceProxyFactory::GetForProfile(profile_)->Launch(
+      app_id, ui::EF_NONE, apps::LaunchSource::kFromFullRestore,
+      std::make_unique<apps::WindowInfo>(
+          display_id.value_or(display::kInvalidDisplayId)));
+}

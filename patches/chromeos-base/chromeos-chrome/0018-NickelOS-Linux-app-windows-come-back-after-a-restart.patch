+// NickelOS: the shelf app id of the Linux app on the device (a NICKEL_HOST
+// registration) a window with these ids belongs to, or "".
+std::string GetNickelHostAppId(
+    const exo::WMHelper::AppPropertyResolver::Params& params) {
+  Profile* profile = ProfileManager::GetPrimaryUserProfile();
+  if (!crostini::IsNickelNativeAppsAllowed(profile)) {
+    return std::string();
+  }
+  auto* registry =
+      guest_os::GuestOsRegistryServiceFactory::GetForProfile(profile);
+  if (!registry) {
+    return std::string();
+  }
+  const std::string app_id = guest_os::GetGuestOsShelfAppId(
+      profile, &params.app_id, &params.startup_id);
+  std::optional<guest_os::GuestOsRegistryService::Registration> registration =
+      registry->GetRegistration(app_id);
+  if (!registration ||
+      registration->VmType() != guest_os::VmType::NICKEL_HOST) {
+    return std::string();
+  }
+  return app_id;
+}
+
+// NickelOS: Linux apps on the device take part in full restore as Chrome
+// apps do. Each of their windows gets a window id under the app's id, so the
+// window a launch opens is saved (crostini::LaunchNickelApp records the
+// launch). After a restart, full restore starts the app once
+// (ash::AppLaunchHandler) and each window it opens takes the place, size,
+// state and desk of the next saved one.
+void UpdatePropertiesForNickelHostApp(
+    const std::string& app_id,
+    ui::PropertyHandler& out_properties_container) {
+  out_properties_container.SetProperty(chromeos::kAppTypeKey,
+                                       chromeos::AppType::CROSTINI_APP);
+  out_properties_container.SetProperty(app_restore::kWindowIdKey,
+                                       SessionID::NewUnique().id());
+  out_properties_container.SetProperty(app_restore::kAppIdKey, app_id);
+  // Asked of full restore itself: app_restore::FetchRestoreWindowId stops
+  // answering five seconds into the restore, and a Linux app can take longer
+  // to open its window.
+  const int32_t restore_window_id =
+      full_restore::FullRestoreReadHandler::GetInstance()
+          ->FetchRestoreWindowId(app_id);
+  if (restore_window_id) {
+    out_properties_container.SetProperty(app_restore::kRestoreWindowIdKey,
+                                         restore_window_id);
+  }
+}
+
 }  // namespace
 

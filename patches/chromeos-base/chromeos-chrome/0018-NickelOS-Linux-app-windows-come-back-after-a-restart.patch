+// NickelOS: nickel-session is about to stop, and every Linux app with it,
+// because the UI is stopping (sign-out, restart, shutdown; also `restart ui`
+// or `reboot` from a shell, where session_manager tells Chrome only after the
+// Linux side has stopped). Their windows closing from now on is the session
+// ending, not the user closing them: stop saving full restore data, as Chrome
+// does when it ends the session itself (FullRestoreService::OnAppTerminating),
+// so the next sign-in brings them back. The reply tells nickel-session it may
+// go on.
+void VmApplicationsServiceProvider::NickelSessionEnding(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  ::full_restore::FullRestoreSaveHandler::GetInstance()->SetShutDown();
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}

-// Sets up what `experience` ("privacy", "google" or "minimal") means for
-// `profile`.
+// Proton's apps, in a folder on the bookmarks bar.
+struct ProtonApp {
+  const char16_t* title;
+  const char* url;
+};
+constexpr ProtonApp kProtonApps[] = {
+    {u"Proton Mail", "https://mail.proton.me/"},
+    {u"Proton Calendar", "https://calendar.proton.me/"},
+    {u"Proton Drive", "https://drive.proton.me/"},
+    {u"Proton Docs", "https://docs.proton.me/"},
+    {u"Proton Pass", "https://pass.proton.me/"},
+    {u"Proton VPN", "https://account.proton.me/vpn"},
+    {u"Lumo", "https://lumo.proton.me/"},
+};
+
+// Adds the Proton folder once the profile's bookmarks are loaded; deletes
+// itself.
+class ProtonBookmarks : public bookmarks::BaseBookmarkModelObserver {
+ public:
+  static void Add(bookmarks::BookmarkModel* model) {
+    if (model->loaded()) {
+      AddNow(model);
+      return;
+    }
+    new ProtonBookmarks(model);
+  }
+
+ private:
+  explicit ProtonBookmarks(bookmarks::BookmarkModel* model) : model_(model) {
+    observation_.Observe(model);
+  }
+  ~ProtonBookmarks() override = default;
+
+  static void AddNow(bookmarks::BookmarkModel* model) {
+    const bookmarks::BookmarkNode* bar = model->bookmark_bar_node();
+    const bookmarks::BookmarkNode* folder =
+        model->AddFolder(bar, bar->children().size(), u"Proton");
+    for (size_t i = 0; i < std::size(kProtonApps); ++i) {
+      model->AddURL(folder, i, kProtonApps[i].title, GURL(kProtonApps[i].url));
+    }
+  }
+
+  // bookmarks::BaseBookmarkModelObserver:
+  void BookmarkModelLoaded(bool ids_reassigned) override {
+    AddNow(model_);
+    delete this;
+  }
+  void BookmarkModelBeingDeleted() override { delete this; }
+  void BookmarkModelChanged() override {}
+
+  raw_ptr<bookmarks::BookmarkModel> model_;
+  base::ScopedObservation<bookmarks::BookmarkModel,
+                          bookmarks::BookmarkModelObserver>
+      observation_{this};
+};
+
+// Sets up what `experience` ("default" or "minimal"; "privacy" is what
+// builds before 2026-10-22 called the default) means for `profile`.
 void Apply(Profile* profile, const std::string& experience) {
   // Minimal: the launcher searches the device only (no web results).
   if (experience == "minimal") {
@@ -69,10 +132,14 @@ void Apply(Profile* profile, const std::string& experience) {

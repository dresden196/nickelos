+                           bool move) override;
+  base::FilePath CrackFileSystemUrl(const GURL& url) override;
+  bool IsInMyFiles(const base::FilePath& path) override;
+
+ private:
+  // The signed-in user's profile, or null.
+  Profile* GetProfile();
+};

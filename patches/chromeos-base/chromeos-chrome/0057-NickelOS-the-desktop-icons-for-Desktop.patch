+// The grid: a cell per item, in the work area, from its top left corner.
+constexpr int kCellWidth = 96;
+constexpr int kCellHeight = 104;
+constexpr int kMargin = 12;
+// An item: a rounded tile with the file type's icon, the name under it.
+constexpr int kTileSize = 56;

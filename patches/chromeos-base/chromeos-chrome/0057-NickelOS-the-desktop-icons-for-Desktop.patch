+#ifndef ASH_NICKEL_DESKTOP_NICKEL_DESKTOP_CONTROLLER_H_
+#define ASH_NICKEL_DESKTOP_NICKEL_DESKTOP_CONTROLLER_H_
+
+#include <memory>
+
+#include "ash/ash_export.h"
+#include "ash/public/cpp/session/session_observer.h"
+#include "ash/wm/overview/overview_observer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/aura/window_observer.h"
+#include "ui/display/display_observer.h"
+
+class PrefRegistrySimple;
+
+namespace views {
+class Widget;
+class WidgetDelegate;
+}  // namespace views
+
+namespace ash {
+
+class NickelDesktopView;
+class OverviewController;
+
+// NickelOS: the desktop, icons for what is in ~/Desktop (docs/desktop.md in
+// overlay-nickel). One widget on the primary display, in the wallpaper
+// container above the wallpaper (so under every window), while a user
+// session is active, in clamshell mode and outside overview.
+class ASH_EXPORT NickelDesktopController : public SessionObserver,
+                                           public OverviewObserver,
+                                           public display::DisplayObserver,
+                                           public aura::WindowObserver {
+ public:
+  // Profile pref: each item's grid cell, by file name ([column, row]).
+  static constexpr char kPositionsPref[] = "nickel.desktop.positions";
+
+  NickelDesktopController();
+  NickelDesktopController(const NickelDesktopController&) = delete;
+  NickelDesktopController& operator=(const NickelDesktopController&) = delete;
+  ~NickelDesktopController() override;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // SessionObserver:
+  void OnSessionStateChanged(session_manager::SessionState state) override;
+  void OnActiveUserPrefServiceChanged(PrefService* pref_service) override;
+
+  // OverviewObserver:
+  void OnOverviewModeStarting() override;
+  void OnOverviewModeEnded() override;
+
+  // display::DisplayObserver:
+  void OnDisplayAdded(const display::Display& new_display) override;
+  void OnDisplaysRemoved(const display::Displays& removed_displays) override;
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override;
+  void OnDisplayTabletStateChanged(display::TabletState state) override;
+
+  // aura::WindowObserver, for the wallpaper container:
+  void OnWindowAdded(aura::Window* new_window) override;
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  // Creates, moves, shows or hides the desktop as the session, the displays
+  // and the modes say.
+  void Update();
+  void CreateWidget(aura::Window* root);
+  void DestroyWidget();
+
+  // The widget's delegate outlives the widget.
+  std::unique_ptr<views::WidgetDelegate> widget_delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<NickelDesktopView> view_ = nullptr;
+  // The wallpaper container the widget is in.
+  raw_ptr<aura::Window> container_ = nullptr;
+
+  ScopedSessionObserver session_observer_{this};
+  display::ScopedDisplayObserver display_observer_{this};
+  base::ScopedObservation<OverviewController, OverviewObserver>
+      overview_observation_{this};
+  bool in_overview_ = false;
+};
+
+}  // namespace ash
+
+#endif  // ASH_NICKEL_DESKTOP_NICKEL_DESKTOP_CONTROLLER_H_

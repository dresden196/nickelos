+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ash/nickel/desktop/nickel_desktop_controller.h"
+
+#include <utility>
+
+#include "ash/nickel/desktop/nickel_desktop_view.h"
+#include "ash/public/cpp/nickel_desktop_client.h"
+#include "ash/public/cpp/shell_window_ids.h"
+#include "ash/session/session_controller_impl.h"
+#include "ash/shell.h"
+#include "ash/wm/overview/overview_controller.h"
+#include "base/files/file_path.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "ui/aura/window.h"
+#include "ui/display/screen.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+namespace ash {
+
+NickelDesktopController::NickelDesktopController() {
+  overview_observation_.Observe(OverviewController::Get());
+  Update();
+}
+
+NickelDesktopController::~NickelDesktopController() {
+  DestroyWidget();
+}
+
+// static
+void NickelDesktopController::RegisterProfilePrefs(
+    PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kPositionsPref);
+}
+
+void NickelDesktopController::OnSessionStateChanged(
+    session_manager::SessionState state) {
+  Update();
+}
+
+void NickelDesktopController::OnActiveUserPrefServiceChanged(
+    PrefService* pref_service) {
+  // Another user's desktop (or the first one, once the profile is there).
+  DestroyWidget();
+  Update();
+}
+
+void NickelDesktopController::OnOverviewModeStarting() {
+  in_overview_ = true;
+  Update();
+}
+
+void NickelDesktopController::OnOverviewModeEnded() {
+  in_overview_ = false;
+  Update();
+}
+
+void NickelDesktopController::OnDisplayAdded(
+    const display::Display& new_display) {
+  Update();
+}
+
+void NickelDesktopController::OnDisplaysRemoved(
+    const display::Displays& removed_displays) {
+  Update();
+}
+
+void NickelDesktopController::OnDisplayMetricsChanged(
+    const display::Display& display,
+    uint32_t changed_metrics) {
+  Update();
+  if (view_) {
+    view_->OnWorkAreaChanged();
+  }
+}
+
+void NickelDesktopController::OnDisplayTabletStateChanged(
+    display::TabletState state) {
+  Update();
+}
+
+void NickelDesktopController::OnWindowAdded(aura::Window* new_window) {
+  // A new wallpaper widget goes on top of the container: stay above it.
+  if (widget_ && new_window != widget_->GetNativeWindow()) {
+    container_->StackChildAtTop(widget_->GetNativeWindow());
+  }
+}
+
+void NickelDesktopController::OnWindowDestroying(aura::Window* window) {
+  if (window == container_) {
+    DestroyWidget();
+  }
+}
+
+void NickelDesktopController::Update() {
+  Shell* shell = Shell::Get();
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  const bool wanted =
+      client &&
+      shell->session_controller()->GetSessionState() ==
+          session_manager::SessionState::ACTIVE &&
+      shell->session_controller()->GetActivePrefService() &&
+      !client->GetDesktopFolder().empty() &&
+      !display::Screen::Get()->InTabletMode();
+  if (!wanted) {
+    DestroyWidget();
+    return;
+  }
+
+  aura::Window* root = Shell::GetPrimaryRootWindow();
+  if (widget_ && widget_->GetNativeWindow()->GetRootWindow() != root) {
+    // The primary display changed.
+    DestroyWidget();
+  }
+  if (!widget_) {
+    CreateWidget(root);
+  }
+  if (in_overview_) {
+    widget_->Hide();
+  } else {
+    widget_->ShowInactive();
+  }
+}
+
+void NickelDesktopController::CreateWidget(aura::Window* root) {
+  container_ = Shell::GetContainer(root, kShellWindowId_WallpaperContainer);
+  container_->AddObserver(this);
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "NickelDesktopWidget";
+  params.parent = container_;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  // On the wallpaper's layer: never the active window (dialogs that need the
+  // keyboard, such as renaming, are bubbles elsewhere).
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.bounds = root->GetBoundsInScreen();
+  // The wallpaper container's layout manager ignores the bounds a window
+  // asks for and fills the display with the maximizable ones, as it does the
+  // wallpaper: so the desktop is maximizable.
+  widget_delegate_ = std::make_unique<views::WidgetDelegate>();
+  widget_delegate_->SetCanMaximize(true);
+  params.delegate = widget_delegate_.get();
+  widget_ = std::make_unique<views::Widget>();
+  widget_->Init(std::move(params));
+  view_ = widget_->SetContentsView(std::make_unique<NickelDesktopView>(
+      NickelDesktopClient::Get()->GetDesktopFolder(),
+      Shell::Get()->session_controller()->GetActivePrefService()));
+  container_->StackChildAtTop(widget_->GetNativeWindow());
+}
+
+void NickelDesktopController::DestroyWidget() {
+  if (container_) {
+    container_->RemoveObserver(this);
+    container_ = nullptr;
+  }
+  view_ = nullptr;
+  widget_.reset();
+  widget_delegate_.reset();
+}
+
+}  // namespace ash

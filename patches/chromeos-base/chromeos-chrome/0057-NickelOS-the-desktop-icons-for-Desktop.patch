+}  // namespace
+
+// The items of the desktop folder, read on a blocking sequence and again
+// whenever the folder changes.
+class NickelDesktopView::Lister {
+ public:
+  using Callback = base::RepeatingCallback<void(std::vector<Entry>)>;
+
+  Lister(base::FilePath folder, Callback callback)
+      : folder_(std::move(folder)), callback_(std::move(callback)) {
+    watcher_.Watch(folder_, base::FilePathWatcher::Type::kNonRecursive,
+                   base::BindRepeating(&Lister::OnChanged,
+                                       base::Unretained(this)));
+    List();
+  }
+
+ private:
+  void OnChanged(const base::FilePath& path, bool error) { List(); }
+
+  void List() {
+    std::vector<Entry> entries;
+    base::FileEnumerator enumerator(
+        folder_, /*recursive=*/false,
+        base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      // Hidden files stay hidden, as in Files.
+      if (path.BaseName().value().starts_with(".")) {
+        continue;
+      }
+      entries.push_back({path, enumerator.GetInfo().IsDirectory()});
+    }
+    std::ranges::sort(entries, [](const Entry& a, const Entry& b) {
+      return base::ToLowerASCII(NameOf(a.path)) <
+             base::ToLowerASCII(NameOf(b.path));
+    });
+    callback_.Run(std::move(entries));
+  }
+
+  const base::FilePath folder_;
+  const Callback callback_;
+  base::FilePathWatcher watcher_;
+};

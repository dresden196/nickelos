index 0000000000000..f97ef7ff9b99a
--- /dev/null
+++ b/chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/nickel_desktop/nickel_desktop_client_impl.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/ash/file_manager/copy_or_move_io_task.h"
+#include "chrome/browser/ash/file_manager/fileapi_util.h"
+#include "chrome/browser/ash/file_manager/io_task.h"
+#include "chrome/browser/ash/file_manager/io_task_controller.h"
+#include "chrome/browser/ash/file_manager/open_util.h"
+#include "chrome/browser/ash/file_manager/path_util.h"
+#include "chrome/browser/ash/file_manager/trash_io_task.h"
+#include "chrome/browser/ash/file_manager/volume_manager.h"
+#include "chrome/browser/platform_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "components/user_manager/user_manager.h"
+#include "storage/browser/file_system/file_system_context.h"
+#include "storage/browser/file_system/file_system_url.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The file system URLs of `paths` for Files' operations; those Files does not
+// know are left out.
+std::vector<storage::FileSystemURL> ToFileSystemUrls(
+    Profile* profile,
+    storage::FileSystemContext* context,
+    const std::vector<base::FilePath>& paths) {
+  std::vector<storage::FileSystemURL> urls;
+  for (const base::FilePath& path : paths) {
+    GURL url;
+    if (file_manager::util::ConvertAbsoluteFilePathToFileSystemUrl(
+            profile, path, file_manager::util::GetFileManagerURL(), &url)) {
+      urls.push_back(context->CrackURLInFirstPartyContext(url));
+    }
+  }
+  return urls;
+}
+
+}  // namespace
+
+NickelDesktopClientImpl::NickelDesktopClientImpl() = default;
+
+NickelDesktopClientImpl::~NickelDesktopClientImpl() = default;
+
+Profile* NickelDesktopClientImpl::GetProfile() {
+  if (!user_manager::UserManager::IsInitialized() ||
+      !user_manager::UserManager::Get()->IsUserLoggedIn()) {
+    return nullptr;
+  }
+  Profile* profile = ProfileManager::GetActiveUserProfile();
+  return profile && !profile->IsOffTheRecord() ? profile : nullptr;
+}
+
+base::FilePath NickelDesktopClientImpl::GetDesktopFolder() {
+  Profile* profile = GetProfile();
+  // My files is the home folder (one home), Desktop one of its folders.
+  return profile ? file_manager::util::GetMyFilesFolderForProfile(profile)
+                       .Append("Desktop")
+                 : base::FilePath();
+}
+
+void NickelDesktopClientImpl::Open(const base::FilePath& path, bool is_folder) {
+  if (Profile* profile = GetProfile()) {
+    // Files tells the user if it cannot open it; it runs the callback in
+    // any case, so an empty one would crash Chrome.
+    file_manager::util::OpenItem(
+        profile, path,
+        is_folder ? platform_util::OPEN_FOLDER : platform_util::OPEN_FILE,
+        base::DoNothing());
+  }
+}
+
+void NickelDesktopClientImpl::ShowInFiles(const base::FilePath& path) {
+  if (Profile* profile = GetProfile()) {
+    file_manager::util::ShowItemInFolder(profile, path, base::DoNothing());
+  }
+}
+
+void NickelDesktopClientImpl::MoveToTrash(
+    const std::vector<base::FilePath>& paths) {
+  Profile* profile = GetProfile();
+  file_manager::VolumeManager* volume_manager =
+      profile ? file_manager::VolumeManager::Get(profile) : nullptr;
+  if (!volume_manager) {
+    return;
+  }
+  scoped_refptr<storage::FileSystemContext> context =
+      file_manager::util::GetFileManagerFileSystemContext(profile);
+  std::vector<storage::FileSystemURL> urls =
+      ToFileSystemUrls(profile, context.get(), paths);
+  if (urls.empty()) {
+    return;
+  }
+  volume_manager->io_task_controller()->Add(
+      std::make_unique<file_manager::io_task::TrashIOTask>(
+          std::move(urls), profile, context, /*base_path=*/base::FilePath()));
+}
+
+void NickelDesktopClientImpl::CopyOrMoveToDesktop(
+    const std::vector<base::FilePath>& paths,
+    bool move) {
+  Profile* profile = GetProfile();
+  file_manager::VolumeManager* volume_manager =
+      profile ? file_manager::VolumeManager::Get(profile) : nullptr;
+  if (!volume_manager) {
+    return;
+  }
+  scoped_refptr<storage::FileSystemContext> context =
+      file_manager::util::GetFileManagerFileSystemContext(profile);
+  std::vector<storage::FileSystemURL> sources =
+      ToFileSystemUrls(profile, context.get(), paths);
+  std::vector<storage::FileSystemURL> destination =
+      ToFileSystemUrls(profile, context.get(), {GetDesktopFolder()});
+  if (sources.empty() || destination.empty()) {
+    return;
+  }
+  volume_manager->io_task_controller()->Add(
+      std::make_unique<file_manager::io_task::CopyOrMoveIOTask>(
+          move ? file_manager::io_task::OperationType::kMove
+               : file_manager::io_task::OperationType::kCopy,
+          std::move(sources), std::move(destination.front()), profile,
+          context));
+}
+
+base::FilePath NickelDesktopClientImpl::CrackFileSystemUrl(const GURL& url) {
+  Profile* profile = GetProfile();
+  return profile ? file_manager::util::GetFileManagerFileSystemContext(profile)
+                       ->CrackURLInFirstPartyContext(url)
+                       .path()
+                 : base::FilePath();
+}
+
+bool NickelDesktopClientImpl::IsInMyFiles(const base::FilePath& path) {
+  Profile* profile = GetProfile();
+  if (!profile) {
+    return false;
+  }
+  const base::FilePath my_files =
+      file_manager::util::GetMyFilesFolderForProfile(profile);
+  return my_files == path || my_files.IsParent(path);
+}

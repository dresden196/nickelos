+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ASH_PUBLIC_CPP_NICKEL_DESKTOP_CLIENT_H_
+#define ASH_PUBLIC_CPP_NICKEL_DESKTOP_CLIENT_H_
+
+#include <vector>
+
+#include "ash/public/cpp/ash_public_export.h"
+
+class GURL;
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace ash {
+
+// NickelOS: what the desktop (icons for ~/Desktop, ash/nickel/desktop) needs
+// from the browser, for the active user's profile. Chrome sets the one
+// instance (NickelDesktopClientImpl).
+class ASH_PUBLIC_EXPORT NickelDesktopClient {
+ public:
+  // The instance, or null before Chrome sets it.
+  static NickelDesktopClient* Get();
+
+  NickelDesktopClient(const NickelDesktopClient&) = delete;
+  NickelDesktopClient& operator=(const NickelDesktopClient&) = delete;
+
+  // The desktop folder (My files, the home folder, then Desktop), or an empty
+  // path while no user is signed in.
+  virtual base::FilePath GetDesktopFolder() = 0;
+
+  // Opens `path`: a folder in Files, a file with the app Files would open it
+  // with.
+  virtual void Open(const base::FilePath& path, bool is_folder) = 0;
+
+  // Opens Files at `path`'s folder, with `path` selected.
+  virtual void ShowInFiles(const base::FilePath& path) = 0;
+
+  // Moves `paths` to the trash, as Files does (with its notification).
+  virtual void MoveToTrash(const std::vector<base::FilePath>& paths) = 0;
+
+  // Copies, or moves if `move`, `paths` into the desktop folder, as Files
+  // does (progress and name clashes as in Files).
+  virtual void CopyOrMoveToDesktop(const std::vector<base::FilePath>& paths,
+                                   bool move) = 0;
+
+  // The local path of a file system URL Files puts in what it drags, or an
+  // empty path.
+  virtual base::FilePath CrackFileSystemUrl(const GURL& url) = 0;
+
+  // Whether `path` is in My files (the home folder), where moving within it
+  // is what dragging does in Files.
+  virtual bool IsInMyFiles(const base::FilePath& path) = 0;
+
+ protected:
+  NickelDesktopClient();
+  virtual ~NickelDesktopClient();
+};
+
+}  // namespace ash
+
+#endif  // ASH_PUBLIC_CPP_NICKEL_DESKTOP_CLIENT_H_

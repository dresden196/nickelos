+
+NickelDesktopView::NickelDesktopView(base::FilePath folder, PrefService* prefs)
+    : folder_(std::move(folder)), prefs_(prefs) {
+  set_context_menu_controller(this);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kListBox);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_ACCESSIBLE_NAME));
+  lister_ = base::SequenceBound<Lister>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      folder_,
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &NickelDesktopView::OnEntries, weak_factory_.GetWeakPtr())));
+}
+
+NickelDesktopView::~NickelDesktopView() = default;
+
+base::WeakPtr<NickelDesktopView> NickelDesktopView::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void NickelDesktopView::OnWorkAreaChanged() {
+  AssignCells();
+  InvalidateLayout();
+}
+
+void NickelDesktopView::OnEntries(std::vector<Entry> entries) {
+  std::set<base::FilePath> present;
+  order_.clear();
+  for (const Entry& entry : entries) {
+    present.insert(entry.path);
+    order_.push_back(entry.path);
+    if (!icons_.contains(entry.path)) {
+      icons_[entry.path] =
+          AddChildView(std::make_unique<NickelDesktopIconView>(this, entry));
+    }
+  }
+  for (auto it = icons_.begin(); it != icons_.end();) {
+    if (present.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    // Gone (deleted, renamed or moved away): forget where it was.
+    if (!renamed_from_.erase(it->first)) {
+      ScopedDictPrefUpdate update(prefs_,
+                                  NickelDesktopController::kPositionsPref);
+      update->Remove(NameOf(it->first));
+    }
+    cells_.erase(it->first);
+    NickelDesktopIconView* icon = it->second;
+    it = icons_.erase(it);
+    RemoveChildViewT(icon);
+  }
+  AssignCells();
+  InvalidateLayout();
+
+  if (!pending_rename_.empty()) {
+    if (NickelDesktopIconView* icon = FindIcon(pending_rename_)) {
+      pending_rename_.clear();
+      // Once laid out, so the bubble finds its icon.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<NickelDesktopView> desktop,
+                 base::FilePath path) {
+                if (desktop) {
+                  if (NickelDesktopIconView* icon = desktop->FindIcon(path)) {
+                    desktop->ShowRenameBubble(icon);
+                  }
+                }
+              },
+              weak_factory_.GetWeakPtr(), icon->path()));
+    }
+  }
+}
+
+gfx::Rect NickelDesktopView::GetGridBounds() const {
+  if (!GetWidget()) {
+    return GetLocalBounds();
+  }
+  gfx::Rect work_area = display::Screen::Get()
+                            ->GetDisplayNearestWindow(
+                                GetWidget()->GetNativeWindow())
+                            .work_area();
+  work_area.Offset(-GetBoundsInScreen().OffsetFromOrigin());
+  work_area.Inset(kMargin);
+  return work_area;
+}
+
+int NickelDesktopView::GetColumns() const {
+  return std::max(1, GetGridBounds().width() / kCellWidth);
+}
+
+int NickelDesktopView::GetRows() const {
+  return std::max(1, GetGridBounds().height() / kCellHeight);
+}
+
+gfx::Rect NickelDesktopView::GetCellBounds(const Cell& cell) const {
+  const gfx::Rect grid = GetGridBounds();
+  return gfx::Rect(grid.x() + cell.column * kCellWidth,
+                   grid.y() + cell.row * kCellHeight, kCellWidth, kCellHeight);
+}
+
+NickelDesktopView::Cell NickelDesktopView::GetCellAt(
+    const gfx::Point& point) const {
+  const gfx::Rect grid = GetGridBounds();
+  return {std::clamp((point.x() - grid.x()) / kCellWidth, 0, GetColumns() - 1),
+          std::clamp((point.y() - grid.y()) / kCellHeight, 0, GetRows() - 1)};
+}
+
+NickelDesktopView::Cell NickelDesktopView::FindFreeCell(
+    const std::set<Cell>& taken,
+    const Cell& start) const {
+  const int columns = GetColumns();
+  const int rows = GetRows();
+  const int count = columns * rows;
+  const int first = std::clamp(start.column, 0, columns - 1) * rows +
+                    std::clamp(start.row, 0, rows - 1);
+  for (int i = 0; i < count; ++i) {
+    const int index = (first + i) % count;
+    const Cell cell{index / rows, index % rows};
+    if (!taken.contains(cell)) {
+      return cell;
+    }
+  }
+  // A full desktop: overlap.
+  return start;
+}
+
+void NickelDesktopView::AssignCells() {
+  // A copy: SaveCell() below replaces the pref's value.
+  const base::DictValue saved =
+      prefs_->GetDict(NickelDesktopController::kPositionsPref).Clone();
+  const int columns = GetColumns();
+  const int rows = GetRows();
+  std::map<base::FilePath, Cell> cells;
+  std::set<Cell> taken;
+  std::vector<base::FilePath> unplaced;
+  for (const base::FilePath& path : order_) {
+    const std::string name = NameOf(path);
+    std::optional<Cell> wanted;
+    if (auto it = pending_cells_.find(name); it != pending_cells_.end()) {
+      wanted = it->second;
+      pending_cells_.erase(it);
+      SaveCell(path, *wanted);
+    } else if (const base::ListValue* list = saved.FindList(name);
+               list && list->size() == 2 && (*list)[0].is_int() &&
+               (*list)[1].is_int()) {
+      wanted = Cell{(*list)[0].GetInt(), (*list)[1].GetInt()};
+    }
+    if (wanted && wanted->column < columns && wanted->row < rows &&
+        !taken.contains(*wanted)) {
+      cells[path] = *wanted;
+      taken.insert(*wanted);
+    } else {
+      unplaced.push_back(path);
+    }
+  }
+  for (const base::FilePath& path : unplaced) {
+    const Cell cell = FindFreeCell(taken, Cell());
+    cells[path] = cell;
+    taken.insert(cell);
+    // Saved only if it had no place yet: one saved off a smaller work area
+    // (another display, a docked shelf) keeps it for later.
+    if (!saved.FindList(NameOf(path))) {
+      SaveCell(path, cell);
+    }
+  }
+  cells_ = std::move(cells);
+}
+
+void NickelDesktopView::SaveCell(const base::FilePath& path, const Cell& cell) {
+  ScopedDictPrefUpdate update(prefs_, NickelDesktopController::kPositionsPref);
+  update->Set(NameOf(path),
+              base::ListValue().Append(cell.column).Append(cell.row));
+}
+
+std::vector<NickelDesktopIconView*> NickelDesktopView::GetSelection() const {
+  std::vector<NickelDesktopIconView*> selection;
+  for (const base::FilePath& path : order_) {
+    if (NickelDesktopIconView* icon = FindIcon(path); icon && icon->selected()) {
+      selection.push_back(icon);
+    }
+  }
+  return selection;
+}
+
+void NickelDesktopView::SelectOnly(NickelDesktopIconView* icon) {
+  for (auto& [path, view] : icons_) {
+    view->SetSelected(view == icon);
+  }
+}
+
+void NickelDesktopView::ClearSelection() {
+  SelectOnly(nullptr);
+}
+
+NickelDesktopIconView* NickelDesktopView::FindIcon(
+    const base::FilePath& path) const {
+  auto it = icons_.find(path);
+  return it == icons_.end() ? nullptr : it->second.get();
+}
+
+void NickelDesktopView::OnIconPressed(NickelDesktopIconView* icon,
+                                      const ui::MouseEvent& event) {
+  if (event.IsOnlyLeftMouseButton() &&
+      (event.flags() & ui::EF_IS_DOUBLE_CLICK)) {
+    if (!icon->selected()) {
+      SelectOnly(icon);
+    }
+    OpenSelection();
+    return;
+  }
+  if (event.IsOnlyLeftMouseButton() && event.IsControlDown()) {
+    icon->SetSelected(!icon->selected());
+    return;
+  }
+  if (!icon->selected()) {
+    SelectOnly(icon);
+  }
+}
+
+void NickelDesktopView::OnIconGesture(NickelDesktopIconView* icon,
+                                      ui::GestureEvent* event) {
+  switch (event->type()) {
+    case ui::EventType::kGestureTapDown:
+      RetargetTouch(icon, *event);
+      return;
+    case ui::EventType::kGestureTap:
+      if (event->details().tap_count() == 2) {
+        if (!icon->selected()) {
+          SelectOnly(icon);
+        }
+        OpenSelection();
+      } else if (event->IsControlDown()) {
+        icon->SetSelected(!icon->selected());
+      } else {
+        SelectOnly(icon);
+      }
+      event->SetHandled();
+      return;
+    case ui::EventType::kGestureLongPress:
+    case ui::EventType::kGestureTwoFingerTap: {
+      if (!icon->selected()) {
+        SelectOnly(icon);
+      }
+      gfx::Point location = event->location();
+      views::View::ConvertPointToScreen(icon, &location);
+      ShowContextMenuForViewImpl(icon, location,
+                                 ui::mojom::MenuSourceType::kLongPress);
+      event->SetHandled();
+      return;
+    }
+    // Dragging with a finger or a pen moves the icons about (as on the
+    // shelf: after a long press, moving closes the menu and drags).
+    case ui::EventType::kGestureScrollBegin:
+      if (!cells_.contains(icon->path())) {
+        return;
+      }
+      if (!icon->selected()) {
+        SelectOnly(icon);
+      }
+      // Before closing the menu, which then leaves this touch alone
+      // (OnMenuClosed).
+      touch_moving_ = true;
+      touch_anchor_ = icon->path();
+      touch_offset_ = event->location().OffsetFromOrigin();
+      if (menu_runner_ && menu_runner_->IsRunning()) {
+        menu_runner_->Cancel();
+      }
+      // Over the other icons while it moves.
+      ReorderChildView(icon, children().size());
+      event->SetHandled();
+      return;
+    case ui::EventType::kGestureScrollUpdate: {
+      if (!touch_moving_) {
+        return;
+      }
+      gfx::Point point = event->location();
+      views::View::ConvertPointToTarget(icon, this, &point);
+      const gfx::Vector2d delta =
+          (point - touch_offset_) -
+          GetCellBounds(cells_[touch_anchor_]).origin();
+      for (NickelDesktopIconView* view : GetSelection()) {
+        if (auto it = cells_.find(view->path()); it != cells_.end()) {
+          view->SetBoundsRect(GetCellBounds(it->second) + delta);
+        }
+      }
+      event->SetHandled();
+      return;
+    }
+    case ui::EventType::kGestureScrollEnd:
+    case ui::EventType::kScrollFlingStart: {
+      if (!touch_moving_) {
+        return;
+      }
+      touch_moving_ = false;
+      gfx::Point point = event->location();
+      views::View::ConvertPointToTarget(icon, this, &point);
+      std::vector<base::FilePath> paths;
+      for (NickelDesktopIconView* view : GetSelection()) {
+        paths.push_back(view->path());
+      }
+      MoveIcons(paths, touch_anchor_, point - touch_offset_);
+      event->SetHandled();
+      return;
+    }
+    case ui::EventType::kGestureEnd:
+      // A move that never ended (cancelled): back to their cells.
+      if (touch_moving_) {
+        touch_moving_ = false;
+        InvalidateLayout();
+      }
+      return;
+    default:
+      return;
+  }
+}
+
+void NickelDesktopView::OnGestureEvent(ui::GestureEvent* event) {
+  // On the desktop itself (not an icon).
+  switch (event->type()) {
+    case ui::EventType::kGestureTapDown:
+      // Not one an icon passed on.
+      if (event->target() == this) {
+        RetargetTouch(this, *event);
+      }
+      return;
+    case ui::EventType::kGestureTap:
+      ClearSelection();
+      event->SetHandled();
+      return;
+    case ui::EventType::kGestureLongPress:
+    case ui::EventType::kGestureTwoFingerTap: {
+      gfx::Point location = event->location();
+      views::View::ConvertPointToScreen(this, &location);
+      ShowContextMenuForViewImpl(this, location,
+                                 ui::mojom::MenuSourceType::kLongPress);
+      event->SetHandled();
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+void NickelDesktopView::RetargetTouch(views::View* handler,
+                                      const ui::GestureEvent& event) {
+  gfx::Point point = event.location();
+  views::View::ConvertPointToTarget(handler, this, &point);
+  views::View* target = this;
+  for (const auto& [path, icon] : icons_) {
+    if (icon->bounds().Contains(point)) {
+      target = icon;
+      break;
+    }
+  }
+  if (target != handler) {
+    SetMouseAndGestureHandler(target);
+    // Only the touch: the mouse finds its own way.
+    SetMouseHandler(nullptr);
+  }
+}
+
+void NickelDesktopView::OnMenuClosed() {
+  // A menu opened by a long press takes the rest of that touch, and the
+  // widget never sees it end: forget the view that opened it, unless that
+  // touch now moves icons.
+  if (!touch_moving_) {
+    SetMouseAndGestureHandler(nullptr);
+  }
+}
+
+void NickelDesktopView::OpenSelection() {
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  if (!client) {
+    return;
+  }
+  for (NickelDesktopIconView* icon : GetSelection()) {
+    client->Open(icon->path(), icon->is_directory());
+  }
+}
+
+void NickelDesktopView::WriteDragDataForIcon(NickelDesktopIconView* icon,
+                                             const gfx::Point& press_point,
+                                             ui::OSExchangeData* data) {
+  if (!icon->selected()) {
+    SelectOnly(icon);
+  }
+  // Files and Linux apps take file names (as from Holding space).
+  std::vector<ui::FileInfo> files;
+  for (NickelDesktopIconView* view : GetSelection()) {
+    files.emplace_back(view->path(), view->path().BaseName());
+  }
+  data->SetFilenames(files);
+  // The item itself follows the pointer, held where it was picked up.
+  data->provider().SetDragImage(icon->CreateDragImage(),
+                                press_point.OffsetFromOrigin());
+  drag_anchor_ = icon->path();
+  drag_offset_ = press_point.OffsetFromOrigin();
+}
+
+void NickelDesktopView::Rename(const base::FilePath& path,
+                               const std::u16string& name,
+                               base::OnceCallback<void(RenameResult)> callback) {
+  const std::string new_name =
+      base::UTF16ToUTF8(base::TrimWhitespace(name, base::TRIM_ALL));
+  if (new_name.empty() || new_name == "." || new_name == ".." ||
+      new_name.starts_with(".") || new_name.find('/') != std::string::npos) {
+    std::move(callback).Run(RenameResult::kInvalidName);
+    return;
+  }
+  const base::FilePath target =
+      path.DirName().Append(base::FilePath::FromUTF8Unsafe(new_name));
+  if (target == path) {
+    std::move(callback).Run(RenameResult::kDone);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](base::FilePath path, base::FilePath target) {
+            if (base::PathExists(target)) {
+              return RenameResult::kNameTaken;
+            }
+            return base::Move(path, target) ? RenameResult::kDone
+                                            : RenameResult::kFailed;
+          },
+          path, target),
+      base::BindOnce(
+          [](base::WeakPtr<NickelDesktopView> desktop, base::FilePath path,
+             base::FilePath target,
+             base::OnceCallback<void(RenameResult)> callback,
+             RenameResult result) {
+            if (desktop && result == RenameResult::kDone) {
+              // It keeps its place under its new name.
+              if (auto it = desktop->cells_.find(path);
+                  it != desktop->cells_.end()) {
+                desktop->pending_cells_[NameOf(target)] = it->second;
+              }
+              desktop->renamed_from_.insert(path);
+              ScopedDictPrefUpdate update(
+                  desktop->prefs_, NickelDesktopController::kPositionsPref);
+              update->Remove(NameOf(path));
+            }
+            std::move(callback).Run(result);
+          },
+          weak_factory_.GetWeakPtr(), path, target, std::move(callback)));
+}
+
+void NickelDesktopView::NewFolder(const Cell& cell) {
+  new_folder_cell_ = cell;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](base::FilePath folder, std::string name) {
+            for (int i = 1; i < 1000; ++i) {
+              const base::FilePath path =
+                  folder.Append(base::FilePath::FromUTF8Unsafe(
+                      i == 1 ? name
+                             : base::StrCat({name, " ", base::NumberToString(i)})));
+              if (base::PathExists(path)) {
+                continue;
+              }
+              return base::CreateDirectory(path) ? path : base::FilePath();
+            }
+            return base::FilePath();
+          },
+          folder_,
+          l10n_util::GetStringUTF8(IDS_ASH_NICKEL_DESKTOP_NEW_FOLDER_NAME)),
+      base::BindOnce(&NickelDesktopView::OnFolderCreated,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void NickelDesktopView::OnFolderCreated(base::FilePath path) {
+  if (path.empty()) {
+    return;
+  }
+  // Where the menu was opened, then renamed: once its icon is there.
+  pending_cells_[NameOf(path)] = new_folder_cell_;
+  pending_rename_ = path;
+  if (FindIcon(path)) {
+    // The folder's watcher was faster.
+    std::set<Cell> taken;
+    for (const auto& [other, cell] : cells_) {
+      if (other != path) {
+        taken.insert(cell);
+      }
+    }
+    cells_[path] = FindFreeCell(taken, new_folder_cell_);
+    SaveCell(path, cells_[path]);
+    pending_cells_.erase(NameOf(path));
+    pending_rename_.clear();
+    InvalidateLayout();
+    ShowRenameBubble(FindIcon(path));
+  }
+}
+
+void NickelDesktopView::ShowRenameBubble(NickelDesktopIconView* icon) {
+  // Asks at the icon; a bubble rather than the label itself, as the
+  // desktop's widget cannot take the keyboard.
+  CloseRenameBubble();
+  SelectOnly(icon);
+  rename_path_ = icon->path();
+
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      icon, views::BubbleBorder::TOP_CENTER);
+  delegate->SetTitle(IDS_ASH_NICKEL_DESKTOP_RENAME_TITLE);
+  delegate->SetButtonLabel(
+      ui::mojom::DialogButton::kOk,
+      l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_RENAME));
+  delegate->SetAcceptCallbackWithClose(base::BindRepeating(
+      &NickelDesktopView::OnRenameAccepted, base::Unretained(this)));
+  delegate->set_close_on_deactivate(true);
+  // A container whose windows can take the keyboard.
+  delegate->set_parent_window(
+      Shell::GetContainer(GetWidget()->GetNativeWindow()->GetRootWindow(),
+                          kShellWindowId_SettingBubbleContainer));
+
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  const std::u16string name = rename_path_.BaseName().LossyDisplayName();
+  rename_textfield_ =
+      contents->AddChildView(std::make_unique<views::Textfield>());
+  rename_textfield_->SetText(name);
+  rename_textfield_->SetDefaultWidthInChars(24);
+  rename_textfield_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_RENAME_TITLE));
+  rename_error_ = contents->AddChildView(std::make_unique<views::Label>());
+  rename_error_->SetMultiLine(true);
+  rename_error_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  rename_error_->SetVisible(false);
+  delegate->SetContentsView(std::move(contents));
+  delegate->SetInitiallyFocusedView(rename_textfield_);
+
+  rename_delegate_ = std::move(delegate);
+  rename_widget_ = views::BubbleDialogDelegate::CreateBubble(
+      rename_delegate_.get(),
+      base::BindOnce(&NickelDesktopView::OnRenameBubbleClosed,
+                     weak_factory_.GetWeakPtr()));
+  rename_widget_->Show();
+  // The name without its extension, ready to type over.
+  const size_t dot = name.rfind(u'.');
+  rename_textfield_->SetSelectedRange(gfx::Range(
+      0, dot == std::u16string::npos || dot == 0 ? name.size() : dot));
+}
+
+bool NickelDesktopView::OnRenameAccepted() {
+  Rename(rename_path_, std::u16string(rename_textfield_->GetText()),
+         base::BindOnce(&NickelDesktopView::OnRenamed,
+                        weak_factory_.GetWeakPtr()));
+  // Closed once renamed.
+  return false;
+}
+
+void NickelDesktopView::OnRenamed(RenameResult result) {
+  if (!rename_widget_) {
+    return;
+  }
+  int message = IDS_ASH_NICKEL_DESKTOP_RENAME_FAILED;
+  switch (result) {
+    case RenameResult::kDone:
+      rename_widget_->Close();
+      return;
+    case RenameResult::kNameTaken:
+      message = IDS_ASH_NICKEL_DESKTOP_NAME_TAKEN;
+      break;
+    case RenameResult::kInvalidName:
+      message = IDS_ASH_NICKEL_DESKTOP_NAME_INVALID;
+      break;
+    case RenameResult::kFailed:
+      break;
+  }
+  rename_error_->SetText(l10n_util::GetStringUTF16(message));
+  rename_error_->SetVisible(true);
+  rename_delegate_->SizeToContents();
+}
+
+void NickelDesktopView::OnRenameBubbleClosed(
+    views::Widget::ClosedReason reason) {
+  // Not from within the widget's own closing.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&NickelDesktopView::CloseRenameBubble,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void NickelDesktopView::CloseRenameBubble() {
+  rename_textfield_ = nullptr;
+  rename_error_ = nullptr;
+  // The widget before its delegate.
+  rename_widget_.reset();
+  rename_delegate_.reset();
+}
+
+void NickelDesktopView::Layout(PassKey) {
+  for (const auto& [path, cell] : cells_) {
+    if (NickelDesktopIconView* icon = FindIcon(path)) {
+      icon->SetBoundsRect(GetCellBounds(cell));
+    }
+  }
+}
+
+bool NickelDesktopView::OnMousePressed(const ui::MouseEvent& event) {
+  // On the desktop itself (not an icon).
+  ClearSelection();
+  return true;
+}
+
+std::vector<base::FilePath> NickelDesktopView::GetDroppedPaths(
+    const ui::OSExchangeData& data) const {
+  std::vector<base::FilePath> paths;
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  // Files puts file system URLs there (directories only appear there).
+  if (std::optional<base::Pickle> pickle = data.GetPickledData(
+          ui::ClipboardFormatType::DataTransferCustomType());
+      pickle && client) {
+    if (std::optional<std::u16string> sources =
+            ui::ReadCustomDataForType(*pickle, u"fs/sources")) {
+      for (std::u16string_view source : base::SplitStringPiece(
+               *sources, u"\n", base::TRIM_WHITESPACE,
+               base::SPLIT_WANT_NONEMPTY)) {
+        if (base::FilePath path = client->CrackFileSystemUrl(GURL(source));
+            !path.empty()) {
+          paths.push_back(std::move(path));
+        }
+      }
+    }
+  }
+  if (paths.empty()) {
+    if (std::optional<std::vector<ui::FileInfo>> files = data.GetFilenames()) {
+      for (const ui::FileInfo& file : *files) {
+        paths.push_back(file.path);
+      }
+    }
+  }
+  return paths;
+}
+
+bool NickelDesktopView::GetDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  *formats = ui::OSExchangeData::FILE_NAME;
+  format_types->insert(ui::ClipboardFormatType::DataTransferCustomType());
+  return true;
+}
+
+bool NickelDesktopView::CanDrop(const ui::OSExchangeData& data) {
+  return !GetDroppedPaths(data).empty();
+}
+
+void NickelDesktopView::OnDragEntered(const ui::DropTargetEvent& event) {
+  drag_paths_ = GetDroppedPaths(event.data());
+  drag_from_desktop_ =
+      !drag_paths_.empty() &&
+      std::ranges::all_of(drag_paths_, [this](const base::FilePath& path) {
+        return path.DirName() == folder_;
+      });
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  int operation = ui::DragDropTypes::DRAG_COPY;
+  if (drag_from_desktop_) {
+    // Only moving icons about.
+    operation = ui::DragDropTypes::DRAG_MOVE;
+  } else if (client && !(event.flags() & ui::EF_CONTROL_DOWN) &&
+             std::ranges::all_of(drag_paths_,
+                                 [client](const base::FilePath& path) {
+                                   return client->IsInMyFiles(path);
+                                 })) {
+    // As Files does between its own folders.
+    operation = ui::DragDropTypes::DRAG_MOVE;
+  }
+  const int allowed = event.source_operations();
+  if (!(allowed & operation)) {
+    operation = (allowed & ui::DragDropTypes::DRAG_COPY)
+                    ? ui::DragDropTypes::DRAG_COPY
+                    : allowed & ui::DragDropTypes::DRAG_MOVE;
+  }
+  drag_operation_ = operation;
+}
+
+int NickelDesktopView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  return drag_paths_.empty() ? ui::DragDropTypes::DRAG_NONE : drag_operation_;
+}
+
+void NickelDesktopView::OnDragExited() {
+  drag_paths_.clear();
+}
+
+views::View::DropCallback NickelDesktopView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  if (drag_paths_.empty() || drag_operation_ == ui::DragDropTypes::DRAG_NONE) {
+    return base::NullCallback();
+  }
+  return base::BindOnce(&NickelDesktopView::PerformDrop,
+                        weak_factory_.GetWeakPtr(), std::move(drag_paths_),
+                        drag_from_desktop_, drag_operation_, event.location());
+}
+
+void NickelDesktopView::PerformDrop(
+    std::vector<base::FilePath> paths,
+    bool from_desktop,
+    int operation,
+    gfx::Point location,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::PreferredDragOperation(operation);
+  drag_paths_.clear();
+
+  if (from_desktop) {
+    // Moved about: the icon dragged goes to the cell under it.
+    MoveIcons(paths,
+              cells_.contains(drag_anchor_) ? drag_anchor_ : paths.front(),
+              location - drag_offset_);
+    return;
+  }
+
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  if (!client) {
+    output_drag_op = ui::mojom::DragOperation::kNone;
+    return;
+  }
+  // They land where they were dropped, side by side.
+  std::set<Cell> taken;
+  for (const auto& [path, cell] : cells_) {
+    taken.insert(cell);
+  }
+  Cell next = GetCellAt(location);
+  for (const base::FilePath& path : paths) {
+    const Cell cell = FindFreeCell(taken, next);
+    pending_cells_[NameOf(path)] = cell;
+    taken.insert(cell);
+    next = cell;
+  }
+  client->CopyOrMoveToDesktop(paths,
+                              operation == ui::DragDropTypes::DRAG_MOVE);
+}
+
+void NickelDesktopView::MoveIcons(const std::vector<base::FilePath>& paths,
+                                  const base::FilePath& anchor,
+                                  const gfx::Point& anchor_origin) {
+  if (!cells_.contains(anchor)) {
+    InvalidateLayout();
+    return;
+  }
+  gfx::Point anchor_center = anchor_origin;
+  anchor_center.Offset(kCellWidth / 2, kCellHeight / 2);
+  const Cell from = cells_[anchor];
+  const Cell to = GetCellAt(anchor_center);
+  const std::set<base::FilePath> moving(paths.begin(), paths.end());
+  std::set<Cell> taken;
+  for (const auto& [path, cell] : cells_) {
+    if (!moving.contains(path)) {
+      taken.insert(cell);
+    }
+  }
+  for (const base::FilePath& path : paths) {
+    auto it = cells_.find(path);
+    if (it == cells_.end()) {
+      continue;
+    }
+    const Cell wanted{
+        std::clamp(it->second.column + to.column - from.column, 0,
+                   GetColumns() - 1),
+        std::clamp(it->second.row + to.row - from.row, 0, GetRows() - 1)};
+    it->second = FindFreeCell(taken, wanted);
+    taken.insert(it->second);
+    SaveCell(path, it->second);
+  }
+  InvalidateLayout();
+}
+
+void NickelDesktopView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  shelf_menu_model_.reset();
+  if (source != this) {
+    // An icon (selected when pressed).
+    const size_t count = GetSelection().size();
+    if (!count) {
+      return;
+    }
+    menu_model_->AddItem(kOpen,
+                         l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_OPEN));
+    if (count == 1) {
+      menu_model_->AddItem(
+          kShowInFiles,
+          l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_SHOW_IN_FILES));
+      menu_model_->AddItem(
+          kRename, l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_RENAME));
+    }
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItem(
+        kMoveToTrash,
+        l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_MOVE_TO_TRASH));
+  } else {
+    ClearSelection();
+    gfx::Point local = point;
+    views::View::ConvertPointFromScreen(this, &local);
+    menu_cell_ = GetCellAt(local);
+    menu_model_->AddItem(
+        kNewFolder,
+        l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_NEW_FOLDER));
+    menu_model_->AddItem(
+        kOpenDesktopInFiles,
+        l10n_util::GetStringUTF16(IDS_ASH_NICKEL_DESKTOP_OPEN_IN_FILES));
+    // Then what the wallpaper's menu has (wallpaper, shelf position and
+    // autohide).
+    shelf_menu_model_ = std::make_unique<ShelfContextMenuModel>(
+        nullptr,
+        display::Screen::Get()
+            ->GetDisplayNearestWindow(GetWidget()->GetNativeWindow())
+            .id(),
+        /*menu_in_shelf=*/false);
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    for (size_t i = 0; i < shelf_menu_model_->GetItemCount(); ++i) {
+      const int id = shelf_menu_model_->GetCommandIdAt(i);
+      const std::u16string label = shelf_menu_model_->GetLabelAt(i);
+      const ui::ImageModel icon = shelf_menu_model_->GetIconAt(i);
+      switch (shelf_menu_model_->GetTypeAt(i)) {
+        case ui::MenuModel::TYPE_COMMAND:
+          menu_model_->AddItemWithIcon(id, label, icon);
+          break;
+        case ui::MenuModel::TYPE_CHECK:
+          menu_model_->AddCheckItem(id, label);
+          break;
+        case ui::MenuModel::TYPE_SUBMENU:
+          menu_model_->AddSubMenuWithIcon(
+              id, label, shelf_menu_model_->GetSubmenuModelAt(i), icon);
+          break;
+        case ui::MenuModel::TYPE_SEPARATOR:
+          menu_model_->AddSeparator(shelf_menu_model_->GetSeparatorTypeAt(i));
+          break;
+        default:
+          break;
+      }
+    }
+  }
+  int run_types =
+      views::MenuRunner::CONTEXT_MENU | views::MenuRunner::USE_ASH_SYS_UI_LAYOUT;
+  if (source_type == ui::mojom::MenuSourceType::kLongPress ||
+      source_type == ui::mojom::MenuSourceType::kTouch) {
+    // A finger that moves on after the long press drags the icons
+    // (OnIconGesture closes the menu then).
+    run_types |= views::MenuRunner::SEND_GESTURE_EVENTS_TO_OWNER;
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), run_types,
+      base::BindRepeating(&NickelDesktopView::OnMenuClosed,
+                          weak_factory_.GetWeakPtr()));
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kBubbleRight,
+                          source_type);
+}
+
+bool NickelDesktopView::IsCommandIdChecked(int command_id) const {
+  return shelf_menu_model_ && shelf_menu_model_->IsCommandIdChecked(command_id);
+}
+
+void NickelDesktopView::ExecuteCommand(int command_id, int event_flags) {
+  NickelDesktopClient* client = NickelDesktopClient::Get();
+  const std::vector<NickelDesktopIconView*> selection = GetSelection();
+  switch (command_id) {
+    case kOpen:
+      OpenSelection();
+      return;
+    case kShowInFiles:
+      if (client && selection.size() == 1) {
+        client->ShowInFiles(selection.front()->path());
+      }
+      return;
+    case kRename:
+      if (selection.size() == 1) {
+        ShowRenameBubble(selection.front());
+      }
+      return;
+    case kMoveToTrash:
+      if (client && !selection.empty()) {
+        std::vector<base::FilePath> paths;
+        for (NickelDesktopIconView* icon : selection) {
+          paths.push_back(icon->path());
+        }
+        client->MoveToTrash(paths);
+      }
+      return;
+    case kNewFolder:
+      NewFolder(menu_cell_);
+      return;
+    case kOpenDesktopInFiles:
+      if (client) {
+        client->Open(folder_, /*is_folder=*/true);
+      }
+      return;
+  }
+  if (shelf_menu_model_) {
+    shelf_menu_model_->ExecuteCommand(command_id, event_flags);
+  }
+}
+
+BEGIN_METADATA(NickelDesktopView)
+END_METADATA
+
+}  // namespace ash

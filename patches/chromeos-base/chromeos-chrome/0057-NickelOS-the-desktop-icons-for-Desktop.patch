+    set_context_menu_controller(desktop);
+    SetNotifyEnterExitOnChild(true);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+    GetViewAccessibility().SetName(name);
+  }
+
+  const base::FilePath& path() const { return path_; }
+  bool is_directory() const { return is_directory_; }
+  bool selected() const { return selected_; }
+
+  // The icon as it looks (tile, glyph, name, selection), for dragging it.
+  gfx::ImageSkia CreateDragImage() {
+    const views::Widget* widget = GetWidget();
+    const float scale = views::ScaleFactorForDragFromWidget(widget);
+    SkBitmap bitmap;
+    {
+      ui::CanvasPainter painter(&bitmap, size(), scale,
+                                /*clear_color=*/SK_ColorTRANSPARENT,
+                                widget->GetCompositor()->is_pixel_canvas());
+      // Painted as a root view, at the origin: its own tile, then its
+      // children (as View::Paint does).
+      const views::PaintInfo info =
+          views::PaintInfo::CreateRootPaintInfo(painter.context(), size());
+      {
+        ui::PaintRecorder recorder(info.context(), info.paint_recording_size(),
+                                   info.paint_recording_scale_x(),
+                                   info.paint_recording_scale_y(), nullptr);
+        OnPaint(recorder.canvas());
+      }
+      PaintChildren(info);
+    }
+    return gfx::ImageSkia::CreateFromBitmap(bitmap, scale);
+  }
+
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    GetViewAccessibility().SetIsSelected(selected);
+    SchedulePaint();
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    const gfx::Rect tile = GetTileBounds();
+    image_view_->SetBoundsRect(tile);
+    // Centred under the tile, as big as the name, so its pill fits it: one
+    // line as wide as the name, or two lines as wide as the cell for a name
+    // that doesn't fit on one. (Label's own height for a width doesn't
+    // break where drawing does, after a hyphen: "clip-h264.mp4" got one
+    // line, showing "clip-".)
+    const int max_width = width() - 8;
+    const int max_height = height() - tile.bottom() - 3;
+    const int one_line = label_->GetPreferredSize(views::SizeBounds()).width();
+    const bool wraps = one_line > max_width;
+    const int name_width = wraps ? max_width : one_line;
+    const int name_height =
+        std::min(label_->GetLineHeight() * (wraps ? 2 : 1) +
+                     kLabelPadding.height(),
+                 max_height);
+    label_->SetBounds((width() - name_width) / 2, tile.bottom() + 3,
+                      name_width, name_height);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if (selected_ || hovered_) {
+      flags.setColor(SkColorSetA(SK_ColorWHITE, selected_ ? 0x47 : 0x24));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kHighlightRadius,
+                            flags);
+    }
+    // The tile is the system's raised surface (as menus and bubbles are),
+    // light or dark with the theme, as the file type icons are.
+    flags.setColor(SkColorSetA(
+        GetColorProvider()->GetColor(cros_tokens::kCrosSysSystemBaseElevated),
+        0xE6));
+    canvas->DrawRoundRect(gfx::RectF(GetTileBounds()), kTileRadius, flags);
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    // The file type icons' colours follow the theme.
+    UpdateImage();
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    desktop_->OnIconPressed(this, event);
+    return true;
+  }
+
+  // Touch (and a pen, which ChromeOS turns into gestures).
+  void OnGestureEvent(ui::GestureEvent* event) override {
+    desktop_->OnIconGesture(this, event);
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    hovered_ = true;
+    SchedulePaint();
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    hovered_ = false;
+    SchedulePaint();
+  }
+
+  int GetDragOperations(const gfx::Point& press_pt) override {
+    return ui::DragDropTypes::DRAG_MOVE | ui::DragDropTypes::DRAG_COPY;
+  }
+
+  void WriteDragData(const gfx::Point& press_pt,
+                     ui::OSExchangeData* data) override {
+    desktop_->WriteDragDataForIcon(this, press_pt, data);
+  }
+
+ private:
+  void UpdateImage() {
+    image_ = is_directory_
+                 ? chromeos::GetIconFromType(chromeos::IconType::kFolder,
+                                             /*dark_background=*/false,
+                                             kGlyphSize)
+                 : chromeos::GetIconForPath(path_, /*dark_background=*/false,
+                                            kGlyphSize);
+    image_view_->SetImage(ui::ImageModel::FromImageSkia(image_));
+  }
+
+  gfx::Rect GetTileBounds() const {
+    return gfx::Rect((width() - kTileSize) / 2, kTileTop, kTileSize,
+                     kTileSize);
+  }
+
+  const raw_ptr<NickelDesktopView> desktop_;
+  const base::FilePath path_;
+  const bool is_directory_;
+  gfx::ImageSkia image_;
+  raw_ptr<views::ImageView> image_view_;
+  raw_ptr<views::Label> label_;
+  bool selected_ = false;
+  bool hovered_ = false;
+};

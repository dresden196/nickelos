+
+// NickelOS: the desktop's contents, one icon per item of the desktop folder
+// on a grid in the display's work area (docs/desktop.md in overlay-nickel).
+class ASH_EXPORT NickelDesktopView : public views::View,
+                                     public views::ContextMenuController,
+                                     public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(NickelDesktopView, views::View)
+
+ public:
+  // An item of the desktop folder.
+  struct Entry {
+    base::FilePath path;
+    bool is_directory = false;
+  };
+
+  // A grid cell.
+  struct Cell {
+    int column = 0;
+    int row = 0;
+    bool operator<(const Cell& other) const {
+      return column != other.column ? column < other.column : row < other.row;
+    }
+    bool operator==(const Cell& other) const = default;
+  };
+
+  // How renaming went.
+  enum class RenameResult { kDone, kNameTaken, kInvalidName, kFailed };
+
+  NickelDesktopView(base::FilePath folder, PrefService* prefs);
+  NickelDesktopView(const NickelDesktopView&) = delete;
+  NickelDesktopView& operator=(const NickelDesktopView&) = delete;
+  ~NickelDesktopView() override;
+
+  base::WeakPtr<NickelDesktopView> GetWeakPtr();
+
+  // The display's work area changed (shelf, resolution).
+  void OnWorkAreaChanged();
+
+  // From the icons.
+  void OnIconPressed(NickelDesktopIconView* icon, const ui::MouseEvent& event);
+  void OnIconGesture(NickelDesktopIconView* icon, ui::GestureEvent* event);
+  void WriteDragDataForIcon(NickelDesktopIconView* icon,
+                            const gfx::Point& press_point,
+                            ui::OSExchangeData* data);
+
+  // Renames `path` to `name` (in the same folder), then runs `callback`.
+  void Rename(const base::FilePath& path,
+              const std::u16string& name,
+              base::OnceCallback<void(RenameResult)> callback);
+
+  // views::View:
+  void Layout(PassKey) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnGestureEvent(ui::GestureEvent* event) override;
+  bool GetDropFormats(int* formats,
+                      std::set<ui::ClipboardFormatType>* format_types) override;
+  bool CanDrop(const ui::OSExchangeData& data) override;
+  void OnDragEntered(const ui::DropTargetEvent& event) override;
+  int OnDragUpdated(const ui::DropTargetEvent& event) override;
+  void OnDragExited() override;
+  DropCallback GetDropCallback(const ui::DropTargetEvent& event) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  class Lister;
+
+  // The folder's items, sorted by name, as the lister reads them.
+  void OnEntries(std::vector<Entry> entries);
+
+  // The work area, in this view's coordinates, and the grid in it.
+  gfx::Rect GetGridBounds() const;
+  int GetColumns() const;
+  int GetRows() const;
+  gfx::Rect GetCellBounds(const Cell& cell) const;
+  Cell GetCellAt(const gfx::Point& point) const;
+  // The first free cell, top to bottom then left to right, starting at
+  // `start`.
+  Cell FindFreeCell(const std::set<Cell>& taken, const Cell& start) const;
+
+  // Gives every icon a cell: the saved one, or a free one, saved.
+  void AssignCells();
+  void SaveCell(const base::FilePath& path, const Cell& cell);
+
+  // A new touch went to `handler`, which an earlier touch left as the
+  // widget's gesture handler (one whose end the widget never saw, as when a
+  // menu took it): the rest of it goes to the view under it instead.
+  void RetargetTouch(views::View* handler, const ui::GestureEvent& event);
+  void OnMenuClosed();
+
+  std::vector<NickelDesktopIconView*> GetSelection() const;
+  void SelectOnly(NickelDesktopIconView* icon);
+  void ClearSelection();
+  NickelDesktopIconView* FindIcon(const base::FilePath& path) const;
+
+  void OpenSelection();
+  void NewFolder(const Cell& cell);
+  void OnFolderCreated(base::FilePath path);
+  void ShowRenameBubble(NickelDesktopIconView* icon);
+  bool OnRenameAccepted();
+  void OnRenamed(RenameResult result);
+  void OnRenameBubbleClosed(views::Widget::ClosedReason reason);
+  void CloseRenameBubble();
+
+  // Moves `paths` (icons of the desktop) about: `anchor`'s icon goes to the
+  // cell under the icon put at `anchor_origin`, the others keep their
+  // distance to it.
+  void MoveIcons(const std::vector<base::FilePath>& paths,
+                 const base::FilePath& anchor,
+                 const gfx::Point& anchor_origin);
+
+  // Drops.
+  std::vector<base::FilePath> GetDroppedPaths(
+      const ui::OSExchangeData& data) const;
+  void PerformDrop(std::vector<base::FilePath> paths,
+                   bool from_desktop,
+                   int operation,
+                   gfx::Point location,
+                   const ui::DropTargetEvent& event,
+                   ui::mojom::DragOperation& output_drag_op,
+                   std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner);
+
+  const base::FilePath folder_;
+  const raw_ptr<PrefService> prefs_;
+  base::SequenceBound<Lister> lister_;
+
+  // The icons, children of this view, by path; the folder's items in name
+  // order; their cells.
+  std::map<base::FilePath, raw_ptr<NickelDesktopIconView>> icons_;
+  std::vector<base::FilePath> order_;
+  std::map<base::FilePath, Cell> cells_;
+
+  // Cells for items about to appear, by name (a new folder, a rename, a
+  // drop). A folder just made, to rename once its icon is there, and where.
+  std::map<std::string, Cell> pending_cells_;
+  base::FilePath pending_rename_;
+  Cell new_folder_cell_;
+  // Items renamed here, whose disappearance is not a deletion.
+  std::set<base::FilePath> renamed_from_;
+
+  // The drag in progress over the desktop.
+  std::vector<base::FilePath> drag_paths_;
+  bool drag_from_desktop_ = false;
+  // ui::DragDropTypes::DragOperation.
+  int drag_operation_ = 0;
+  // Where in the icon being dragged from the desktop the press was.
+  gfx::Vector2d drag_offset_;
+  base::FilePath drag_anchor_;
+
+  // An icon (and the rest of the selection) moved with a finger or a pen:
+  // the icon under it, and where on that icon it is.
+  bool touch_moving_ = false;
+  base::FilePath touch_anchor_;
+  gfx::Vector2d touch_offset_;
+
+  // The context menu.
+  std::unique_ptr<ShelfContextMenuModel> shelf_menu_model_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  // Where the desktop menu was opened, for New folder.
+  Cell menu_cell_;
+
+  // The rename bubble (the delegate outlives its widget), and the item.
+  std::unique_ptr<views::BubbleDialogDelegate> rename_delegate_;
+  std::unique_ptr<views::Widget> rename_widget_;
+  raw_ptr<views::Textfield> rename_textfield_ = nullptr;
+  raw_ptr<views::Label> rename_error_ = nullptr;
+  base::FilePath rename_path_;
+
+  base::WeakPtrFactory<NickelDesktopView> weak_factory_{this};
+};
+

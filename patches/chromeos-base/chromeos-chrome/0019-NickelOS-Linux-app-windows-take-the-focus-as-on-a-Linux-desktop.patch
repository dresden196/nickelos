+
+#ifndef COMPONENTS_EXO_WAYLAND_XDG_ACTIVATION_H_
+#define COMPONENTS_EXO_WAYLAND_XDG_ACTIVATION_H_
+
+#include <stdint.h>
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// xdg-activation-v1 (NickelOS): how a Linux app hands the focus on. The app
+// the user is using gets tokens it can pass along (to a window of its own or
+// of an app it starts); a window is brought forward with a token, or, as an
+// activation request of the app's own, when the security delegate allows it
+// (e.g. right after the user started the app again from the launcher).
+void bind_xdg_activation(wl_client* client,
+                         void* data,
+                         uint32_t version,
+                         uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_XDG_ACTIVATION_H_

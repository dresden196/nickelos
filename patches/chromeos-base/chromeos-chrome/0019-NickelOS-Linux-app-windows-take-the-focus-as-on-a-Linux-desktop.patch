 }
 
diff --git a/chrome/browser/ash/exo/chrome_security_delegate.cc b/chrome/browser/ash/exo/chrome_security_delegate.cc
index 729f3c4dc68ff..863e53f4307d2 100644
--- a/chrome/browser/ash/exo/chrome_security_delegate.cc
+++ b/chrome/browser/ash/exo/chrome_security_delegate.cc
@@ -8,6 +8,7 @@
 #include <string>
 
 #include "ash/public/cpp/app_types_util.h"
+#include "ash/wm/window_util.h"
 #include "base/command_line.h"
 #include "base/feature_list.h"
 #include "base/memory/ref_counted_memory.h"
@@ -38,6 +39,7 @@
 #include "ui/base/clipboard/file_info.h"
 #include "ui/base/data_transfer_policy/data_transfer_endpoint.h"
 #include "ui/gl/gl_switches.h"
+#include "ui/wm/core/window_util.h"
 
 namespace ash {
 
@@ -301,7 +303,32 @@ bool ChromeSecurityDelegate::CanSelfActivate(aura::Window* window) const {
   //
   // Unfortunately, several clients don't have their own SecurityDelegate yet,
   // so we will continue to use the old exo::Permissions stuff until they do.
-  return exo::HasPermissionToActivate(window);
+  if (exo::HasPermissionToActivate(window)) {
+    return true;
+  }
+
+  // NickelOS: this server's clients are the user's Linux apps on the device
+  // (VMs have their own delegates). They take the focus as on a Linux
+  // desktop: a window takes it when it first shows (ChromeOS showed them all
+  // inactive, so the dialogs apps open and the password prompt got no
+  // keyboard), and later an app may move it between its own windows (a
+  // dialog for the window in use, another window of the same app), never
+  // take it from another app's window.
+  if (!window->IsVisible()) {
+    return true;
+  }
+  aura::Window* active = ash::window_util::GetActiveWindow();
+  if (!active) {
+    return false;
+  }
+  if (wm::HasTransientAncestor(window, active) ||
+      wm::HasTransientAncestor(active, window)) {
+    return true;
+  }
+  const std::string* app_id = exo::GetShellApplicationId(window);
+  const std::string* active_app_id = exo::GetShellApplicationId(active);
+  return app_id && active_app_id && !app_id->empty() &&
+         *app_id == *active_app_id;
 }
 
 bool ChromeSecurityDelegate::CanLockPointer(aura::Window* window) const {

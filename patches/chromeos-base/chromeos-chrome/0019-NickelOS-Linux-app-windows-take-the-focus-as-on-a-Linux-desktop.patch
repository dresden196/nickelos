diff --git a/components/exo/wayland/xdg_activation.cc b/components/exo/wayland/xdg_activation.cc
new file mode 100644
index 0000000000000..ba8cd95c23c49
--- /dev/null
+++ b/components/exo/wayland/xdg_activation.cc
@@ -0,0 +1,191 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/xdg_activation.h"
+
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+#include <xdg-activation-v1-server-protocol.h>
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "components/exo/shell_surface_base.h"
+#include "components/exo/shell_surface_util.h"
+#include "components/exo/surface.h"
+#include "components/exo/surface_observer.h"
+#include "components/exo/wayland/server_util.h"
+#include "components/exo/wm_helper.h"
+#include "ui/aura/window.h"
+
+namespace exo::wayland {
+namespace {
+
+// A token brings a window forward once, within this time of being made.
+constexpr base::TimeDelta kTokenLifetime = base::Seconds(10);
+
+// The tokens that can still activate a window, with when they stop.
+std::map<std::string, base::TimeTicks>& GoodTokens() {
+  static base::NoDestructor<std::map<std::string, base::TimeTicks>> tokens;
+  return *tokens;
+}
+
+// A token request (xdg_activation_token_v1) until it is committed.
+class TokenRequest : public SurfaceObserver {
+ public:
+  TokenRequest() = default;
+  TokenRequest(const TokenRequest&) = delete;
+  TokenRequest& operator=(const TokenRequest&) = delete;
+  ~TokenRequest() override { SetSurface(nullptr); }
+
+  void SetSurface(Surface* surface) {
+    if (surface_) {
+      surface_->RemoveSurfaceObserver(this);
+    }
+    surface_ = surface;
+    if (surface_) {
+      surface_->AddSurfaceObserver(this);
+    }
+  }
+
+  // Makes the token. It is good only if asked for from the window that has
+  // the focus: the app the user is using hands the focus on.
+  std::string Commit() {
+    committed_ = true;
+    const std::string token =
+        base::HexEncode(base::RandBytesAsVector(16));
+    aura::Window* active = WMHelper::GetInstance()->GetActiveWindow();
+    if (surface_ && surface_->window() && active &&
+        active->Contains(surface_->window())) {
+      auto& tokens = GoodTokens();
+      const base::TimeTicks now = base::TimeTicks::Now();
+      std::erase_if(tokens, [now](const auto& t) { return t.second <= now; });
+      tokens[token] = now + kTokenLifetime;
+    }
+    return token;
+  }
+
+  bool committed() const { return committed_; }
+
+  // SurfaceObserver:
+  void OnSurfaceDestroying(Surface* surface) override { SetSurface(nullptr); }
+
+ private:
+  raw_ptr<Surface> surface_ = nullptr;
+  bool committed_ = false;
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// xdg_activation_token_v1_interface:
+
+void token_set_serial(wl_client* client,
+                      wl_resource* resource,
+                      uint32_t serial,
+                      wl_resource* seat) {
+  // The focus check in Commit() stands in for the serial.
+}
+
+void token_set_app_id(wl_client* client,
+                      wl_resource* resource,
+                      const char* app_id) {}
+
+void token_set_surface(wl_client* client,
+                       wl_resource* resource,
+                       wl_resource* surface_resource) {
+  GetUserDataAs<TokenRequest>(resource)->SetSurface(
+      GetUserDataAs<Surface>(surface_resource));
+}
+
+void token_commit(wl_client* client, wl_resource* resource) {
+  TokenRequest* request = GetUserDataAs<TokenRequest>(resource);
+  if (request->committed()) {
+    wl_resource_post_error(resource, XDG_ACTIVATION_TOKEN_V1_ERROR_ALREADY_USED,
+                           "the activation token was already committed");
+    return;
+  }
+  xdg_activation_token_v1_send_done(resource, request->Commit().c_str());
+}
+
+void token_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct xdg_activation_token_v1_interface token_implementation = {
+    .set_serial = token_set_serial,
+    .set_app_id = token_set_app_id,
+    .set_surface = token_set_surface,
+    .commit = token_commit,
+    .destroy = token_destroy,
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// xdg_activation_v1_interface:
+
+void activation_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void activation_get_activation_token(wl_client* client,
+                                     wl_resource* resource,
+                                     uint32_t id) {
+  wl_resource* token_resource = wl_resource_create(
+      client, &xdg_activation_token_v1_interface,
+      wl_resource_get_version(resource), id);
+  SetImplementation(token_resource, &token_implementation,
+                    std::make_unique<TokenRequest>());
+}
+
+void activation_activate(wl_client* client,
+                         wl_resource* resource,
+                         const char* token,
+                         wl_resource* surface_resource) {
+  Surface* surface = GetUserDataAs<Surface>(surface_resource);
+  if (!surface->window()) {
+    return;
+  }
+  ShellSurfaceBase* shell_surface =
+      GetShellSurfaceBaseForWindow(surface->window()->GetToplevelWindow());
+  if (!shell_surface) {
+    return;
+  }
+
+  auto& tokens = GoodTokens();
+  auto it = tokens.find(token);
+  const bool good = it != tokens.end() && it->second > base::TimeTicks::Now();
+  if (it != tokens.end()) {
+    tokens.erase(it);
+  }
+  if (good) {
+    shell_surface->Activate();
+  } else {
+    // As the app's own request: the security delegate decides.
+    shell_surface->RequestActivation();
+  }
+}
+
+const struct xdg_activation_v1_interface activation_implementation = {
+    .destroy = activation_destroy,
+    .get_activation_token = activation_get_activation_token,
+    .activate = activation_activate,
+};
+
+}  // namespace
+
+void bind_xdg_activation(wl_client* client,
+                         void* data,
+                         uint32_t version,
+                         uint32_t id) {
+  wl_resource* resource =
+      wl_resource_create(client, &xdg_activation_v1_interface, 1, id);
+  wl_resource_set_implementation(resource, &activation_implementation, data,
+                                 nullptr);
+}
+
+}  // namespace exo::wayland

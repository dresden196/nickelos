+// The service answers with a JSON array of
+// {path, model, size_in_bytes, removable, recommended}.
+void OsInstallClientImpl::HandleGetInstallDestinationsResponse(
+    GetInstallDestinationsCallback callback,
+    dbus::Response* response) {
+  if (!response) {
+    LOG(ERROR) << "Invalid response";
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    LOG(ERROR) << "Missing destinations";
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+
+  std::optional<base::ListValue> list =
+      base::JSONReader::ReadList(json, base::JSON_PARSE_RFC);
+  if (!list) {
+    LOG(ERROR) << "Invalid destinations: " << json;
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+
+  std::vector<Destination> destinations;
+  for (const base::Value& item : *list) {
+    const base::DictValue* dict = item.GetIfDict();
+    const std::string* path = dict ? dict->FindString("path") : nullptr;
+    if (!path) {
+      continue;
+    }
+    Destination destination;
+    destination.path = *path;
+    if (const std::string* model = dict->FindString("model")) {
+      destination.model = *model;
+    }
+    // Large integers come back from JSON as doubles.
+    destination.size_in_bytes = static_cast<uint64_t>(
+        dict->FindDouble("size_in_bytes").value_or(0));
+    destination.removable = dict->FindBool("removable").value_or(false);
+    destination.recommended = dict->FindBool("recommended").value_or(false);
+    destinations.push_back(std::move(destination));
+  }
+  std::move(callback).Run(std::move(destinations));
+}

+    }
+    StartInstall(device_path);
   } else if (action_id == kUserActionErrorSendFeedbackClicked) {
     LoginDisplayHost::default_host()->HandleAccelerator(
         LoginAcceleratorAction::kShowFeedback);
@@ -70,7 +83,34 @@ void OsInstallScreen::StatusChanged(OsInstallClient::Status status,
   view_->SetServiceLogs(service_log);
 }
 
-void OsInstallScreen::StartInstall() {
+void OsInstallScreen::ListDestinations() {
+  if (listing_destinations_) {
+    return;
+  }
+  listing_destinations_ = true;
+  OsInstallClient::Get()->GetInstallDestinations(
+      base::BindOnce(&OsInstallScreen::OnDestinationsListed,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void OsInstallScreen::OnDestinationsListed(
+    std::optional<std::vector<OsInstallClient::Destination>> destinations) {
+  listing_destinations_ = false;
+  if (!view_) {
+    return;
+  }
+  if (destinations && destinations->empty()) {
+    view_->SetStatus(OsInstallClient::Status::NoDestinationDeviceFound);
+    return;
+  }
+  // If the service could not list disks, the view gets none and asks to
+  // confirm an install to the disk the service chooses, as before.
+  view_->ShowDestinations(
+      destinations ? std::move(*destinations)
+                   : std::vector<OsInstallClient::Destination>());
+}
+
+void OsInstallScreen::StartInstall(const std::string& device_path) {
   if (!view_)
     return;
   view_->SetStatus(OsInstallClient::Status::InProgress);
@@ -78,7 +118,11 @@ void OsInstallScreen::StartInstall() {
   OsInstallClient* const os_install_client = OsInstallClient::Get();
 
   scoped_observation_.Observe(os_install_client);
-  os_install_client->StartOsInstall();
+  if (device_path.empty()) {
+    os_install_client->StartOsInstall();
+  } else {
+    os_install_client->StartOsInstallTo(device_path);
+  }
 }
 

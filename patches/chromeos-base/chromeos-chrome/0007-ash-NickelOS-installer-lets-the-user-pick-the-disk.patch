+void OsInstallScreenHandler::ShowDestinations(
+    const std::vector<OsInstallClient::Destination>& destinations) {
+  base::ListValue list;
+  for (const auto& destination : destinations) {
+    const std::string& name =
+        destination.model.empty() ? destination.path : destination.model;
+    base::DictValue dict;
+    dict.Set("path", destination.path);
+    dict.Set("label",
+             base::StrCat({name, " (",
+                           base::UTF16ToUTF8(ui::FormatBytes(
+                               base::ByteSize(destination.size_in_bytes))),
+                           ")"}));
+    dict.Set("recommended", destination.recommended);
+    dict.Set("removable", destination.removable);
+    list.Append(std::move(dict));
+  }
+  CallExternalAPI("showDestinations", std::move(list));
+}

@@ -71,6 +71,9 @@ class VmApplicationsServiceProvider
   void NickelScreenCastChoose(
       dbus::MethodCall* method_call,
       dbus::ExportedObject::ResponseSender response_sender);
+  void NickelScreenCastPrimary(
+      dbus::MethodCall* method_call,
+      dbus::ExportedObject::ResponseSender response_sender);
   void NickelScreenCastStart(
       dbus::MethodCall* method_call,
       dbus::ExportedObject::ResponseSender response_sender);

From: dresden196 <50474030+dresden196@users.noreply.github.com>
Subject: [PATCH] gpu: honor the stride of padded shared memory buffers

SharedMemoryRegionWrapper::Initialize() recomputed every plane's stride
as the packed row size and only DCHECKed that the handle agreed. Wayland
clients on NickelOS reach Exo directly (no sommelier copy), and Mesa's
software Vulkan WSI pads wl_shm rows (1270 px -> 5120 byte stride), so
release builds drew those windows sheared.

For single-plane formats, use the handle's stride and map enough memory
for the padded rows. Multi-plane formats keep the packed layout.

diff --git a/gpu/command_buffer/service/shared_memory_region_wrapper.cc b/gpu/command_buffer/service/shared_memory_region_wrapper.cc
index abe91d0a0498a..6ec1f5e4d5769 100644
--- a/gpu/command_buffer/service/shared_memory_region_wrapper.cc
+++ b/gpu/command_buffer/service/shared_memory_region_wrapper.cc
@@ -84,6 +84,28 @@ bool SharedMemoryRegionWrapper::Initialize(
     return false;
   }
 
+  // Single-plane buffers may have padded rows (e.g. Wayland wl_shm buffers
+  // from Mesa's software WSI). Honor the client's stride and map the last
+  // padded row's start plus one row of pixels.
+  const bool use_handle_stride =
+      format.is_single_plane() && !size.IsEmpty() &&
+      handle.stride !=
+          viz::SharedMemoryRowSizeForSharedImageFormat(format, /*plane=*/0,
+                                                       size.width())
+              .value();
+  if (use_handle_stride) {
+    base::CheckedNumeric<size_t> padded_size = handle.stride;
+    padded_size *= size.height() - 1;
+    padded_size += viz::SharedMemoryRowSizeForSharedImageFormat(
+                       format, /*plane=*/0, size.width())
+                       .value();
+    if (!padded_size.IsValid()) {
+      DLOG(ERROR) << "Invalid GMB size for stride " << handle.stride;
+      return false;
+    }
+    buffer_size = padded_size.ValueOrDie();
+  }
+
   // Minimize the amount of address space we use but make sure offset is a
   // multiple of page size as required by MapAt().
   // TODO(sunnyps): This doesn't seem to be a requirement of MapAt() anymore.
@@ -111,22 +133,26 @@ bool SharedMemoryRegionWrapper::Initialize(
   planes_.resize(num_planes);
 
   // The offset/stride only make sense when GpuMemoryBufferHandle is for a
-  // single plane. Stride should be set as the expected stride for first plane
-  // and offset should always be zero.
-  DCHECK_EQ(static_cast<size_t>(handle.stride),
-            viz::SharedMemoryRowSizeForSharedImageFormat(format, /*plane=*/0,
-                                                         size.width())
-                .value());
-  DCHECK_EQ(handle.offset, 0u);
+  // single plane. For multi-plane formats, stride should be set as the
+  // expected stride for first plane and offset should always be zero.
+  if (!format.is_single_plane()) {
+    DCHECK_EQ(static_cast<size_t>(handle.stride),
+              viz::SharedMemoryRowSizeForSharedImageFormat(format, /*plane=*/0,
+                                                           size.width())
+                  .value());
+    DCHECK_EQ(handle.offset, 0u);
+  }
 
   for (int plane_index = 0; plane_index < num_planes; ++plane_index) {
     const size_t plane_offset =
         viz::SharedMemoryOffsetForSharedImageFormat(format, plane_index, size);
 
     planes_[plane_index].offset = memory_offset + plane_offset;
-    planes_[plane_index].stride = viz::SharedMemoryRowSizeForSharedImageFormat(
-                                      format, plane_index, size.width())
-                                      .value();
+    planes_[plane_index].stride =
+        use_handle_stride ? handle.stride
+                          : viz::SharedMemoryRowSizeForSharedImageFormat(
+                                format, plane_index, size.width())
+                                .value();
   }
 
   return true;

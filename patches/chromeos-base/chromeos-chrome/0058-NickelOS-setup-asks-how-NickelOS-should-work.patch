+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ASH_CONSTANTS_NICKEL_PREF_NAMES_H_
+#define ASH_CONSTANTS_NICKEL_PREF_NAMES_H_
+
+// NickelOS's own profile prefs, apart from ash_pref_names.h, which nearly
+// all of Ash includes.
+namespace ash::prefs {
+
+// Profile: the experience picked in setup (privacy, google or minimal; empty
+// before setup or for other accounts).
+inline constexpr char kNickelSetupExperience[] = "nickel.setup.experience";
+
+// Local state: the experience picked in setup, until the device's first
+// account's session applies it (setup asks before the account exists).
+inline constexpr char kNickelSetupPendingExperience[] =
+    "nickel.setup.pending_experience";
+
+}  // namespace ash::prefs
+
+#endif  // ASH_CONSTANTS_NICKEL_PREF_NAMES_H_

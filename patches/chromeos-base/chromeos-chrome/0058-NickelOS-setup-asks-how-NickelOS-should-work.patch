+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/login/nickel_setup_screen_handler.h"
+
+#include "components/login/localized_values_builder.h"
+#include "ui/chromeos/strings/grit/ui_chromeos_strings.h"
+
+namespace ash {
+
+NickelSetupScreenHandler::NickelSetupScreenHandler()
+    : BaseScreenHandler(kScreenId) {}
+
+NickelSetupScreenHandler::~NickelSetupScreenHandler() = default;
+
+void NickelSetupScreenHandler::DeclareLocalizedValues(
+    ::login::LocalizedValuesBuilder* builder) {
+  builder->Add("nickelSetupTitle", IDS_NICKEL_SETUP_TITLE);
+  builder->Add("nickelSetupSubtitle", IDS_NICKEL_SETUP_SUBTITLE);
+  builder->Add("nickelSetupPrivacy", IDS_NICKEL_SETUP_PRIVACY);
+  builder->Add("nickelSetupPrivacyDescription",
+               IDS_NICKEL_SETUP_PRIVACY_DESCRIPTION);
+  builder->Add("nickelSetupGoogle", IDS_NICKEL_SETUP_GOOGLE);
+  builder->Add("nickelSetupGoogleDescription",
+               IDS_NICKEL_SETUP_GOOGLE_DESCRIPTION);
+  builder->Add("nickelSetupMinimal", IDS_NICKEL_SETUP_MINIMAL);
+  builder->Add("nickelSetupMinimalDescription",
+               IDS_NICKEL_SETUP_MINIMAL_DESCRIPTION);
+}
+
+void NickelSetupScreenHandler::Show() {
+  ShowInWebUI();
+}
+
+base::WeakPtr<NickelSetupView> NickelSetupScreenHandler::AsWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+}  // namespace ash

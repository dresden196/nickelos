+<!--
+Copyright 2026 The NickelOS Authors
+Use of this source code is governed by a BSD-style license that can be
+found in the LICENSE file.
+-->
+
+<!--
+  NickelOS: how NickelOS works for the user (Privacy, Google or Minimal).
+  Text only: no Google or vendor logos.
+-->
+<style include="oobe-dialog-host-styles cr-card-radio-group-styles
+    cros-color-overrides">
+  cr-card-radio-button:not(:last-child) {
+    margin-bottom: 12px;
+  }
+
+  .card-container {
+    padding: 12px 16px;
+  }
+</style>
+<oobe-adaptive-dialog id="nickelSetupDialog" role="presentation"
+    for-step="overview" aria-live="polite"
+    aria-label$="[[i18nDynamic(locale, 'nickelSetupTitle')]]">
+  <iron-icon slot="icon" icon="oobe-32:stars"></iron-icon>
+  <h1 slot="title" id="nickel-setup-title">
+    [[i18nDynamic(locale, 'nickelSetupTitle')]]

diff --git a/chrome/browser/ash/login/screens/nickel_setup_screen.cc b/chrome/browser/ash/login/screens/nickel_setup_screen.cc
new file mode 100644
index 0000000000000..82c56960d796a
--- /dev/null
+++ b/chrome/browser/ash/login/screens/nickel_setup_screen.cc
@@ -0,0 +1,162 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/login/screens/nickel_setup_screen.h"
+
+#include <memory>
+#include <utility>
+
+#include "ash/constants/ash_pref_names.h"
+#include "ash/constants/nickel_pref_names.h"
+#include "ash/public/cpp/app_list/app_list_types.h"
+#include "base/callback_list.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/ash/profiles/profile_helper.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ui/webui/ash/login/nickel_setup_screen_handler.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_data_util.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/user_manager/nickel_local_account.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "third_party/search_engines_data/resources/definitions/prepopulated_engines.h"
+
+namespace ash {
+
+namespace {
+
+constexpr char kUserActionNext[] = "next";
+
+// Makes the search engine with `keyword` the default, adding DuckDuckGo from
+// Chromium's built-in list if the profile's list lacks it.
+void SetDefaultSearchEngine(TemplateURLService* service,
+                            const std::u16string& keyword) {
+  if (service->is_default_search_managed()) {
+    return;
+  }
+  TemplateURL* engine = service->GetTemplateURLForKeyword(keyword);
+  if (!engine && keyword == u"duckduckgo.com") {
+    std::unique_ptr<TemplateURLData> data =
+        TemplateURLDataFromPrepopulatedEngine(
+            TemplateURLPrepopulateData::duckduckgo);
+    engine = service->Add(std::make_unique<TemplateURL>(*data));
+  }
+  if (!engine) {
+    LOG(WARNING) << "NickelOS setup: no search engine " << keyword;
+    return;
+  }
+  service->SetUserSelectedDefaultSearchProvider(engine);
+}
+
+// Sets up what `experience` ("privacy", "google" or "minimal") means for
+// `profile`.
+void Apply(Profile* profile, const std::string& experience) {
+  // Minimal: the launcher searches the device only (no web results).
+  if (experience == "minimal") {
+    ScopedDictPrefUpdate update(profile->GetPrefs(),
+                                prefs::kLauncherSearchCategoryControlStatus);
+    update->Set(GetAppListControlCategoryName(AppListSearchControlCategory::kWeb),
+                false);
+    return;
+  }
+
+  // Privacy and Google: the search engine for the browser and the launcher
+  // (whose web results follow the browser's).
+  const std::u16string keyword =
+      experience == "google" ? u"google.com" : u"duckduckgo.com";
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+  if (service->loaded()) {
+    SetDefaultSearchEngine(service, keyword);
+    return;
+  }
+  // Once the profile's search engines are loaded (the session's one profile:
+  // the service lives as long as the subscription needs).
+  static base::NoDestructor<base::CallbackListSubscription> loaded;
+  *loaded = service->RegisterOnLoadedCallback(base::BindOnce(
+      &SetDefaultSearchEngine, base::Unretained(service), keyword));
+  service->Load();
+}
+
+}  // namespace
+
+// static
+std::string NickelSetupScreen::GetResultString(Result result) {
+  switch (result) {
+    case Result::kNext:
+      return "Next";
+    case Result::kNotApplicable:
+      return BaseScreen::kNotApplicable;
+  }
+}
+
+// static
+void NickelSetupScreen::MaybeApplyChoice(Profile* profile) {
+  PrefService* local_state = g_browser_process->local_state();
+  const std::string experience =
+      local_state->GetString(prefs::kNickelSetupPendingExperience);
+  const user_manager::User* user =
+      ProfileHelper::Get()->GetUserByProfile(profile);
+  if (experience.empty() || !user ||
+      !user_manager::IsNickelLocalAccount(user->GetAccountId()) ||
+      !profile->GetPrefs()->GetString(prefs::kNickelSetupExperience).empty()) {
+    return;
+  }
+  // The device's first account takes it, once.
+  local_state->ClearPref(prefs::kNickelSetupPendingExperience);
+  profile->GetPrefs()->SetString(prefs::kNickelSetupExperience, experience);
+  Apply(profile, experience);
+}
+
+NickelSetupScreen::NickelSetupScreen(base::WeakPtr<NickelSetupView> view,
+                                     const ScreenExitCallback& exit_callback)
+    : BaseScreen(NickelSetupView::kScreenId, OobeScreenPriority::DEFAULT),
+      view_(std::move(view)),
+      exit_callback_(exit_callback) {}
+
+NickelSetupScreen::~NickelSetupScreen() = default;
+
+bool NickelSetupScreen::MaybeSkip(WizardContext& context) {
+  // Only before the device's first account.
+  if (!user_manager::UserManager::Get()->GetPersistedUsers().empty()) {
+    exit_callback_.Run(Result::kNotApplicable);
+    return true;
+  }
+  return false;
+}
+
+void NickelSetupScreen::ShowImpl() {
+  if (view_) {
+    view_->Show();
+  }
+}
+
+void NickelSetupScreen::HideImpl() {}
+
+void NickelSetupScreen::OnUserAction(const base::ListValue& args) {
+  const std::string& action = args[0].GetString();
+  if (action == kUserActionNext && args.size() > 1 && args[1].is_string()) {
+    PrefService* local_state = g_browser_process->local_state();
+    local_state->SetString(prefs::kNickelSetupPendingExperience,
+                           args[1].GetString());
+    // Chrome restarts soon after, as the new account's Linux user.
+    local_state->CommitPendingWrite();
+    exit_callback_.Run(Result::kNext);
+    return;
+  }
+  BaseScreen::OnUserAction(args);
+}
+
+}  // namespace ash

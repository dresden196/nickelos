+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_LOGIN_SCREENS_NICKEL_SETUP_SCREEN_H_
+#define CHROME_BROWSER_ASH_LOGIN_SCREENS_NICKEL_SETUP_SCREEN_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ash/login/screens/base_screen.h"
+
+class Profile;
+
+namespace ash {
+
+class NickelSetupView;
+
+// NickelOS: before the device's first account is created, setup asks how
+// NickelOS should work (docs/setup-experiences.md in overlay-nickel):
+// Privacy (preselected; DuckDuckGo searches the web from the browser and the
+// launcher), Google (Google does) or Minimal (the launcher searches only the
+// device). Everything it sets can be changed in Settings later.
+//
+// It asks before the account rather than after, as ChromeOS's onboarding
+// does, because a local account's session restarts Chrome as its Linux user
+// (patch 0008), which ends onboarding. The choice waits in local state and
+// the account's first session applies it (MaybeApplyChoice()).
+class NickelSetupScreen : public BaseScreen {
+ public:
+  using TView = NickelSetupView;
+
+  enum class Result {
+    kNext,
+    kNotApplicable,
+  };
+
+  static std::string GetResultString(Result result);
+
+  // In a session, once: sets up the experience chosen in setup for the
+  // device's first account (search engine, launcher) and keeps it in its
+  // profile.
+  static void MaybeApplyChoice(Profile* profile);
+
+  using ScreenExitCallback = base::RepeatingCallback<void(Result result)>;
+
+  NickelSetupScreen(base::WeakPtr<NickelSetupView> view,
+                    const ScreenExitCallback& exit_callback);
+  NickelSetupScreen(const NickelSetupScreen&) = delete;
+  NickelSetupScreen& operator=(const NickelSetupScreen&) = delete;
+  ~NickelSetupScreen() override;
+
+ private:
+  // BaseScreen:
+  bool MaybeSkip(WizardContext& context) override;
+  void ShowImpl() override;
+  void HideImpl() override;
+  void OnUserAction(const base::ListValue& args) override;
+
+  base::WeakPtr<NickelSetupView> view_;
+  ScreenExitCallback exit_callback_;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_LOGIN_SCREENS_NICKEL_SETUP_SCREEN_H_

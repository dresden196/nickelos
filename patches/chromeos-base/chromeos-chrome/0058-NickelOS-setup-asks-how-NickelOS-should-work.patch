+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_NICKEL_SETUP_SCREEN_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_NICKEL_SETUP_SCREEN_HANDLER_H_
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/webui/ash/login/base_screen_handler.h"
+
+namespace ash {
+
+// NickelOS: the screen where a new user picks how NickelOS works for them.
+class NickelSetupView {
+ public:
+  inline constexpr static StaticOobeScreenId kScreenId{"nickel-setup",
+                                                       "NickelSetupScreen"};
+
+  virtual ~NickelSetupView() = default;
+
+  virtual void Show() = 0;
+  virtual base::WeakPtr<NickelSetupView> AsWeakPtr() = 0;
+};
+
+class NickelSetupScreenHandler final : public BaseScreenHandler,
+                                       public NickelSetupView {
+ public:
+  using TView = NickelSetupView;
+
+  NickelSetupScreenHandler();
+  NickelSetupScreenHandler(const NickelSetupScreenHandler&) = delete;
+  NickelSetupScreenHandler& operator=(const NickelSetupScreenHandler&) =
+      delete;
+  ~NickelSetupScreenHandler() override;
+
+ private:
+  // NickelSetupView:
+  void Show() override;
+  base::WeakPtr<NickelSetupView> AsWeakPtr() override;
+
+  // BaseScreenHandler:
+  void DeclareLocalizedValues(
+      ::login::LocalizedValuesBuilder* builder) override;
+
+  base::WeakPtrFactory<NickelSetupView> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_NICKEL_SETUP_SCREEN_HANDLER_H_

+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_handler.h"
+
+namespace ash {
+
+// NickelOS: global shortcuts for Linux apps (the GlobalShortcuts portal:
+// push-to-talk in voice chat, OBS's hotkeys), shortcuts that work while
+// another window has the focus. NickelOS's portal backend binds an app's
+// shortcuts through VmApplicationsService; the user allows them in a
+// ChromeOS dialog, where each one's keys can be changed, and the answer is
+// remembered for the app (guest_os::prefs::kNickelGlobalShortcuts).
+// ChromeOS's own shortcuts come first: their keys are never given to an
+// app. A bound shortcut's key press and release go to the backend through
+// the socket that came with the call, never to the window with the focus;
+// the bindings last until that socket closes.
+class NickelGlobalShortcuts : public ui::EventHandler {
+ public:
+  // One shortcut the app asks for, with the keys it would like: modifiers
+  // (kShift, kCtrl, kAlt, kLogo) and an evdev key code, 0 for none.
+  struct Shortcut {
+    std::string id;
+    std::string description;
+    uint32_t modifiers = 0;
+    uint32_t evdev = 0;
+  };
+  static constexpr uint32_t kShift = 1;
+  static constexpr uint32_t kCtrl = 2;
+  static constexpr uint32_t kAlt = 4;
+  static constexpr uint32_t kLogo = 8;
+
+  // Answers whether the user allowed the shortcuts and, if so, each one's
+  // keys as ChromeOS writes them ("Ctrl+Alt+A"), "" for none.
+  using BindCallback =
+      base::OnceCallback<void(bool allowed,
+                              const std::vector<std::string>& triggers)>;
+
+  static NickelGlobalShortcuts* Get();
+
+  NickelGlobalShortcuts();
+  NickelGlobalShortcuts(const NickelGlobalShortcuts&) = delete;
+  NickelGlobalShortcuts& operator=(const NickelGlobalShortcuts&) = delete;
+  ~NickelGlobalShortcuts() override;
+
+  // |app_id| (Flatpak's, "" if not known) is what the answer is remembered
+  // by; |app_name| is what the dialog calls the app.
+  void Bind(const std::string& app_id,
+            const std::string& app_name,
+            std::vector<Shortcut> shortcuts,
+            base::ScopedFD socket,
+            BindCallback callback);
+
+  // For the dialog: whether |accelerator| may be bound for |app_id|, and
+  // pausing the bindings while it takes keys.
+  bool IsAvailable(const ui::Accelerator& accelerator,
+                   const std::string& app_id) const;
+  void SetCapturing(bool capturing);
+
+  // ui::EventHandler:
+  void OnKeyEvent(ui::KeyEvent* event) override;
+
+ private:
+  struct Binding;
+  struct Pending;
+
+  void Ask(std::unique_ptr<Pending> pending);
+  void OnDialogDone(int serial, bool allowed);
+  void OnPendingSocket(int serial);
+  void Add(std::unique_ptr<Binding> binding);
+  void OnSocket(int serial);
+  void Remove(int serial);
+  void Send(Binding* binding, char kind, size_t index, base::TimeTicks time);
+
+  int next_serial_ = 1;
+  std::map<int, std::unique_ptr<Binding>> bindings_;
+  std::map<int, std::unique_ptr<Pending>> pending_;
+  // Shortcuts held down: their key, binding and place in it.
+  struct Held {
+    ui::KeyboardCode key;
+    int serial;
+    size_t index;
+  };
+  std::vector<Held> held_;
+  int capturing_ = 0;
+  bool observing_ = false;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_GLOBAL_SHORTCUTS_H_

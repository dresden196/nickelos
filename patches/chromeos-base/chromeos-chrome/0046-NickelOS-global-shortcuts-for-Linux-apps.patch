+// NickelOS: the GlobalShortcuts portal's backend binds an app's shortcuts:
+// (app id, app name, a(ssuu) shortcuts: id, description, modifiers, evdev
+// code of the preferred key, h socket the key events go into). Answers once
+// the user decides: (b allowed, as each shortcut's keys, "" for none).
+void VmApplicationsServiceProvider::NickelShortcutsBind(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string app_id;
+  std::string app_name;
+  dbus::MessageReader array(nullptr);
+  base::ScopedFD socket;
+  std::vector<NickelGlobalShortcuts::Shortcut> shortcuts;
+  bool ok = reader.PopString(&app_id) && reader.PopString(&app_name) &&
+            reader.PopArray(&array);
+  while (ok && array.HasMoreData()) {
+    dbus::MessageReader entry(nullptr);
+    NickelGlobalShortcuts::Shortcut shortcut;
+    ok = array.PopStruct(&entry) && entry.PopString(&shortcut.id) &&
+         entry.PopString(&shortcut.description) &&
+         entry.PopUint32(&shortcut.modifiers) &&
+         entry.PopUint32(&shortcut.evdev);
+    shortcuts.push_back(std::move(shortcut));
+  }
+  if (!ok || !reader.PopFileDescriptor(&socket)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected app id, app name, shortcuts, socket"));
+    return;
+  }
+  NickelGlobalShortcuts::Get()->Bind(
+      app_id, app_name, std::move(shortcuts), std::move(socket),
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             bool allowed, const std::vector<std::string>& triggers) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter writer(response.get());
+            writer.AppendBool(allowed);
+            writer.AppendArrayOfStrings(triggers);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}

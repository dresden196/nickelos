+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_GLOBAL_SHORTCUTS_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_GLOBAL_SHORTCUTS_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <string>

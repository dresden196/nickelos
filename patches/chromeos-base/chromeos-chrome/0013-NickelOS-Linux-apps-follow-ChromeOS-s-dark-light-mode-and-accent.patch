--- /dev/null
+++ b/chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APPS_APP_SERVICE_PUBLISHERS_NICKEL_APPEARANCE_REPORTER_H_
+#define CHROME_BROWSER_APPS_APP_SERVICE_PUBLISHERS_NICKEL_APPEARANCE_REPORTER_H_
+
+#include <string>
+
+#include "ash/style/color_palette_controller.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+
+namespace dbus {
+class ObjectProxy;
+}  // namespace dbus
+
+namespace apps {
+
+// NickelOS: tells nickel-appd whether the system is in dark or light mode and
+// which accent color it uses (org.nickelos.Apps.SetAppearance), at start, on
+// every change, and again whenever nickel-appd (re)starts. NickelOS's portal
+// backend hands both to Linux apps (xdg-desktop-portal Settings,
+// org.freedesktop.appearance), so they follow ChromeOS's theme.
+class NickelAppearanceReporter
+    : public ash::ColorPaletteController::Observer {
+ public:
+  NickelAppearanceReporter();
+  NickelAppearanceReporter(const NickelAppearanceReporter&) = delete;
+  NickelAppearanceReporter& operator=(const NickelAppearanceReporter&) =
+      delete;
+  ~NickelAppearanceReporter() override;
+
+ private:
+  // ash::ColorPaletteController::Observer:
+  void OnColorPaletteChanging(const ash::ColorPaletteSeed& seed) override;
+
+  void OnServiceAvailable(bool available);
+  void OnNameOwnerChanged(const std::string& old_owner,
+                          const std::string& new_owner);
+  void SendCurrent();
+  void Send(const ash::ColorPaletteSeed& seed);
+
+  raw_ptr<dbus::ObjectProxy> proxy_;
+  base::ScopedObservation<ash::ColorPaletteController,
+                          ash::ColorPaletteController::Observer>
+      observation_{this};
+  base::WeakPtrFactory<NickelAppearanceReporter> weak_ptr_factory_{this};
+};
+
+}  // namespace apps
+
+#endif  // CHROME_BROWSER_APPS_APP_SERVICE_PUBLISHERS_NICKEL_APPEARANCE_REPORTER_H_

diff --git a/chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.cc b/chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.cc
new file mode 100644
index 0000000000000..f041c7604bae6
--- /dev/null
+++ b/chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.h"
+
+#include <memory>
+#include <optional>
+
+#include "ash/shell.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/ash/crostini/crostini_util.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/dynamic_color/palette.h"
+#include "ui/color/dynamic_color/palette_factory.h"
+
+namespace apps {
+
+namespace {
+
+// The palette variant Ash uses for each color scheme, as in
+// ash/style/color_palette_controller.cc.
+ui::ColorProviderKey::SchemeVariant ToVariant(
+    ash::style::mojom::ColorScheme scheme) {
+  using Scheme = ash::style::mojom::ColorScheme;
+  using Variant = ui::ColorProviderKey::SchemeVariant;
+  switch (scheme) {
+    case Scheme::kStatic:
+    case Scheme::kNeutral:
+      return Variant::kNeutral;
+    case Scheme::kTonalSpot:
+      return Variant::kTonalSpot;
+    case Scheme::kExpressive:
+      return Variant::kExpressive;
+    case Scheme::kVibrant:
+      return Variant::kVibrant;
+  }
+  return Variant::kTonalSpot;
+}
+
+void OnSent(dbus::Response* response, dbus::ErrorResponse* error) {
+  LOG_IF(WARNING, !response)
+      << "nickel-appd did not take the appearance"
+      << (error ? ": " + error->GetErrorName() : std::string());
+}
+
+}  // namespace
+
+NickelAppearanceReporter::NickelAppearanceReporter() {
+  proxy_ = ash::DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      crostini::kNickelAppsServiceName,
+      dbus::ObjectPath(crostini::kNickelAppsServicePath));
+  proxy_->SetNameOwnerChangedCallback(
+      base::BindRepeating(&NickelAppearanceReporter::OnNameOwnerChanged,
+                          weak_ptr_factory_.GetWeakPtr()));
+  proxy_->WaitForServiceToBeAvailable(
+      base::BindOnce(&NickelAppearanceReporter::OnServiceAvailable,
+                     weak_ptr_factory_.GetWeakPtr()));
+  observation_.Observe(ash::Shell::Get()->color_palette_controller());
+}
+
+NickelAppearanceReporter::~NickelAppearanceReporter() = default;
+
+void NickelAppearanceReporter::OnColorPaletteChanging(
+    const ash::ColorPaletteSeed& seed) {
+  Send(seed);
+}
+
+void NickelAppearanceReporter::OnServiceAvailable(bool available) {
+  if (available) {
+    SendCurrent();
+  }
+}
+
+void NickelAppearanceReporter::OnNameOwnerChanged(
+    const std::string& old_owner,
+    const std::string& new_owner) {
+  if (!new_owner.empty()) {
+    SendCurrent();
+  }
+}
+
+void NickelAppearanceReporter::SendCurrent() {
+  std::optional<ash::ColorPaletteSeed> seed =
+      ash::Shell::Get()->color_palette_controller()->GetCurrentSeed();
+  if (seed) {
+    Send(*seed);
+  }
+}
+
+void NickelAppearanceReporter::Send(const ash::ColorPaletteSeed& seed) {
+  const bool dark = seed.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  // Ash's own primary color (cros.sys.primary): tone 80 of the primary
+  // palette in dark mode, tone 40 in light mode.
+  std::unique_ptr<ui::Palette> palette =
+      ui::GeneratePalette(seed.seed_color, ToVariant(seed.scheme));
+  const SkColor accent = palette->primary().get(dark ? 80.f : 40.f);
+
+  dbus::MethodCall method_call(crostini::kNickelAppsServiceInterface,
+                               "SetAppearance");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendBool(dark);
+  writer.AppendUint32(accent);
+  proxy_->CallMethodWithErrorResponse(&method_call,
+                                      dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+                                      base::BindOnce(&OnSent));
+}
+
+}  // namespace apps

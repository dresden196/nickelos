@@ -52,6 +58,9 @@ class NickelHostApps : public GuestOSApps {
   void CreateAppOverrides(
       const guest_os::GuestOsRegistryService::Registration& registration,
       App* app) override;
+
+  // Tells nickel-appd the system's appearance, for Linux apps to follow.
+  std::unique_ptr<NickelAppearanceReporter> appearance_reporter_;
 };
 
 }  // namespace apps

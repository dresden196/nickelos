 #include "chrome/browser/apps/app_service/app_service_proxy.h"
 #include "chrome/browser/apps/app_service/menu_util.h"
+#include "chrome/browser/apps/app_service/publishers/nickel_appearance_reporter.h"
 #include "chrome/browser/ash/crostini/crostini_util.h"
 #include "chrome/grit/chrome_unscaled_resources.h"
 #include "chrome/grit/generated_resources.h"
@@ -22,6 +24,15 @@ NickelHostApps::NickelHostApps(AppServiceProxy* proxy) : GuestOSApps(proxy) {}
 
 NickelHostApps::~NickelHostApps() = default;
 
+void NickelHostApps::Initialize() {
+  GuestOSApps::Initialize();
+  // This publisher exists exactly when host apps do, so it also keeps
+  // their appearance in step with the system's.
+  if (CouldBeAllowed() && ash::Shell::HasInstance()) {
+    appearance_reporter_ = std::make_unique<NickelAppearanceReporter>();
+  }
+}
+
 bool NickelHostApps::CouldBeAllowed() const {
   return crostini::IsNickelNativeAppsAllowed(profile());
 }

+constexpr char kValentService[] = "ca.andyholmes.Valent";
+constexpr char kValentPath[] = "/ca/andyholmes/Valent";
+constexpr char kDeviceInterface[] = "ca.andyholmes.Valent.Device";
+constexpr char kActionsInterface[] = "org.gtk.Actions";
+constexpr char kObjectManagerInterface[] = "org.freedesktop.DBus.ObjectManager";
+
+// Valent's device states (ValentDeviceState).
+constexpr uint32_t kConnected = 1 << 0;
+constexpr uint32_t kPaired = 1 << 1;
+constexpr uint32_t kPairIncoming = 1 << 2;
+constexpr uint32_t kPairOutgoing = 1 << 3;
+
+// The device actions the page may activate.
+constexpr auto kPageActions = base::MakeFixedFlatSet<std::string_view>(
+    {"pair", "unpair", "findmyphone.ring", "ping.ping"});
+
+// The session's D-Bus, where Valent is: nickel-session's, at
+// /run/user/<uid>/bus, as Chrome runs as the session's user. One private
+// connection, on its own I/O thread, for as long as Chrome runs.
+dbus::Bus* SessionBus() {
+  static base::NoDestructor<base::Thread> thread("NickelSessionDBus");
+  static base::NoDestructor<scoped_refptr<dbus::Bus>> bus;
+  if (!*bus) {
+    CHECK(thread->StartWithOptions(
+        base::Thread::Options(base::MessagePumpType::IO, 0)));
+    dbus::Bus::Options options;
+    options.bus_type = dbus::Bus::CUSTOM_ADDRESS;
+    options.address = base::StringPrintf("unix:path=/run/user/%u/bus",
+                                         static_cast<unsigned>(getuid()));
+    options.connection_type = dbus::Bus::PRIVATE;
+    options.dbus_task_runner = thread->task_runner();
+    *bus = base::MakeRefCounted<dbus::Bus>(std::move(options));
+  }
+  return bus->get();
+}
+
+dbus::ObjectProxy* ValentProxy(const std::string& path) {
+  return SessionBus()->GetObjectProxy(kValentService, dbus::ObjectPath(path));
+}
+
+// The page never starts Valent: nickel-phone runs it, with the firewall open
+// for it. D-Bus activation would start another, outside that job.
+void NoAutoStart(dbus::MethodCall* method_call) {
+  dbus_message_set_auto_start(method_call->raw_message(), false);
+}
+
+// battery.state's description, after its "enabled" flag: the parameter
+// type (g), then the state (av), an a{sv} with percentage, charging and
+// is-present.
+void ReadBattery(DBusMessageIter* description,
+                 NickelPhonesHandler::Device* device) {
+  DBusMessageIter state, variant, dict;
+  if (!dbus_message_iter_next(description) ||
+      !dbus_message_iter_next(description) ||
+      dbus_message_iter_get_arg_type(description) != DBUS_TYPE_ARRAY) {
+    return;
+  }
+  dbus_message_iter_recurse(description, &state);
+  if (dbus_message_iter_get_arg_type(&state) != DBUS_TYPE_VARIANT) {
+    return;
+  }
+  dbus_message_iter_recurse(&state, &variant);
+  if (dbus_message_iter_get_arg_type(&variant) != DBUS_TYPE_ARRAY) {
+    return;
+  }
+  double percentage = -1;
+  dbus_bool_t charging = false;
+  dbus_bool_t present = false;
+  for (dbus_message_iter_recurse(&variant, &dict);
+       dbus_message_iter_get_arg_type(&dict) == DBUS_TYPE_DICT_ENTRY;
+       dbus_message_iter_next(&dict)) {
+    DBusMessageIter entry, value;
+    dbus_message_iter_recurse(&dict, &entry);
+    if (dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_STRING) {
+      continue;
+    }
+    const char* key = nullptr;
+    dbus_message_iter_get_basic(&entry, &key);
+    if (!dbus_message_iter_next(&entry) ||
+        dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_VARIANT) {
+      continue;
+    }
+    dbus_message_iter_recurse(&entry, &value);
+    const int type = dbus_message_iter_get_arg_type(&value);
+    const std::string_view name(key);
+    if (name == "percentage" && type == DBUS_TYPE_DOUBLE) {
+      dbus_message_iter_get_basic(&value, &percentage);
+    } else if (name == "charging" && type == DBUS_TYPE_BOOLEAN) {
+      dbus_message_iter_get_basic(&value, &charging);
+    } else if (name == "is-present" && type == DBUS_TYPE_BOOLEAN) {
+      dbus_message_iter_get_basic(&value, &present);
+    }
+  }
+  if (present && percentage >= 0) {
+    device->battery = static_cast<int>(std::lround(percentage));
+    device->charging = charging;
+  }
+}
+
+// org.gtk.Actions DescribeAll's a{s(bgav)}: the device's enabled actions,
+// and its battery. Read with libdbus: dbus::MessageReader cannot read the
+// signature (g) in each description.
+void ReadActions(dbus::Response* response,
+                 NickelPhonesHandler::Device* device) {
+  DBusMessageIter iter, actions;
+  if (!dbus_message_iter_init(response->raw_message(), &iter) ||
+      dbus_message_iter_get_arg_type(&iter) != DBUS_TYPE_ARRAY) {
+    return;
+  }
+  for (dbus_message_iter_recurse(&iter, &actions);
+       dbus_message_iter_get_arg_type(&actions) == DBUS_TYPE_DICT_ENTRY;
+       dbus_message_iter_next(&actions)) {
+    DBusMessageIter entry, description;
+    dbus_message_iter_recurse(&actions, &entry);
+    if (dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_STRING) {
+      continue;
+    }
+    const char* name = nullptr;
+    dbus_message_iter_get_basic(&entry, &name);
+    if (!dbus_message_iter_next(&entry) ||
+        dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_STRUCT) {
+      continue;
+    }
+    dbus_message_iter_recurse(&entry, &description);
+    if (dbus_message_iter_get_arg_type(&description) != DBUS_TYPE_BOOLEAN) {
+      continue;
+    }
+    dbus_bool_t enabled = false;
+    dbus_message_iter_get_basic(&description, &enabled);
+    if (enabled) {
+      device->actions.emplace_back(name);
+    }
+    if (std::string_view(name) == "battery.state") {
+      ReadBattery(&description, device);
+    }
+  }
+}
+
+void OnDescribed(NickelPhonesHandler::Device device,
+                 base::RepeatingCallback<void(NickelPhonesHandler::Device)> done,
+                 dbus::Response* response,
+                 dbus::ErrorResponse* error) {
+  if (response) {
+    ReadActions(response, &device);
+  }
+  done.Run(std::move(device));
+}

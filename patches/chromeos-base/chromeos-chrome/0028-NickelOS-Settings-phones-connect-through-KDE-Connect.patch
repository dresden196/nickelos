+void NickelPhonesHandler::HandleGetPhones(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kObjectManagerInterface, "GetManagedObjects");
+  NoAutoStart(&method_call);
+  ValentProxy(kValentPath)
+      ->CallMethodWithErrorResponse(
+          &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+          base::BindOnce(&NickelPhonesHandler::OnManagedObjects,
+                         weak_ptr_factory_.GetWeakPtr(),
+                         args[0].GetString()));
+}
+
+void NickelPhonesHandler::OnManagedObjects(std::string callback_id,
+                                           dbus::Response* response,
+                                           dbus::ErrorResponse* error) {
+  if (!response) {
+    // Valent is not running (or the session's bus is not there yet).
+    base::DictValue result;
+    result.Set("running", false);
+    result.Set("devices", base::ListValue());
+    ResolveJavascriptCallback(base::Value(callback_id), result);
+    return;
+  }
+  // a{oa{sa{sv}}}: each object's interfaces and their properties.
+  std::vector<Device> devices;
+  dbus::MessageReader reader(response);
+  dbus::MessageReader objects(nullptr);
+  if (reader.PopArray(&objects)) {
+    while (objects.HasMoreData()) {
+      dbus::MessageReader object(nullptr);
+      dbus::ObjectPath path;
+      dbus::MessageReader interfaces(nullptr);
+      if (!objects.PopDictEntry(&object) || !object.PopObjectPath(&path) ||
+          !object.PopArray(&interfaces)) {
+        break;
+      }
+      while (interfaces.HasMoreData()) {
+        dbus::MessageReader iface(nullptr);
+        std::string name;
+        dbus::MessageReader properties(nullptr);
+        if (!interfaces.PopDictEntry(&iface) ||
+            !iface.PopString(&name) || !iface.PopArray(&properties)) {
+          break;
+        }
+        if (name != kDeviceInterface) {
+          continue;
+        }
+        Device device;
+        device.path = path.value();
+        while (properties.HasMoreData()) {
+          dbus::MessageReader property(nullptr);
+          std::string key;
+          if (!properties.PopDictEntry(&property) ||
+              !property.PopString(&key)) {
+            break;
+          }
+          if (key == "Id") {
+            property.PopVariantOfString(&device.id);
+          } else if (key == "Name") {
+            property.PopVariantOfString(&device.name);
+          } else if (key == "IconName") {
+            property.PopVariantOfString(&device.icon);
+          } else if (key == "State") {
+            dbus::MessageReader variant(nullptr);
+            if (property.PopVariant(&variant)) {
+              variant.PopUint32(&device.state);
+            }
+          }
+        }
+        if (!device.id.empty()) {
+          devices.push_back(std::move(device));
+        }
+      }
+    }
+  }
+
+  paths_.clear();
+  for (const Device& device : devices) {
+    paths_[device.id] = device.path;
+  }
+  if (devices.empty()) {
+    OnDevicesDescribed(std::move(callback_id), {});
+    return;
+  }
+  auto described = base::BarrierCallback<Device>(
+      devices.size(),
+      base::BindOnce(&NickelPhonesHandler::OnDevicesDescribed,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback_id)));
+  for (Device& device : devices) {
+    dbus::MethodCall method_call(kActionsInterface, "DescribeAll");
+    NoAutoStart(&method_call);
+    ValentProxy(device.path)
+        ->CallMethodWithErrorResponse(
+            &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+            base::BindOnce(&OnDescribed, std::move(device), described));
+  }
+}
+
+void NickelPhonesHandler::OnDevicesDescribed(std::string callback_id,
+                                             std::vector<Device> devices) {
+  // Paired devices first, then by name.
+  std::ranges::sort(devices, [](const Device& a, const Device& b) {
+    const bool a_paired = a.state & kPaired;
+    const bool b_paired = b.state & kPaired;
+    if (a_paired != b_paired) {
+      return a_paired;
+    }
+    return a.name < b.name;
+  });
+  base::ListValue list;
+  for (const Device& device : devices) {
+    base::ListValue actions;
+    for (const std::string& action : device.actions) {
+      actions.Append(action);
+    }
+    base::DictValue dict;
+    dict.Set("id", device.id);
+    dict.Set("name", device.name);
+    dict.Set("icon", device.icon);
+    dict.Set("connected", (device.state & kConnected) != 0);
+    dict.Set("paired", (device.state & kPaired) != 0);
+    dict.Set("pairIncoming", (device.state & kPairIncoming) != 0);
+    dict.Set("pairOutgoing", (device.state & kPairOutgoing) != 0);
+    dict.Set("battery", device.battery);
+    dict.Set("charging", device.charging);
+    dict.Set("actions", std::move(actions));
+    list.Append(std::move(dict));
+  }
+  base::DictValue result;
+  result.Set("running", true);
+  result.Set("devices", std::move(list));
+  ResolveJavascriptCallback(base::Value(callback_id), result);
+}
+
+void NickelPhonesHandler::HandlePhoneAction(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string& callback_id = args[0].GetString();
+  const auto path = paths_.find(args[1].GetString());
+  const std::string& action = args[2].GetString();
+  if (path == paths_.end() || !kPageActions.contains(action)) {
+    ResolveJavascriptCallback(base::Value(callback_id), base::Value(false));
+    return;
+  }
+  Activate(path->second, action, std::nullopt, callback_id);
+}
+
+void NickelPhonesHandler::HandleSendFiles(const base::ListValue& args) {
+  const auto path = paths_.find(args[0].GetString());
+  if (path == paths_.end()) {
+    return;
+  }
+  send_to_ = path->second;
+  content::WebContents* web_contents = web_ui()->GetWebContents();
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(web_contents));
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE,
+      l10n_util::GetStringUTF16(IDS_SETTINGS_NICKEL_PHONES_SEND_FILES_TITLE),
+      base::FilePath(), /*file_types=*/nullptr, /*file_type_index=*/0,
+      base::FilePath::StringType(), web_contents->GetTopLevelNativeWindow());
+}
+
+void NickelPhonesHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                       int index) {
+  MultiFilesSelected({file});
+}
+
+void NickelPhonesHandler::MultiFilesSelected(
+    const std::vector<ui::SelectedFileInfo>& files) {
+  // Valent runs as the same user as Chrome and reads the files itself.
+  base::ListValue uris;
+  for (const ui::SelectedFileInfo& file : files) {
+    const base::FilePath& path =
+        file.local_path.empty() ? file.file_path : file.local_path;
+    uris.Append(net::FilePathToFileURL(path).spec());
+  }
+  if (!send_to_.empty() && !uris.empty()) {
+    Activate(send_to_, "share.uris", base::Value(std::move(uris)),
+             std::nullopt);
+  }
+  send_to_.clear();
+}
+
+void NickelPhonesHandler::FileSelectionCanceled() {
+  send_to_.clear();
+}
+
+void NickelPhonesHandler::HandleOpenValent(const base::ListValue& args) {
+  AllowJavascript();
+  const std::string& callback_id = args[0].GetString();
+  const std::string& what = args[1].GetString();
+  if (what == "messages") {
+    Activate(kValentPath, "messages-window", std::nullopt, callback_id);
+    return;
+  }
+  // Valent's window, on a device's page or its own.
+  const std::string& device_id = args[2].GetString();
+  Activate(kValentPath, "window",
+           base::Value(what == "device" && !device_id.empty() ? device_id
+                                                               : "main"),
+           callback_id);
+}
+
+void NickelPhonesHandler::Activate(const std::string& path,
+                                   const std::string& action,
+                                   std::optional<base::Value> parameter,
+                                   std::optional<std::string> callback_id) {
+  // org.gtk.Actions Activate(s action, av parameter, a{sv} platform_data)
+  dbus::MethodCall method_call(kActionsInterface, "Activate");
+  NoAutoStart(&method_call);
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(action);
+  dbus::MessageWriter parameters(nullptr);
+  writer.OpenArray("v", &parameters);
+  if (parameter && parameter->is_string()) {
+    parameters.AppendVariantOfString(parameter->GetString());
+  } else if (parameter && parameter->is_list()) {
+    std::vector<std::string> strings;
+    for (const base::Value& value : parameter->GetList()) {
+      if (value.is_string()) {
+        strings.push_back(value.GetString());
+      }
+    }
+    dbus::MessageWriter variant(nullptr);
+    parameters.OpenVariant("as", &variant);
+    variant.AppendArrayOfStrings(strings);
+    parameters.CloseContainer(&variant);
+  }
+  writer.CloseContainer(&parameters);
+  // A window Valent shows for it comes forward (Exo's xdg-activation).
+  dbus::MessageWriter platform_data(nullptr);
+  writer.OpenArray("{sv}", &platform_data);
+  dbus::MessageWriter entry(nullptr);
+  platform_data.OpenDictEntry(&entry);
+  entry.AppendString("activation-token");
+  entry.AppendVariantOfString(exo::wayland::MakeActivationToken());
+  platform_data.CloseContainer(&entry);
+  writer.CloseContainer(&platform_data);
+
+  ValentProxy(path)->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelPhonesHandler::OnActivated,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback_id)));
+}
+
+void NickelPhonesHandler::OnActivated(std::optional<std::string> callback_id,
+                                      dbus::Response* response,
+                                      dbus::ErrorResponse* error) {
+  if (callback_id) {
+    ResolveJavascriptCallback(base::Value(*callback_id),
+                              base::Value(response != nullptr));
+  }
+}

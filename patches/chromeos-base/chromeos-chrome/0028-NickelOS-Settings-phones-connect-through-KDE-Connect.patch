diff --git a/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.html b/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.html
new file mode 100644
index 0000000000000..f77d2c063cde4
--- /dev/null
+++ b/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.html
@@ -0,0 +1,82 @@
+<style include="settings-shared">
+  iron-icon {
+    --iron-icon-fill-color: var(--cros-sys-primary);
+    flex-shrink: 0;
+  }
+
+  .device cr-button,
+  .device cr-icon-button {
+    margin-inline-start: 8px;
+  }
+</style>
+<div class="settings-box first two-line">
+  <iron-icon icon="os-settings:connected-devices"></iron-icon>
+  <div class="middle settings-box-text">
+    <div id="phonesTitle">$i18n{nickelPhonesTitle}</div>
+    <div class="secondary">$i18n{nickelPhonesDescription}</div>
+  </div>
+  <template is="dom-if" if="[[running_]]">
+    <cr-button on-click="onOpenValentClick_">
+      $i18n{nickelPhonesOpenValent}
+    </cr-button>
+  </template>
+</div>
+<template is="dom-if" if="[[!running_]]">
+  <div class="settings-box">
+    <div class="middle secondary">$i18n{nickelPhonesNotRunning}</div>
+  </div>
+</template>
+<template is="dom-if" if="[[showNone_(loaded_, running_, devices_)]]">
+  <div class="settings-box">
+    <div class="middle secondary">$i18n{nickelPhonesNone}</div>
+  </div>
+</template>
+<template is="dom-repeat" items="[[devices_]]" as="device">
+  <div class="settings-box two-line device">
+    <iron-icon icon="[[iconFor_(device)]]"></iron-icon>
+    <div class="middle settings-box-text">
+      <div>[[device.name]]</div>
+      <div class="secondary">[[statusFor_(device)]]</div>
+    </div>
+    <template is="dom-if" if="[[showAnswer_(device)]]" restamp>
+      <cr-button data-id$="[[device.id]]" on-click="onUnpairClick_">
+        $i18n{nickelPhonesReject}
+      </cr-button>
+      <cr-button class="action-button" data-id$="[[device.id]]"
+          on-click="onPairClick_">
+        $i18n{nickelPhonesAccept}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showPair_(device)]]" restamp>
+      <cr-button class="action-button" data-id$="[[device.id]]"
+          on-click="onPairClick_">
+        $i18n{nickelPhonesPair}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showCancelPair_(device)]]" restamp>
+      <cr-button data-id$="[[device.id]]" on-click="onUnpairClick_">
+        $i18n{nickelPhonesCancel}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showRing_(device)]]" restamp>
+      <cr-button data-id$="[[device.id]]" on-click="onRingClick_">
+        $i18n{nickelPhonesRing}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showSend_(device)]]" restamp>
+      <cr-button data-id$="[[device.id]]" on-click="onSendClick_">
+        $i18n{nickelPhonesSendFiles}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showUnpair_(device)]]" restamp>
+      <cr-button data-id$="[[device.id]]" on-click="onUnpairClick_">
+        $i18n{nickelPhonesUnpair}
+      </cr-button>
+    </template>
+    <template is="dom-if" if="[[showMore_(device)]]" restamp>
+      <cr-icon-button class="subpage-arrow" data-id$="[[device.id]]"
+          aria-label="[[moreLabel_(device)]]" on-click="onMoreClick_">
+      </cr-icon-button>
+    </template>
+  </div>
+</template>
diff --git a/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.ts b/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.ts
new file mode 100644
index 0000000000000..c2c552dbea380
--- /dev/null
+++ b/chrome/browser/resources/ash/settings/multidevice_page/nickel_phones_card.ts
@@ -0,0 +1,219 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: Settings > Connected devices' phones and tablets,
+ * which connect through KDE Connect (Valent, NickelPhonesHandler) instead of
+ * Google's Phone Hub. Lists the devices Valent knows, refreshed every two
+ * seconds while Settings is visible: pairing (a phone asking, or asking
+ * one), what a connected one reports (its battery), ringing it, sending it
+ * files, and Valent's own window for the rest (messages, remote input,
+ * media, each device's settings).
+ */
+
+import 'chrome://resources/ash/common/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/ash/common/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/polymer/v3_0/iron-icon/iron-icon.js';
+import '../os_settings_icons.html.js';
+import '../settings_shared.css.js';
+
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_phones_card.html.js';
+
+interface NickelPhone {
+  id: string;
+  name: string;
+  // Valent's icon name: phone-symbolic, tablet-symbolic, computer-symbolic...
+  icon: string;
+  connected: boolean;
+  paired: boolean;
+  pairIncoming: boolean;
+  pairOutgoing: boolean;
+  // Percent, or -1 for none.
+  battery: number;
+  charging: boolean;
+  // The device's enabled actions (findmyphone.ring, share.uris...).
+  actions: string[];
+}
+
+interface NickelPhones {
+  running: boolean;
+  devices: NickelPhone[];
+}
+
+const REFRESH_MS = 2000;
+
+const NickelPhonesCardElementBase = I18nMixin(PolymerElement);
+
+export class NickelPhonesCardElement extends NickelPhonesCardElementBase {
+  static get is() {
+    return 'nickel-phones-card' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      running_: {type: Boolean, value: true},
+      loaded_: {type: Boolean, value: false},
+      devices_: {type: Array, value: () => []},
+    };
+  }
+
+  declare private running_: boolean;
+  declare private loaded_: boolean;
+  declare private devices_: NickelPhone[];
+  private timer_: number|null = null;
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.refresh_();
+    this.timer_ = setInterval(() => this.refresh_(), REFRESH_MS);
+  }
+
+  override disconnectedCallback(): void {
+    super.disconnectedCallback();
+    if (this.timer_ !== null) {
+      clearInterval(this.timer_);
+      this.timer_ = null;
+    }
+  }
+
+  private async refresh_(): Promise<void> {
+    if (document.hidden && this.loaded_) {
+      return;
+    }
+    const phones: NickelPhones = await sendWithPromise('nickelGetPhones');
+    this.running_ = phones.running;
+    this.devices_ = phones.devices;
+    this.loaded_ = true;
+  }
+
+  private showNone_(
+      loaded: boolean, running: boolean, devices: NickelPhone[]): boolean {
+    return loaded && running && devices.length === 0;
+  }
+
+  private iconFor_(device: NickelPhone): string {
+    if (device.icon.startsWith('tablet')) {
+      return 'os-settings:tablet';
+    }
+    if (device.icon.startsWith('computer') || device.icon.startsWith('laptop')) {
+      return 'os-settings:laptop-chromebook';
+    }
+    return 'os-settings:smartphone';
+  }
+
+  private statusFor_(device: NickelPhone): string {
+    if (device.pairIncoming) {
+      return this.i18n('nickelPhonesWantsToPair');
+    }
+    if (device.pairOutgoing) {
+      return this.i18n('nickelPhonesPairRequested');
+    }
+    if (!device.paired) {
+      return this.i18n('nickelPhonesAvailable');
+    }
+    if (!device.connected) {
+      return this.i18n('nickelPhonesPairedNotConnected');
+    }
+    if (device.battery >= 0) {
+      return this.i18n(
+          device.charging ? 'nickelPhonesConnectedCharging' :
+                            'nickelPhonesConnectedBattery',
+          String(device.battery));
+    }
+    return this.i18n('nickelPhonesConnected');
+  }
+
+  // A phone asking to pair: Accept or Reject.
+  private showAnswer_(device: NickelPhone): boolean {
+    return device.pairIncoming;
+  }
+
+  private showPair_(device: NickelPhone): boolean {
+    return !device.paired && device.connected && !device.pairIncoming &&
+        !device.pairOutgoing;
+  }
+
+  private showCancelPair_(device: NickelPhone): boolean {
+    return device.pairOutgoing;
+  }
+
+  private ready_(device: NickelPhone, action: string): boolean {
+    return device.paired && device.connected &&
+        device.actions.includes(action);
+  }
+
+  private showRing_(device: NickelPhone): boolean {
+    return this.ready_(device, 'findmyphone.ring');
+  }
+
+  private showSend_(device: NickelPhone): boolean {
+    return this.ready_(device, 'share.uris');
+  }
+
+  // Out of reach, nothing else to do with it here.
+  private showUnpair_(device: NickelPhone): boolean {
+    return device.paired && !device.connected;
+  }
+
+  private showMore_(device: NickelPhone): boolean {
+    return device.paired;
+  }
+
+  private moreLabel_(device: NickelPhone): string {
+    return this.i18n('nickelPhonesMore', device.name);
+  }
+
+  private idOf_(e: Event): string {
+    return (e.currentTarget as HTMLElement).dataset['id'] || '';
+  }
+
+  private async act_(e: Event, action: string): Promise<void> {
+    e.stopPropagation();
+    await sendWithPromise('nickelPhoneAction', this.idOf_(e), action);
+    this.refresh_();
+  }
+
+  private onPairClick_(e: Event): void {
+    this.act_(e, 'pair');
+  }
+
+  // Rejecting a request, cancelling ours, and unpairing are all "unpair".
+  private onUnpairClick_(e: Event): void {
+    this.act_(e, 'unpair');
+  }
+
+  private onRingClick_(e: Event): void {
+    this.act_(e, 'findmyphone.ring');
+  }
+
+  private onSendClick_(e: Event): void {
+    e.stopPropagation();
+    chrome.send('nickelPhoneSendFiles', [this.idOf_(e)]);
+  }
+
+  private onMoreClick_(e: Event): void {
+    e.stopPropagation();
+    sendWithPromise('nickelOpenValent', 'device', this.idOf_(e));
+  }
+
+  private onOpenValentClick_(): void {
+    sendWithPromise('nickelOpenValent', 'main', '');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelPhonesCardElement.is]: NickelPhonesCardElement;
+  }
+}
+
+customElements.define(NickelPhonesCardElement.is, NickelPhonesCardElement);

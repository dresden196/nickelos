+// NickelOS: Settings > Connected devices' phones and tablets, in place of
+// Google's Phone Hub. They connect through KDE Connect: Valent runs in the
+// session (nickel-phone) and Chrome, running as the session's user, talks to
+// it on the session's D-Bus. The page lists Valent's devices (its
+// ObjectManager), with their battery and what they can do (each device's
+// org.gtk.Actions); pairs, unpairs, rings and sends files to them (device
+// actions); and opens Valent's own windows for the rest (app actions), with
+// an xdg-activation token so they come forward.
+class NickelPhonesHandler : public ::settings::SettingsPageUIHandler,
+                            public ui::SelectFileDialog::Listener {
+ public:
+  NickelPhonesHandler();
+  NickelPhonesHandler(const NickelPhonesHandler&) = delete;
+  NickelPhonesHandler& operator=(const NickelPhonesHandler&) = delete;
+  ~NickelPhonesHandler() override;
+
+  // ::settings::SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void MultiFilesSelected(
+      const std::vector<ui::SelectedFileInfo>& files) override;
+  void FileSelectionCanceled() override;
+
+  // A device as the page shows it.
+  struct Device {
+    Device();
+    Device(const Device&);
+    Device(Device&&);
+    Device& operator=(const Device&);
+    Device& operator=(Device&&);
+    ~Device();
+
+    std::string path;
+    std::string id;
+    std::string name;
+    std::string icon;
+    uint32_t state = 0;
+    // The device actions that are enabled (pair, findmyphone.ring...).
+    std::vector<std::string> actions;
+    // Percent, or -1 when the device reports no battery.
+    int battery = -1;
+    bool charging = false;
+  };
+
+ private:
+  // nickelGetPhones(callback_id): {running, devices: [...]}.
+  void HandleGetPhones(const base::ListValue& args);
+  // nickelPhoneAction(callback_id, device_id, action): a device action.
+  void HandlePhoneAction(const base::ListValue& args);
+  // nickelPhoneSendFiles(device_id): ChromeOS's file picker, then sends.
+  void HandleSendFiles(const base::ListValue& args);
+  // nickelOpenValent(callback_id, what, device_id): Valent's window on a
+  // device ("device"), its main window ("main") or Messages ("messages").
+  void HandleOpenValent(const base::ListValue& args);
+
+  void OnManagedObjects(std::string callback_id,
+                        dbus::Response* response,
+                        dbus::ErrorResponse* error);
+  void OnDevicesDescribed(std::string callback_id,
+                          std::vector<Device> devices);
+  void OnActivated(std::optional<std::string> callback_id,
+                   dbus::Response* response,
+                   dbus::ErrorResponse* error);
+  // Activates org.gtk.Actions `action` on Valent's object `path`, with
+  // `parameter` if given (a string, or a list of strings); resolves
+  // `callback_id`, if given, with whether it went through.
+  void Activate(const std::string& path,
+                const std::string& action,
+                std::optional<base::Value> parameter,
+                std::optional<std::string> callback_id);
+
+  // Device id -> object path, from the last listing.
+  std::map<std::string, std::string> paths_;
+  // The device the file picker sends to.
+  std::string send_to_;
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  base::WeakPtrFactory<NickelPhonesHandler> weak_ptr_factory_{this};
+};

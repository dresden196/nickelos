 }
 
+// NickelOS: the ScreenCast portal's backend asks which screen or window an
+// app may have, ChromeOS's picker answering (source id, width, height; ""
+// if the user canceled).
+void VmApplicationsServiceProvider::NickelScreenCastChoose(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string app_name;
+  uint32_t types = 0;
+  if (!reader.PopString(&app_name) || !reader.PopUint32(&types)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected the app's name and the source types"));
+    return;
+  }
+  // Portal source types: 1 screens, 2 windows.
+  NickelScreenCast::Choose(
+      app_name, types & 2,
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             const std::string& source_id, int width, int height) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter writer(response.get());
+            writer.AppendString(source_id);
+            writer.AppendInt32(width);
+            writer.AppendInt32(height);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
+// NickelOS: starts copying the chosen source into the backend's frame
+// buffer (see NickelScreenCast::Start).
+void VmApplicationsServiceProvider::NickelScreenCastStart(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string source_id;
+  base::ScopedFD ring;
+  base::ScopedFD notify;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t slots = 0;
+  bool cursor = true;
+  std::string app_name;
+  if (!reader.PopString(&source_id) || !reader.PopFileDescriptor(&ring) ||
+      !reader.PopFileDescriptor(&notify) || !reader.PopUint32(&width) ||
+      !reader.PopUint32(&height) || !reader.PopUint32(&slots) ||
+      !reader.PopBool(&cursor) || !reader.PopString(&app_name)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected source, frame buffer, pipe, size, slots, cursor, app"));
+    return;
+  }
+  const bool started = NickelScreenCast::Start(
+      source_id, std::move(ring), std::move(notify), width, height, slots,
+      cursor, app_name);
+  std::unique_ptr<dbus::Response> response =
+      dbus::Response::FromMethodCall(method_call);
+  dbus::MessageWriter(response.get()).AppendBool(started);
+  std::move(response_sender).Run(std::move(response));
+}
+
+void VmApplicationsServiceProvider::NickelScreenCastStop(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string source_id;
+  if (reader.PopString(&source_id)) {
+    NickelScreenCast::Stop(source_id);
+  }
+  std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
+}
+

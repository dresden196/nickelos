+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_screen_cast.h"
+
+#include <errno.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "ash/shell.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/media/webrtc/desktop_media_list_ash.h"
+#include "chrome/browser/media/webrtc/desktop_media_picker.h"
+#include "chrome/browser/ui/screen_capture_notification_ui.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/viz/common/frame_sinks/copy_output_request.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/desktop_media_id.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_observer.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/compositor/layer.h"
+#include "ui/display/display.h"
+#include "ui/display/manager/display_manager.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/size_conversions.h"
+
+namespace ash {
+
+namespace {
+
+constexpr base::TimeDelta kFrameInterval = base::Milliseconds(33);
+
+std::u16string DisplayName(const std::string& app_name) {
+  return app_name.empty()
+             ? l10n_util::GetStringUTF16(
+                   IDS_APP_MANAGEMENT_APP_DETAILS_TYPE_NICKEL_HOST)
+             : base::UTF8ToUTF16(app_name);
+}
+
+// The window to copy for a source, and its size in pixels.
+aura::Window* SourceWindow(const content::DesktopMediaID& id,
+                           gfx::Size* size_in_pixels) {
+  aura::Window* window = content::DesktopMediaID::GetNativeWindowById(id);
+  if (!window) {
+    return nullptr;
+  }
+  const display::Display display =
+      display::Screen::Get()->GetDisplayNearestWindow(window);
+  if (id.type == content::DesktopMediaID::TYPE_SCREEN) {
+    *size_in_pixels = display.GetSizeInPixel();
+  } else {
+    *size_in_pixels = gfx::ScaleToCeiledSize(window->bounds().size(),
+                                             display.device_scale_factor());
+  }
+  return window;
+}
+
+class Session;
+
+std::map<std::string, std::unique_ptr<Session>>& Sessions() {
+  static base::NoDestructor<std::map<std::string, std::unique_ptr<Session>>>
+      sessions;
+  return *sessions;
+}
+
+// Copies a screen or a window into the portal backend's frame buffer.
+class Session : public aura::WindowObserver {
+ public:
+  Session(const std::string& source_id,
+          aura::Window* window,
+          base::ScopedFD notify,
+          int width,
+          int height,
+          int slots,
+          bool cursor)
+      : source_id_(source_id),
+        window_(window),
+        notify_(std::move(notify)),
+        width_(width),
+        height_(height),
+        slots_(slots),
+        cursor_(cursor) {}
+
+  Session(const Session&) = delete;
+  Session& operator=(const Session&) = delete;
+
+  ~Session() override {
+    timer_.Stop();
+    if (window_) {
+      window_->RemoveObserver(this);
+    }
+    if (counted_) {
+      Shell::Get()->display_manager()->dec_screen_capture_active_counter();
+      Shell::Get()->UpdateCursorCompositingEnabled();
+    }
+    if (ring_) {
+      munmap(ring_, ring_size_);
+    }
+  }
+
+  bool Init(const base::ScopedFD& ring, const std::string& app_name) {
+    ring_size_ = static_cast<size_t>(slots_) * width_ * height_ * 4;
+    void* ring_memory = mmap(nullptr, ring_size_, PROT_READ | PROT_WRITE,
+                             MAP_SHARED, ring.get(), 0);
+    if (ring_memory == MAP_FAILED) {
+      PLOG(ERROR) << "NickelOS screen cast: cannot map the frame buffer";
+      return false;
+    }
+    ring_ = static_cast<uint8_t*>(ring_memory);
+    window_->AddObserver(this);
+    if (cursor_) {
+      // As for ARC's screen capture: Ash draws the pointer into the frames.
+      Shell::Get()->display_manager()->inc_screen_capture_active_counter();
+      Shell::Get()->UpdateCursorCompositingEnabled();
+      counted_ = true;
+    }
+    notification_ = ScreenCaptureNotificationUI::Create(
+        l10n_util::GetStringFUTF16(IDS_MEDIA_SCREEN_CAPTURE_NOTIFICATION_TEXT,
+                                   DisplayName(app_name)),
+        /*capturing_web_contents=*/nullptr);
+    notification_->OnStarted(
+        base::BindOnce(&Session::StopSoon, weak_ptr_factory_.GetWeakPtr()),
+        content::MediaStreamUI::SourceCallback(),
+        std::vector<content::DesktopMediaID>{});
+    timer_.Start(FROM_HERE, kFrameInterval,
+                 base::BindRepeating(&Session::Capture,
+                                     weak_ptr_factory_.GetWeakPtr()));
+    return true;
+  }
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override {
+    window_->RemoveObserver(this);
+    window_ = nullptr;
+    StopSoon();
+  }
+
+ private:
+  void Capture() {
+    if (in_flight_ || !window_) {
+      return;
+    }
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(&Session::OnCaptured, weak_ptr_factory_.GetWeakPtr()));
+    request->set_result_task_runner(
+        base::SequencedTaskRunner::GetCurrentDefault());
+    in_flight_ = true;
+    window_->layer()->RequestCopyOfOutput(std::move(request));
+  }
+
+  void OnCaptured(std::unique_ptr<viz::CopyOutputResult> result) {
+    in_flight_ = false;
+    if (result->IsEmpty()) {
+      return;
+    }
+    auto scoped_bitmap = result->ScopedAccessSkBitmap();
+    const SkBitmap& bitmap = scoped_bitmap.bitmap();
+    if (bitmap.drawsNothing()) {
+      return;
+    }
+    // A window that changed size since the start keeps the stream's size:
+    // cut to it, or padded with black.
+    const size_t frame_size = static_cast<size_t>(width_) * height_ * 4;
+    uint8_t* frame = ring_ + next_slot_ * frame_size;
+    const int rows = std::min(height_, bitmap.height());
+    const int columns = std::min(width_, bitmap.width());
+    if (rows < height_ || columns < width_) {
+      memset(frame, 0, frame_size);
+    }
+    for (int y = 0; y < rows; ++y) {
+      memcpy(frame + static_cast<size_t>(y) * width_ * 4, bitmap.getAddr32(0, y),
+             static_cast<size_t>(columns) * 4);
+    }
+    const uint32_t slot = next_slot_;
+    next_slot_ = (next_slot_ + 1) % slots_;
+    if (HANDLE_EINTR(write(notify_.get(), &slot, sizeof(slot))) < 0 &&
+        errno != EAGAIN) {
+      // The backend is gone.
+      StopSoon();
+    }
+  }
+
+  // Ends the session outside the current call (it owns this object).
+  void StopSoon() {
+    timer_.Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&NickelScreenCast::Stop, source_id_));
+  }
+
+  const std::string source_id_;
+  raw_ptr<aura::Window> window_;
+  base::ScopedFD notify_;
+  const int width_;
+  const int height_;
+  const int slots_;
+  const bool cursor_;
+  bool counted_ = false;
+  uint8_t* ring_ = nullptr;
+  size_t ring_size_ = 0;
+  uint32_t next_slot_ = 0;
+  bool in_flight_ = false;
+  base::RepeatingTimer timer_;
+  std::unique_ptr<ScreenCaptureNotificationUI> notification_;
+  base::WeakPtrFactory<Session> weak_ptr_factory_{this};
+};
+
+void OnChosen(std::unique_ptr<DesktopMediaPicker> picker,
+              NickelScreenCast::ChooseCallback callback,
+              DesktopMediaPicker::DoneCallbackArgumentType result) {
+  // Not deleted in its own callback.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(picker));
+  gfx::Size size;
+  if (!result.has_value() || result.value().is_null() ||
+      !SourceWindow(result.value(), &size) || size.IsEmpty()) {
+    std::move(callback).Run(std::string(), 0, 0);
+    return;
+  }
+  std::move(callback).Run(result.value().ToString(), size.width(),
+                          size.height());
+}
+
+}  // namespace
+
+// static
+void NickelScreenCast::Choose(const std::string& app_name,
+                              bool windows,
+                              ChooseCallback callback) {
+  std::unique_ptr<DesktopMediaPicker> picker =
+      DesktopMediaPicker::Create(nullptr);
+  std::vector<std::unique_ptr<DesktopMediaList>> source_lists;
+  source_lists.emplace_back(
+      std::make_unique<DesktopMediaListAsh>(DesktopMediaList::Type::kScreen));
+  if (windows) {
+    source_lists.emplace_back(
+        std::make_unique<DesktopMediaListAsh>(DesktopMediaList::Type::kWindow));
+  }
+  // Shown as for ARC apps' screen capture: no web page asks.
+  DesktopMediaPicker::Params params{
+      DesktopMediaPicker::Params::RequestSource::kArcScreenCapture};
+  params.context = Shell::GetRootWindowForDisplayId(
+      display::Screen::Get()->GetPrimaryDisplay().id());
+  params.modality = ui::mojom::ModalType::kSystem;
+  params.app_name = DisplayName(app_name);
+  params.target_name = params.app_name;
+  DesktopMediaPicker* shown = picker.get();
+  shown->Show(params, std::move(source_lists),
+              base::BindOnce(&OnChosen, std::move(picker),
+                             std::move(callback)));
+}
+
+// static
+bool NickelScreenCast::Start(const std::string& source_id,
+                             base::ScopedFD ring,
+                             base::ScopedFD notify,
+                             int width,
+                             int height,
+                             int slots,
+                             bool cursor,
+                             const std::string& app_name) {
+  if (Sessions().count(source_id) || width <= 0 || height <= 0 ||
+      slots <= 0) {
+    return false;
+  }
+  gfx::Size size;
+  aura::Window* window =
+      SourceWindow(content::DesktopMediaID::Parse(source_id), &size);
+  if (!window) {
+    return false;
+  }
+  auto session = std::make_unique<Session>(source_id, window,
+                                           std::move(notify), width, height,
+                                           slots, cursor);
+  if (!session->Init(ring, app_name)) {
+    return false;
+  }
+  Sessions()[source_id] = std::move(session);
+  return true;
+}
+
+// static
+void NickelScreenCast::Stop(const std::string& source_id) {
+  Sessions().erase(source_id);
+}
+
+}  // namespace ash

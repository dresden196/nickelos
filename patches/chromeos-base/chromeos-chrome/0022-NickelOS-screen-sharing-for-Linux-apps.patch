+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_SCREEN_CAST_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_SCREEN_CAST_H_
+
+#include <string>
+
+#include "base/files/scoped_file.h"
+#include "base/functional/callback.h"
+
+namespace ash {
+
+// NickelOS: screen sharing for Linux apps. NickelOS's backend for the
+// ScreenCast portal (xdg-desktop-portal-nickel) calls these through
+// VmApplicationsService; it publishes the frames as a PipeWire stream.
+class NickelScreenCast {
+ public:
+  using ChooseCallback = base::OnceCallback<
+      void(const std::string& source_id, int width, int height)>;
+
+  // Shows ChromeOS's "share your screen" picker for |app_name|, with the
+  // screens, and the windows too if |windows|. Answers with the chosen
+  // source (a DesktopMediaID string) and its size in pixels, or "" if the
+  // user canceled.
+  static void Choose(const std::string& app_name,
+                     bool windows,
+                     ChooseCallback callback);
+
+  // Starts copying |source_id|, at most 30 times a second, into |ring|
+  // (|slots| frames of |width| x |height|, BGRx), writing each frame's slot
+  // (uint32) to |notify|, and shows the "sharing your screen" notification;
+  // with |cursor|, the pointer is drawn into the frames. It stops when the
+  // user stops it there, when the source goes away, when |notify| closes, or
+  // with Stop().
+  static bool Start(const std::string& source_id,
+                    base::ScopedFD ring,
+                    base::ScopedFD notify,
+                    int width,
+                    int height,
+                    int slots,
+                    bool cursor,
+                    const std::string& app_name);
+  static void Stop(const std::string& source_id);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_SCREEN_CAST_H_

+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview NickelOS: the computer's name, a row on the About page.
+ * ChromiumOS has none (every computer was "localhost"); nickel-hostnamed
+ * keeps it (NickelComputerNameHandler). The name as typed is kept as is, and
+ * the hostname the Terminal and Linux apps see is made from it. Changes are
+ * for administrators of the device.
+ */
+
+import 'chrome://resources/ash/common/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/ash/common/cr_elements/cr_input/cr_input.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/ash/common/cr_elements/cr_dialog/cr_dialog.js';
+import {I18nMixin} from 'chrome://resources/ash/common/cr_elements/i18n_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_computer_name.html.js';
+
+interface ComputerName {
+  // Whether nickel-hostnamed answered.
+  available: boolean;
+  // The running hostname, the kept one, and the name as typed (or "").
+  Hostname: string;
+  StaticHostname: string;
+  PrettyHostname: string;
+  canChange: boolean;
+}
+
+const NickelComputerNameElementBase = I18nMixin(PolymerElement);
+
+export class NickelComputerNameElement extends NickelComputerNameElementBase {
+  static get is() {
+    return 'nickel-computer-name' as const;
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      state_: {
+        type: Object,
+        value: () => ({
+          available: false,
+          Hostname: '',
+          StaticHostname: '',
+          PrettyHostname: '',
+          canChange: false,
+        }),
+      },
+      dialogOpen_: {type: Boolean, value: false},
+      draft_: {type: String, value: ''},
+      error_: {type: String, value: ''},
+      saving_: {type: Boolean, value: false},
+    };
+  }
+
+  declare private state_: ComputerName;
+  declare private dialogOpen_: boolean;
+  declare private draft_: string;
+  declare private error_: string;
+  declare private saving_: boolean;
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    this.refresh_();
+  }
+
+  private async refresh_(): Promise<void> {
+    this.state_ = await sendWithPromise('getNickelComputerName');
+  }
+
+  private displayName_(state: ComputerName): string {
+    return state.PrettyHostname || state.StaticHostname || state.Hostname;
+  }
+
+  // The hostname, when it reads differently from the name as typed.
+  private terminalName_(state: ComputerName): string {
+    if (!state.PrettyHostname || !state.Hostname ||
+        state.PrettyHostname === state.Hostname) {
+      return '';
+    }
+    return this.i18n('nickelComputerNameTerminal', state.Hostname);
+  }
+
+  private adminOnly_(state: ComputerName): boolean {
+    return state.available && !state.canChange;
+  }
+
+  private hasError_(error: string): boolean {
+    return !!error;
+  }
+
+  private canSave_(draft: string, saving: boolean): boolean {
+    return !saving && draft.trim().length > 0;
+  }
+
+  private onChangeClick_(): void {
+    this.draft_ = this.displayName_(this.state_);
+    this.error_ = '';
+    this.saving_ = false;
+    this.dialogOpen_ = true;
+  }
+
+  private onInputKeydown_(e: KeyboardEvent): void {
+    this.error_ = '';
+    if (e.key === 'Enter' && this.canSave_(this.draft_, this.saving_)) {
+      this.onSaveClick_();
+    }
+  }
+
+  private async onSaveClick_(): Promise<void> {
+    this.saving_ = true;
+    const result: string =
+        await sendWithPromise('setNickelComputerName', this.draft_.trim());
+    this.saving_ = false;
+    if (result === 'invalid') {
+      this.error_ = this.i18n('nickelComputerNameInvalid');
+      return;
+    }
+    if (result) {
+      this.error_ = this.i18n(
+          result === 'not-allowed' ? 'nickelComputerNameAdminOnly' :
+                                     'nickelComputerNameFailed');
+      return;
+    }
+    this.closeDialog_();
+    this.refresh_();
+  }
+
+  private onCancelClick_(): void {
+    this.closeDialog_();
+  }
+
+  private closeDialog_(): void {
+    const dialog =
+        this.shadowRoot!.querySelector<CrDialogElement>('#dialog');
+    if (dialog?.open) {
+      dialog.close();
+    }
+  }
+
+  private onDialogClose_(): void {
+    this.dialogOpen_ = false;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelComputerNameElement.is]: NickelComputerNameElement;
+  }
+}
+
+customElements.define(NickelComputerNameElement.is, NickelComputerNameElement);

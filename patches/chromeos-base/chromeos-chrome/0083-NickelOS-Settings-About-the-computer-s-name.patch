diff --git a/chrome/browser/ui/webui/ash/settings/pages/about/nickel_computer_name_handler.cc b/chrome/browser/ui/webui/ash/settings/pages/about/nickel_computer_name_handler.cc
new file mode 100644
index 0000000000000..765aad825f18a
--- /dev/null
+++ b/chrome/browser/ui/webui/ash/settings/pages/about/nickel_computer_name_handler.cc
@@ -0,0 +1,146 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/about/nickel_computer_name_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chromeos/ash/components/dbus/dbus_thread_manager.h"
+#include "content/public/browser/web_ui.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+
+namespace ash::settings {
+
+namespace {
+
+constexpr char kService[] = "org.freedesktop.hostname1";
+constexpr char kPath[] = "/org/freedesktop/hostname1";
+constexpr char kInterface[] = "org.freedesktop.hostname1";
+constexpr char kNickelInterface[] = "org.nickelos.Hostname1";
+constexpr char kErrorPrefix[] = "org.freedesktop.hostname1.Error.";
+
+dbus::ObjectProxy* Proxy() {
+  return DBusThreadManager::Get()->GetSystemBus()->GetObjectProxy(
+      kService, dbus::ObjectPath(kPath));
+}
+
+}  // namespace
+
+NickelComputerNameHandler::NickelComputerNameHandler() = default;
+
+NickelComputerNameHandler::~NickelComputerNameHandler() = default;
+
+void NickelComputerNameHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getNickelComputerName",
+      base::BindRepeating(&NickelComputerNameHandler::HandleGet,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setNickelComputerName",
+      base::BindRepeating(&NickelComputerNameHandler::HandleSet,
+                          base::Unretained(this)));
+}
+
+void NickelComputerNameHandler::OnJavascriptDisallowed() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void NickelComputerNameHandler::HandleGet(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call("org.freedesktop.DBus.Properties", "GetAll");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(kInterface);
+  Proxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelComputerNameHandler::OnProperties,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void NickelComputerNameHandler::OnProperties(const std::string& callback_id,
+                                             dbus::Response* response,
+                                             dbus::ErrorResponse* error) {
+  base::DictValue state;
+  state.Set("available", response != nullptr);
+  for (const char* key : {"Hostname", "StaticHostname", "PrettyHostname"}) {
+    state.Set(key, "");
+  }
+  dbus::MessageReader reader(response);
+  dbus::MessageReader array(nullptr);
+  if (response && reader.PopArray(&array)) {
+    while (array.HasMoreData()) {
+      dbus::MessageReader entry(nullptr);
+      std::string key;
+      std::string value;
+      if (!array.PopDictEntry(&entry) || !entry.PopString(&key)) {
+        break;
+      }
+      if ((key == "Hostname" || key == "StaticHostname" ||
+           key == "PrettyHostname") &&
+          entry.PopVariantOfString(&value)) {
+        state.Set(key, value);
+      }
+    }
+  }
+  if (!response) {
+    state.Set("canChange", false);
+    ResolveJavascriptCallback(base::Value(callback_id), state);
+    return;
+  }
+  dbus::MethodCall method_call(kNickelInterface, "CanChange");
+  Proxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelComputerNameHandler::OnCanChange,
+                     weak_ptr_factory_.GetWeakPtr(), callback_id,
+                     std::move(state)));
+}
+
+void NickelComputerNameHandler::OnCanChange(const std::string& callback_id,
+                                            base::DictValue state,
+                                            dbus::Response* response,
+                                            dbus::ErrorResponse* error) {
+  bool can_change = false;
+  if (response) {
+    dbus::MessageReader reader(response);
+    reader.PopBool(&can_change);
+  }
+  state.Set("canChange", can_change);
+  ResolveJavascriptCallback(base::Value(callback_id), state);
+}
+
+void NickelComputerNameHandler::HandleSet(const base::ListValue& args) {
+  AllowJavascript();
+  dbus::MethodCall method_call(kNickelInterface, "SetName");
+  dbus::MessageWriter writer(&method_call);
+  writer.AppendString(args.size() > 1 && args[1].is_string()
+                          ? args[1].GetString()
+                          : std::string());
+  Proxy()->CallMethodWithErrorResponse(
+      &method_call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&NickelComputerNameHandler::OnSet,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void NickelComputerNameHandler::OnSet(const std::string& callback_id,
+                                      dbus::Response* response,
+                                      dbus::ErrorResponse* error) {
+  // "", or why the name was not changed, as the page names it.
+  std::string result;
+  if (!response) {
+    const std::string name = error ? error->GetErrorName() : std::string();
+    if (name == base::StrCat({kErrorPrefix, "InvalidName"})) {
+      result = "invalid";
+    } else if (name == base::StrCat({kErrorPrefix, "NotAllowed"})) {
+      result = "not-allowed";
+    } else {
+      result = "failed";
+    }
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), base::Value(result));
+}
+
+}  // namespace ash::settings

+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_COMPUTER_NAME_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_COMPUTER_NAME_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace dbus {
+class ErrorResponse;
+class Response;
+}  // namespace dbus
+
+namespace ash::settings {
+
+// NickelOS: the computer's name, for Settings > About. nickel-hostnamed keeps
+// it (org.freedesktop.hostname1 on the system bus); changes are for the
+// device's administrators, which nickel-hostnamed checks.
+class NickelComputerNameHandler : public content::WebUIMessageHandler {
+ public:
+  NickelComputerNameHandler();
+  NickelComputerNameHandler(const NickelComputerNameHandler&) = delete;
+  NickelComputerNameHandler& operator=(const NickelComputerNameHandler&) =
+      delete;
+  ~NickelComputerNameHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGet(const base::ListValue& args);
+  void OnProperties(const std::string& callback_id,
+                    dbus::Response* response,
+                    dbus::ErrorResponse* error);
+  void OnCanChange(const std::string& callback_id,
+                   base::DictValue state,
+                   dbus::Response* response,
+                   dbus::ErrorResponse* error);
+  void HandleSet(const base::ListValue& args);
+  void OnSet(const std::string& callback_id,
+             dbus::Response* response,
+             dbus::ErrorResponse* error);
+
+  base::WeakPtrFactory<NickelComputerNameHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace ash::settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_ABOUT_NICKEL_COMPUTER_NAME_HANDLER_H_

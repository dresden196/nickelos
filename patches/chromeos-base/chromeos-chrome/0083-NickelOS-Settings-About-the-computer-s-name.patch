+<style include="settings-shared">
+  .nickel-computer-name-error {
+    color: var(--cros-sys-error);
+  }
+
+  cr-dialog p {
+    margin: 0 0 12px;
+  }
+</style>
+<div class="settings-box two-line">
+  <div class="start settings-box-text">
+    <div id="nickelComputerNameLabel">$i18n{nickelComputerNameLabel}</div>
+    <div class="secondary" id="nickelComputerNameValue">
+      [[displayName_(state_)]]
+    </div>
+    <div class="secondary"
+        hidden$="[[!terminalName_(state_)]]">
+      [[terminalName_(state_)]]
+    </div>
+    <div class="secondary" hidden$="[[!adminOnly_(state_)]]">
+      $i18n{nickelComputerNameAdminOnly}
+    </div>
+  </div>
+  <div class="separator"></div>
+  <cr-button id="nickelComputerNameChange" on-click="onChangeClick_"
+      disabled="[[!state_.canChange]]"
+      aria-describedby="nickelComputerNameLabel nickelComputerNameValue">
+    $i18n{nickelComputerNameChange}
+  </cr-button>
+</div>
+
+<template is="dom-if" if="[[dialogOpen_]]" restamp>
+  <cr-dialog id="dialog" show-on-attach on-close="onDialogClose_">
+    <div slot="title">$i18n{nickelComputerNameDialogTitle}</div>
+    <div slot="body">
+      <p>$i18n{nickelComputerNameDialogBody}</p>
+      <cr-input id="nameInput" value="{{draft_}}" maxlength="64"
+          aria-label="$i18n{nickelComputerNameLabel}"
+          invalid="[[hasError_(error_)]]" error-message="[[error_]]"
+          on-keydown="onInputKeydown_" spellcheck="false" autofocus>
+      </cr-input>
+    </div>
+    <div slot="button-container">
+      <cr-button class="cancel-button" on-click="onCancelClick_">
+        $i18n{cancel}
+      </cr-button>
+      <cr-button class="action-button" on-click="onSaveClick_"
+          disabled="[[!canSave_(draft_, saving_)]]">
+        $i18n{save}
+      </cr-button>
+    </div>
+  </cr-dialog>
+</template>

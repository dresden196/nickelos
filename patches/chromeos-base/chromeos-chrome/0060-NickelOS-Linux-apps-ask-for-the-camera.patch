 }
 
+// NickelOS: the Access portal's backend asks whether an app may use
+// something, the camera today: (app id, app name, title, body, grant label,
+// deny label, icon name). Answers once the user decides: (s "allow", "deny"
+// or "off", the camera being off in the privacy controls).
+void VmApplicationsServiceProvider::NickelAccessAsk(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string app_id;
+  std::string app_name;
+  std::string title;
+  std::string body;
+  std::string grant_label;
+  std::string deny_label;
+  std::string icon;
+  if (!reader.PopString(&app_id) || !reader.PopString(&app_name) ||
+      !reader.PopString(&title) || !reader.PopString(&body) ||
+      !reader.PopString(&grant_label) || !reader.PopString(&deny_label) ||
+      !reader.PopString(&icon)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected app id, app name, title, body, grant and deny labels, "
+            "icon"));
+    return;
+  }
+  NickelAccess::Ask(
+      app_id, app_name, title, body, grant_label, deny_label, icon,
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             const std::string& answer) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter(response.get()).AppendString(answer);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
 // NickelOS: nickel-x11-keys connects: (h socket) the shortcut keys for
 // X11 apps go into.
 void VmApplicationsServiceProvider::NickelX11KeysConnect(

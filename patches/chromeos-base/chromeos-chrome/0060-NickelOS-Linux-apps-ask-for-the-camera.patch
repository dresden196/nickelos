+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/dbus/vm/nickel_access.h"
+
+#include <memory>
+#include <utility>
+
+#include "ash/constants/ash_pref_names.h"
+#include "ash/public/cpp/system_tray_client.h"
+#include "ash/resources/vector_icons/vector_icons.h"
+#include "ash/shell.h"
+#include "ash/style/system_dialog_delegate_view.h"
+#include "ash/system/model/system_tray_model.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/chromeos/strings/grit/ui_chromeos_strings.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/widget/widget.h"
+
+namespace ash {
+
+namespace {
+
+using Answer = base::RefCountedData<base::OnceCallback<void(bool)>>;
+
+std::u16string DisplayName(const std::string& app_name) {
+  return app_name.empty()
+             ? l10n_util::GetStringUTF16(
+                   IDS_APP_MANAGEMENT_APP_DETAILS_TYPE_NICKEL_HOST)
+             : base::UTF8ToUTF16(app_name);
+}
+
+// The camera switch in Settings > Privacy controls, for the user signed in.
+bool CameraTurnedOff() {
+  Profile* profile = ProfileManager::GetActiveUserProfile();
+  return profile && !profile->GetPrefs()->GetBoolean(prefs::kUserCameraAllowed);
+}
+
+void Run(scoped_refptr<Answer> answer, bool accepted) {
+  // Accept and cancel close the dialog too: the first one counts.
+  if (answer->data) {
+    std::move(answer->data).Run(accepted);
+  }
+}
+
+// Ash's system dialog, with Esc for "no", as in any dialog (Ash's has no key
+// for it; its users have buttons only).
+class AccessDialog : public SystemDialogDelegateView {
+ public:
+  explicit AccessDialog(scoped_refptr<Answer> answer)
+      : answer_(std::move(answer)) {
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  }
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    if (accelerator.key_code() != ui::VKEY_ESCAPE) {
+      return SystemDialogDelegateView::AcceleratorPressed(accelerator);
+    }
+    Run(answer_, false);
+    GetWidget()->CloseWithReason(views::Widget::ClosedReason::kEscKeyPressed);
+    return true;
+  }
+
+ private:
+  scoped_refptr<Answer> answer_;
+};
+
+// ChromeOS's system dialog, over every window; `done` runs once, with
+// whether the user accepted.
+void ShowDialog(const std::u16string& title,
+                const std::u16string& description,
+                const std::u16string& accept,
+                const std::u16string& cancel,
+                const gfx::VectorIcon* icon,
+                base::OnceCallback<void(bool)> done) {
+  auto answer = base::MakeRefCounted<Answer>(std::move(done));
+  auto dialog = std::make_unique<AccessDialog>(answer);
+  dialog->SetTitleText(title);
+  dialog->SetDescription(description);
+  dialog->SetAcceptButtonText(accept);
+  dialog->SetCancelButtonText(cancel);
+  dialog->SetAcceptCallback(base::BindOnce(&Run, answer, true));
+  dialog->SetCancelCallback(base::BindOnce(&Run, answer, false));
+  dialog->SetCloseCallback(base::BindOnce(&Run, answer, false));
+  dialog->SetModalType(ui::mojom::ModalType::kSystem);
+  if (icon) {
+    dialog->SetIcon(*icon);
+  }
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.context = Shell::GetPrimaryRootWindow();
+  params.delegate = dialog.release();
+  params.name = "NickelAccess";
+  views::Widget* widget = new views::Widget();
+  widget->Init(std::move(params));
+  widget->Show();
+}
+
+}  // namespace
+
+// static
+void NickelAccess::Ask(const std::string& app_id,
+                       const std::string& app_name,
+                       const std::string& title,
+                       const std::string& body,
+                       const std::string& grant_label,
+                       const std::string& deny_label,
+                       const std::string& icon,
+                       Callback callback) {
+  const std::u16string name = DisplayName(app_name);
+  if (icon.find("camera") == std::string::npos) {
+    // Something else: the portal's own words.
+    ShowDialog(
+        base::UTF8ToUTF16(title), base::UTF8ToUTF16(body),
+        grant_label.empty()
+            ? l10n_util::GetStringUTF16(IDS_NICKEL_ACCESS_ALLOW)
+            : base::UTF8ToUTF16(grant_label),
+        deny_label.empty() ? l10n_util::GetStringUTF16(IDS_NICKEL_ACCESS_DENY)
+                           : base::UTF8ToUTF16(deny_label),
+        nullptr,
+        base::BindOnce(
+            [](Callback callback, bool allowed) {
+              std::move(callback).Run(allowed ? "allow" : "deny");
+            },
+            std::move(callback)));
+    return;
+  }
+
+  if (CameraTurnedOff()) {
+    // As ChromeOS does for its own apps: say so, and offer the switch.
+    ShowDialog(
+        l10n_util::GetStringUTF16(IDS_NICKEL_CAMERA_OFF_TITLE),
+        l10n_util::GetStringFUTF16(IDS_NICKEL_CAMERA_OFF_MESSAGE, name),
+        l10n_util::GetStringUTF16(IDS_NICKEL_CAMERA_OFF_SETTINGS),
+        l10n_util::GetStringUTF16(IDS_NICKEL_ACCESS_NOT_NOW),
+        &kPrivacyIndicatorsCameraIcon,
+        base::BindOnce(
+            [](Callback callback, bool open_settings) {
+              if (open_settings) {
+                Shell::Get()
+                    ->system_tray_model()
+                    ->client()
+                    ->ShowPrivacyHubSettings();
+              }
+              std::move(callback).Run("off");
+            },
+            std::move(callback)));
+    return;
+  }
+
+  ShowDialog(
+      l10n_util::GetStringFUTF16(IDS_NICKEL_CAMERA_ACCESS_TITLE, name),
+      l10n_util::GetStringFUTF16(IDS_NICKEL_CAMERA_ACCESS_MESSAGE, name),
+      l10n_util::GetStringUTF16(IDS_NICKEL_ACCESS_ALLOW),
+      l10n_util::GetStringUTF16(IDS_NICKEL_ACCESS_DENY),
+      &kPrivacyIndicatorsCameraIcon,
+      base::BindOnce(
+          [](Callback callback, bool allowed) {
+            std::move(callback).Run(allowed ? "allow" : "deny");
+          },
+          std::move(callback)));
+}
+
+}  // namespace ash

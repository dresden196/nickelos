+base::FilePath AmbientClientImpl::GetNickelPicturesFolder() {
+  const user_manager::User* const active_user = GetActiveUser();
+  if (!active_user ||
+      !user_manager::IsNickelLocalAccount(active_user->GetAccountId())) {
+    return base::FilePath();
+  }
+  Profile* profile = GetProfileForActiveUser();
+  if (!profile || profile->IsOffTheRecord()) {
+    return base::FilePath();
+  }
+  // My files (one home: the user's Linux home too), as file_manager::util's
+  // GetMyFilesFolderForProfile has it; nickel-user-dirs makes Pictures.
+  return profile->GetPath().Append("MyFiles").Append("Pictures");
+}

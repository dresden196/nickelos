+
+#include "ash/ambient/nickel_ambient_backend_controller.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/task/sequenced_task_runner.h"
+#include "url/gurl.h"
+
+namespace ash {
+
+namespace {
+
+// No server: nothing to download, ever.
+constexpr std::array<const char*, 2> kNoUrls = {"", ""};
+
+}  // namespace
+
+NickelAmbientBackendController::NickelAmbientBackendController() = default;
+NickelAmbientBackendController::~NickelAmbientBackendController() = default;
+
+// The callers expect an answer later, as from a server: post each one.
+
+void NickelAmbientBackendController::FetchScreenUpdateInfo(
+    int num_topics,
+    bool show_pair_personal_portraits,
+    const gfx::Size& screen_size,
+    OnScreenUpdateInfoFetchedCallback callback) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback), ScreenUpdate()));
+}
+
+void NickelAmbientBackendController::FetchPreviewImages(
+    const gfx::Size& preview_size,
+    OnPreviewImagesFetchedCallback callback) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback), std::vector<GURL>()));
+}
+
+void NickelAmbientBackendController::UpdateSettings(
+    const AmbientSettings settings,
+    UpdateSettingsCallback callback) {
+  settings_ = settings;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback), /*success=*/true,
+                                settings_));
+}
+
+void NickelAmbientBackendController::FetchSettingsAndAlbums(
+    int banner_width,
+    int banner_height,
+    int num_albums,
+    OnSettingsAndAlbumsFetchedCallback callback) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(std::move(callback),
+                     std::optional<AmbientSettings>(settings_),
+                     PersonalAlbums()));
+}
+
+void NickelAmbientBackendController::FetchWeather(
+    std::optional<std::string> weather_client_id,
+    FetchWeatherCallback callback) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(std::move(callback), std::optional<WeatherInfo>()));
+}
+
+const std::array<const char*, 2>&
+NickelAmbientBackendController::GetBackupPhotoUrls() const {
+  return kNoUrls;
+}
+
+std::array<const char*, 2>
+NickelAmbientBackendController::GetTimeOfDayVideoPreviewImageUrls(
+    AmbientVideo video) const {
+  return kNoUrls;
+}
+
+const char* NickelAmbientBackendController::GetPromoBannerUrl() const {
+  return "";
+}
+
+const char* NickelAmbientBackendController::GetTimeOfDayProductName() const {
+  return "";
+}
+
+}  // namespace ash

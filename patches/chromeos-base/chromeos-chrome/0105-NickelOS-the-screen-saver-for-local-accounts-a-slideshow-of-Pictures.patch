+// NickelOS: a folder's pictures (CreateForFolder). At most this many a
+// screen saver, a random choice of them when the folder has more; bigger
+// files are left out (the decoder is handed the whole file).
+constexpr size_t kMaxFolderImages = 500;
+constexpr int64_t kMaxFolderImageBytes = 64 * 1024 * 1024;
+// Entries looked at, at most (a disk's worth of files linked in by hand).
+constexpr size_t kMaxFolderEntries = 100000;
+// With too few pictures for a screen saver, it is not started: look again
+// this often, so the first pictures put there turn it on.
+constexpr base::TimeDelta kFolderRetryInterval = base::Minutes(1);
+
+bool IsFolderImage(const base::FilePath& path) {
+  const std::string extension = base::ToLowerASCII(path.Extension());
+  for (const char* image : {".jpg", ".jpeg", ".png", ".webp", ".gif",
+                            ".bmp"}) {
+    if (extension == image) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The pictures in |folder| and its folders as Files shows them: hidden files
+// and folders left out, links not followed.
+std::vector<base::FilePath> FindImagesInFolder(const base::FilePath& folder) {
+  std::vector<base::FilePath> images;
+  std::vector<base::FilePath> folders = {folder};
+  size_t entries = 0;
+  while (!folders.empty() && entries < kMaxFolderEntries) {
+    const base::FilePath dir = folders.back();
+    folders.pop_back();
+    base::FileEnumerator enumerator(
+        dir, /*recursive=*/false,
+        base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES |
+            base::FileEnumerator::SHOW_SYM_LINKS);
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      if (++entries >= kMaxFolderEntries) {
+        break;
+      }
+      if (path.BaseName().value().starts_with('.')) {
+        continue;
+      }
+      const base::FileEnumerator::FileInfo info = enumerator.GetInfo();
+      if (S_ISLNK(info.stat().st_mode)) {
+        continue;
+      }
+      if (info.IsDirectory()) {
+        folders.push_back(path);
+      } else if (IsFolderImage(path) && info.GetSize() > 0 &&
+                 info.GetSize() <= kMaxFolderImageBytes) {
+        images.push_back(path);
+      }
+    }
+  }
+  base::RandomShuffle(images.begin(), images.end());
+  if (images.size() > kMaxFolderImages) {
+    images.resize(kMaxFolderImages);
+  }
+  return images;
+}
+
 }  // namespace
 
+// static
+std::unique_ptr<ScreensaverImagesPolicyHandler>
+ScreensaverImagesPolicyHandler::CreateForFolder(const base::FilePath& folder) {
+  return std::make_unique<ScreensaverImagesPolicyHandler>(folder);
+}
+
+ScreensaverImagesPolicyHandler::ScreensaverImagesPolicyHandler(
+    const base::FilePath& folder)
+    : folder_(folder) {
+  CHECK(!folder_.empty());
+  FindFolderImages();
+}
+
+void ScreensaverImagesPolicyHandler::FindFolderImages() {
+  if (finding_folder_images_) {
+    return;
+  }
+  finding_folder_images_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&FindImagesInFolder, folder_),
+      base::BindOnce(&ScreensaverImagesPolicyHandler::OnFolderImagesFound,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ScreensaverImagesPolicyHandler::OnFolderImagesFound(
+    std::vector<base::FilePath> images) {
+  finding_folder_images_ = false;
+  // The new list is for the next screen saver (GetScreensaverImages), not
+  // the one showing: it would start over. Unless the last list had too few
+  // pictures to show at all, when it is what makes one possible.
+  const bool too_few = folder_images_.size() < 2;
+  folder_images_ = std::move(images);
+  if (too_few && on_images_updated_callback_) {
+    on_images_updated_callback_.Run(folder_images_);
+  }
+  if (folder_images_.size() < 2) {
+    folder_retry_timer_.Start(
+        FROM_HERE, kFolderRetryInterval,
+        base::BindOnce(&ScreensaverImagesPolicyHandler::FindFolderImages,
+                       base::Unretained(this)));
+  }
+}
+
 // static
 std::unique_ptr<ScreensaverImagesPolicyHandler>
 ScreensaverImagesPolicyHandler::Create(PrefService* pref_service) {
@@ -170,6 +290,10 @@ void ScreensaverImagesPolicyHandler::SetImagesForTesting(
 
 std::vector<base::FilePath>

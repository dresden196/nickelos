 function isVolumeSlowToScan(volume?: Volume|VolumeInfo|null): boolean {
+  // NickelOS: not cloud storage accounts (NICKEL_CLOUD), though they are
+  // network volumes: rclone keeps their listings, so their folders are
+  // scanned as local ones are, and only folders with folders in them get an

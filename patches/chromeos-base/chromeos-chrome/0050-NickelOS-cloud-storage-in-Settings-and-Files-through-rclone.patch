@@ -0,0 +1,64 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_FILES_NICKEL_CLOUD_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_FILES_NICKEL_CLOUD_HANDLER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ash/file_manager/nickel_cloud_client.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+namespace ash::settings {
+
+// NickelOS: Settings > System preferences > Files > Cloud storage. The
+// user's cloud storage accounts (Google Drive, OneDrive, Dropbox, Proton
+// Drive, S3, WebDAV/Nextcloud...), which nickel-cloud keeps through rclone
+// and Files shows as drives: the page lists them, adds them (rclone's
+// configuration, one question at a time, sign-ins in the browser) and
+// removes them, through file_manager::NickelCloudClient.
+class NickelCloudHandler : public ::settings::SettingsPageUIHandler,
+                           public file_manager::NickelCloudClient::Observer {
+ public:
+  NickelCloudHandler();
+  NickelCloudHandler(const NickelCloudHandler&) = delete;
+  NickelCloudHandler& operator=(const NickelCloudHandler&) = delete;
+  ~NickelCloudHandler() override;
+
+  // ::settings::SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // file_manager::NickelCloudClient::Observer:
+  void OnNickelCloudChanged() override;
+
+ private:
+  // nickelCloudGetState(callback_id): nickel-cloud's state.
+  void HandleGetState(const base::ListValue& args);
+  // nickelCloudAdd(callback_id, name, type, parameters JSON).
+  void HandleAdd(const base::ListValue& args);
+  // nickelCloudContinue(callback_id, name, state, answer).
+  void HandleContinue(const base::ListValue& args);
+  // nickelCloudCancel(name).
+  void HandleCancel(const base::ListValue& args);
+  // nickelCloudRemove(callback_id, name).
+  void HandleRemove(const base::ListValue& args);
+
+  // Resolves the page's promise with nickel-cloud's answer, or with
+  // {"error": ...}.
+  void Resolve(const std::string& callback_id,
+               std::optional<base::Value> reply,
+               const std::string& error);
+
+  bool observing_ = false;
+  base::WeakPtrFactory<NickelCloudHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace ash::settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_SETTINGS_PAGES_FILES_NICKEL_CLOUD_HANDLER_H_

+#include "base/observer_list_types.h"
+#include "base/values.h"
+
+namespace dbus {
+class Bus;
+class ErrorResponse;
+class ObjectProxy;
+class Response;
+class Signal;
+}  // namespace dbus
+
+namespace file_manager {
+
+// NickelOS: talks to nickel-cloud (org.nickelos.Cloud on the session's
+// D-Bus), the session service that runs rclone for the user's cloud storage
+// accounts. Files shows its mounts as volumes (VolumeManager); Settings adds
+// and removes accounts through it. One per browser process, used on the UI
+// thread. Chrome can start before the session's bus does (it starts again as
+// the session's user while the session comes up): the connection is tried
+// again until it works.
+class NickelCloudClient {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // nickel-cloud's accounts or mounts changed, or nickel-cloud (or the
+    // connection to it) came up: its state is worth reading again.
+    virtual void OnNickelCloudChanged() = 0;
+  };
+
+  // nickel-cloud's JSON answer, parsed, or std::nullopt and why not.
+  using Callback = base::OnceCallback<void(std::optional<base::Value> reply,
+                                           const std::string& error)>;
+
+  static NickelCloudClient* Get();
+
+  NickelCloudClient(const NickelCloudClient&) = delete;
+  NickelCloudClient& operator=(const NickelCloudClient&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // nickel-cloud's methods (see chromeos-base/nickel-cloud in
+  // overlay-nickel). Add and Continue can take minutes: a first account
+  // downloads rclone, and a sign-in waits for the browser.
+  void GetState(Callback callback);
+  void Add(const std::string& name,
+           const std::string& type,
+           const std::string& parameters_json,
+           Callback callback);
+  void Continue(const std::string& name,
+                const std::string& state,
+                const std::string& answer,
+                Callback callback);
+  void Cancel(const std::string& name);
+  void Remove(const std::string& name, Callback callback);
+
+ private:
+  friend class base::NoDestructor<NickelCloudClient>;
+
+  NickelCloudClient();
+  ~NickelCloudClient();
+
+  void Connect();
+  void OnConnected(bool connected);
+  void Call(const std::string& method,
+            const std::vector<std::string>& arguments,
+            int timeout_ms,
+            bool expect_reply,
+            Callback callback);
+  void OnResponse(bool expect_reply,
+                  Callback callback,
+                  dbus::Response* response,
+                  dbus::ErrorResponse* error);
+  void OnChangedSignal(dbus::Signal* signal);
+  void OnNameOwnerChanged(const std::string& old_owner,
+                          const std::string& new_owner);
+  void NotifyChanged();
+
+  scoped_refptr<dbus::Bus> bus_;
+  raw_ptr<dbus::ObjectProxy> proxy_ = nullptr;
+  bool connecting_ = false;
+  int connect_tries_ = 0;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<NickelCloudClient> weak_ptr_factory_{this};
+};
+
+}  // namespace file_manager
+
+#endif  // CHROME_BROWSER_ASH_FILE_MANAGER_NICKEL_CLOUD_CLIENT_H_

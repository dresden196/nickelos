+
+void VolumeManager::RefreshNickelCloud() {
+  NickelCloudClient::Get()->GetState(
+      base::BindOnce(&VolumeManager::OnNickelCloudState,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+// nickel-cloud's state: {"accounts": [{"name", "mounted", "mountPath"}...]}.
+// A mounted account is a volume; an account gone or not mounted is not. No
+// answer (nickel-cloud stopped, and its mounts went with it) is no accounts.
+void VolumeManager::OnNickelCloudState(std::optional<base::Value> reply,
+                                       const std::string& error) {
+  std::map<base::FilePath, std::string> mounted;
+  const base::ListValue* accounts =
+      reply && reply->is_dict() ? reply->GetDict().FindList("accounts")
+                                : nullptr;
+  if (accounts) {
+    for (const base::Value& account : *accounts) {
+      if (!account.is_dict()) {
+        continue;
+      }
+      const base::DictValue& fields = account.GetDict();
+      const std::string* name = fields.FindString("name");
+      const std::string* path = fields.FindString("mountPath");
+      if (name && path && fields.FindBool("mounted").value_or(false)) {
+        mounted[base::FilePath(*path)] = *name;
+      }
+    }
+  }
+  storage::ExternalMountPoints* const mount_points =
+      storage::ExternalMountPoints::GetSystemInstance();
+  for (auto it = nickel_cloud_volumes_.begin();
+       it != nickel_cloud_volumes_.end();) {
+    if (mounted.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    DoUnmountEvent(*Volume::CreateForNickelCloud(it->first, std::string()));
+    mount_points->RevokeFileSystem(it->second);
+    it = nickel_cloud_volumes_.erase(it);
+  }
+  for (const auto& [path, name] : mounted) {
+    if (nickel_cloud_volumes_.contains(path)) {
+      continue;
+    }
+    const std::string mount_name =
+        "nickel-cloud-" +
+        base::HexEncode(crypto::SHA256HashString(path.value())).substr(0, 16);
+    if (!mount_points->RegisterFileSystem(
+            mount_name, storage::kFileSystemTypeLocal,
+            storage::FileSystemMountOption(), path)) {
+      LOG(ERROR) << "NickelOS: cannot register cloud storage at " << path;
+      continue;
+    }
+    nickel_cloud_volumes_[path] = mount_name;
+    DoMountEvent(Volume::CreateForNickelCloud(path, name));
+  }
+}

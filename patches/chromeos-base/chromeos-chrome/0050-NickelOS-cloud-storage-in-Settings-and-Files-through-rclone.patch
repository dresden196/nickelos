+std::unique_ptr<Volume> Volume::CreateForNickelCloud(base::FilePath mount_path,
+                                                     std::string display_name) {
+  std::unique_ptr<Volume> volume(new Volume());
+  volume->type_ = VOLUME_TYPE_NICKEL_CLOUD;
+  // Keep source_path empty.
+  volume->source_ = SOURCE_NETWORK;
+  volume->mount_path_ = std::move(mount_path);
+  volume->volume_id_ = GenerateVolumeId(*volume);
+  volume->volume_label_ = std::move(display_name);
+  // A FUSE mount of a remote: no inotify for changes made elsewhere.
+  volume->watchable_ = false;
+  volume->is_read_only_ = false;
+  return volume;
+}

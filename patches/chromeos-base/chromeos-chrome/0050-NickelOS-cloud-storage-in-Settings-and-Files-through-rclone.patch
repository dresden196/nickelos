new file mode 100644
index 0000000000000..bb3437af40e78
--- /dev/null
+++ b/chrome/browser/ash/file_manager/nickel_cloud_client.cc
@@ -0,0 +1,224 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/file_manager/nickel_cloud_client.h"
+
+#include <unistd.h>
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/strings/stringprintf.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/threading/thread.h"
+#include "base/time/time.h"
+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_path.h"
+#include "dbus/object_proxy.h"
+
+namespace file_manager {
+
+namespace {
+
+constexpr char kService[] = "org.nickelos.Cloud";
+constexpr char kPath[] = "/org/nickelos/Cloud";
+constexpr char kInterface[] = "org.nickelos.Cloud";
+
+// How long and how often the session's bus is waited for.
+constexpr int kMaxConnectTries = 60;
+constexpr base::TimeDelta kConnectRetry = base::Seconds(5);
+
+// The D-Bus thread, for as long as Chrome runs.
+base::Thread* DBusThread() {
+  static base::NoDestructor<base::Thread> thread("NickelCloudDBus");
+  if (!thread->IsRunning()) {
+    CHECK(thread->StartWithOptions(
+        base::Thread::Options(base::MessagePumpType::IO, 0)));
+  }
+  return thread.get();
+}
+
+}  // namespace
+
+// static
+NickelCloudClient* NickelCloudClient::Get() {
+  static base::NoDestructor<NickelCloudClient> client;
+  return client.get();
+}
+
+NickelCloudClient::NickelCloudClient() {
+  Connect();
+}
+
+NickelCloudClient::~NickelCloudClient() = default;
+
+void NickelCloudClient::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void NickelCloudClient::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+// The session's D-Bus: nickel-session's, at /run/user/<uid>/bus (Chrome runs
+// as the session's user). A private connection on its own thread.
+void NickelCloudClient::Connect() {
+  if (connecting_ || proxy_) {
+    return;
+  }
+  connecting_ = true;
+  dbus::Bus::Options options;
+  options.bus_type = dbus::Bus::CUSTOM_ADDRESS;
+  options.address = base::StringPrintf("unix:path=/run/user/%u/bus",
+                                       static_cast<unsigned>(getuid()));
+  options.connection_type = dbus::Bus::PRIVATE;
+  options.dbus_task_runner = DBusThread()->task_runner();
+  bus_ = base::MakeRefCounted<dbus::Bus>(std::move(options));
+  bus_->GetDBusTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce([](scoped_refptr<dbus::Bus> bus) { return bus->Connect(); },
+                     bus_),
+      base::BindOnce(&NickelCloudClient::OnConnected,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void NickelCloudClient::OnConnected(bool connected) {
+  connecting_ = false;
+  if (!connected) {
+    // No session bus yet: a new connection a little later.
+    bus_->GetDBusTaskRunner()->PostTask(
+        FROM_HERE, base::BindOnce(&dbus::Bus::ShutdownAndBlock, bus_));
+    bus_ = nullptr;
+    if (++connect_tries_ < kMaxConnectTries) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&NickelCloudClient::Connect,
+                         weak_ptr_factory_.GetWeakPtr()),
+          kConnectRetry);
+    } else {
+      LOG(ERROR) << "NickelOS: no session bus for cloud storage";
+    }
+    return;
+  }
+  proxy_ = bus_->GetObjectProxy(kService, dbus::ObjectPath(kPath));
+  proxy_->ConnectToSignal(kInterface, "Changed",
+                          base::BindRepeating(&NickelCloudClient::OnChangedSignal,
+                                              weak_ptr_factory_.GetWeakPtr()),
+                          base::DoNothing());
+  proxy_->SetNameOwnerChangedCallback(
+      base::BindRepeating(&NickelCloudClient::OnNameOwnerChanged,
+                          weak_ptr_factory_.GetWeakPtr()));
+  NotifyChanged();
+}
+
+void NickelCloudClient::GetState(Callback callback) {
+  Call("GetState", {}, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT, true,
+       std::move(callback));
+}
+
+void NickelCloudClient::Add(const std::string& name,
+                            const std::string& type,
+                            const std::string& parameters_json,
+                            Callback callback) {
+  Call("Add", {name, type, parameters_json}, dbus::ObjectProxy::TIMEOUT_MAX,
+       true, std::move(callback));
+}
+
+void NickelCloudClient::Continue(const std::string& name,
+                                 const std::string& state,
+                                 const std::string& answer,
+                                 Callback callback) {
+  Call("Continue", {name, state, answer}, dbus::ObjectProxy::TIMEOUT_MAX,
+       true, std::move(callback));
+}
+
+void NickelCloudClient::Cancel(const std::string& name) {
+  Call("Cancel", {name}, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT, false,
+       base::DoNothing());
+}
+
+void NickelCloudClient::Remove(const std::string& name, Callback callback) {
+  Call("Remove", {name}, 60 * 1000, false, std::move(callback));
+}
+
+void NickelCloudClient::Call(const std::string& method,
+                             const std::vector<std::string>& arguments,
+                             int timeout_ms,
+                             bool expect_reply,
+                             Callback callback) {
+  if (!proxy_) {
+    Connect();
+    std::move(callback).Run(std::nullopt,
+                            "Cloud storage isn't running yet. Try again soon.");
+    return;
+  }
+  dbus::MethodCall call(kInterface, method);
+  dbus::MessageWriter writer(&call);
+  for (const std::string& argument : arguments) {
+    writer.AppendString(argument);
+  }
+  proxy_->CallMethodWithErrorResponse(
+      &call, timeout_ms,
+      base::BindOnce(&NickelCloudClient::OnResponse,
+                     weak_ptr_factory_.GetWeakPtr(), expect_reply,
+                     std::move(callback)));
+}
+
+void NickelCloudClient::OnResponse(bool expect_reply,
+                                   Callback callback,
+                                   dbus::Response* response,
+                                   dbus::ErrorResponse* error) {
+  if (!response) {
+    std::string message = "Cloud storage didn't answer";
+    if (error) {
+      dbus::MessageReader reader(error);
+      std::string text;
+      if (reader.PopString(&text) && !text.empty()) {
+        message = text;
+      }
+    }
+    std::move(callback).Run(std::nullopt, message);
+    return;
+  }
+  if (!expect_reply) {
+    std::move(callback).Run(base::Value(), std::string());
+    return;
+  }
+  dbus::MessageReader reader(response);
+  std::string json;
+  if (!reader.PopString(&json)) {
+    std::move(callback).Run(std::nullopt, "Cloud storage answered wrongly");
+    return;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value) {
+    std::move(callback).Run(std::nullopt, "Cloud storage answered wrongly");
+    return;
+  }
+  std::move(callback).Run(std::move(value), std::string());
+}
+
+void NickelCloudClient::OnChangedSignal(dbus::Signal*) {
+  NotifyChanged();
+}
+
+void NickelCloudClient::OnNameOwnerChanged(const std::string&,
+                                           const std::string& new_owner) {
+  // nickel-cloud started (again), or stopped: its state is new either way.
+  NotifyChanged();
+}
+
+void NickelCloudClient::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnNickelCloudChanged();
+  }
+}
+
+}  // namespace file_manager

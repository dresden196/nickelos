+#ifndef CHROME_BROWSER_ASH_FILE_MANAGER_NICKEL_CLOUD_CLIENT_H_
+#define CHROME_BROWSER_ASH_FILE_MANAGER_NICKEL_CLOUD_CLIENT_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"

diff --git a/chrome/browser/ui/webui/ash/settings/pages/files/nickel_cloud_handler.cc b/chrome/browser/ui/webui/ash/settings/pages/files/nickel_cloud_handler.cc
new file mode 100644
index 0000000000000..969c79632fb8a
--- /dev/null
+++ b/chrome/browser/ui/webui/ash/settings/pages/files/nickel_cloud_handler.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The NickelOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/settings/pages/files/nickel_cloud_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "content/public/browser/web_ui.h"
+
+namespace ash::settings {
+
+namespace {
+
+file_manager::NickelCloudClient* Client() {
+  return file_manager::NickelCloudClient::Get();
+}
+
+// The string at `index` of a message's arguments, or "".
+std::string StringArg(const base::ListValue& args, size_t index) {
+  if (index < args.size() && args[index].is_string()) {
+    return args[index].GetString();
+  }
+  return std::string();
+}
+
+}  // namespace
+
+NickelCloudHandler::NickelCloudHandler() = default;
+
+NickelCloudHandler::~NickelCloudHandler() {
+  if (observing_) {
+    Client()->RemoveObserver(this);
+  }
+}
+
+void NickelCloudHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "nickelCloudGetState",
+      base::BindRepeating(&NickelCloudHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelCloudAdd", base::BindRepeating(&NickelCloudHandler::HandleAdd,
+                                            base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelCloudContinue",
+      base::BindRepeating(&NickelCloudHandler::HandleContinue,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelCloudCancel", base::BindRepeating(&NickelCloudHandler::HandleCancel,
+                                               base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "nickelCloudRemove", base::BindRepeating(&NickelCloudHandler::HandleRemove,
+                                               base::Unretained(this)));
+}
+
+void NickelCloudHandler::OnJavascriptAllowed() {
+  if (!observing_) {
+    Client()->AddObserver(this);
+    observing_ = true;
+  }
+}
+
+void NickelCloudHandler::OnJavascriptDisallowed() {
+  if (observing_) {
+    Client()->RemoveObserver(this);
+    observing_ = false;
+  }
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void NickelCloudHandler::OnNickelCloudChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("nickel-cloud-changed");
+  }
+}
+
+void NickelCloudHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  Client()->GetState(base::BindOnce(&NickelCloudHandler::Resolve,
+                                    weak_ptr_factory_.GetWeakPtr(),
+                                    StringArg(args, 0)));
+}
+
+void NickelCloudHandler::HandleAdd(const base::ListValue& args) {
+  AllowJavascript();
+  Client()->Add(StringArg(args, 1), StringArg(args, 2), StringArg(args, 3),
+                base::BindOnce(&NickelCloudHandler::Resolve,
+                               weak_ptr_factory_.GetWeakPtr(),
+                               StringArg(args, 0)));
+}
+
+void NickelCloudHandler::HandleContinue(const base::ListValue& args) {
+  AllowJavascript();
+  Client()->Continue(StringArg(args, 1), StringArg(args, 2), StringArg(args, 3),
+                     base::BindOnce(&NickelCloudHandler::Resolve,
+                                    weak_ptr_factory_.GetWeakPtr(),
+                                    StringArg(args, 0)));
+}
+
+void NickelCloudHandler::HandleCancel(const base::ListValue& args) {
+  Client()->Cancel(StringArg(args, 0));
+}
+
+void NickelCloudHandler::HandleRemove(const base::ListValue& args) {
+  AllowJavascript();
+  Client()->Remove(StringArg(args, 1),
+                   base::BindOnce(&NickelCloudHandler::Resolve,
+                                  weak_ptr_factory_.GetWeakPtr(),
+                                  StringArg(args, 0)));
+}
+
+void NickelCloudHandler::Resolve(const std::string& callback_id,
+                                 std::optional<base::Value> reply,
+                                 const std::string& error) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!reply || reply->is_none()) {
+    base::DictValue failed;
+    if (!error.empty()) {
+      failed.Set("error", error);
+    }
+    ResolveJavascriptCallback(base::Value(callback_id), failed);
+    return;
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), *reply);
+}
+
+}  // namespace ash::settings

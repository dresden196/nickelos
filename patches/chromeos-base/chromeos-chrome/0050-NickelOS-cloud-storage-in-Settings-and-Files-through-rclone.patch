+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './nickel_cloud_dialog.html.js';
+
+/** A field the user fills for a service: an rclone option. */
+interface CloudField {
+  key: string;
+  label: string;
+  inputType: string;
+  required: boolean;
+  placeholder: string;
+}
+
+/** A cloud service, an rclone backend. */
+interface CloudService {
+  type: string;
+  label: string;
+  // Sign-in through the browser (OAuth).
+  oauth: boolean;
+  fields: CloudField[];
+}
+
+/** One of rclone's questions (its config Option). */
+interface RcloneQuestion {
+  Name: string;
+  Help: string;
+  DefaultStr?: string;
+  Examples?: Array<{Value: string, Help: string}>;
+  Exclusive?: boolean;
+  IsPassword?: boolean;
+}
+
+/** nickel-cloud's answer to Add and Continue. */
+interface CloudResult {
+  done?: boolean;
+  state?: string;
+  error?: string;
+  option?: RcloneQuestion;
+}
+
+type Step = 'choose'|'working'|'question'|'signin'|'done'|'error';
+
+const NickelCloudDialogElementBase = I18nMixin(PolymerElement);
+
+class NickelCloudDialogElement extends NickelCloudDialogElementBase {
+  static get is() {
+    return 'nickel-cloud-dialog';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      /** The accounts' names, which a new one must not take. */
+      existingNames: {type: Array, value: () => []},
+      services_: {type: Array},
+      selectedType_: String,
+      name_: String,
+      values_: {type: Object, value: () => ({})},
+      step_: {type: String, value: 'choose'},
+      question_: Object,
+      questionState_: String,
+      questionError_: String,
+      answer_: String,
+      error_: String,
+      doneText_: String,
+    };
+  }
+
+  declare existingNames: string[];
+  declare private services_: CloudService[];
+  declare private selectedType_: string;
+  declare private name_: string;
+  declare private values_: Record<string, string>;
+  declare private step_: Step;
+  declare private question_: RcloneQuestion|null;
+  declare private questionState_: string;
+  declare private questionError_: string;
+  declare private answer_: string;
+  declare private error_: string;
+  declare private doneText_: string;
+  // The name nickel-cloud is adding, once Add was sent.
+  private adding_ = '';
+
+  override connectedCallback(): void {
+    super.connectedCallback();
+    const field = (key: string, label: string, inputType = 'text',
+                   required = false, placeholder = ''): CloudField =>
+        ({key, label, inputType, required, placeholder});
+    this.services_ = [
+      {
+        type: 'drive',
+        label: 'Google Drive',
+        oauth: true,
+        fields: [
+          field('client_id', this.i18n('nickelCloudClientId'), 'text', true),
+          field(
+              'client_secret', this.i18n('nickelCloudClientSecret'),
+              'password', true),
+        ],
+      },
+      {type: 'onedrive', label: 'OneDrive', oauth: true, fields: []},
+      {type: 'dropbox', label: 'Dropbox', oauth: true, fields: []},
+      {
+        type: 'protondrive',
+        label: 'Proton Drive',
+        oauth: false,
+        fields: [
+          field('username', this.i18n('nickelCloudEmail'), 'text', true),
+          field('password', this.i18n('nickelCloudPassword'), 'password', true),
+          field('2fa', this.i18n('nickelCloudTwoFactor')),
+        ],
+      },
+      {
+        type: 'webdav',
+        label: this.i18n('nickelCloudWebdav'),
+        oauth: false,
+        fields: [
+          field(
+              'url', this.i18n('nickelCloudServer'), 'url', true,
+              'https://cloud.example.com/remote.php/dav/files/you'),
+          field('user', this.i18n('nickelCloudUsername')),
+          field('pass', this.i18n('nickelCloudPassword'), 'password'),
+        ],
+      },
+      {
+        type: 's3',
+        label: this.i18n('nickelCloudS3'),
+        oauth: false,
+        fields: [
+          field('endpoint', this.i18n('nickelCloudEndpoint')),
+          field('access_key_id', this.i18n('nickelCloudAccessKey'), 'text',
+                true),
+          field(
+              'secret_access_key', this.i18n('nickelCloudSecretKey'),
+              'password', true),
+          field('region', this.i18n('nickelCloudRegion')),
+        ],
+      },
+      {type: 'box', label: 'Box', oauth: true, fields: []},
+      {type: 'pcloud', label: 'pCloud', oauth: true, fields: []},
+    ];
+    this.selectService_(this.services_[0].type);
+  }
+
+  private service_(type: string): CloudService|undefined {
+    return this.services_.find(service => service.type === type);
+  }
+
+  private selectService_(type: string): void {
+    this.selectedType_ = type;
+    this.values_ = {};
+    // A name not taken yet: "Dropbox", "Dropbox 2"...
+    const label = this.service_(type)!.label;
+    let name = label;
+    for (let i = 2; this.existingNames.includes(name); i++) {
+      name = `${label} ${i}`;
+    }
+    this.name_ = name;
+  }
+
+  private onServiceChange_(e: Event): void {
+    this.selectService_((e.target as HTMLSelectElement).value);
+  }
+
+  private onFieldChanged_(e: CustomEvent<{value: string}>): void {
+    const key = (e.target as HTMLElement).dataset['key'];
+    if (key) {
+      this.values_ = {...this.values_, [key]: e.detail.value};
+    }
+  }
+
+  private fieldsFor_(type: string): CloudField[] {
+    return this.service_(type)?.fields || [];
+  }
+
+  private valueOf_(key: string): string {
+    return this.values_[key] || '';
+  }
+
+  private isSelected_(value: string, selected: string): boolean {
+    return value === selected;
+  }
+
+  private isStep_(step: Step, wanted: Step): boolean {
+    return step === wanted;
+  }
+
+  private isDrive_(type: string): boolean {
+    return type === 'drive';
+  }
+
+  private isOAuth_(type: string): boolean {
+    return !!this.service_(type)?.oauth;
+  }
+
+  private nameError_(name: string): string {
+    const trimmed = (name || '').trim();
+    if (!trimmed || /[:/\\]/.test(trimmed) || trimmed.startsWith('-') ||
+        this.existingNames.includes(trimmed)) {
+      return 'invalid';
+    }
+    return '';
+  }
+
+  private canConnect_(type: string, name: string): boolean {
+    if (this.nameError_(name)) {
+      return false;
+    }
+    return this.fieldsFor_(type).every(
+        field => !field.required || !!(this.values_[field.key] || '').trim());
+  }
+
+  // rclone's options for the service, from what the user filled.
+  private parameters_(): Record<string, string> {
+    const parameters: Record<string, string> = {};
+    for (const [key, value] of Object.entries(this.values_)) {
+      if (value.trim()) {
+        parameters[key] = value.trim();
+      }
+    }
+    switch (this.selectedType_) {
+      case 'drive':
+        parameters['scope'] = 'drive';
+        break;
+      case 'webdav':
+        parameters['vendor'] =
+            (parameters['url'] || '').includes('remote.php') ? 'nextcloud' :
+                                                                'other';
+        break;
+      case 's3':
+        parameters['provider'] = parameters['endpoint'] ? 'Other' : 'AWS';
+        parameters['env_auth'] = 'false';
+        break;
+    }
+    return parameters;
+  }
+
+  private async onConnectClick_(): Promise<void> {
+    if (!this.canConnect_(this.selectedType_, this.name_)) {
+      return;
+    }
+    this.adding_ = this.name_.trim();
+    this.step_ = 'working';
+    const result = await sendWithPromise(
+        'nickelCloudAdd', this.adding_, this.selectedType_,
+        JSON.stringify(this.parameters_()));
+    this.onResult_(result as CloudResult);
+  }
+
+  private async continue_(answer: string): Promise<void> {
+    const result = await sendWithPromise(
+        'nickelCloudContinue', this.adding_, this.questionState_, answer);
+    this.onResult_(result as CloudResult);
+  }
+
+  private onResult_(result: CloudResult): void {
+    if (!this.adding_) {
+      return;  // cancelled meanwhile
+    }
+    if (result.done) {
+      this.doneText_ = this.i18n('nickelCloudDone', this.adding_);
+      this.adding_ = '';
+      this.step_ = 'done';
+      this.dispatchEvent(new CustomEvent(
+          'nickel-cloud-added', {bubbles: true, composed: true}));
+      return;
+    }
+    if (!result.state) {
+      // nickel-cloud ended the attempt (and removed what rclone half-made).
+      this.error_ = result.error || this.i18n('nickelCloudFailed');
+      this.adding_ = '';
+      this.step_ = 'error';
+      return;
+    }
+    this.questionState_ = result.state;
+    const question = result.option || null;
+    // A browser sign-in: always through this device's browser.
+    if (question && question.Name === 'config_is_local') {
+      this.step_ = 'signin';
+      this.continue_('true');
+      return;
+    }
+    this.question_ = question;
+    this.questionError_ = result.error || '';
+    const examples = question?.Examples || [];
+    this.answer_ = question?.DefaultStr ||
+        (examples.length ? examples[0].Value : '');
+    this.step_ = 'question';
+  }
+
+  private hasExamples_(question: RcloneQuestion|null): boolean {
+    return !!question?.Examples?.length;
+  }
+
+  private exampleLabel_(example: {Value: string, Help: string}): string {
+    // rclone's help can be several lines; its first says what it is.
+    const help = (example.Help || '').split('\n')[0];
+    return help ? help : example.Value;
+  }
+
+  private answerInputType_(question: RcloneQuestion|null): string {
+    return question?.IsPassword ? 'password' : 'text';
+  }
+
+  private onAnswerSelect_(e: Event): void {
+    this.answer_ = (e.target as HTMLSelectElement).value;
+  }
+
+  private onNextClick_(): void {
+    this.step_ = 'working';
+    this.continue_(this.answer_ || '');
+  }
+
+  private onBackClick_(): void {
+    this.error_ = '';
+    this.step_ = 'choose';
+  }
+
+  private cancelAdding_(): void {
+    if (this.adding_) {
+      chrome.send('nickelCloudCancel', [this.adding_]);
+      this.adding_ = '';
+    }
+  }
+
+  private onCancelClick_(): void {
+    this.cancelAdding_();
+    this.shadowRoot!.querySelector<CrDialogElement>('#dialog')!.close();
+  }
+
+  private onDialogCancel_(): void {
+    this.cancelAdding_();
+  }
+
+  private onDoneClick_(): void {
+    this.shadowRoot!.querySelector<CrDialogElement>('#dialog')!.close();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    [NickelCloudDialogElement.is]: NickelCloudDialogElement;
+  }
+}
+
+customElements.define(NickelCloudDialogElement.is, NickelCloudDialogElement);

+#ifndef CHROME_BROWSER_ASH_DBUS_VM_NICKEL_DESKTOP_TOOLS_H_
+#define CHROME_BROWSER_ASH_DBUS_VM_NICKEL_DESKTOP_TOOLS_H_
+
+#include <optional>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace ash {
+
+// NickelOS: what Linux apps ask ChromeOS for through two of their portals,
+// for the NickelOS portal backend (xdg-desktop-portal-nickel), through
+// VmApplicationsService.
+class NickelDesktopTools {
+ public:
+  // The Screenshot portal's PickColor: ChromeOS's eyedropper (the one web
+  // pages' colour inputs use) on the screen the pointer is on, over
+  // everything, Linux apps included. Answers with the colour the user
+  // clicks, or nothing if they press Esc, or if a pick is already open.
+  using PickColorCallback =
+      base::OnceCallback<void(std::optional<SkColor> color)>;
+  static void PickColor(PickColorCallback callback);
+
+  // The Wallpaper portal: the picture at `path` becomes the signed-in user's
+  // wallpaper, filling the screen, as Wallpaper & style's "My images" sets
+  // one (Ash keeps its own copy); an empty path brings back NickelOS's
+  // default wallpaper. Answers whether it did.
+  static void SetWallpaper(const base::FilePath& path,
+                           base::OnceCallback<void(bool done)> callback);
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_DBUS_VM_NICKEL_DESKTOP_TOOLS_H_

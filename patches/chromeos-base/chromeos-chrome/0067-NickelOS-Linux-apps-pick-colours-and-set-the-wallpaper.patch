+
+#include "chrome/browser/ash/dbus/vm/nickel_desktop_tools.h"
+
+#include <memory>
+#include <utility>
+
+#include "ash/public/cpp/shell_window_ids.h"
+#include "ash/public/cpp/wallpaper/wallpaper_controller.h"
+#include "ash/public/cpp/wallpaper/wallpaper_types.h"
+#include "ash/shell.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/eye_dropper/eye_dropper_view.h"
+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
+#include "content/public/browser/eye_dropper_listener.h"
+#include "ui/aura/window.h"
+
+namespace ash {
+
+namespace {
+
+// One colour pick: the eyedropper and who asked.
+class ColorPick : public content::EyeDropperListener {
+ public:
+  explicit ColorPick(NickelDesktopTools::PickColorCallback callback)
+      : callback_(std::move(callback)) {}
+
+  ColorPick(const ColorPick&) = delete;
+  ColorPick& operator=(const ColorPick&) = delete;
+
+  ~ColorPick() override = default;
+
+  void Show() {
+    // As for a web page's eyedropper on ChromeOS: in the menu container,
+    // so it can move between displays; all events go through it, by way of
+    // the root window.
+    aura::Window* root = Shell::GetRootWindowForNewWindows();
+    view_ = std::make_unique<eye_dropper::EyeDropperView>(
+        root->GetChildById(kShellWindowId_MenuContainer), root, this);
+  }
+
+  void Answer(std::optional<SkColor> color) {
+    std::move(callback_).Run(color);
+  }
+
+  // content::EyeDropperListener:
+  void ColorSelected(SkColor color) override { Done(color); }
+  void ColorSelectionCanceled() override { Done(std::nullopt); }
+
+ private:
+  void Done(std::optional<SkColor> color);
+
+  NickelDesktopTools::PickColorCallback callback_;
+  std::unique_ptr<eye_dropper::EyeDropperView> view_;
+};
+
+std::unique_ptr<ColorPick>& CurrentPick() {
+  static base::NoDestructor<std::unique_ptr<ColorPick>> pick;
+  return *pick;
+}
+
+void ColorPick::Done(std::optional<SkColor> color) {
+  // Called from the eyedropper's own code: it goes away afterwards, once.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](std::optional<SkColor> color) {
+                       std::unique_ptr<ColorPick> pick =
+                           std::move(CurrentPick());
+                       if (pick) {
+                         pick->Answer(color);
+                       }
+                     },
+                     color));
+}
+
+}  // namespace
+
+// static
+void NickelDesktopTools::PickColor(PickColorCallback callback) {
+  if (CurrentPick()) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  CurrentPick() = std::make_unique<ColorPick>(std::move(callback));
+  CurrentPick()->Show();
+}
+
+// static
+void NickelDesktopTools::SetWallpaper(
+    const base::FilePath& path,
+    base::OnceCallback<void(bool done)> callback) {
+  const user_manager::User* user =
+      user_manager::UserManager::Get()->GetActiveUser();
+  WallpaperController* controller = WallpaperController::Get();
+  if (!user || !controller) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (path.empty()) {
+    controller->SetDefaultWallpaper(user->GetAccountId(),
+                                    /*show_wallpaper=*/true,
+                                    std::move(callback));
+    return;
+  }
+  if (!path.IsAbsolute()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  controller->SetCustomWallpaper(user->GetAccountId(), path,
+                                 WALLPAPER_LAYOUT_CENTER_CROPPED,
+                                 /*preview_mode=*/false, std::move(callback));
+}
+
+}  // namespace ash

 }
 
+// NickelOS: the Screenshot portal's PickColor, ChromeOS's eyedropper
+// (NickelDesktopTools::PickColor): () -> (picked, ARGB).
+void VmApplicationsServiceProvider::NickelPickColor(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  NickelDesktopTools::PickColor(base::BindOnce(
+      [](dbus::MethodCall* method_call,
+         dbus::ExportedObject::ResponseSender response_sender,
+         std::optional<SkColor> color) {
+        std::unique_ptr<dbus::Response> response =
+            dbus::Response::FromMethodCall(method_call);
+        dbus::MessageWriter writer(response.get());
+        writer.AppendBool(color.has_value());
+        writer.AppendUint32(color.value_or(SK_ColorTRANSPARENT));
+        std::move(response_sender).Run(std::move(response));
+      },
+      method_call, std::move(response_sender)));
+}
+
+// NickelOS: the Wallpaper portal (NickelDesktopTools::SetWallpaper):
+// (path, "" for the default) -> (done).
+void VmApplicationsServiceProvider::NickelSetWallpaper(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string path;
+  if (!reader.PopString(&path)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS, "Expected a path"));
+    return;
+  }
+  NickelDesktopTools::SetWallpaper(
+      base::FilePath(path),
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             bool done) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter(response.get()).AppendBool(done);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}
+
 void VmApplicationsServiceProvider::LaunchTerminal(
     dbus::MethodCall* method_call,
     dbus::ExportedObject::ResponseSender response_sender) {

+
+namespace ash {
+
+// NickelOS: Linux apps print through ChromeOS's print preview (the Print
+// portal's backend, xdg-desktop-portal-nickel; VmApplicationsService
+// .NickelPrint).
+class NickelPrint {
+ public:
+  // Reads the document (a PDF) from `document`, opens it in a window of its
+  // own and print preview over it; `callback` gets whether it opened.
+  static void Print(const std::string& app_name,
+                    const std::string& title,
+                    base::ScopedFD document,
+                    base::OnceCallback<void(bool)> callback);
+};
+
+}  // namespace ash

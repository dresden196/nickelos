   exported_object->ExportMethod(
       vm_tools::apps::kVmApplicationsServiceInterface, kNickelAccessAskMethod,
       base::BindRepeating(&VmApplicationsServiceProvider::NickelAccessAsk,
@@ -747,6 +756,37 @@ void VmApplicationsServiceProvider::NickelInhibit(
   std::move(response_sender).Run(dbus::Response::FromMethodCall(method_call));
 }
 
+// NickelOS: a Linux app prints: (app name, title, h document, a PDF).
+// Answers whether ChromeOS's print preview opened: (b).
+void VmApplicationsServiceProvider::NickelPrint(
+    dbus::MethodCall* method_call,
+    dbus::ExportedObject::ResponseSender response_sender) {
+  dbus::MessageReader reader(method_call);
+  std::string app_name;
+  std::string title;
+  base::ScopedFD document;
+  if (!reader.PopString(&app_name) || !reader.PopString(&title) ||
+      !reader.PopFileDescriptor(&document)) {
+    std::move(response_sender)
+        .Run(dbus::ErrorResponse::FromMethodCall(
+            method_call, DBUS_ERROR_INVALID_ARGS,
+            "Expected app name, title, document"));
+    return;
+  }
+  NickelPrint::Print(
+      app_name, title, std::move(document),
+      base::BindOnce(
+          [](dbus::MethodCall* method_call,
+             dbus::ExportedObject::ResponseSender response_sender,
+             bool shown) {
+            std::unique_ptr<dbus::Response> response =
+                dbus::Response::FromMethodCall(method_call);
+            dbus::MessageWriter(response.get()).AppendBool(shown);
+            std::move(response_sender).Run(std::move(response));
+          },
+          method_call, std::move(response_sender)));
+}

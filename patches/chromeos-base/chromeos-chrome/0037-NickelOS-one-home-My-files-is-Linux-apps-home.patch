+// The one home of the session's Linux user: Chrome runs as a local account's
+// own user, whose home nickel-accountsd sets to /home/<name>. Empty for any
+// other home (a guest session runs as chronos, home /home/chronos/user).
+const base::FilePath& NickelOneHome() {
+  static const base::NoDestructor<base::FilePath> home([] {
+    struct passwd entry;
+    struct passwd* result = nullptr;
+    std::array<char, 4096> buffer;
+    if (getpwuid_r(getuid(), &entry, buffer.data(), buffer.size(), &result) !=
+            0 ||
+        !result || !result->pw_dir) {
+      return base::FilePath();
+    }
+    base::FilePath dir(result->pw_dir);
+    return dir.DirName() == base::FilePath("/home") ? dir : base::FilePath();
+  }());
+  return *home;
+}

+base::FilePath NickelPathForLinuxApps(Profile* profile,
+                                      const base::FilePath& path) {
+  const base::FilePath& home = NickelOneHome();
+  if (home.empty() || !profile) {
+    return path;
+  }
+  const base::FilePath my_files =
+      file_manager::util::GetMyFilesFolderForProfile(profile);
+  base::FilePath relative;
+  if (path == my_files) {
+    return home;
+  }
+  if (my_files.AppendRelativePath(path, &relative)) {
+    return home.Append(relative);
+  }
+  return path;
+}
+
+base::FilePath NickelPathFromLinuxApps(Profile* profile,
+                                       const base::FilePath& path) {
+  if (!profile) {
+    return path;
+  }
+  const base::FilePath& home = NickelOneHome();
+  base::FilePath relative;
+  if (!home.empty()) {
+    const base::FilePath my_files =
+        file_manager::util::GetMyFilesFolderForProfile(profile);
+    if (path == home) {
+      return my_files;
+    }
+    if (home.AppendRelativePath(path, &relative)) {
+      return my_files.Append(relative);
+    }
+  }
+  // /home/chronos/user (Linux apps' home before one home, and a guest's My
+  // files is below it) is a bind mount of the profile directory, under which
+  // ChromeOS's volumes are.
+  const base::FilePath user_home(kHomeDirectory);
+  if (path == user_home) {
+    return profile->GetPath();
+  }
+  if (user_home.AppendRelativePath(path, &relative)) {
+    return profile->GetPath().Append(relative);
+  }
+  return path;
+}

diff --git a/chrome/browser/extensions/api/terminal/terminal_private_api.cc b/chrome/browser/extensions/api/terminal/terminal_private_api.cc
index 521812409c8c6..ec46f4dfc1608 100644
--- a/chrome/browser/extensions/api/terminal/terminal_private_api.cc
+++ b/chrome/browser/extensions/api/terminal/terminal_private_api.cc
@@ -109,6 +109,37 @@ const char kSwitchContainerFeatures[] = "container_features";
 
 const char kCwdTerminalIdPrefix[] = "terminal_id:";
 
+// NickelOS: "vmshell" for the host (crostini::kNickelVmName) is a login shell
+// of the signed-in user on the device itself, not vsh into a VM.
+bool IsNickelHostShell(const std::optional<std::vector<std::string>>& args) {
+  if (!args) {
+    return false;
+  }
+  std::vector<std::string> argv = {kVmShellCommand};
+  argv.insert(argv.end(), args->begin(), args->end());
+  return base::CommandLine(argv).GetSwitchValueASCII(kSwitchVmName) ==
+         crostini::kNickelVmName;
+}
+
+base::CommandLine NickelHostShellCommandLine(
+    const std::optional<std::vector<std::string>>& args) {
+  std::vector<std::string> argv = {kVmShellCommand};
+  if (args) {
+    argv.insert(argv.end(), args->begin(), args->end());
+  }
+  base::CommandLine params(argv);
+  // nickel-terminal-shell (nickel-appd) has the session start a login shell
+  // of the signed-in user in their home directory, outside Chrome's sandbox:
+  // session_manager starts Chrome with no_new_privs and Landlock, which a
+  // shell started by Chrome would inherit (no sudo, no mount). Args after
+  // `--` (apps with Terminal=true) run instead of a prompt.
+  base::CommandLine shell(base::FilePath("/usr/bin/nickel-terminal-shell"));
+  for (const auto& arg : params.GetArgs()) {
+    shell.AppendArg(arg);
+  }
+  return shell;
+}
+
 // Prefs that we read and observe.
 constexpr auto kPrefsReadAllowList = std::to_array<std::string_view>({
     ash::prefs::kAccessibilitySpokenFeedbackEnabled,
@@ -340,6 +371,10 @@ TerminalPrivateOpenTerminalProcessFunction::OpenProcess(
       OpenProcess(user_id_hash,
                   base::CommandLine(base::FilePath(kStubbedCroshCommand)));
     }
+  } else if (process_name == kVmShellName && IsNickelHostShell(args) &&
+             crostini::IsNickelNativeAppsAllowed(
+                 Profile::FromBrowserContext(browser_context()))) {
+    OpenProcess(user_id_hash, NickelHostShellCommandLine(args));
   } else if (process_name == kVmShellName) {
     // Ensure vms are allowed before starting terminal.
     if (!virtual_machines::AreVirtualMachinesAllowedByPolicy()) {

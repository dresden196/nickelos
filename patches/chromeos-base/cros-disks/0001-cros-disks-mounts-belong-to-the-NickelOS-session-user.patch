@@ -58,6 +90,22 @@
 }
 
 void SessionManagerProxy::OnSessionStateChanged(const std::string& state) {
+  // NickelOS: mounts made for the session belong to its user.
+  if (state == "started") {
+    std::map<std::string, std::string> sessions;
+    brillo::ErrorPtr error;
+    uid_t owner = kChronosUID;
+    if (proxy_.RetrieveActiveSessions(&sessions, &error) && !sessions.empty()) {
+      owner = SessionUserUid(sessions.begin()->first);
+    } else {
+      LOG(ERROR) << "Cannot get the session's account; mounts stay chronos's";
+    }
+    g_mount_owner_uid = owner;
+    LOG(INFO) << "Mounts for this session belong to uid " << owner;
+  } else if (state == "stopped") {
+    g_mount_owner_uid = kChronosUID;
+  }
+

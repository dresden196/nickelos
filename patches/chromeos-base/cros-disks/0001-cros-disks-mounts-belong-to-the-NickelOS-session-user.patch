 namespace cros_disks {
 
 namespace {
 
+// NickelOS: a local account (<name>@nickel.localhost, created by
+// nickel-accountsd) is the Linux user <name> (uid 5000-5999), and its
+// session runs Chrome and the user's apps as that user. Returns that uid, or
+// chronos's for any other account.
+uid_t SessionUserUid(const std::string& account_id) {
+  constexpr std::string_view kSuffix = "@nickel.localhost";
+  if (!base::EndsWith(account_id, kSuffix)) {
+    return kChronosUID;
+  }
+  const std::string name =
+      account_id.substr(0, account_id.size() - kSuffix.size());
+  std::vector<char> buf(16384);
+  struct passwd pwd = {};
+  struct passwd* result = nullptr;
+  if (getpwnam_r(name.c_str(), &pwd, buf.data(), buf.size(), &result) != 0 ||
+      !result || result->pw_uid < 5000 || result->pw_uid > 5999) {
+    LOG(ERROR) << "No local account user for " << account_id;
+    return kChronosUID;
+  }
+  return result->pw_uid;
+}
+

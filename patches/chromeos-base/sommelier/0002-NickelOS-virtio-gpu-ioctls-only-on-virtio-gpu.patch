@@ -186,6 +186,10 @@ bool sl_linux_dmabuf_fixup_plane0_params(struct sl_context* ctx,
    * and may have different stride for host buffer and shadow/guest buffer.
    * For context, see: crbug.com/892242 and b/230510320.
    */
+  // NickelOS: only virtio-gpu has these (see sl_context.drm_is_virtgpu).

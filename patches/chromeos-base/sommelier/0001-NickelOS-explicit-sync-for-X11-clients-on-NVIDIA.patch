diff --git a/vm_tools/sommelier/compositor/sommelier-drm-syncobj.cc b/vm_tools/sommelier/compositor/sommelier-drm-syncobj.cc
new file mode 100644
index 0000000..f2012dd
--- /dev/null
+++ b/vm_tools/sommelier/compositor/sommelier-drm-syncobj.cc
@@ -0,0 +1,446 @@
+// Copyright 2026 NickelOS
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// NickelOS: explicit synchronization (linux-drm-syncobj-v1) for sommelier's
+// clients, i.e. Xwayland. NVIDIA's driver has no implicit sync, so without
+// this Xwayland copies every frame an app presents into its own buffer and
+// waits for the GPU (glFinish) before handing that to the compositor. With
+// it, Xwayland hands the app's buffers through, with an acquire point (the
+// app's rendering is done when it signals) and a release point (signaled
+// when the buffer is free again).
+//
+// Exo has no explicit synchronization, so sommelier keeps the promises
+// itself, the way Wayland compositors with explicit sync do: a commit whose
+// acquire point has not signaled yet is held (its fence watched in the event
+// loop) and goes to Exo once the app's rendering is done. Nothing waits on a
+// CPU meanwhile: input, other windows and Exo's events go on, and Exo never
+// gets a buffer the GPU is still drawing into, so its compositing never
+// waits for an app (a GPU-side wait in Exo would stall the whole screen
+// behind a slow app). Xwayland sends nothing more for a surface until that
+// commit's frame callback; anything that does come for it first sends the
+// held commit on (waiting for its fence, at most a second). A release point
+// is signaled when Exo releases the buffer, which it does once the GPU is
+// done with it.
+//
+// Offered only on NVIDIA (Mesa's drivers keep implicit sync, which costs
+// nothing here); NICKEL_SOMMELIER_EXPLICIT_SYNC=0 turns it off. Apps that
+// pass no sync points of their own (no DRI3 1.4 syncobjs, e.g. NVIDIA's GL
+// and Vulkan with libxcb older than 1.17) are not flipped by Xwayland on
+// NVIDIA (xwayland 24.1.13-r3): it copies their frames and fences the copy.
+
+#include "sommelier-drm-syncobj.h"  // NOLINT(build/include_directory)
+
+#include <errno.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include <gbm.h>
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "../sommelier.h"          // NOLINT(build/include_directory)
+#include "../sommelier-logging.h"  // NOLINT(build/include_directory)
+#include "linux-drm-syncobj-v1-server-protocol.h"  // NOLINT(build/include_directory)
+
+#ifndef DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE
+#define DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE (1 << 2)
+#endif
+
+namespace {
+
+constexpr int64_t kAcquireTimeoutNs = 1000 * 1000 * 1000;
+
+// A timeline the client imported: a DRM syncobj handle on sommelier's render
+// node, kept until every point waiting on it was signaled.
+struct Timeline {
+  int fd;
+  uint32_t handle;
+  ~Timeline() { drmSyncobjDestroy(fd, handle); }
+};
+
+struct Point {
+  std::shared_ptr<Timeline> timeline;
+  uint64_t value = 0;
+  explicit operator bool() const { return timeline != nullptr; }
+};
+
+struct SyncobjSurface {
+  struct wl_resource* resource;
+  struct sl_host_surface* surface;
+  Point acquire;
+  Point release;
+  struct sl_host_buffer* attached = nullptr;
+  bool buffer_attached = false;
+};
+
+int g_drm_fd = -1;
+// NICKEL_SOMMELIER_EXPLICIT_SYNC=test-nowait: commits go to the host with no
+// wait and no fence, unsynchronized, so that hw/x-sync-test.sh can show it
+// catches frames shown before the GPU finished them. Never for real use.
+bool g_test_nowait = false;
+std::map<struct sl_host_surface*, SyncobjSurface*> g_surfaces;
+// Release points of committed buffers, signaled when the buffer is released.
+std::multimap<struct sl_host_buffer*, Point> g_releases;
+
+// A commit held until its acquire fence signals.
+struct HeldCommit {
+  int fence = -1;
+  struct wl_event_source* source = nullptr;
+  struct sl_host_buffer* buffer = nullptr;
+  Point release;
+  std::function<void()> resume;
+};
+std::map<struct sl_host_surface*, HeldCommit> g_held;
+// Surfaces whose held commit is going on to the host right now.
+std::set<struct sl_host_surface*> g_resuming;
+
+void Signal(const Point& point) {
+  uint32_t handle = point.timeline->handle;
+  uint64_t value = point.value;
+  if (drmSyncobjTimelineSignal(g_drm_fd, &handle, &value, 1)) {
+    LOG(WARNING) << "drm syncobj: signaling a release point failed: "
+                 << strerror(errno);
+  }
+}
+
+int64_t Deadline() {
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return now.tv_sec * 1000000000LL + now.tv_nsec + kAcquireTimeoutNs;
+}
+
+// Waits until the rendering behind |point| is done (on a CPU: the fallback
+// when Exo cannot wait itself).
+void WaitSignaled(const Point& point) {
+  uint32_t handle = point.timeline->handle;
+  uint64_t value = point.value;
+  if (drmSyncobjTimelineWait(g_drm_fd, &handle, &value, 1, Deadline(),
+                             DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT,
+                             nullptr)) {
+    LOG(WARNING) << "drm syncobj: acquire point not signaled in time ("
+                 << strerror(errno) << "), presenting anyway";
+  }
+}
+
+// Waits until the rendering behind |point| is submitted (not done) and
+// returns its fence as a sync_file, or -1.
+int ExportSubmitted(const Point& point) {
+  uint32_t handle = point.timeline->handle;
+  uint64_t value = point.value;
+  if (drmSyncobjTimelineWait(g_drm_fd, &handle, &value, 1, Deadline(),
+                             DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT |
+                                 DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE,
+                             nullptr)) {
+    return -1;
+  }
+  uint32_t binary;
+  if (drmSyncobjCreate(g_drm_fd, 0, &binary))
+    return -1;
+  int fd = -1;
+  if (drmSyncobjTransfer(g_drm_fd, binary, 0, handle, value, 0) ||
+      drmSyncobjExportSyncFile(g_drm_fd, binary, &fd)) {
+    fd = -1;
+  }
+  drmSyncobjDestroy(g_drm_fd, binary);
+  return fd;
+}
+
+// Sends |surface|'s held commit on to the host; with |wait|, once its fence
+// signals (at most a second).
+void ReleaseHeld(struct sl_host_surface* surface, bool wait) {
+  auto it = g_held.find(surface);
+  if (it == g_held.end())
+    return;
+  HeldCommit held = std::move(it->second);
+  g_held.erase(it);
+  if (held.source)
+    wl_event_source_remove(held.source);
+  if (wait) {
+    struct pollfd p = {held.fence, POLLIN, 0};
+    if (poll(&p, 1, static_cast<int>(kAcquireTimeoutNs / 1000000)) <= 0) {
+      LOG(WARNING) << "drm syncobj: acquire point not signaled in time, "
+                      "presenting anyway";
+    }
+  }
+  close(held.fence);
+  if (held.buffer)
+    g_releases.emplace(held.buffer, std::move(held.release));
+  else if (held.release)
+    Signal(held.release);
+  g_resuming.insert(surface);
+  held.resume();
+  g_resuming.erase(surface);
+}
+
+int OnFenceSignaled(int, uint32_t, void* data) {
+  ReleaseHeld(static_cast<struct sl_host_surface*>(data), false);
+  return 0;
+}
+
+uint64_t PointValue(uint32_t hi, uint32_t lo) {
+  return (static_cast<uint64_t>(hi) << 32) | lo;
+}
+
+std::shared_ptr<Timeline> TimelineOf(struct wl_resource* resource) {
+  return *static_cast<std::shared_ptr<Timeline>*>(
+      wl_resource_get_user_data(resource));
+}
+
+// wp_linux_drm_syncobj_timeline_v1
+
+void TimelineDestroy(struct wl_client*, struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct wp_linux_drm_syncobj_timeline_v1_interface kTimelineImpl = {
+    TimelineDestroy};
+
+void DestroyTimelineResource(struct wl_resource* resource) {
+  delete static_cast<std::shared_ptr<Timeline>*>(
+      wl_resource_get_user_data(resource));
+}
+
+// wp_linux_drm_syncobj_surface_v1
+
+SyncobjSurface* SurfaceOf(struct wl_resource* resource) {
+  return static_cast<SyncobjSurface*>(wl_resource_get_user_data(resource));
+}
+
+void SurfaceDestroy(struct wl_client*, struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void SetAcquirePoint(struct wl_client*,
+                     struct wl_resource* resource,
+                     struct wl_resource* timeline,
+                     uint32_t point_hi,
+                     uint32_t point_lo) {
+  SyncobjSurface* s = SurfaceOf(resource);
+  if (!s->surface) {
+    wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_SURFACE,
+                           "the surface was destroyed");
+    return;
+  }
+  s->acquire = Point{TimelineOf(timeline), PointValue(point_hi, point_lo)};
+}
+
+void SetReleasePoint(struct wl_client*,
+                     struct wl_resource* resource,
+                     struct wl_resource* timeline,
+                     uint32_t point_hi,
+                     uint32_t point_lo) {
+  SyncobjSurface* s = SurfaceOf(resource);
+  if (!s->surface) {
+    wl_resource_post_error(resource, WP_LINUX_DRM_SYNCOBJ_SURFACE_V1_ERROR_NO_SURFACE,
+                           "the surface was destroyed");
+    return;
+  }
+  s->release = Point{TimelineOf(timeline), PointValue(point_hi, point_lo)};
+}
+
+const struct wp_linux_drm_syncobj_surface_v1_interface kSurfaceImpl = {
+    SurfaceDestroy, SetAcquirePoint, SetReleasePoint};
+
+void DestroySurfaceResource(struct wl_resource* resource) {
+  SyncobjSurface* s = SurfaceOf(resource);
+  if (s->surface)
+    g_surfaces.erase(s->surface);
+  delete s;
+}
+
+// wp_linux_drm_syncobj_manager_v1
+
+void ManagerDestroy(struct wl_client*, struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void GetSurface(struct wl_client* client,
+                struct wl_resource* resource,
+                uint32_t id,
+                struct wl_resource* surface_resource) {
+  struct sl_host_surface* surface = static_cast<sl_host_surface*>(
+      wl_resource_get_user_data(surface_resource));
+  if (g_surfaces.count(surface)) {
+    wl_resource_post_error(resource,
+                           WP_LINUX_DRM_SYNCOBJ_MANAGER_V1_ERROR_SURFACE_EXISTS,
+                           "the surface already has a syncobj surface");
+    return;
+  }
+  SyncobjSurface* s = new SyncobjSurface();
+  s->surface = surface;
+  s->resource = wl_resource_create(client, &wp_linux_drm_syncobj_surface_v1_interface,
+                                   wl_resource_get_version(resource), id);
+  wl_resource_set_implementation(s->resource, &kSurfaceImpl, s,
+                                 DestroySurfaceResource);
+  g_surfaces[surface] = s;
+}
+
+void ImportTimeline(struct wl_client* client,
+                    struct wl_resource* resource,
+                    uint32_t id,
+                    int32_t fd) {
+  uint32_t handle;
+  int ret = drmSyncobjFDToHandle(g_drm_fd, fd, &handle);
+  close(fd);
+  if (ret) {
+    wl_resource_post_error(resource,
+                           WP_LINUX_DRM_SYNCOBJ_MANAGER_V1_ERROR_INVALID_TIMELINE,
+                           "not a DRM syncobj: %s", strerror(errno));
+    return;
+  }
+  auto* timeline = new std::shared_ptr<Timeline>(new Timeline{g_drm_fd, handle});
+  struct wl_resource* timeline_resource =
+      wl_resource_create(client, &wp_linux_drm_syncobj_timeline_v1_interface,
+                         wl_resource_get_version(resource), id);
+  wl_resource_set_implementation(timeline_resource, &kTimelineImpl, timeline,
+                                 DestroyTimelineResource);
+}
+
+const struct wp_linux_drm_syncobj_manager_v1_interface kManagerImpl = {
+    ManagerDestroy, GetSurface, ImportTimeline};
+
+void BindManager(struct wl_client* client,
+                 void* data,
+                 uint32_t version,
+                 uint32_t id) {
+  struct wl_resource* resource = wl_resource_create(
+      client, &wp_linux_drm_syncobj_manager_v1_interface, version, id);
+  wl_resource_set_implementation(resource, &kManagerImpl, data, nullptr);
+}
+
+}  // namespace
+
+struct sl_global* sl_drm_syncobj_global_create(struct sl_context* ctx) {
+  const char* enabled = getenv("NICKEL_SOMMELIER_EXPLICIT_SYNC");
+  if (!ctx->gbm || (enabled && !strcmp(enabled, "0")))
+    return nullptr;
+  int fd = gbm_device_get_fd(ctx->gbm);
+  drmVersionPtr version = drmGetVersion(fd);
+  bool nvidia = version && version->name && !strcmp(version->name, "nvidia-drm");
+  drmFreeVersion(version);
+  uint64_t timeline_cap = 0;
+  if (!nvidia || drmGetCap(fd, DRM_CAP_SYNCOBJ_TIMELINE, &timeline_cap) ||
+      !timeline_cap) {
+    return nullptr;
+  }
+  g_drm_fd = fd;
+  g_test_nowait = enabled && !strcmp(enabled, "test-nowait");
+  if (g_test_nowait)
+    LOG(WARNING) << "drm syncobj: test-nowait, frames are NOT synchronized";
+  LOG(INFO) << "explicit sync (linux-drm-syncobj-v1) for X11 clients";
+  return sl_global_create(ctx, &wp_linux_drm_syncobj_manager_v1_interface, 1,
+                          ctx, BindManager);
+}
+
+void sl_drm_syncobj_surface_attach(struct sl_host_surface* surface,
+                                   struct sl_host_buffer* buffer) {
+  auto it = g_surfaces.find(surface);
+  if (it == g_surfaces.end())
+    return;
+  it->second->attached = buffer;
+  it->second->buffer_attached = true;
+}
+
+bool sl_drm_syncobj_surface_commit(struct sl_host_surface* surface,
+                                   std::function<void()> resume) {
+  // The held commit itself, going on now.
+  if (g_resuming.erase(surface))
+    return false;
+  // Another commit before the held one's frame callback: that one first.
+  ReleaseHeld(surface, true);
+  auto it = g_surfaces.find(surface);
+  if (it == g_surfaces.end())
+    return false;
+  SyncobjSurface* s = it->second;
+  bool has_buffer = s->buffer_attached && s->attached;
+  bool held = false;
+  // The protocol makes these errors, but an error ends Xwayland, and every
+  // X11 app with it: a commit without both points goes through unsynced,
+  // and a release point nobody can keep is signaled at once.
+  if (has_buffer && (!s->acquire || !s->release)) {
+    LOG(WARNING) << "drm syncobj: buffer committed without both points";
+    if (s->release)
+      Signal(s->release);
+    has_buffer = false;
+  } else if (!has_buffer && s->release) {
+    Signal(s->release);
+  }
+  if (has_buffer && !g_test_nowait) {
+    int fence = ExportSubmitted(s->acquire);
+    struct pollfd p = {fence, POLLIN, 0};
+    if (fence < 0) {
+      WaitSignaled(s->acquire);
+    } else if (poll(&p, 1, 0) > 0) {
+      close(fence);  // Already done.
+    } else {
+      HeldCommit& h = g_held[surface];
+      h.fence = fence;
+      h.buffer = s->attached;
+      h.release = std::move(s->release);
+      h.resume = std::move(resume);
+      h.source = wl_event_loop_add_fd(
+          wl_display_get_event_loop(surface->ctx->host_display), fence,
+          WL_EVENT_READABLE, OnFenceSignaled, surface);
+      held = true;
+    }
+  }
+  if (has_buffer && !held)
+    g_releases.emplace(s->attached, std::move(s->release));
+  s->acquire = Point();
+  s->release = Point();
+  s->buffer_attached = false;
+  return held;
+}
+
+void sl_drm_syncobj_surface_flush(const struct sl_host_surface* surface) {
+  ReleaseHeld(const_cast<struct sl_host_surface*>(surface), true);
+}
+
+void sl_drm_syncobj_surface_destroyed(struct sl_host_surface* surface) {
+  // A held commit of a destroyed surface is never shown.
+  auto held = g_held.find(surface);
+  if (held != g_held.end()) {
+    if (held->second.source)
+      wl_event_source_remove(held->second.source);
+    close(held->second.fence);
+    if (held->second.release)
+      Signal(held->second.release);
+    g_held.erase(held);
+  }
+  auto it = g_surfaces.find(surface);
+  if (it == g_surfaces.end())
+    return;
+  it->second->surface = nullptr;
+  g_surfaces.erase(it);
+}
+
+void sl_drm_syncobj_buffer_released(struct sl_host_buffer* buffer) {
+  auto range = g_releases.equal_range(buffer);
+  for (auto it = range.first; it != range.second; ++it)
+    Signal(it->second);
+  g_releases.erase(range.first, range.second);
+}
+
+void sl_drm_syncobj_buffer_destroyed(struct sl_host_buffer* buffer) {
+  sl_drm_syncobj_buffer_released(buffer);
+  // A held commit keeps the surface's content; its release point is kept
+  // now, as nothing can release the buffer any more.
+  for (auto& [surface, held] : g_held) {
+    if (held.buffer == buffer) {
+      held.buffer = nullptr;
+      if (held.release)
+        Signal(held.release);
+      held.release = Point();
+    }
+  }
+}

+
+// NickelOS: shows |host|'s cursor, ChromeOS's own shape for the X cursor's
+// name where it has one, else the image Xwayland gave.
+static void sl_pointer_show_cursor(struct sl_host_pointer* host) {
+  struct sl_context* ctx = host->seat->ctx;
+  if (host->cursor_resource && host->shape_device && ctx->x11_cursor_shape) {
+    wp_cursor_shape_device_v1_set_shape(host->shape_device,
+                                        host->cursor_serial,
+                                        ctx->x11_cursor_shape);
+    return;
+  }
+  struct sl_host_surface* host_surface =
+      host->cursor_resource ? static_cast<sl_host_surface*>(
+                                  wl_resource_get_user_data(
+                                      host->cursor_resource))
+                            : nullptr;
+  wl_pointer_set_cursor(host->proxy, host->cursor_serial,
+                        host_surface ? host_surface->proxy : nullptr,
+                        host->cursor_hotspot_x, host->cursor_hotspot_y);
+}
+
+static void sl_pointer_cursor_resource_destroyed(struct wl_listener* listener,
+                                                 void* data) {
+  struct sl_host_pointer* host;
+
+  host = wl_container_of(listener, host, cursor_resource_listener);
+  wl_list_remove(&host->cursor_resource_listener.link);
+  wl_list_init(&host->cursor_resource_listener.link);
+  host->cursor_resource = nullptr;
+}
+
+void sl_pointers_x11_cursor_named(struct sl_context* ctx, const char* name) {
+  uint32_t shape = sl_cursor_shape_for_name(name);
+  if (shape == ctx->x11_cursor_shape) {
+    return;
+  }
+  ctx->x11_cursor_shape = shape;
+  struct sl_host_pointer* host;
+  wl_list_for_each(host, &ctx->host_pointers, link) {
+    if (host->focus_resource && host->cursor_resource) {
+      sl_pointer_show_cursor(host);
+    }
+  }
+}

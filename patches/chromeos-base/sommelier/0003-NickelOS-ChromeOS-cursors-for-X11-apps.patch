+// NickelOS: the X cursor changed. Its name (libXcursor names the cursors it
+// loads from themes: left_ptr, pointer, xterm, ...) picks ChromeOS's own
+// cursor for X11 apps (sl_pointers_x11_cursor_named).
+static void sl_handle_xfixes_cursor_notify(
+    struct sl_context* ctx, xcb_xfixes_cursor_notify_event_t* event) {
+  static std::map<xcb_atom_t, std::string> names;
+  if (event->name == XCB_ATOM_NONE) {
+    sl_pointers_x11_cursor_named(ctx, nullptr);
+    return;
+  }
+  auto it = names.find(event->name);
+  if (it == names.end()) {
+    xcb_get_atom_name_reply_t* reply = xcb_get_atom_name_reply(
+        ctx->connection, xcb_get_atom_name(ctx->connection, event->name),
+        nullptr);
+    std::string name;
+    if (reply) {
+      name.assign(xcb_get_atom_name_name(reply),
+                  xcb_get_atom_name_name_length(reply));
+      free(reply);
+    }
+    it = names.emplace(event->name, name).first;
+  }
+  sl_pointers_x11_cursor_named(ctx,
+                               it->second.empty() ? nullptr : it->second.c_str());
+}

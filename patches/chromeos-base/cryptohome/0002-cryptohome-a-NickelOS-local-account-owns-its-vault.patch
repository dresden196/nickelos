        libstorage::kChronosAccessGid},
       {dir.Append(kRootHomeSuffix).Append(kDaemonStoreCacheDir),
        kAccessMode | kGroupWriteAccess, libstorage::kRootUid,
@@ -117,33 +150,34 @@

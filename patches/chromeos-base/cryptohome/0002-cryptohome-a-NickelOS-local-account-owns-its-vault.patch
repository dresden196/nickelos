 };
 
-std::vector<DirectoryACL> GetCacheSubdirectories(const FilePath& dir) {
+// NickelOS: a local account (<name>@nickel.localhost, see nickel-accountsd)
+// is the Linux user <name>, and its session runs Chrome as that user, so the
+// user owns the vault. Every other account's vault is chronos's.
+// /home/chronos itself stays chronos's (EnsurePathComponent checks it).
+constexpr std::string_view kNickelLocalAccountSuffix = "@nickel.localhost";
+constexpr uid_t kNickelFirstLocalUid = 5000;
+constexpr uid_t kNickelLastLocalUid = 5999;
+
+VaultOwner ResolveVaultOwner(const Username& username) {
+  VaultOwner owner{libstorage::kChronosUid, libstorage::kChronosGid};
+  const std::string& account_id = *username;
+  if (!base::EndsWith(account_id, kNickelLocalAccountSuffix)) {
+    return owner;
+  }
+  const std::string name = account_id.substr(
+      0, account_id.size() - kNickelLocalAccountSuffix.size());
+  std::vector<char> buf(16384);
+  struct passwd pwd = {};
+  struct passwd* result = nullptr;
+  if (getpwnam_r(name.c_str(), &pwd, buf.data(), buf.size(), &result) != 0 ||
+      !result || result->pw_uid < kNickelFirstLocalUid ||
+      result->pw_uid > kNickelLastLocalUid) {
+    LOG(ERROR) << "No local account user for " << account_id
+               << "; the vault stays chronos's";
+    return owner;
+  }
+  owner.uid = result->pw_uid;
+  owner.gid = result->pw_gid;
+  return owner;
+}
+
